+    std::wstring path;
+    uint32_t flags = 0;
+    std::mutex mutex;                                  // guards everything below
+    poster::Composer composer;
+    std::map<uint32_t, std::vector<uint8_t>> early;    // tiles read back before the one the composer needs next
+    uint32_t tilesDone = 0;                            // tiles read back
+    uint32_t state = RTXPOSTER_STATE_RENDERING;
+    int32_t error = RTXPOSTER_OK;
+    std::string why;
+  };
+
+  namespace {
+    constexpr uint32_t kMinFrames = 4, kMaxFrames = 4096;
+    // The view counts as moved past one Source unit (about 2 cm) or about a fifth of a degree.
+    constexpr float kMoveDistance = 1.0f, kMoveCosine = 0.999994f;
+
+    std::string utf8(const std::wstring& text) { return str::fromws(text.c_str()); }
+
+    std::wstring tilePath(const std::wstring& path, uint32_t column, uint32_t row) {
+      const std::filesystem::path p(path);
+      const std::wstring name = p.stem().wstring() + L"_tile_" + std::to_wstring(column) + L"_" + std::to_wstring(row) + L".png";
+      return (p.parent_path() / name).wstring();
+    }
+  }
+
+  // The exports' way to the device's poster (rtx_poster_instance.h): GMod never registers its device with the Remix
+  // API, so the API's device pointer stays empty. The lock is held across an export's call, so the poster it reaches
+  // is not torn down meanwhile; the render thread never takes it.
+  namespace {
+    std::mutex g_instanceMutex;
+    RtxPoster* g_instance = nullptr;
+  }
+
+  RtxPoster::RtxPoster(DxvkDevice* device) : CommonDeviceObject(device) {
+    std::lock_guard lock(g_instanceMutex);
+    g_instance = this;
+  }
+
+  RtxPoster::~RtxPoster() {
+    std::lock_guard lock(g_instanceMutex);
+    if (g_instance == this) { g_instance = nullptr; }
+  }
+
+  void RtxPoster::onDestroy() {
+    {
+      std::lock_guard lock(g_instanceMutex);
+      if (g_instance == this) { g_instance = nullptr; }
+    }
+    // A poster being traced stops; one whose tiles are all traced is still read back and written (its readbacks
+    // and its writer hold the job, never the device's objects).
+    if (m_narrowing) { fail(RTXPOSTER_E_CANCELLED, "the device was destroyed"); }
+    m_captureImage = nullptr;
+  }
+
+  namespace poster {
+    int apiStart(const rtxposter_Request* request) {
+      std::lock_guard lock(g_instanceMutex);
+      return g_instance ? g_instance->start(request) : RTXPOSTER_E_NO_DEVICE;
+    }
+
+    void apiCancel() {
+      std::lock_guard lock(g_instanceMutex);
+      if (g_instance) { g_instance->cancel(); }
+    }
+
+    int apiStatus(rtxposter_Status* status) {
+      if (!status || status->structSize != sizeof(*status)) { return RTXPOSTER_E_ARGUMENT; }
+      std::lock_guard lock(g_instanceMutex);
+      if (!g_instance) {
+        *status = {};
+        status->structSize = sizeof(*status);
+        return RTXPOSTER_OK;
+      }
+      return g_instance->status(status);
+    }
+  }
+
+  int RtxPoster::start(const rtxposter_Request* request) {
+    if (!request || request->structSize != sizeof(rtxposter_Request)) { return RTXPOSTER_E_VERSION; }
+    if (request->multiplier < 1 || request->multiplier > poster::kMaxMultiplier
+     || (request->framesPerTile != 0 && (request->framesPerTile < kMinFrames || request->framesPerTile > kMaxFrames))
+     || (request->flags & ~RTXPOSTER_SAVE_TILES) != 0) {
+      return RTXPOSTER_E_ARGUMENT;
+    }
+    const size_t length = wcsnlen(request->path, RTXPOSTER_PATH_CHARS);
+    if (length == 0 || length + 16 > RTXPOSTER_PATH_CHARS) { return RTXPOSTER_E_ARGUMENT; }  // room for ".part"
+    if (m_device->getCommon()->metaVr().hasWork()) { return RTXPOSTER_E_VR; }
+    std::lock_guard lock(m_mutex);
+    if (m_requested) { return RTXPOSTER_E_BUSY; }
+    if (m_job) {
+      std::lock_guard jobLock(m_job->mutex);
+      if (m_job->state == RTXPOSTER_STATE_RENDERING || m_job->state == RTXPOSTER_STATE_WRITING) { return RTXPOSTER_E_BUSY; }
+    }
+    m_request.multiplier = request->multiplier;
+    m_request.framesPerTile = request->framesPerTile ? request->framesPerTile : RTXPOSTER_DEFAULT_FRAMES;
+    m_request.flags = request->flags;
+    m_request.path.assign(request->path, length);
+    m_requested = true;
+    m_cancel.store(false);
+    ++m_generation;
+    m_lastError = RTXPOSTER_OK;
+    m_lastErrorText.clear();
+    m_path = m_request.path;
+    m_statusTile.store(0);
+    m_statusFrame.store(0);
+    return RTXPOSTER_OK;
+  }
+
+  void RtxPoster::cancel() {
+    std::lock_guard lock(m_mutex);
+    if (m_requested) {
+      m_requested = false;
+      m_lastError = RTXPOSTER_E_CANCELLED;
+      m_lastErrorText = "cancelled";
+      return;
+    }
+    m_cancel.store(true);
+  }
+
+  int RtxPoster::status(rtxposter_Status* out) {
+    if (!out || out->structSize != sizeof(rtxposter_Status)) { return RTXPOSTER_E_ARGUMENT; }
+    rtxposter_Status status {};
+    status.structSize = sizeof(status);
+    std::string why;
+    {
+      std::lock_guard lock(m_mutex);
+      status.generation = m_generation;
+      status.framesPerTile = m_request.framesPerTile;
+      const size_t count = std::min<size_t>(m_path.size(), RTXPOSTER_PATH_CHARS - 1);
+      std::memcpy(status.path, m_path.data(), count * sizeof(wchar_t));
+      if (m_requested) {
+        status.state = RTXPOSTER_STATE_STARTING;
+      } else if (m_lastError != RTXPOSTER_OK) {
+        status.state = RTXPOSTER_STATE_FAILED;
+        status.lastError = m_lastError;
+        why = m_lastErrorText;
+      } else if (m_job) {
+        std::lock_guard jobLock(m_job->mutex);
+        status.state = m_job->state;
+        status.lastError = m_job->error;
+        why = m_job->why;
+        status.width = m_job->layout.width;
+        status.height = m_job->layout.height;
+        status.columns = m_job->layout.columns;
+        status.rows = m_job->layout.rows;
+        status.tilesDone = m_job->tilesDone;
+      }
+    }
+    if (status.state == RTXPOSTER_STATE_RENDERING) {
+      status.frame = m_statusFrame.load();
+      status.tilesDone = std::max(status.tilesDone, std::min(m_statusTile.load(), status.columns * status.rows));
+    }
+    std::snprintf(status.lastErrorText, sizeof(status.lastErrorText), "%s", why.c_str());
+    *out = status;
+    return RTXPOSTER_OK;
+  }
+
+  bool RtxPoster::jobFailed() {
+    std::lock_guard lock(m_job->mutex);
+    return m_job->state == RTXPOSTER_STATE_FAILED;
+  }
+
+  bool RtxPoster::beginFrame(RtxContext& ctx, VkExtent3D outputExtent) {
+    if (!m_narrowing) {
+      bool requested = false;
+      {
+        std::lock_guard lock(m_mutex);
+        requested = m_requested;
+      }
+      // A poster's tiles start with the next frame: this frame's views were already taken whole.
+      if (requested) { startJob(ctx, outputExtent); }
+      return false;
+    }
+    if (m_cancel.exchange(false)) {
+      fail(RTXPOSTER_E_CANCELLED, "cancelled");
+      return false;
+    }
+    if (jobFailed()) {  // a readback failed
+      stopNarrowing();
+      return false;
+    }
+    if (m_device->getCommon()->metaVr().hasWork()) {
+      fail(RTXPOSTER_E_VR, "VR started");
+      return false;
+    }
+    if (outputExtent.width != m_job->layout.tileWidth || outputExtent.height != m_job->layout.tileHeight) {
+      fail(RTXPOSTER_E_RESIZED, "the window changed size");
+      return false;
+    }
+    const RtCamera& camera = ctx.getSceneManager().getCamera();
+    const Vector3 position = camera.getPosition(false), direction = camera.getDirection(false);
+    if (length(position - m_startPosition) > kMoveDistance || dot(direction, m_startDirection) < kMoveCosine) {
+      fail(RTXPOSTER_E_MOVED, "the view moved; hold still while a poster renders");
+      return false;
+    }
+    return m_frame == 0;
+  }
+
+  void RtxPoster::startJob(RtxContext& ctx, VkExtent3D extent) {
+    Request request;
+    {
+      std::lock_guard lock(m_mutex);
+      request = m_request;
+    }
+    auto job = std::make_shared<Job>();
+    std::string why;
+    int error = RTXPOSTER_OK;
+    if (!poster::makeLayout(extent.width, extent.height, request.multiplier,
+                            poster::defaultOverlap(extent.width, extent.height), job->layout, why)) {
+      error = RTXPOSTER_E_SIZE;
+    } else if (!job->composer.begin(job->layout, why)) {
+      error = RTXPOSTER_E_MEMORY;
+    }
+    job->path = request.path;
+    job->flags = request.flags;
+    {
+      std::lock_guard lock(m_mutex);
+      m_requested = false;
+      if (error != RTXPOSTER_OK) {
+        m_lastError = error;
+        m_lastErrorText = why;
+        m_job = nullptr;
+      } else {
+        m_job = job;
+      }
+    }
+    if (error != RTXPOSTER_OK) {
+      Logger::warn(str::format("[Poster] not started: ", why));
+      return;
+    }
+    m_framesPerTile = request.framesPerTile;
+    m_tile = 0;
+    m_frame = 0;
+    m_window = poster::tileWindow(job->layout, 0);
+    m_pixelScale = float(poster::pixelScale(job->layout));
+    const RtCamera& camera = ctx.getSceneManager().getCamera();
+    m_startPosition = camera.getPosition(false);
+    m_startDirection = camera.getDirection(false);
+    m_narrowing = true;
+    m_cancel.store(false);
+    // The clock stands still: the sky, the clouds, animated materials and particles stay as they are.
+    GlobalTime::get().setAdvanceTime(false);
+    Logger::info(str::format("[Poster] ", job->layout.width, "x", job->layout.height, " in ", job->layout.columns, "x",
+                             job->layout.rows, " tiles of ", job->layout.tileWidth, "x", job->layout.tileHeight,
+                             " (overlap ", job->layout.overlap, "), ", m_framesPerTile, " frames each: ", utf8(job->path)));
+  }
+
+  void RtxPoster::endFrame(RtxContext& ctx, const Rc<DxvkImage>& picture) {
+    if (!m_narrowing || picture == nullptr) { return; }
+    ++m_frame;
+    m_statusFrame.store(m_frame);
+    if (m_frame < m_framesPerTile) { return; }
+    capture(ctx, picture, m_tile);
+    if (!m_narrowing) { return; }  // the capture failed
+    const uint32_t tiles = m_job->layout.tiles();
+    ++m_tile;
+    m_frame = 0;
+    m_statusTile.store(m_tile);
+    m_statusFrame.store(0);
+    if (m_tile < tiles) {
+      m_window = poster::tileWindow(m_job->layout, m_tile);
+      return;
+    }
+    // Every tile is traced; its readbacks and the writer finish the poster.
+    stopNarrowing();
+    Logger::info(str::format("[Poster] all ", tiles, " tiles traced"));
+  }
+
+  void RtxPoster::capture(RtxContext& ctx, const Rc<DxvkImage>& picture, uint32_t tile) {
+    const auto& layout = m_job->layout;
+    const VkExtent3D size { layout.tileWidth, layout.tileHeight, 1 };
+    try {
+      if (m_captureImage == nullptr || m_captureImage->info().extent != size) {
+        DxvkImageCreateInfo desc {};
+        desc.type = VK_IMAGE_TYPE_2D;
+        desc.format = VK_FORMAT_R8G8B8A8_UNORM;
+        desc.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+        desc.extent = size;
+        desc.numLayers = 1;
+        desc.mipLevels = 1;
+        desc.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        desc.stages = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+        desc.access = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+        desc.tiling = VK_IMAGE_TILING_OPTIMAL;
+        desc.layout = VK_IMAGE_LAYOUT_UNDEFINED;
+        m_captureImage = m_device->createImage(desc, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+                                               DxvkMemoryStats::Category::RTXRenderTarget, "poster tile");
+        ctx.changeImageLayout(m_captureImage, VK_IMAGE_LAYOUT_GENERAL);
+      }
+      // The picture is 16-bit float, already in display (sRGB) values; the blit rounds it to the bytes shown.
+      RtxContext::blitImageHelper(&ctx, picture, m_captureImage, VK_FILTER_NEAREST);
+      const VkDeviceSize bytes = VkDeviceSize(size.width) * size.height * 4;
+      DxvkBufferCreateInfo desc {};
+      desc.size = bytes;
+      desc.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+      desc.stages = VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_HOST_BIT;
+      desc.access = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_HOST_READ_BIT;
+      auto buffer = m_device->createBuffer(desc, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+                                           DxvkMemoryStats::Category::RTXBuffer, "poster tile readback");
+      ctx.copyImageToBuffer(buffer, 0, 1, 1, m_captureImage, { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, { 0, 0, 0 }, size);
+      std::shared_ptr<Job> job = m_job;
+      ctx.getCommonObjects()->metaExporter().copyBufferFromGPU(&ctx, DxvkBufferSlice(buffer, 0, bytes),
+        [job, tile](Rc<DxvkBuffer> readback) { onReadback(job, tile, readback); });
+    } catch (const DxvkError& error) {
+      fail(RTXPOSTER_E_CAPTURE, str::format("a tile could not be read back: ", error.message()));
+    }
+  }
+
+  // The exporter's thread, one readback after another in the order they were recorded.
+  void RtxPoster::onReadback(const std::shared_ptr<Job>& job, uint32_t tile, const Rc<DxvkBuffer>& buffer) {
+    const auto& layout = job->layout;
+    const auto* data = buffer != nullptr ? static_cast<const uint8_t*>(buffer->mapPtr(0)) : nullptr;
+    const size_t pitch = size_t(layout.tileWidth) * 4;
+    {
+      std::lock_guard lock(job->mutex);
+      if (job->state != RTXPOSTER_STATE_RENDERING) { return; }  // stopped, or the readback of a stopped poster
+    }
+    if (data && (job->flags & RTXPOSTER_SAVE_TILES)) {
+      std::vector<uint8_t> bgr(size_t(layout.tileWidth) * layout.tileHeight * 3);
+      for (size_t i = 0, n = size_t(layout.tileWidth) * layout.tileHeight; i < n; ++i) {
+        bgr[i * 3] = data[i * 4 + 2]; bgr[i * 3 + 1] = data[i * 4 + 1]; bgr[i * 3 + 2] = data[i * 4];
+      }
+      std::string why;
+      const std::wstring path = tilePath(job->path, tile % layout.columns, tile / layout.columns);
+      if (!poster::writePng(path, layout.tileWidth, layout.tileHeight, bgr.data(), size_t(layout.tileWidth) * 3, why)) {
+        Logger::warn(str::format("[Poster] tile ", tile, " not saved: ", why));
+      }
+    }
+    bool complete = false;
+    {
+      std::lock_guard lock(job->mutex);
+      if (job->state != RTXPOSTER_STATE_RENDERING) { return; }
+      if (!data) {
+        job->state = RTXPOSTER_STATE_FAILED;
+        job->error = RTXPOSTER_E_CAPTURE;
+        job->why = "a tile's readback could not be mapped";
+        job->composer.release();
+        job->early.clear();
+        return;
+      }
+      if (tile == job->composer.nextTile()) {
+        job->composer.addTile(tile, data, pitch);
+        for (auto next = job->early.find(job->composer.nextTile()); next != job->early.end();
+             next = job->early.find(job->composer.nextTile())) {
+          job->composer.addTile(next->first, next->second.data(), pitch);
+          job->early.erase(next);
+        }
+      } else {
+        job->early.emplace(tile, std::vector<uint8_t>(data, data + pitch * layout.tileHeight));
+      }
+      ++job->tilesDone;
+      complete = job->composer.complete();
+      if (complete) { job->state = RTXPOSTER_STATE_WRITING; }
+    }
+    // The writer holds the job and nothing of the device's, so it may outlive both the exporter's readback and the
+    // device; it is not joined. A game that quits while a poster is written leaves only its ".part" file.
+    if (complete) { std::thread(writePoster, job).detach(); }
+  }
+
+  void RtxPoster::writePoster(std::shared_ptr<Job> job) {
+    const auto& layout = job->layout;
+    const std::wstring part = job->path + L".part";
+    std::string why;
+    // The composer is complete, and nothing changes it while the state is WRITING.
+    bool written = poster::writePng(part, layout.width, layout.height, job->composer.pixels(), size_t(layout.width) * 3, why);
+    std::error_code error;
+    if (written) {
+      std::filesystem::rename(part, job->path, error);
+      if (error) { written = false; why = "the finished file could not be renamed: " + error.message(); }
+    }
+    if (!written) { std::filesystem::remove(part, error); }
+    {
+      std::lock_guard lock(job->mutex);
+      job->composer.release();
+      job->state = written ? RTXPOSTER_STATE_DONE : RTXPOSTER_STATE_FAILED;
+      job->error = written ? RTXPOSTER_OK : RTXPOSTER_E_WRITE;
+      job->why = written ? std::string() : why;
+    }
+    if (written) {
+      Logger::info(str::format("[Poster] saved ", layout.width, "x", layout.height, ": ", utf8(job->path)));
+    } else {
+      Logger::err(str::format("[Poster] not saved: ", why));
+    }
+  }
+
+  void RtxPoster::fail(int error, const std::string& why) {
+    if (m_job) {
+      std::lock_guard lock(m_job->mutex);
+      if (m_job->state == RTXPOSTER_STATE_RENDERING) {
+        m_job->state = RTXPOSTER_STATE_FAILED;
+        m_job->error = error;
+        m_job->why = why;
+        m_job->composer.release();
+        m_job->early.clear();
+      }
+    }
+    if (m_narrowing) { stopNarrowing(); }
+    Logger::warn(str::format("[Poster] stopped: ", why));
+  }
+
+  void RtxPoster::stopNarrowing() {
+    m_narrowing = false;
+    m_frame = 0;
+    GlobalTime::get().setAdvanceTime(RtxOptions::advanceTime());
+  }
+}
