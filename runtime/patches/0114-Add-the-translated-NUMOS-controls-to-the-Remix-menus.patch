+#, c-format
+msgid "Remix fog is active. Select Enhanced mist to use NUMOS haze throughout the scene."
+msgstr "Remix 雾已启用。选择“增强雾”可在整个场景中使用 NUMOS 雾霭。"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:754
+msgid "Rainbow"
+msgstr "彩虹"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:756
+msgid "Sunlit Rain"
+msgstr "阳光照亮的雨"
+
