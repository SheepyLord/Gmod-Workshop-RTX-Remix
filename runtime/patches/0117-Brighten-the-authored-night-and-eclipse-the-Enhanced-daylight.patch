+namespace numos { class Renderer; }
+
+namespace dxvk {
+  struct NumosSolarEclipse {
+    float coverage = 0.f;      // Fraction of the visible solar disc's area hidden by moons.
+    float daylight = 1.f;      // Remaining limb-darkened flux, including the configured totality floor.
+    numos::Vector3 fullSun;    // Authored irradiance before occultation or NUMOS pre-exposure.
+    float totalityStarGain = 1.f;
+  };
