   class PoseRing {
   public:
+    enum class Selection { Fresh,Stale,Unknown };
+    Selection select(const float origin[3],Vec3 forward,Vec3 up,rtxvr_FramePose& result,uint64_t consumed) const {
+      if(match(origin,forward,up,result,consumed)) { return Selection::Fresh; }
+      rtxvr_FramePose previous{};
+      if(match(origin,forward,up,previous)&&previous.sequence<=consumed) {
+        result=previous;return Selection::Stale;
+      }
+      return Selection::Unknown;
+    }
     bool push(const rtxvr_FramePose& pose) {
       if (m_count && pose.sequence<=m_poses[(m_next+15)%16].pose.sequence) { return false; }
       auto orientation=sourceOrientation(pose.cameraAngles);
