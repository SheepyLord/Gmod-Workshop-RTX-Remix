     const auto infinity=project(actual,eyeRay(index[0],.5,.5));
-    require(searchSteps(start,infinity,1536,1376)==34,"Index spacing is derived from its depth texels, not guessed");
+    require(searchSteps(start,infinity,actual.width/2,actual.height/2)==83,"Index near-hand spacing follows its depth texels");
     unsigned fixedMisses=0;
     for(int cell:{700,750,800}) for(const auto& side:index) {
       auto depthAt=[&](double u,double) { return std::clamp(int(u*1536),0,1535)==cell?1.5:10.; };
