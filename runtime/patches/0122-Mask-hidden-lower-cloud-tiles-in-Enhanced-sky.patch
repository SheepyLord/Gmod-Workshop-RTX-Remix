diff --git a/src/dxvk/shaders/numos_lower/lower_cloud.slangh b/src/dxvk/shaders/numos_lower/lower_cloud.slangh
new file mode 100644
index 0000000000000000000000000000000000000000..184a245af636eadee2e7ce3a6ac7d6ff15e277d6
--- /dev/null
+++ b/src/dxvk/shaders/numos_lower/lower_cloud.slangh
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: MIT
+// Each entry point calls the pinned library shader for an entire visible workgroup.
+// The normal sky and the lower dome used by reflection rays keep their original shaders.
+#include "rtx/pass/numos/numos_lower_tiles.h"
+layout(binding = NUMOS_LOWER_TILE_INPUT) Texture2D<uint> lowerCloudTiles;
+
+bool needsCloudGroup(uint2 firstPixel)
+{
+  uint2 size;
+  lowerCloudTiles.GetDimensions(size.x, size.y);
+  // The shifted temporal grid can have an extra group at the right or bottom.
+  return lowerCloudTiles.Load(int3(min(firstPixel / NUMOS_LOWER_TILE_PIXELS, size - 1u), 0)) != 0;
+}
+
+bool skipLowerCloudGroup(uint3 group, uint3 lane, uint3 id)
+{
+#if defined(LOWER_DENOISE) || defined(LOWER_CIRRUS)
+  // Display-only outputs are sampled by the composite inside the active tiles.
+  return !needsCloudGroup(group.xy * 8u);
+#else
+  const AtmosphereArgs args = atmosphereArgs;
+  // Leave the library's explicit clears (and their unshifted grid) intact.
+  const float coverage = max(args.cloudCoverageMean, args.cloudLayer2Enable != 0 ? args.cloudLayer2CoverageMean : 0.f);
+  if (args.cloudEnabled < .5f || coverage < .01f || args.cloudViewSamples == 0u)
+  {
+    return false;
+  }
+
+#if CLOUD_SCREEN_MARCH_ONLY
+  const uint scale = (args.cloudScreenInterleave & 0x80000u) != 0 ? 4u : 2u;
+#elif CLOUD_SCREEN_REBUILD
+  const uint scale = uint(kCloudRebuildBlock);
+#elif CLOUD_SCREEN_FALLBACK || defined(CLOUD_REFERENCE_PATH_TRACE)
+  const uint scale = 1u;
+#else
+  const uint scale = (args.cloudScreenInterleave & 0x40000u) != 0 ? 2u : 1u;
+#endif
+  if (needsCloudGroup(group.xy * 8u * scale))
+  {
+    return false;
+  }
+
+#if CLOUD_SCREEN_MARCH_ONLY
+  // The rebuild pass gathers cells from adjacent groups. A skipped cell has no fresh sample.
+  uint2 cells;
+  cloudFreshDepth.GetDimensions(cells.x, cells.y);
+  if (all(id.xy < cells))
+  {
+    cloudFreshColor[id.xy] = float4(0, 0, 0, 1);
+    cloudFreshDepth[id.xy] = float4(-1, 0, -kNoSurfaceKm, -1);
+    cloudFreshAux[id.xy] = 0;
+  }
+#elif !CLOUD_SCREEN_FALLBACK
+  // A miss can become visible on the next frame. Invalidate the previous-depth tap that the
+  // library checks on reprojection, and reset its empty-skip and history-length state.
+  uint2 dim;
+  cloudRenderOutput.GetDimensions(dim.x, dim.y);
+  int2 first = int2(id.xy);
+#if !CLOUD_SCREEN_REBUILD && !defined(CLOUD_REFERENCE_PATH_TRACE)
+  first -= int2((args.cloudRenderFrameIdx * 5u) % 8u, (args.cloudRenderFrameIdx * 3u) % 8u);
+#endif
+  first *= int(scale);
+  for (uint y = 0; y < scale; ++y)
+    for (uint x = 0; x < scale; ++x)
+    {
+      const int2 p = first + int2(x, y);
+      if (all(p >= 0) && all(p < int2(dim)))
+      {
+        cloudRenderOutput[p] = float4(0, 0, 0, 1);
+        cloudDepthOutput[p] = float4(-1, 0, -kNoSurfaceKm, 0);
+        cloudStateOutput[p] = 0;
+      }
+    }
+#if CLOUD_SCREEN_REBUILD
+  if (all(lane.xy == 0))
+    cloudFallbackTiles[group.xy * 8u * scale / uint(kCloudFallbackTilePixels)] = 0;
+#endif
+#endif
+  return true;
+#endif
+}
