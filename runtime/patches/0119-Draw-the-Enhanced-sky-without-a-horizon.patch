+// see THIRD_PARTY_NOTICES.md.
+
+// Lower half of the pin's sky view (Hillaire 2020, section 5.3). Phase and march directions
+// are independent. The output keeps the library's original texel centres.
+
+#include "numos/lib/atmosphere_common.slangh"
+#include "numos/lib/night_sky.slangh"
+#include "rtx/pass/numos/numos_horizon_bindings.h"
+
+layout(binding = SKY_VIEW_LUT_ATMOSPHERE_ARGS)
+ConstantBuffer<enhanced_AtmosphereArgs> atmosphereArgs;
+
+layout(binding = SKY_VIEW_LUT_TRANSMITTANCE_INPUT)
+Texture2D<float4> transmittanceLutInput;
+
+layout(binding = SKY_VIEW_LUT_MULTISCATTERING_INPUT)
+Texture2D<float4> multiscatteringLutInput;
+
+layout(binding = SKY_VIEW_LUT_SAMPLER)
+SamplerState lutSampler;
+
+layout(binding = SKY_VIEW_LUT_OUTPUT, rgba16f)
+RWTexture2D<float4> skyViewLutOutput;
+
+// The starlight blurred to ~3 deg (night_sky.slangh): the LUT carries it through the air so the
+// clouds' and the ground's sky light include it.
+layout(binding = SKY_VIEW_LUT_STARLIGHT_LOW)
+Texture2D<float4> starlightLowInput;
+
+vec3 numosHorizonAir(
+  vec3 rayOrigin,
+  vec3 rayDir,
+  vec3 phaseDir,
+  vec3 sunDir,
+  enhanced_AtmosphereArgs args,
+  Texture2D<float4> transmittanceLut,
+  SamplerState transmittanceLutSampler,
+  Texture2D<float4> multiscatteringLut,
+  int numSamples = 32
+) {
+  const vec3 planetCenter = enhanced_getPlanetCenter(args);
+  float t0, t1;
+
+  float distToCenter = length(rayOrigin - planetCenter);
+  bool insideAtmosphere = distToCenter < args.atmosphereRadius;
+
+  if (!enhanced_intersectSphere(rayOrigin, rayDir, planetCenter, args.atmosphereRadius, t0, t1)) {
+    return vec3(0.0f);
+  }
+
+  if (insideAtmosphere) {
+    t0 = 0.0f;
+  }
+
+  float tPlanet0, tPlanet1;
+  bool hitsPlanet = enhanced_intersectSphere(rayOrigin, rayDir, planetCenter, args.planetRadius, tPlanet0, tPlanet1);
+
+  t0 = max(0.0f, t0);
+  // A ray that reaches the planet stops at its surface: this is the air in front of the ground.
+  // evalSkyRadiance adds the lit ground itself (evalSkyGroundRadiance), seen through that air.
+  const bool entersGround = hitsPlanet && tPlanet1 > 0.0f
+    && dot(rayDir, rayOrigin - planetCenter) < 0.0f;
+  if (entersGround) {
+    t1 = min(t1, max(tPlanet0, 0.0f));
+  }
+
+  if (t1 <= t0) {
+    return vec3(0.0f);
+  }
+
+  // Power-distributed segments (atmosphereStepFraction).
+  const int actualSamples = clamp(numSamples, 1, 64);
+  const float span = t1 - t0;
+  const float invSamples = 1.0f / float(actualSamples);
+
+  vec3 L = vec3(0.0f);
+  vec3 transmittance = vec3(1.0f);
+
+  float cosTheta = dot(phaseDir, sunDir);
+  float phaseR = enhanced_rayleighPhase(cosTheta);
+  float phaseM = enhanced_hgPhase(cosTheta, args.mieAnisotropy);
+
+  // Moonlight: each moon flagged in moonSkyLightMask is a second light through the same air, with
+  // the same transmittance (and planet shadow) and multiscattering as the sun, so a moonlit sky is a
+  // dim sky in the moon's colours. Its phase terms depend only on the ray, so they are hoisted.
+  vec3 moonDirs[enhanced_MAX_MOONS];
+  float moonPhaseR[enhanced_MAX_MOONS];
+  float moonPhaseM[enhanced_MAX_MOONS];
+  [unroll] for (uint mi = 0u; mi < enhanced_MAX_MOONS; ++mi) {
+    moonDirs[mi] = normalize(args.moons[mi].direction);
+    const float moonCosTheta = dot(phaseDir, moonDirs[mi]);
+    moonPhaseR[mi] = enhanced_rayleighPhase(moonCosTheta);
+    moonPhaseM[mi] = enhanced_hgPhase(moonCosTheta, args.mieAnisotropy);
+  }
+
+  float segmentStart = 0.0f;
+  for (int i = 0; i < actualSamples; ++i) {
+    const float segmentEnd = enhanced_atmosphereStepFraction(float(i + 1) * invSamples);
+    const float dt = (segmentEnd - segmentStart) * span;
+    const float t = t0 + (segmentStart + (segmentEnd - segmentStart) * 0.5f) * span;
+    segmentStart = segmentEnd;
+
+    if (dt <= 0.0f) {
+      continue;
+    }
+
+    vec3 samplePos = rayOrigin + rayDir * t;
+    float altitude = length(samplePos - planetCenter) - args.planetRadius;
+
+    altitude = clamp(altitude, 0.0f, args.atmosphereThickness);
+
+    const enhanced_AtmosphereMedium medium = enhanced_sampleAtmosphereMedium(altitude, args);
+    vec3 scatteringR = medium.rayleighScattering;
+    vec3 scatteringM = medium.mieScattering;
+    vec3 scattering = medium.scattering;
+    vec3 extinction = medium.extinction;
+
+    // Sun visibility: transmittance times planet shadow, with below-surface samples lifted to the
+    // ground (evalSunShadowingClampedToSurface).
+    vec3 up = normalize(samplePos - planetCenter);
+    float sunZenithCosAngle = dot(up, normalize(sunDir));
+    vec3 sunTransmittance = enhanced_evalSunShadowingClampedToSurface(samplePos, normalize(sunDir), transmittanceLut, transmittanceLutSampler, args);
+
+    // Multiple scattering: the analytical fill blended toward the LUT (Hillaire's physical model)
+    // by multiScatterPhysicalStrength.
+    vec3 msAnalytical = enhanced_getAnalyticalMultiscattering(altitude, sunZenithCosAngle, args);
+    vec3 msLut        = enhanced_sampleMultiscatteringLut(multiscatteringLut, transmittanceLutSampler, altitude, sunZenithCosAngle, args);
+
+    vec3 singleScatter = args.sunIlluminance * sunTransmittance *
+                         (scatteringR * phaseR + scatteringM * phaseM);
+    // Both multiscatter terms are transfers without the illuminance, which is applied here, once.
+    vec3 contribAnalytical = args.sunIlluminance * msAnalytical * scattering;
+    vec3 contribLut        = args.sunIlluminance * scattering * msLut;
+    vec3 multiScatterContrib = lerp(contribAnalytical, contribLut,
+                                     args.multiScatterPhysicalStrength);
+    vec3 scatteredLight = singleScatter + multiScatterContrib;
+
+    [unroll] for (uint mi = 0u; mi < enhanced_MAX_MOONS; ++mi) {
+      if (((args.moonSkyLightMask >> mi) & 1u) == 0u) {
+        continue;
+      }
+      const vec3 moonTransmittance = enhanced_evalSunShadowingClampedToSurface(samplePos, moonDirs[mi], transmittanceLut,
+                                                                      transmittanceLutSampler, args);
+      const vec3 moonMs = enhanced_sampleMultiscatteringLut(multiscatteringLut, transmittanceLutSampler, altitude,
+                                                   dot(up, moonDirs[mi]), args);
+      scatteredLight += args.moons[mi].illuminance
+                      * (moonTransmittance * (scatteringR * moonPhaseR[mi] + scatteringM * moonPhaseM[mi])
+                         + scattering * moonMs);
+    }
+
+    // The night sky's own glow lighting the air (night_sky.slangh): the airglow layer, the zodiacal
+    // light and the starlight above, reaching this sample through about two air masses.
+    if ((args.nightSkyFlags & 8u) != 0u) {
+      scatteredLight += scattering * args.nightGlowInScatter
+                      * enhanced_sampleTransmittanceLut(transmittanceLut, transmittanceLutSampler, altitude, 0.5f, args);
+    }
+
+    // Energy-conserving segment integral (Hillaire 2016, section 5.6.3, Eq. 17):
+    // integral of exp(-sigma_t x) S dx over the segment = (S - S exp(-sigma_t d)) / sigma_t.
+    vec3 sampleTransmittance = exp(-extinction * dt);
+    sampleTransmittance = clamp(sampleTransmittance, vec3(0.0f), vec3(1.0f));
+    scatteredLight = max(scatteredLight, vec3(0.0f));
+
+    vec3 clampedExtinction = max(extinction, vec3(1e-7f));
+
+    vec3 integScatt = (scatteredLight - scatteredLight * sampleTransmittance) / clampedExtinction;
+
+    // A NaN or Inf sample is dropped rather than turning the pixel black.
+    vec3 contribution = transmittance * integScatt;
+    if (any(isnan(contribution)) || any(isinf(contribution))) {
+      continue;
+    }
+
+    L += contribution;
+    transmittance *= sampleTransmittance;
+  }
+
+  L = max(L, vec3(0.0f));
+  if (any(isnan(L)) || any(isinf(L))) {
+    L = vec3(0.0f);
+  }
+
+  return L;
+}
+
+vec3 numosHorizonGlow(vec3 viewDirYUp, vec3 phaseDir, float eyeRadius, float groundDistance, enhanced_AtmosphereArgs args) {
+  const float rLow = args.planetRadius + args.airglowAltitudeKm - 0.5f * args.airglowThicknessKm;
+  const float rHigh = rLow + args.airglowThicknessKm;
+  const float path = enhanced_nightSkyLengthInsideSphere(eyeRadius, viewDirYUp.y, rHigh, groundDistance)
+                   - enhanced_nightSkyLengthInsideSphere(eyeRadius, viewDirYUp.y, rLow, groundDistance);
+  vec3 glow = args.airglowEmission * max(path, 0.0f);
+  if (groundDistance > 1e9f) {
+    glow += args.nightSkyIlluminance * (args.zodiacalLightScale
+            * enhanced_zodiacalLightS10(phaseDir, normalize(args.sunDirection), args.eclipticPoleLocal));
+  }
+  return glow;
+}
+
+// The sky's radiance toward the direction of LUT texel uv.
+vec3 computeSkyView(vec2 uv, enhanced_AtmosphereArgs args,
+                    Texture2D<float4> transmittanceLut,
+                    SamplerState lutSampler,
+                    Texture2D<float4> multiscatteringLut) {
+  // The origin is the eye: getPlanetCenter places the planet planetRadius + cameraAltitudeKm below
+  // it, so the bake follows the camera's altitude without an offset here.
+  vec3 cameraPos = vec3(0.0f, 0.0f, 0.0f);
+
+  // Non-linear elevation l * l * sign(l) puts most texels near the horizon, where the colour changes
+  // fastest; sampleSkyViewLutForRay inverts it.
+  float azimuth = uv.x * 2.0f * enhanced_kPi;
+  float l = uv.y * 2.0f - 1.0f;
+  float elevation = l * l * sign(l) * enhanced_kPi * 0.5f;  // [-pi/2, pi/2]
+
+  float cosElevation = cos(elevation);
+  float sinElevation = sin(elevation);
+  vec3 viewDir = vec3(
+    cosElevation * cos(azimuth),
+    sinElevation,
+    cosElevation * sin(azimuth)
+  );
+  viewDir = normalize(viewDir);
+
+  // The path to space and its transmission follow the mirrored elevation.
+  // The scattering angle and the celestial sphere belong to the actual sightline.
+  const vec3 phaseDir = viewDir;
+  viewDir.y = abs(viewDir.y);
+  vec3 sunDir = args.sunDirection;
+  vec3 radiance = numosHorizonAir(
+    cameraPos,
+    viewDir,
+    phaseDir,
+    sunDir,
+    args,
+    transmittanceLut,
+    lutSampler,
+    multiscatteringLut,
+    32  // numSamples
+  );
+
+  // Once the sky is dark enough for them to register (nightSkyFlags bit 3): the airglow and the
+  // zodiacal light, and the starlight from beyond the air (bits 0, 1), extinguished along the ray.
+  // Rays that reach the ground see only the airglow in front of it, from an eye above the layer.
+  if ((args.nightSkyFlags & 8u) != 0u) {
+    const float eyeRadius = args.planetRadius + max(args.cameraAltitudeKm, 0.0f);
+    const float horizonMu = -sqrt(max(1.0f - (args.planetRadius / eyeRadius) * (args.planetRadius / eyeRadius), 0.0f));
+    const bool reachesSpace = viewDir.y > horizonMu;
+    const float b = eyeRadius * viewDir.y;
+    const float groundDistance = reachesSpace
+      ? 1e30f : -b - sqrt(max(b * b - eyeRadius * eyeRadius + args.planetRadius * args.planetRadius, 0.0f));
+    const vec3 transmittance = reachesSpace
+      ? enhanced_sampleTransmittanceLut(transmittanceLut, lutSampler, max(args.cameraAltitudeKm, 0.0f), viewDir.y, args)
+      : vec3(1.0f);
+    vec3 beyondAir = numosHorizonGlow(viewDir, phaseDir, eyeRadius, groundDistance, args);
+    if (reachesSpace && (args.nightSkyFlags & 3u) == 3u) {
+      const vec3 e = enhanced_nightSkyLocalToEquatorial(phaseDir, args);
+      beyondAir += enhanced_sampleNightSkyStarlightLow(e, starlightLowInput, lutSampler)
+                 * args.nightSkyIlluminance * (args.nightSkyGain / enhanced_kNightSkyAssetScale);  // night gain
+    }
+    radiance += beyondAir * transmittance;
+  }
+
+  return radiance;
+}
+
+[shader("compute")]
+[numthreads(16, 16, 1)]
+void main(uint2 threadId : SV_DispatchThreadID) {
+  enhanced_AtmosphereArgs args = atmosphereArgs;
+
+  if (threadId.x >= args.skyViewLutWidth || threadId.y >= args.skyViewLutHeight / 2u) {
+    return;
+  }
+
+  vec2 uv = (vec2(threadId) + 0.5f) / vec2(args.skyViewLutWidth, args.skyViewLutHeight);
+
+  vec3 skyColor = computeSkyView(uv, args, transmittanceLutInput, lutSampler, multiscatteringLutInput);
+
+  skyViewLutOutput[threadId] = float4(skyColor, 1.0f);
+}
