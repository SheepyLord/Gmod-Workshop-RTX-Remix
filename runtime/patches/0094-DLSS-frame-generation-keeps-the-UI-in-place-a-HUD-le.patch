+  // NV-DXVK start: HUD-less frame generation input (GMod)
+  // While frame generation presents, keeps a copy of the back buffer (its format, size and view) for RTX injection to
+  // fill before the UI is drawn, and tells frame generation which copy that is (rtx_dlfg_hudless.h).
+  void D3D9SwapChainEx::UpdateDlfgHudless(const Rc<DxvkImageView>& backBufferView) {
+    auto& handoff = m_device->getCommon()->metaDLFG().hudless();
+    const Rc<DxvkImage> backBuffer = backBufferView != nullptr ? backBufferView->image() : nullptr;
+
+    if (m_dlfgPresenter == nullptr || backBuffer == nullptr || backBuffer->info().sampleCount != VK_SAMPLE_COUNT_1_BIT) {
+      if (m_dlfgHudless != nullptr) {
+        handoff.dropSource(m_dlfgHudless);
+        m_dlfgHudless = nullptr;
+        m_dlfgHudlessView = nullptr;
+      }
+      return;
+    }
+
+    if (m_dlfgHudless != nullptr
+     && m_dlfgHudless->info().extent == backBuffer->info().extent
+     && m_dlfgHudless->info().format == backBuffer->info().format
+     && m_dlfgHudlessView->info().format == backBufferView->info().format) {
+      return;
+    }
+
+    DxvkImageCreateInfo info = backBuffer->info();
+    info.usage  |= VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    info.stages |= VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+    info.access |= VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+    info.shared  = VK_FALSE;
+
+    const Rc<DxvkImage> previous = m_dlfgHudless;
+    m_dlfgHudless = m_device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+                                          DxvkMemoryStats::Category::RTXRenderTarget, "DLFG HUD-less back buffer");
+    // Sampled as the back buffer is (its view's format and swizzle): the blit then treats both alike.
+    m_dlfgHudlessView = m_device->createImageView(m_dlfgHudless, backBufferView->info());
+    handoff.dropSource(previous);
+    handoff.setSource(m_dlfgHudless);
+  }
+  // NV-DXVK end
+
   void D3D9SwapChainEx::PresentImage(UINT SyncInterval) {
     ScopedCpuProfileZone();
     m_parent->Flush();
@@ -1247,6 +1290,10 @@ namespace dxvk {
     auto swapImage = m_backBuffers[0]->GetCommonTexture()->GetImage();
     auto swapImageView = m_backBuffers[0]->GetImageView(false);
 
+    // NV-DXVK start: HUD-less frame generation input (GMod)
+    UpdateDlfgHudless(swapImageView);
+    // NV-DXVK end
+
     // Bump our frame id.
     ++m_frameId;
     SyncFrameLatency();
@@ -1319,6 +1366,17 @@ namespace dxvk {
         m_imageViews.at(imageIndex), dstRect,
         swapImageView, srcRect);
 
+      // NV-DXVK start: HUD-less frame generation input (GMod)
+      // The frame before its UI goes beside the frame generation back buffer through the same blit, so a pixel no UI
+      // was drawn over comes out exactly as in the back buffer (rtx_dlfg_hudless.h).
+      if (m_dlfgPresenter != nullptr && m_dlfgHudlessView != nullptr) {
+        const Rc<DxvkImageView> hudless = m_dlfgPresenter->getHudlessView(imageIndex);
+        if (hudless != nullptr) {
+          m_blitter->presentImage(m_context.ptr(), hudless, dstRect, m_dlfgHudlessView, srcRect);
+        }
+      }
+      // NV-DXVK end
+
       if (m_hud != nullptr)
         m_hud->render(m_context, info.format, info.imageExtent);
 
