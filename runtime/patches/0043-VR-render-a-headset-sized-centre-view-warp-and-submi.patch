+  int RtxVr::start(const rtxvr_StartInfo* info) {
+    if (!info || info->structSize!=sizeof(*info)) { return RTXVR_E_ARGUMENT; }
+    if (info->apiVersion!=RTXVR_API_VERSION) { return RTXVR_E_VERSION; }
+    vrmath::Projection p;
+    if ((info->flags & ~(RTXVR_START_NO_SUBMIT|RTXVR_START_NO_MIRROR)) ||
+        (!(info->flags&RTXVR_START_NO_SUBMIT) && !info->getGenericInterface) ||
+        !std::isfinite(info->worldUnitsPerMetre) || info->worldUnitsPerMetre<=0 || info->worldUnitsPerMetre>10000 ||
+        !std::isfinite(info->refreshHz) || info->refreshHz<=0 || info->refreshHz>1000 ||
+        !vrmath::centreProjection(info->eyes,info->eyeWidth,info->eyeHeight,info->renderScale,p)) {
+      return RTXVR_E_ARGUMENT;
+    }
+    std::lock_guard lock(m_requestMutex);
+    if (m_active) { return RTXVR_E_ALREADY; }
+    m_requested=*info; m_projection=p; ++m_generation;
+    m_poses.clear(); m_overlayRequests.clear(); m_captureWhat=0;
+    m_status={}; m_status.structSize=sizeof(m_status); m_status.state=RTXVR_STATE_STARTING;
+    m_active.store(true,std::memory_order_release); m_work.store(true,std::memory_order_release);
+    return RTXVR_OK;
+  }
+
+  void RtxVr::stop() {
+    {
+      std::lock_guard lock(m_requestMutex);
+      m_active.store(false,std::memory_order_release); ++m_generation;
+      m_status.state=RTXVR_STATE_OFF;
+      m_poses.clear(); m_overlayRequests.clear(); m_captureWhat=0;
+    }
+    // The module may unload OpenVR as soon as Stop returns.
+    std::lock_guard calls(m_openVrMutex);
+    if (m_overlay) {
+      for (uint64_t handle:m_submittedOverlays) { m_overlay->ClearOverlayTexture(handle); }
+      m_submittedOverlays.clear();
+    }
+    if (m_compositor) { m_compositor->ClearLastSubmittedFrame(); }
+    m_compositor=nullptr; m_overlay=nullptr;
+  }
+
+  int RtxVr::updateEyes(const rtxvr_Eye eyes[2]) {
+    if (!eyes) { return RTXVR_E_ARGUMENT; }
+    std::lock_guard lock(m_requestMutex);
+    if (!m_active) { return RTXVR_E_NOT_RUNNING; }
+    vrmath::Projection p;
+    if (!vrmath::centreProjection(eyes,m_requested.eyeWidth,m_requested.eyeHeight,m_requested.renderScale,p)) { return RTXVR_E_ARGUMENT; }
+    std::copy(eyes,eyes+2,m_requested.eyes); m_projection=p; ++m_generation;
+    return RTXVR_OK;
+  }
+
+  int RtxVr::pushPose(const rtxvr_FramePose* pose) {
+    if (!pose || pose->structSize!=sizeof(*pose) || (pose->flags&~RTXVR_POSE_SCRIPTED) || !finitePose(*pose)) { return RTXVR_E_ARGUMENT; }
+    std::lock_guard lock(m_requestMutex);
+    if (!m_active) { return RTXVR_E_NOT_RUNNING; }
+    return m_poses.push(*pose) ? RTXVR_OK : RTXVR_E_ARGUMENT;
+  }
+
+  int RtxVr::overlaySource(uint64_t handle,uint32_t w,uint32_t h) {
+    if (!handle || ((!w)!=(!h)) || w>8192 || h>8192) { return RTXVR_E_ARGUMENT; }
+    std::lock_guard lock(m_requestMutex);
+    if (!m_active) { return RTXVR_E_NOT_RUNNING; }
+    if (m_overlayRequests.size()>=16 && !m_overlayRequests.count(handle)) { return RTXVR_E_RESOURCES; }
+    m_overlayRequests[handle]={w,h}; return RTXVR_OK;
+  }
+
+  int RtxVr::capture(const wchar_t* folder,uint32_t what) {
+    if (!folder || !*folder || !what || (what&~15u)) { return RTXVR_E_ARGUMENT; }
+    std::lock_guard lock(m_requestMutex);
+    if (!m_active) { return RTXVR_E_NOT_RUNNING; }
+    m_captureFolder=folder; m_captureWhat=what; return RTXVR_OK;
+  }
