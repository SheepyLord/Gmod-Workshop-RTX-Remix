+  int RtxVr::status(rtxvr_Status* out) {
+    if (!out || out->structSize!=sizeof(*out)) { return RTXVR_E_ARGUMENT; }
+    std::lock_guard lock(m_requestMutex); *out=m_status; return RTXVR_OK;
+  }
