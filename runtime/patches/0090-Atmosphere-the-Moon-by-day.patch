+#: src/dxvk/rtx_render/rtx_atmosphere.h:334
 msgid "Altitude of the ozone tent profile's peak in kilometers."
 msgstr "臭氧帳篷形分佈峰值的高度，單位為公里。"
 
 #. option rtx.atmosphere.ozoneLayerWidth
-#: src/dxvk/rtx_render/rtx_atmosphere.h:328
+#: src/dxvk/rtx_render/rtx_atmosphere.h:335
 msgid "Half-width of the ozone tent profile in kilometers, and therefore the vertical ozone column. The paper uses a 30 km wide tent, so 15."
 msgstr "臭氧帳篷形分佈的半寬，單位為公里，也因此決定垂直臭氧柱。論文使用 30 km 寬的帳篷形分佈，所以為 15。"
 
 #. option rtx.atmosphere.sunIlluminance
