diff --git a/tests/rtx/unit/test_dlfg_hudless.cpp b/tests/rtx/unit/test_dlfg_hudless.cpp
new file mode 100644
index 000000000..dab574a1f
--- /dev/null
+++ b/tests/rtx/unit/test_dlfg_hudless.cpp
@@ -0,0 +1,169 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// The HUD-less input of DLSS Frame Generation (ADR 0223 of the GMod native loader project): the presenter passes a
+// frame's HUD-less image only when the render thread filled the swapchain's current copy for that frame.
+// Standalone: cl /EHsc /std:c++17 /W4 /WX test_dlfg_hudless.cpp
+
+#include "../../../src/dxvk/rtx_render/rtx_dlfg_hudless.h"
+
+#include <atomic>
+#include <cstdio>
+#include <memory>
+#include <thread>
+
+using namespace dxvk;
+
+namespace {
+  int g_checks = 0;
+  int g_failures = 0;
+
+  void check(bool condition, const char* what, int line) {
+    ++g_checks;
+    if (!condition) {
+      ++g_failures;
+      std::printf("FAIL line %d: %s\n", line, what);
+    }
+  }
+#define CHECK(condition) check((condition), #condition, __LINE__)
+
+  using Image = std::shared_ptr<int>;
+  using Handoff = DlfgHudlessHandoff<Image>;
+
+  void testNothingBeforeACopy() {
+    Handoff handoff;
+    uint64_t generation = 99;
+    CHECK(handoff.source(generation) == nullptr);
+    CHECK(generation == 0);
+    // Without a copy no frame is ever marked, so no frame is interpolated with a HUD-less image.
+    CHECK(!handoff.mark(1, generation));
+    CHECK(!handoff.has(1));
+    CHECK(!handoff.has(0));
+    CHECK(!handoff.has(Handoff::kNoFrame));
+  }
+
+  void testAFilledFrameIsPassed() {
+    Handoff handoff;
+    const Image a = std::make_shared<int>(1);
+    handoff.setSource(a);
+    uint64_t generation = 0;
+    CHECK(handoff.source(generation) == a);
+    CHECK(generation == 1);
+    CHECK(handoff.mark(10, generation));
+    CHECK(handoff.has(10));
+    // Only the frame that filled the copy: the next frame, and one that shares its slot, were not marked.
+    CHECK(!handoff.has(11));
+    CHECK(!handoff.has(10 + Handoff::kCapacity));
+    // The frame kCapacity later takes the slot.
+    CHECK(handoff.mark(10 + Handoff::kCapacity, generation));
+    CHECK(handoff.has(10 + Handoff::kCapacity));
+    CHECK(!handoff.has(10));
+    CHECK(!handoff.mark(Handoff::kNoFrame, generation));
+    CHECK(!handoff.has(Handoff::kNoFrame));
+  }
+
+  void testANewCopyForgetsTheOld() {
+    Handoff handoff;
+    const Image a = std::make_shared<int>(1);
+    const Image b = std::make_shared<int>(2);
+    handoff.setSource(a);
+    uint64_t first = 0;
+    handoff.source(first);
+    CHECK(handoff.mark(5, first));
+    // The back buffer changed size: the swapchain's new copy has not been filled, frame 5's image went with the old.
+    handoff.setSource(b);
+    CHECK(!handoff.has(5));
+    uint64_t second = 0;
+    CHECK(handoff.source(second) == b);
+    CHECK(second == first + 1);
+    // The render thread read the old copy before the swap and marks after it: its frame is not passed.
+    CHECK(!handoff.mark(6, first));
+    CHECK(!handoff.has(6));
+    CHECK(handoff.mark(7, second));
+    CHECK(handoff.has(7));
+    // The same copy again changes nothing.
+    handoff.setSource(b);
+    uint64_t third = 0;
+    handoff.source(third);
+    CHECK(third == second);
+    CHECK(handoff.has(7));
+  }
+
+  void testDroppingACopy() {
+    Handoff handoff;
+    const Image a = std::make_shared<int>(1);
+    const Image other = std::make_shared<int>(2);
+    handoff.setSource(a);
+    uint64_t generation = 0;
+    handoff.source(generation);
+    CHECK(handoff.mark(3, generation));
+    // Another swapchain's copy is not this one's to drop.
+    handoff.dropSource(other);
+    handoff.dropSource(nullptr);
+    CHECK(handoff.has(3));
+    uint64_t same = 0;
+    CHECK(handoff.source(same) == a);
+    CHECK(same == generation);
+    // The swapchain went (or frame generation was turned off): nothing more is passed.
+    handoff.dropSource(a);
+    CHECK(!handoff.has(3));
+    uint64_t after = 0;
+    CHECK(handoff.source(after) == nullptr);
+    CHECK(after == generation + 1);
+    CHECK(!handoff.mark(4, after));
+    CHECK(!handoff.has(4));
+  }
+
+  // The render thread marks frames as it fills the copy; the presenter thread asks for each frame after it was
+  // filled, at most a few frames behind. Every asked frame within kCapacity of the newest is found.
+  void testThreads() {
+    Handoff handoff;
+    handoff.setSource(std::make_shared<int>(1));
+    uint64_t generation = 0;
+    handoff.source(generation);
+    constexpr uint32_t kFrames = 200000;
+    // `marking` is the frame the render thread is about to mark (stored before its slot), `filled` the last one it
+    // marked: a slot the presenter reads overwritten was written after `marking` reached the overwriting frame.
+    std::atomic<uint32_t> marking = { 0 };
+    std::atomic<uint32_t> filled = { 0 };
+    std::atomic<bool> stop = { false };
+    std::thread render([&] {
+      for (uint32_t frame = 1; frame <= kFrames && !stop.load(); ++frame) {
+        marking.store(frame, std::memory_order_release);
+        handoff.mark(frame, generation);
+        filled.store(frame, std::memory_order_release);
+      }
+    });
+    int missed = 0;
+    int judged = 0;
+    for (uint32_t frame = 1; frame <= kFrames; ++frame) {
+      while (filled.load(std::memory_order_acquire) < frame) {}
+      const bool found = handoff.has(frame);
+      // A frame the render thread has already passed by kCapacity may have lost its slot; any other must be found.
+      if (marking.load(std::memory_order_acquire) < frame + Handoff::kCapacity) {
+        ++judged;
+        if (!found) {
+          ++missed;
+        }
+      }
+    }
+    stop.store(true);
+    render.join();
+    CHECK(missed == 0);
+    CHECK(judged > 0);
+  }
+}
+
+int main() {
+  testNothingBeforeACopy();
+  testAFilledFrameIsPassed();
+  testANewCopyForgetsTheOld();
+  testDroppingACopy();
+  testThreads();
+  if (g_failures) {
+    std::printf("FAILED dlfg hudless: %d of %d checks\n", g_failures, g_checks);
+    return 1;
+  }
+  std::printf("PASS dlfg hudless: %d checks\n", g_checks);
+  return 0;
+}
