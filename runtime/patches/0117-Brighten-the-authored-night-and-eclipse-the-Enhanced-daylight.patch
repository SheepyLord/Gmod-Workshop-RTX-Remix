diff --git a/src/dxvk/rtx_render/rtx_fork_numos_eclipse.cpp b/src/dxvk/rtx_render/rtx_fork_numos_eclipse.cpp
new file mode 100644
index 000000000..24f4b9f92
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_numos_eclipse.cpp
@@ -0,0 +1,183 @@
+// Solar clock and topocentric conventions adapted from NUMOS.
+// Copyright 2026 Kim2091 (Sparkles)
+// Portions Copyright (c) 2025-2026 CattaRappa (sambow23), softsoundd
+// SPDX-License-Identifier: Apache-2.0 AND MIT
+// See the pinned library's LICENSE, licenses/LICENSE-MIT-contributors.txt and THIRD_PARTY_NOTICES.md.
+#include "rtx_fork_numos_eclipse.h"
+#include "numos/renderer.h"
+#include "../../../submodules/numos/src/celestial.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace dxvk {
+  namespace {
+    constexpr double pi = 3.14159265358979323846;
+    constexpr float rad = numos::kDegreesToRadians;
+
+    numos::Vector3 direction(float elevation, float azimuth) {
+      const float e = elevation * rad, a = azimuth * rad;
+      return {std::cos(e) * std::sin(a), std::sin(e), std::cos(e) * std::cos(a)};
+    }
+
+    // beginFrame advances NUMOS's clock before it resolves the sun. Read its current
+    // clock, including an explicit scrub, rather than accumulating another one.
+    float frameHours(const numos::Settings& s, const numos::Renderer& renderer, float dt) {
+      if (!s.timeCycleEnable) return s.timeOfDayHours;
+      const float start = renderer.settings().timeOfDayHours == s.timeOfDayHours
+        ? renderer.simulationState().timeOfDayHours : s.timeOfDayHours;
+      const float daySeconds = 60.f * std::max(s.dayLengthMinutes, .01f);
+      const float next = start + (std::max(dt, 0.f) / daySeconds) * 24.f;
+      return std::fmod(std::fmod(next, 24.f) + 24.f, 24.f);
+    }
+
+    numos::Vector3 sunDirection(const numos::Settings& s, float hours) {
+      if (!s.timeCycleEnable) return direction(s.sunElevation, s.sunRotation);
+      // Cooper declination and local hour angle, with the pin's pole/zenith convention.
+      const float lat = s.latitudeDegrees * rad;
+      const float dec = 23.44f * rad * std::sin(2.f * numos::kPi * (284.f + float(s.dayOfYear)) / 365.f);
+      const float hour = (hours - 12.f) * 15.f * rad;
+      const float sinEl = std::clamp(std::sin(lat) * std::sin(dec) +
+        std::cos(lat) * std::cos(dec) * std::cos(hour), -1.f, 1.f);
+      const float el = std::asin(sinEl);
+      const float denom = std::cos(el) * std::cos(lat);
+      float az = 0.f;
+      if (std::abs(denom) >= 1e-6f) {
+        az = std::acos(std::clamp((std::sin(dec) - sinEl * std::sin(lat)) / denom, -1.f, 1.f));
+        if (hour > 0.f) az = 2.f * numos::kPi - az;
+      }
+      return direction(el / rad, az / rad + s.northOffsetDegrees);
+    }
+
+    numos::Vector3 realMoonDirection(const numos::Settings& s, float hours, numos::Vector3 sun) {
+      using namespace numos::celestial;
+      const double days = daysSinceJ2000(s.calendarYear, s.dayOfYear, hours);
+      double sunLon, obliquity, moonLon, moonLat, distance;
+      sunEcliptic(days, sunLon, obliquity);
+      moonEcliptic(days, moonLon, moonLat, distance);
+      const auto frame = alignedFrame(eclipticToEquatorial(sunLon, 0., obliquity), sun,
+                                      celestialPoleLocal(s.latitudeDegrees * rad, s.northOffsetDegrees * rad));
+      const auto geocentric = frame.toLocal(eclipticToEquatorial(moonLon, moonLat, obliquity));
+      return numos::normalize(geocentric * float(distance) - numos::Vector3(0.f, 1.f, 0.f));
+    }
+
+    struct Disc { double distance, radius, angle; }; // Solar radii in the tangent plane.
+    struct Arc { double begin, end; };
+    using Discs = std::array<Disc, numos::kMaxMoons>;
+
+    // Exactly union the covered arcs of one solar ring. Coincident moons cast one shadow.
+    double coveredRing(const Discs& discs, size_t count, double r) {
+      std::array<Arc, 2 * numos::kMaxMoons> arcs;
+      size_t n = 0;
+      for (size_t i = 0; i < count; ++i) {
+        const auto& m = discs[i];
+        if (m.distance + r <= m.radius) return 1.;
+        if (std::abs(m.distance - r) >= m.radius) continue;
+        const double c = (r*r + m.distance*m.distance - m.radius*m.radius) / (2. * r * m.distance);
+        const double half = std::acos(std::clamp(c, -1., 1.));
+        if (count == 1) return half / pi;
+        double lo = m.angle - half, hi = m.angle + half;
+        if (lo < 0.) { arcs[n++] = {lo + 2.*pi, 2.*pi}; lo = 0.; }
+        if (hi > 2.*pi) { arcs[n++] = {0., hi - 2.*pi}; hi = 2.*pi; }
+        arcs[n++] = {lo, hi};
+      }
+      std::sort(arcs.begin(), arcs.begin() + n, [](Arc a, Arc b) { return a.begin < b.begin; });
+      double covered = 0., end = 0.;
+      for (size_t i = 0; i < n; ++i) {
+        covered += std::max(0., arcs[i].end - std::max(end, arcs[i].begin));
+        end = std::max(end, arcs[i].end);
+      }
+      return std::clamp(covered / (2.*pi), 0., 1.);
+    }
+
+    // Normalized flux inside r for 0115's I(mu) = 0.4 + 0.6*mu (disc mean 0.8).
+    double enclosedFlux(double r) {
+      const double r2 = r*r, mu2 = std::max(0., 1.-r2);
+      return .5 * (r2 + 1. - mu2 * std::sqrt(mu2));
+    }
+
+    void integrate(const Discs& discs, size_t count, float floor, NumosSolarEclipse& eclipse) {
+      std::array<double, 2 + 2 * numos::kMaxMoons> stops {0., 1.};
+      size_t n = 2;
+      for (size_t i = 0; i < count; ++i) {
+        const auto& m = discs[i];
+        stops[n++] = std::clamp(std::abs(m.distance - m.radius), 0., 1.);
+        stops[n++] = std::min(m.distance + m.radius, 1.);
+      }
+      std::sort(stops.begin(), stops.begin() + n);
+      double area = 0., visible = 0.;
+      for (size_t band = 1; band < n; ++band) {
+        const double lo = stops[band-1], hi = stops[band];
+        if (lo == hi) continue;
+        // Split at tangencies; concentrate samples at each end. The annular area
+        // and limb-darkened flux weights are analytic, including for annular eclipses.
+        double a = lo, fa = enclosedFlux(a);
+        for (int j = 1; j <= 32; ++j) {
+          const double t = j / 32.;
+          const double b = lo + (hi-lo) * t*t*(3.-2.*t), fb = enclosedFlux(b);
+          const double cover = coveredRing(discs, count, .5*(a+b));
+          area += cover * (b*b-a*a);
+          visible += (1.-cover) * (fb-fa);
+          a = b; fa = fb;
+        }
+      }
+      eclipse.coverage = float(std::clamp(area, 0., 1.));
+      eclipse.daylight = floor + (1.f-floor) * float(std::clamp(visible, 0., 1.));
+    }
+  }
+
+  NumosSolarEclipse applyNumosSolarEclipse(numos::Settings& s, const numos::Renderer& renderer,
+                                           float dt, bool enabled, float totalityFloor) {
+    NumosSolarEclipse eclipse;
+    eclipse.fullSun = s.sunIlluminance * s.sunIntensity;
+    eclipse.totalityStarGain = std::exp2(std::clamp(std::clamp(s.nightGainStops, 0.f, 16.f) + s.starGainStops, -16.f, 16.f));
+    if (!enabled || s.sunSize <= 0.f) return eclipse;
+    const float hours = frameHours(s, renderer, dt);
+    const numos::Vector3 sun = sunDirection(s, hours);
+    const double radius = std::max(.5f * s.sunSize * rad, 1e-4f);
+    const float horizonWidth = float(std::sin(std::min(radius, .5 * pi)));
+    if (sun.y <= -horizonWidth) return eclipse;
+    const float floor = std::clamp(totalityFloor, 0.f, 1.f);
+
+    Discs discs {};
+    size_t count = 0;
+    auto add = [&](numos::Vector3 moon, float diameter) {
+      const double mr = .5f * std::max(.01f, diameter) * rad;
+      const auto normal = numos::cross(sun, moon);
+      const double d = std::atan2(double(numos::length(normal)), double(numos::dot(sun, moon)));
+      if (d >= radius + mr) return;
+      if (d + radius <= mr) {
+        eclipse.coverage = 1.f;
+        eclipse.daylight = floor;
+        return;
+      }
+      const auto east = numos::normalize(numos::cross(std::abs(sun.y) < .9f ? numos::Vector3(0,1,0) : numos::Vector3(1,0,0), sun));
+      const auto north = numos::cross(sun, east);
+      double phi = std::atan2(double(numos::dot(moon, north)), double(numos::dot(moon, east)));
+      if (phi < 0.) phi += 2.*pi;
+      discs[count++] = {d / radius, mr / radius, phi};
+    };
+    size_t slots = 0;
+    if (s.realMoonEnabled) {
+      add(realMoonDirection(s, hours, sun), s.realMoonAngularDiameter);
+      ++slots;
+    }
+    for (const auto& m : s.moons) {
+      if (slots == numos::kMaxMoons || eclipse.coverage == 1.f) break;
+      if (!m.enabled) continue;
+      add(direction(m.elevation, m.rotation), m.angularDiameter);
+      ++slots;
+    }
+    if (count && eclipse.coverage != 1.f) integrate(discs, count, floor, eclipse);
+    if (sun.y < 0.f) {
+      // Ease back to the ordinary twilight as the last of the solar limb sets.
+      const float t = 1.f + sun.y / horizonWidth;
+      const float visible = t*t * (3.f - 2.f*t);
+      eclipse.coverage *= visible;
+      eclipse.daylight += (1.f - eclipse.daylight) * (1.f - visible);
+    }
+    s.sunIntensity *= eclipse.daylight;
+    return eclipse;
+  }
+}
