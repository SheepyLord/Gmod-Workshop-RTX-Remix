+    // NV-DXVK start: the mod texture cache (ADR 0195)
+    // The bytes dmaCopyDataToStaging reads from data(0, level): whole blocks, every layer, tightly packed.
+    size_t stagingReadSize(int level) const {
+      const DxvkFormatInfo* formatInfo = imageFormatInfo(m_info.format);
+      if (formatInfo == nullptr) {
+        return 0;
+      }
+      const VkExtent3D levelExtent = util::computeMipLevelExtent(m_info.extent, uint32_t(level));
+      VkExtent3D elementCount = util::computeBlockCount(levelExtent, formatInfo->blockSize);
+      elementCount.depth *= m_info.numLayers;
+      return size_t(formatInfo->elementSize) * size_t(util::flattenImageExtent(elementCount));
+    }
+
+    void record(DdsAssetRecord& out) const {
+      out.fileSize = m_fileSize;
+      out.dataOffset = m_dataOffset;
+      out.dataSize = m_dataSize;
+      out.sizeOfAllLevels = uint64_t(m_sizeOfAllLevels);
+      out.format = uint32_t(m_format);
+      out.width = m_width;
+      out.height = m_height;
+      out.depth = m_depth;
+      out.levels = m_levels;
+      out.layers = m_layers;
+      out.faces = m_faces;
+      out.levelSizes.assign(m_levelSizes.begin(), m_levelSizes.begin() + m_levels);
+      out.lastWriteTime = int64_t(m_info.lastWriteTime.time_since_epoch().count());
+    }
+
+    // The smallest mips a new texture uploads first (mininumLevelsToUpload), read through data() as an upload
+    // reads them, when this is one 2D image and they take at most maxBytes.
+    void readTail(size_t maxBytes, DdsAssetTail& out) {
+      out = DdsAssetTail {};
+      if (m_layers != 1 || m_faces != 1 || m_depth > 1 || m_info.mininumLevelsToUpload == 0 ||
+          m_info.mininumLevelsToUpload > uint32_t(m_levels)) {
+        return;
+      }
+      const uint32_t first = uint32_t(m_levels) - m_info.mininumLevelsToUpload;
+      std::vector<uint8_t> bytes;
+      for (uint32_t level = first; level < uint32_t(m_levels); ++level) {
+        uint64_t offset;
+        size_t placed;
+        const size_t size = stagingReadSize(int(level));
+        if (size == 0 || !getDataPlacement(0, 0, int(level), offset, placed) || offset + size > m_fileSize ||
+            bytes.size() + size > maxBytes) {
+          return;
+        }
+        const uint8_t* source = static_cast<const uint8_t*>(data(0, int(level)));
+        if (source == nullptr) {
+          return;
+        }
+        bytes.insert(bytes.end(), source, source + size);
+      }
+      out.firstLevel = first;
+      out.bytes = std::move(bytes);
+    }
+
+    // As load() leaves the asset, from what an earlier load() of the same, unchanged file recorded.
+    bool restore(const std::string& filename, const DdsAssetRecord& r, DdsAssetTail tail) {
+      if (r.levels <= 0 || r.levels > int32_t(m_levelSizes.size()) || r.levelSizes.size() != size_t(r.levels) ||
+          r.layers <= 0 || r.faces <= 0) {
+        return false;
+      }
+      m_filename = filename;
+      m_fileSize = r.fileSize;
+      m_dataOffset = r.dataOffset;
+      m_dataSize = r.dataSize;
+      m_sizeOfAllLevels = size_t(r.sizeOfAllLevels);
+      m_format = gli::format(r.format);
+      m_width = r.width;
+      m_height = r.height;
+      m_depth = r.depth;
+      m_levels = r.levels;
+      m_layers = r.layers;
+      m_faces = r.faces;
+      m_levelSizes = {};
+      for (int32_t level = 0; level < r.levels; ++level) {
+        m_levelSizes[size_t(level)] = size_t(r.levelSizes[size_t(level)]);
+      }
+
+      m_info.type = type();
+      m_info.compression = AssetCompression::None;
+      m_info.format = static_cast<VkFormat>(m_format);
+      m_info.extent = { m_width, m_height, m_depth };
+      m_info.mipLevels = m_levels;
+      m_info.mininumLevelsToUpload = std::min(int(kMipLevelsToCache), m_levels);
+      m_info.numLayers = m_layers;
+      m_info.lastWriteTime = std::filesystem::file_time_type(std::filesystem::file_time_type::duration(r.lastWriteTime));
+      m_info.filename = m_filename.c_str();
+
+      m_hash = XXH64_std_hash<std::string> {}(m_filename);
+
+      setTail(std::move(tail));
+      return true;
+    }
+
+    // data() serves the smallest mips from these bytes until they are uploaded, when they are exactly the levels
+    // and sizes readTail() reads.
+    void setTail(DdsAssetTail tail) {
+      if (tail.firstLevel == UINT32_MAX || m_layers != 1 || m_faces != 1 || m_depth > 1 ||
+          m_info.mininumLevelsToUpload == 0 || tail.firstLevel != uint32_t(m_levels) - m_info.mininumLevelsToUpload) {
+        return;
+      }
+      size_t expected = 0;
+      std::vector<size_t> offsets;
+      for (uint32_t level = tail.firstLevel; level < uint32_t(m_levels); ++level) {
+        offsets.push_back(expected);
+        expected += stagingReadSize(int(level));
+      }
+      if (expected == tail.bytes.size() && expected > 0) {
+        m_tail = std::move(tail);
+        m_tailOffsets = std::move(offsets);
+      }
+    }
+
+  private:
+    DdsAssetTail m_tail;
+    std::vector<size_t> m_tailOffsets;
+    // NV-DXVK end
   };
 
+  // NV-DXVK start: the mod texture cache (ADR 0195)
+  Rc<AssetData> loadDdsAssetForCache(const std::string& filename, size_t maxTailBytes,
+                                     DdsAssetRecord& record, DdsAssetTail& tail) {
+    Rc<DdsTextureData> dds = new DdsTextureData;
+    if (!dds->load(filename)) {
+      return nullptr;
+    }
+    dds->record(record);
+    dds->readTail(maxTailBytes, tail);
+    dds->releaseSource();
+    // The first upload copies these bytes instead of opening the file a second time.
+    dds->setTail(tail);
+    return dds;
+  }
+
+  Rc<AssetData> restoreDdsAsset(const std::string& filename, const DdsAssetRecord& record, DdsAssetTail tail) {
+    Rc<DdsTextureData> dds = new DdsTextureData;
+    if (!dds->restore(filename, record, std::move(tail))) {
+      return nullptr;
+    }
+    return dds;
+  }
+  // NV-DXVK end
+
   class PackagedAssetData : public AssetData {
   public:
     PackagedAssetData() = delete;
