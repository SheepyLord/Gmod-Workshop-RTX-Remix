+  RtxVr::Image RtxVr::makeImage(DxvkContext& ctx,VkExtent3D size,VkFormat format) {
+    DxvkImageCreateInfo desc {};
+    desc.type=VK_IMAGE_TYPE_2D; desc.format=format; desc.sampleCount=VK_SAMPLE_COUNT_1_BIT;
+    desc.extent=size; desc.numLayers=1; desc.mipLevels=1;
+    desc.usage=VK_IMAGE_USAGE_STORAGE_BIT|VK_IMAGE_USAGE_SAMPLED_BIT|VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    desc.stages=VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT|VK_PIPELINE_STAGE_TRANSFER_BIT;
+    desc.access=VK_ACCESS_SHADER_READ_BIT|VK_ACCESS_SHADER_WRITE_BIT|VK_ACCESS_TRANSFER_READ_BIT|VK_ACCESS_TRANSFER_WRITE_BIT;
+    desc.tiling=VK_IMAGE_TILING_OPTIMAL; desc.layout=VK_IMAGE_LAYOUT_GENERAL;
+    Image result; result.image=m_device->createImage(desc,VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,DxvkMemoryStats::Category::RTXRenderTarget,"VR image");
+    DxvkImageViewCreateInfo view {};
+    view.type=VK_IMAGE_VIEW_TYPE_2D; view.format=format; view.usage=desc.usage; view.aspect=VK_IMAGE_ASPECT_COLOR_BIT;
+    view.numLevels=1; view.numLayers=1;
+    result.view=m_device->createImageView(result.image,view);
+    return result;
+  }
+
+  void RtxVr::clearResources() {
+    RtxOptionManager::releaseLayer(m_layer); m_layer=nullptr;
+    m_eyes={}; m_overlays.clear(); m_timers={}; m_timer=nullptr; m_ready=false;
+    m_frameCaptureWhat=0;
+  }
+
+  bool RtxVr::initialise(RtxContext& ctx) {
+    std::lock_guard calls(m_openVrMutex);
+    {
+      std::lock_guard lock(m_requestMutex);
+      if (!m_active || m_renderGeneration!=m_generation) { return false; }
+    }
+    if (!(m_frame.flags&RTXVR_START_NO_SUBMIT)) {
+      int error=0;
+      m_compositor=static_cast<vr::IVRCompositor*>(m_frame.getGenericInterface(vr::IVRCompositor_Version,&error));
+      m_overlay=static_cast<vr::IVROverlay*>(m_frame.getGenericInterface(vr::IVROverlay_Version,&error));
+      if (!m_compositor || !m_overlay) { fail(RTXVR_E_INTERFACE,"Pinned OpenVR compositor or overlay interface is unavailable"); return false; }
+      std::vector<char> instance(m_compositor->GetVulkanInstanceExtensionsRequired(nullptr,0)+1,0);
+      m_compositor->GetVulkanInstanceExtensionsRequired(instance.data(),uint32_t(instance.size()));
+      std::vector<char> device(m_compositor->GetVulkanDeviceExtensionsRequired(m_device->adapter()->handle(),nullptr,0)+1,0);
+      m_compositor->GetVulkanDeviceExtensionsRequired(m_device->adapter()->handle(),device.data(),uint32_t(device.size()));
+      Logger::info(str::format("RTX VR required instance extensions: ",instance.data()));
+      Logger::info(str::format("RTX VR required device extensions: ",device.data()));
+      std::string missing;
+      if (missingExtension(instance.data(),m_device->instance()->enabledExtensionNames(),missing) || missingExtension(device.data(),m_device->enabledExtensionNames(),missing)) {
+        fail(RTXVR_E_EXTENSION,"Vulkan extension not enabled: "+missing); return false;
+      }
+      m_compositor->SetExplicitTimingMode(vr::VRCompositorTimingMode_Explicit_ApplicationPerformsPostPresentHandoff);
+    }
+    // The session layer precedes quality presets and never has a file path.
+    Config preset({{"rtx.dlfg.enable","False"},{"rtx.fsrfg.enable","False"},{"rtx.frameGenerationType","0"},
+      {"rtx.upscalerType","1"},{"rtx.qualityDLSS","2"},{"rtx.enableRayReconstruction","True"},
+      {"rtx.pathMinBounces","1"},{"rtx.pathMaxBounces","4"},
+      {"rtx.postfx.enableMotionBlur","False"},{"rtx.postfx.enableChromaticAberration","False"},
+      {"rtx.postfx.enableVignette","False"},{"rtx.enablePresentThrottle","False"}});
+    m_layer=RtxOptionManager::acquireLayer("",kVrLayer,1,0.1f,true,&preset);
+    RtxOptionManager::applyPendingValues(m_device,false);
+    const VkExtent3D size {std::max(1u,uint32_t(std::ceil(m_frame.eyeWidth*m_frame.renderScale))),
+      std::max(1u,uint32_t(std::ceil(m_frame.eyeHeight*m_frame.renderScale))),1};
+    for (auto& eye:m_eyes) { eye=makeImage(ctx,size); }
+    for (auto& timer:m_timers) {
+      for (auto& q:timer.queries) { q=m_device->createGpuQuery(VK_QUERY_TYPE_TIMESTAMP,0,0); }
+    }
+    m_frames=0; m_timerIndex=0; m_ready=true;
+    Logger::info(str::format("RTX VR: centre ",m_frameProjection.width,"x",m_frameProjection.height,
+      ", eyes ",size.width,"x",size.height,", window unchanged, refresh ",m_frame.refreshHz));
+    return true;
+  }
+
+  VkExtent3D RtxVr::beginFrame(RtxContext& ctx,VkExtent3D flat) {
+    uint64_t generation;
+    bool requested;
+    {
+      std::lock_guard lock(m_requestMutex);
+      generation=m_generation; requested=m_active;
+      m_frame=m_requested; m_frameProjection=m_projection;
+    }
+    if (generation!=m_renderGeneration || !requested) {
+      clearResources(); m_renderGeneration=generation;
+      if (!requested) {
+        RtxOptionManager::applyPendingValues(m_device,false);
+        std::lock_guard lock(m_requestMutex);
+        if (m_generation==generation && !m_active) { m_work=false; }
+        return flat;
+      }
+    }
+    try {
+      if (!m_ready && !initialise(ctx)) { return flat; }
+    } catch (const std::exception& e) { fail(RTXVR_E_RESOURCES,e.what()); return flat; }
+    std::lock_guard lock(m_requestMutex);
+    if (!m_active || generation!=m_generation) { return flat; }
+    for (const auto& item:m_overlayRequests) {
+      if (!item.second.first) { m_overlays.erase(item.first); }
+      else if (m_overlays[item.first].width!=item.second.first || m_overlays[item.first].height!=item.second.second) {
+        m_overlays[item.first]={item.second.first,item.second.second,{},false};
+      }
+    }
+    m_overlayRequests.clear();
+    m_frameCaptureFolder=m_captureFolder; m_frameCaptureWhat=std::exchange(m_captureWhat,0u);
+    const auto& camera=ctx.getSceneManager().getCamera();
+    const auto origin=camera.getPosition(false); const auto dir=camera.getDirection(false); const auto right=camera.getRight(false);
+    const float angles[3] {float(std::atan2(-dir.z,std::hypot(dir.x,dir.y))*180/M_PI),
+      float(std::atan2(dir.y,dir.x)*180/M_PI),float(std::atan2(-right.z,camera.getUp(false).z)*180/M_PI)};
+    const float pos[3] {origin.x,origin.y,origin.z};
+    if (m_poses.match(pos,angles,m_framePose)) { ++m_status.posesMatched; } else { ++m_status.posesUnmatched; }
+    m_status.centreWidth=m_frameProjection.width; m_status.centreHeight=m_frameProjection.height;
+    m_status.eyeWidth=m_eyes[0].image->info().extent.width; m_status.eyeHeight=m_eyes[0].image->info().extent.height;
+    if ((m_frames%120)==0) {
+      Logger::info(str::format("RTX VR camera: main, cut=",camera.isCameraCut(),", FOV=",camera.getFov(),
+        ", pose=",m_framePose.sequence,", matched=",m_status.posesMatched,", unmatched=",m_status.posesUnmatched));
+    }
+    return {m_frameProjection.width,m_frameProjection.height,1};
+  }
+
+  void RtxVr::timestamp(RtxContext& ctx,uint32_t stage) {
+    if (!m_ready || !active()) { return; }
+    if (!stage) {
+      auto& old=m_timers[m_timerIndex]; m_timer=nullptr;
+      if (old.pending) {
+        std::array<DxvkQueryData,6> data {};
+        bool ready=true;
+        for (int i=0;i<6;++i) { ready &= old.queries[i]->getData(data[i])==DxvkGpuQueryStatus::Available; }
+        if (!ready) { return; }
+        const double factor=m_device->properties().core.properties.limits.timestampPeriod/1e6;
+        std::lock_guard lock(m_requestMutex);
+        m_status.gpuMsTotal=float((data[5].timestamp.time-data[0].timestamp.time)*factor);
+        m_status.gpuMsPathTrace=float((data[1].timestamp.time-data[0].timestamp.time)*factor);
+        m_status.gpuMsUpscale=float((data[2].timestamp.time-data[1].timestamp.time)*factor);
+        m_status.gpuMsWarp=float((data[4].timestamp.time-data[3].timestamp.time)*factor);
+        m_status.gpuMsOther=std::max(0.f,m_status.gpuMsTotal-m_status.gpuMsPathTrace-m_status.gpuMsUpscale-m_status.gpuMsWarp);
+      }
+      old.pending=false; m_timer=&old;
+    }
+    if (m_timer && stage<6) { ctx.writeTimestamp(m_timer->queries[stage]); }
+    if (stage==5) {
+      if (m_timer) { m_timer->pending=true; }
+      m_timer=nullptr; m_timerIndex=(m_timerIndex+1)%m_timers.size();
+    }
+  }
+
+  void RtxVr::output(RtxContext& ctx,const Rc<DxvkImage>& colour,const Rc<DxvkImageView>& depth,const Rc<DxvkImage>& game) {
+    if (!m_ready || !active()) { return; }
+    timestamp(ctx,3);
+    DxvkImageViewCreateInfo desc {};
+    desc.type=VK_IMAGE_VIEW_TYPE_2D; desc.format=colour->info().format; desc.aspect=VK_IMAGE_ASPECT_COLOR_BIT;
+    desc.usage=VK_IMAGE_USAGE_SAMPLED_BIT; desc.numLevels=1; desc.numLayers=1;
+    auto view=m_device->createImageView(colour,desc);
+    ctx.setPushConstantBank(DxvkPushConstantBank::RTX);
+    for (int i=0;i<2;++i) {
+      const auto& e=m_frame.eyes[i]; const auto& m=e.eyeToHead.m;
+      VrWarpArgs args {};
+      args.tangents={e.tanLeft,e.tanRight,e.tanTop,e.tanBottom};
+      args.eyeRow0={m[0][0],m[0][1],m[0][2],m[0][3]*m_frame.worldUnitsPerMetre};
+      args.eyeRow1={m[1][0],m[1][1],m[1][2],m[1][3]*m_frame.worldUnitsPerMetre};
+      args.eyeRow2={m[2][0],m[2][1],m[2][2],m[2][3]*m_frame.worldUnitsPerMetre};
+      args.centre={float(m_frameProjection.tanX),float(m_frameProjection.tanY),0,0};
+      ctx.changeImageLayout(m_eyes[i].image,VK_IMAGE_LAYOUT_GENERAL);
+      ctx.bindResourceView(0,view,nullptr); ctx.bindResourceView(1,depth,nullptr); ctx.bindResourceView(2,m_eyes[i].view,nullptr);
+      ctx.bindShader(VK_SHADER_STAGE_COMPUTE_BIT,VrWarpShader::getShader());
+      ctx.pushConstants(0,sizeof(args),&args);
+      auto size=m_eyes[i].image->info().extent;
+      ctx.dispatch((size.width+15)/16,(size.height+15)/16,1);
+    }
+    timestamp(ctx,4);
+    if (!(m_frame.flags&RTXVR_START_NO_MIRROR)) {
+      // Crop the eye to the desktop aspect, keeping the centre and leaving subsequent game UI on top.
+      const auto src=m_eyes[0].image->info().extent; const auto dst=game->info().extent;
+      uint32_t w=src.width,h=src.height;
+      if (uint64_t(w)*dst.height>uint64_t(h)*dst.width) { w=uint32_t(uint64_t(h)*dst.width/dst.height); }
+      else { h=uint32_t(uint64_t(w)*dst.height/dst.width); }
+      VkImageBlit blit {};
+      blit.srcSubresource={VK_IMAGE_ASPECT_COLOR_BIT,0,0,1}; blit.dstSubresource=blit.srcSubresource;
+      blit.srcOffsets[0]={int32_t((src.width-w)/2),int32_t((src.height-h)/2),0};
+      blit.srcOffsets[1]={blit.srcOffsets[0].x+int32_t(w),blit.srcOffsets[0].y+int32_t(h),1};
+      blit.dstOffsets[1]={int32_t(dst.width),int32_t(dst.height),1};
+      const VkComponentMapping identity {VK_COMPONENT_SWIZZLE_IDENTITY,VK_COMPONENT_SWIZZLE_IDENTITY,VK_COMPONENT_SWIZZLE_IDENTITY,VK_COMPONENT_SWIZZLE_IDENTITY};
+      ctx.blitImage(game,identity,m_eyes[0].image,identity,blit,VK_FILTER_LINEAR);
+    }
+    if (m_frameCaptureWhat) {
+      std::error_code error; std::filesystem::create_directories(m_frameCaptureFolder,error);
+      if (m_frameCaptureWhat&RTXVR_CAPTURE_CENTRE) {
+        captureImage(ctx,colour,m_frameCaptureFolder/L"centre.png");
+        captureImage(ctx,depth->image(),m_frameCaptureFolder/L"centre_depth.png",true);
+      }
+      if (m_frameCaptureWhat&RTXVR_CAPTURE_EYES) {
+        captureImage(ctx,m_eyes[0].image,m_frameCaptureFolder/L"left.png"); captureImage(ctx,m_eyes[1].image,m_frameCaptureFolder/L"right.png");
+      }
+    }
+    timestamp(ctx,5);
+    {
+      std::lock_guard lock(m_requestMutex);
+      ++m_status.framesRendered; m_status.state=RTXVR_STATE_RUNNING;
+      m_status.renderWidth=depth->imageInfo().extent.width; m_status.renderHeight=depth->imageInfo().extent.height;
+    }
+    ++m_frames;
+    submit(ctx);
+  }
+
+  vr::VRVulkanTextureData_t RtxVr::textureData(const Image& image) const {
+    const auto& queue=m_device->queues().graphics;
+    const auto& info=image.image->info();
+    return {uint64_t(image.image->handle()),m_device->handle(),m_device->adapter()->handle(),m_device->instance()->handle(),
+      queue.queueHandle,queue.queueFamily,info.extent.width,info.extent.height,uint32_t(info.format),1};
+  }
+
+  void RtxVr::submit(RtxContext& ctx) {
+    if (m_frame.flags&RTXVR_START_NO_SUBMIT) { return; }
+    std::lock_guard calls(m_openVrMutex);
+    if (!active() || !m_compositor) { return; }
+    for (auto& eye:m_eyes) { ctx.changeImageLayout(eye.image,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL); }
+    ctx.flushCommandList();
+    SubmissionLock queue(m_device);
+    const auto begin=std::chrono::steady_clock::now();
+    bool success=true;
+    for (int i=0;i<2;++i) {
+      auto data=textureData(m_eyes[i]);
+      vr::VRTextureWithPose_t texture {};
+      texture.handle=&data; texture.eType=vr::TextureType_Vulkan; texture.eColorSpace=vr::ColorSpace_Gamma;
+      std::memcpy(&texture.mDeviceToAbsoluteTracking,&m_framePose.hmdToTracking,sizeof(m_framePose.hmdToTracking));
+      const auto flags=(m_framePose.structSize && !(m_framePose.flags&RTXVR_POSE_SCRIPTED)) ? vr::Submit_TextureWithPose : vr::Submit_Default;
+      const auto error=m_compositor->Submit(vr::EVREye(i),&texture,nullptr,flags);
+      if (error!=vr::VRCompositorError_None) {
+        success=false;
+        std::lock_guard lock(m_requestMutex); ++m_status.submitErrors; m_status.lastSubmitError=error;
+      }
+    }
+    const float ms=std::chrono::duration<float,std::milli>(std::chrono::steady_clock::now()-begin).count();
+    m_compositor->PostPresentHandoff();
+    std::lock_guard lock(m_requestMutex); if (success) { ++m_status.framesSubmitted; } m_status.cpuMsSubmit=ms;
+  }
+
+  void RtxVr::observeTarget(DxvkContext& ctx,const Rc<DxvkImage>& image) {
+    if (!m_ready || !active() || image == nullptr) { return; }
+    const auto size=image->info().extent;
+    for (auto& item:m_overlays) {
+      auto& overlay=item.second;
+      if (size.width!=overlay.width || size.height!=overlay.height) { continue; }
+      if (overlay.texture.image == nullptr) { overlay.texture=makeImage(ctx,size); }
+      RtxContext::blitImageHelper(&ctx,image,overlay.texture.image,VK_FILTER_NEAREST);
+      overlay.dirty=true;
+    }
+  }
+
+  void RtxVr::present(RtxContext& ctx,const Rc<DxvkImage>& game) {
+    if (!m_ready || !active()) { return; }
+    bool updates=false;
+    uint32_t bound=0;
+    for (auto& item:m_overlays) {
+      auto& overlay=item.second;
+      if (overlay.texture.image == nullptr) { continue; }
+      ++bound;
+      if (overlay.dirty) { ctx.changeImageLayout(overlay.texture.image,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL); updates=true; }
+      if ((m_frameCaptureWhat&RTXVR_CAPTURE_OVERLAYS)) {
+        captureImage(ctx,overlay.texture.image,m_frameCaptureFolder/(L"overlay_"+std::to_wstring(item.first)+L".png"));
+      }
+    }
+    if (updates && !(m_frame.flags&RTXVR_START_NO_SUBMIT)) {
+      std::lock_guard calls(m_openVrMutex);
+      if (active() && m_overlay) {
+        ctx.flushCommandList(); SubmissionLock queue(m_device);
+        for (auto& item:m_overlays) {
+          if (!item.second.dirty) { continue; }
+          auto data=textureData(item.second.texture);
+          vr::Texture_t texture {&data,vr::TextureType_Vulkan,vr::ColorSpace_Gamma};
+          const auto error=m_overlay->SetOverlayTexture(item.first,&texture);
+          if (error==vr::VROverlayError_None) {
+            std::lock_guard lock(m_requestMutex); ++m_status.overlayUpdates; m_submittedOverlays.insert(item.first);
+          } else { Logger::warn(str::format("RTX VR overlay ",item.first,": error ",int(error))); }
+          item.second.dirty=false;
+        }
+      }
+    }
+    if ((m_frameCaptureWhat&RTXVR_CAPTURE_MIRROR) && game != nullptr) { captureImage(ctx,game,m_frameCaptureFolder/L"mirror.png"); }
+    m_frameCaptureWhat=0;
+    std::lock_guard lock(m_requestMutex); m_status.overlaysBound=bound;
+  }
+
+  void RtxVr::beforeSubmission() {
+    std::unique_lock calls(m_openVrMutex,std::try_to_lock);
+    if (!calls.owns_lock() || !active() || !m_compositor || m_timingFrame==m_device->getCurrentFrameId()) { return; }
+    SubmissionLock queue(m_device);
+    const auto error=m_compositor->SubmitExplicitTimingData();
+    if (error!=vr::VRCompositorError_None) { Logger::warn(str::format("RTX VR explicit timing error: ",int(error))); }
+    m_timingFrame=m_device->getCurrentFrameId();
+  }
+
+  void RtxVr::captureImage(RtxContext& ctx,const Rc<DxvkImage>& image,const std::filesystem::path& path,bool depth) {
+    Rc<DxvkImage> source=image;
+    Image temp;
+    if (!depth && image->info().format!=VK_FORMAT_R8G8B8A8_UNORM) {
+      temp=makeImage(ctx,image->info().extent);
+      RtxContext::blitImageHelper(&ctx,image,temp.image,VK_FILTER_NEAREST); source=temp.image;
+    }
+    const auto size=source->info().extent;
+    const VkDeviceSize bytes=VkDeviceSize(size.width)*size.height*4;
+    DxvkBufferCreateInfo desc {};
+    desc.size=bytes; desc.usage=VK_BUFFER_USAGE_TRANSFER_DST_BIT|VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    desc.stages=VK_PIPELINE_STAGE_TRANSFER_BIT|VK_PIPELINE_STAGE_HOST_BIT;
+    desc.access=VK_ACCESS_TRANSFER_READ_BIT|VK_ACCESS_TRANSFER_WRITE_BIT|VK_ACCESS_HOST_READ_BIT;
+    auto buffer=m_device->createBuffer(desc,VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT|VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,DxvkMemoryStats::Category::RTXBuffer,"VR capture");
+    ctx.copyImageToBuffer(buffer,0,1,1,source,{VK_IMAGE_ASPECT_COLOR_BIT,0,0,1},{0,0,0},size);
+    ctx.getCommonObjects()->metaExporter().copyBufferFromGPU(&ctx,DxvkBufferSlice(buffer,0,bytes),[path,size,depth](Rc<DxvkBuffer> readback) {
+      const auto* data=static_cast<const uint8_t*>(readback->mapPtr(0));
+      if (!data) { return; }
+      std::vector<uint8_t> rgba;
+      if (depth) {
+        rgba.resize(size_t(size.width)*size.height*4);
+        const auto* z=reinterpret_cast<const float*>(data);
+        for (size_t i=0;i<size_t(size.width)*size.height;++i) {
+          const uint8_t value=uint8_t(std::clamp(std::log2(1.f+std::abs(z[i]))/16.f,0.f,1.f)*255);
+          rgba[i*4]=value; rgba[i*4+1]=value; rgba[i*4+2]=value; rgba[i*4+3]=255;
+        }
+        data=rgba.data();
+      }
+      if (!vrpng::save(path,size.width,size.height,data)) { Logger::err("RTX VR: PNG capture write failed"); }
+    });
+  }
+}
