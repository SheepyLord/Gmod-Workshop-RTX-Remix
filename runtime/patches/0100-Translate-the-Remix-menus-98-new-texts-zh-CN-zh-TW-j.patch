 msgstr "Ce réglage définit l'altitude de la couche de nuages élevés en km [2..20]. Les cirrus se forment vers 6 à 12 km."
 
 #. option rtx.atmosphere.cirrusFibrous
-#: src/dxvk/rtx_render/rtx_atmosphere.h:608
+#: src/dxvk/rtx_render/rtx_atmosphere.h:650
 msgid "Share of fibrous cirrus in the high layer [0..1]: thin streaks drawn out by the wind."
 msgstr "Ce réglage définit la part de cirrus fibreux dans la couche élevée [0..1] : de fines traînées étirées par le vent."
 
 #. option rtx.atmosphere.cirrusSheet
-#: src/dxvk/rtx_render/rtx_atmosphere.h:610
+#: src/dxvk/rtx_render/rtx_atmosphere.h:652
 msgid "Share of cirrostratus in the high layer [0..1]: an even veil that rings the sun and moon with the 22 degree halo."
 msgstr "Ce réglage définit la part de cirrostratus dans la couche élevée [0..1] : un voile uniforme qui entoure le soleil et la lune d'un halo de 22°."
 
 #. option rtx.atmosphere.cirrusDappled
-#: src/dxvk/rtx_render/rtx_atmosphere.h:613
+#: src/dxvk/rtx_render/rtx_atmosphere.h:655
 msgid "Share of cirrocumulus in the high layer [0..1]: small grains in rows."
 msgstr "Ce réglage définit la part de cirrocumulus dans la couche élevée [0..1] : de petits granules en rangées."
 
 #. option rtx.atmosphere.cirrusOpticalDepth
-#: src/dxvk/rtx_render/rtx_atmosphere.h:615
+#: src/dxvk/rtx_render/rtx_atmosphere.h:657
 msgid "Optical depth of the high layer's densest parts [0..5]. Cirrus is thin: below 1 the sun shines through it."
 msgstr "Ce réglage définit l'épaisseur optique des parties les plus denses de la couche élevée [0..5]. Les cirrus sont fins : en dessous de 1, le soleil les traverse."
 
 #. option rtx.atmosphere.cirrusHaloStrength
-#: src/dxvk/rtx_render/rtx_atmosphere.h:618
+#: src/dxvk/rtx_render/rtx_atmosphere.h:660
 msgid "Strength of the 22 degree halo of a cirrostratus veil [0..2]. 0 = no halo."
 msgstr "Ce réglage définit l'intensité du halo de 22° d'un voile de cirrostratus [0..2]. 0 = aucun halo."
 
 #. option rtx.atmosphere.cirrusArcStrength
-#: src/dxvk/rtx_render/rtx_atmosphere.h:620
+#: src/dxvk/rtx_render/rtx_atmosphere.h:662
 msgid "Strength of the halos of level-falling plate crystals in the high clouds [0..2]: the sun dogs at the sun's height 22 degrees and more to either side, and the circumzenithal arc 46 degrees above a sun lower than 32 degrees. The moon gets them too. 0 = none."
 msgstr "Intensité des halos produits par les cristaux de glace en plaquettes qui tombent à plat dans les nuages élevés [0..2] : les parhélies, à la hauteur du soleil et à 22 degrés ou plus de chaque côté, et l'arc circumzénithal, 46 degrés au-dessus d'un soleil situé à moins de 32 degrés de hauteur. La lune produit aussi ces phénomènes. 0 = aucun."
 
 #. option rtx.atmosphere.cirrusScale
-#: src/dxvk/rtx_render/rtx_atmosphere.h:624
+#: src/dxvk/rtx_render/rtx_atmosphere.h:666
