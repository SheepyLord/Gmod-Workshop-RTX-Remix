   }
 
+  // True stereo: an eye's view from the centre view. The engine's view space has x right and y up, and looks
+  // along +z when its projection is left-handed and -z otherwise; OpenVR's head and eye spaces look along -z,
+  // in metres. Row-major 3x4, translation in world units: centre-view point = toCentre * eye-view point.
+  inline void eyeToCentreView(const rtxvr_Eye& eye, bool leftHanded, double unitsPerMetre, double toCentre[3][4]) {
+    const double s[3] = { 1, 1, leftHanded ? -1.0 : 1.0 };
+    for (int i = 0; i < 3; ++i) {
+      for (int j = 0; j < 3; ++j) { toCentre[i][j] = s[i] * eye.eyeToHead.m[i][j] * s[j]; }
+      toCentre[i][3] = s[i] * eye.eyeToHead.m[i][3] * unitsPerMetre;
+    }
+  }
+
+  // The eye's projection terms in the engine's column-major matrix: [0][0], [1][1], and the off-centre [2][0] and
+  // [2][1]. `wSign` is the centre projection's [2][3] (+1 left-handed, -1 right-handed); its depth terms stay.
+  // fovY and aspect describe the frustum at the eye's optical centre, for the pixel's ray spread.
+  struct EyeProjection { double xScale, yScale, xOffset, yOffset, fovY, aspect; };
+  inline EyeProjection eyeProjection(const rtxvr_Eye& e, double wSign) {
+    const double w = double(e.tanRight) - e.tanLeft, h = double(e.tanBottom) - e.tanTop;
+    EyeProjection p {};
+    p.xScale = 2 / w; p.yScale = 2 / h;
+    p.xOffset = -wSign * (double(e.tanRight) + e.tanLeft) / w;
+    p.yOffset = wSign * (double(e.tanTop) + e.tanBottom) / h;
+    p.fovY = 2 * std::atan(h / 2); p.aspect = w / h;
+    return p;
+  }
+
+  // The aerial perspective volume's basis for an off-centre eye: a direction for screen ndc (x, y) is
+  // forward + right * x + up * y, which an off-centre frustum gets by shifting forward. The vectors are the eye
+  // camera's unit forward, right and up in world space.
+  inline void eyeFrustumBasis(const rtxvr_Eye& e, Vec3 forward, Vec3 right, Vec3 up, Vec3& outForward, Vec3& outRight, Vec3& outUp) {
+    const double cx = (double(e.tanRight) + e.tanLeft) / 2, sx = (double(e.tanRight) - e.tanLeft) / 2;
+    const double cy = -(double(e.tanTop) + e.tanBottom) / 2, sy = (double(e.tanBottom) - e.tanTop) / 2;
+    outForward = { forward.x + right.x*cx + up.x*cy, forward.y + right.y*cx + up.y*cy, forward.z + right.z*cx + up.z*cy };
+    outRight = { right.x*sx, right.y*sx, right.z*sx };
+    outUp = { up.x*sy, up.y*sy, up.z*sy };
+  }
+
   struct Orientation { Vec3 forward, up; };
 
