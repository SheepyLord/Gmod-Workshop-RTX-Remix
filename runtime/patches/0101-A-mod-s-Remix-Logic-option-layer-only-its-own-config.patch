--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_mod_layer_policy.h
@@ -0,0 +1,380 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+#pragma once
+
+// NV-DXVK: what a Remix Logic graph in a mod may do with option layers (runtime patch 0101 of the GMod native loader
+// project). Self-contained (the standard library only), so the project's gate compiles and runs
+// tests/rtx/unit/test_mod_layer_policy.cpp against it. The runtime's side: resolveAssetPath in
+// graph/rtx_graph_usd_parser.cpp, RtxOptionManager::acquireModLayer, RtxOptionImpl::readOptionLayer and readValue's
+// callers in rtx_option.cpp, and RtxOptionLayerAction::initializeInstance.
+//
+// Upstream treats Remix mods as trusted configuration. The GMod loader deploys the Remix mods of any subscribed
+// Workshop item as content (its ADR 0027 and 0111), and an RtxOptionLayerAction node in such a mod's graph acquired
+// an option layer, above rtx.conf, from any config file it named: a UNC path made Windows offer the player's login to
+// another host, the file could set every runtime option (the folder NRC loads its CUDA DLLs from, the welcome message
+// the splash formatted as printf), and a hash list that failed to parse threw out of the graph and ended the game.
+// A mod's graph now reads a config file only from its own folder, and its layer applies only rendering options.
+
+#include <cstddef>
+#include <exception>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace dxvk::mod_layer_policy {
+
+  // ==============================================================================================================
+  // Paths
+  // ==============================================================================================================
+
+  inline char foldAscii(char c) {
+    return (c >= 'A' && c <= 'Z') ? static_cast<char>(c - 'A' + 'a') : c;
+  }
+
+  inline std::string foldAscii(std::string_view text) {
+    std::string folded(text);
+    for (char& c : folded) {
+      c = foldAscii(c);
+    }
+    return folded;
+  }
+
+  inline bool isSeparator(char c) {
+    return c == '/' || c == '\\';
+  }
+
+  inline bool refuse(std::string* reason, const char* why) {
+    if (reason != nullptr) {
+      *reason = why;
+    }
+    return false;
+  }
+
+  // A path taken apart, '/' and '\\' alike. An absolute path's first part is its root: "x:" for a drive, "//server"
+  // for a share, whose name is the second part. Parts compare without ASCII case, as Windows names do.
+  struct PathParts {
+    enum class Root { Relative, Drive, Share };
+    Root root = Root::Relative;
+    std::vector<std::string> parts;
+  };
+
+  // Splits `path`; false for what is neither a plain relative path, a drive path ("x:\...") nor a share
+  // ("\\server\share\..."): a device path ("\\?\", "\\.\"), a rooted path without a drive ("\x"), a drive without a
+  // separator ("c:x"), a ':' anywhere else (a stream, a scheme), a character Windows refuses in a name, a control
+  // character, or more than 4096 bytes.
+  inline bool splitPath(std::string_view path, PathParts& out, std::string* reason = nullptr) {
+    out = PathParts {};
+    if (path.empty()) {
+      return refuse(reason, "the path is empty");
+    }
+    if (path.size() > 4096) {
+      return refuse(reason, "the path is longer than 4096 bytes");
+    }
+    for (const char c : path) {
+      const unsigned char u = static_cast<unsigned char>(c);
+      if (u < 0x20 || u == 0x7f) {
+        return refuse(reason, "the path holds a control character");
+      }
+      if (c == '"' || c == '<' || c == '>' || c == '|' || c == '*' || c == '?') {
+        return refuse(reason, "the path holds a character Windows refuses in a name");
+      }
+    }
+    size_t at = 0;
+    const auto nextPart = [&path, &at]() {
+      while (at < path.size() && isSeparator(path[at])) {
+        ++at;
+      }
+      const size_t start = at;
+      while (at < path.size() && !isSeparator(path[at])) {
+        ++at;
+      }
+      return path.substr(start, at - start);
+    };
+    if (path.size() >= 2 && isSeparator(path[0]) && isSeparator(path[1])) {
+      // "\\?\" and "\\.\" were refused with '?' above, or read here: a share's server is never "." or "?".
+      at = 2;
+      const std::string_view server = nextPart();
+      const std::string_view share = nextPart();
+      if (server.empty() || share.empty() || server == "." || server == "..") {
+        return refuse(reason, "the path is a device or an incomplete share");
+      }
+      out.root = PathParts::Root::Share;
+      out.parts.push_back("//" + foldAscii(server));
+      out.parts.push_back(foldAscii(share));
+    } else if (path.size() >= 2 && ((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) &&
+               path[1] == ':') {
+      if (path.size() == 2 || !isSeparator(path[2])) {
+        return refuse(reason, "the path names a drive without a folder (x:file)");
+      }
+      out.root = PathParts::Root::Drive;
+      out.parts.push_back(std::string(1, foldAscii(path[0])) + ":");
+      at = 3;
+    } else if (isSeparator(path[0])) {
+      return refuse(reason, "the path starts at a root without a drive");
+    }
+    while (at < path.size()) {
+      const std::string_view part = nextPart();
+      if (part.empty()) {
+        break;  // trailing separators
+      }
+      if (part.find(':') != std::string_view::npos) {
+        return refuse(reason, "the path holds a ':' after its drive (a stream or a scheme)");
+      }
+      out.parts.push_back(foldAscii(part));
+    }
+    return true;
+  }
+
+  // A name Windows would shorten ("x.", "x ", "...") can reach another file than the one it spells.
+  inline bool trailingDotOrSpace(const std::string& part) {
+    return part != "." && part != ".." && !part.empty() && (part.back() == '.' || part.back() == ' ');
+  }
+
+  // `parts` with "." dropped and ".." taking the part before it (never the root). Lexical, as Win32 normalizes.
+  inline std::vector<std::string> lexicallyNormal(const PathParts& path) {
+    std::vector<std::string> out;
+    const size_t rootParts = path.root == PathParts::Root::Share ? 2 : path.root == PathParts::Root::Drive ? 1 : 0;
+    for (size_t i = 0; i < path.parts.size(); ++i) {
+      const std::string& part = path.parts[i];
+      if (i < rootParts) {
+        out.push_back(part);
+      } else if (part == ".") {
+        continue;
+      } else if (part == "..") {
+        if (out.size() > rootParts) {
+          out.pop_back();
+        }
+      } else {
+        out.push_back(part);
+      }
+    }
+    return out;
+  }
+
+  // True when `parts` starts with every part of `folder` and has at least `deeper` parts more.
+  inline bool startsWithParts(const std::vector<std::string>& parts, const std::vector<std::string>& folder,
+                              size_t deeper) {
+    if (parts.size() < folder.size() + deeper) {
+      return false;
+    }
+    for (size_t i = 0; i < folder.size(); ++i) {
+      if (parts[i] != folder[i]) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // The folder of a file path: everything before its last separator ("" without one).
+  inline std::string parentFolder(std::string_view path) {
+    const size_t slash = path.find_last_of("/\\");
+    return slash == std::string_view::npos ? std::string() : std::string(path.substr(0, slash));
+  }
+
+  // `relative` anchored to the absolute `folder`, lexically normal, with '/' between parts (folded ASCII case, as
+  // the parts compare); "" when either does not split as such.
+  inline std::string joinedNormal(std::string_view folder, std::string_view relative) {
+    PathParts base;
+    PathParts rest;
+    if (!splitPath(folder, base, nullptr) || base.root == PathParts::Root::Relative ||
+        !splitPath(relative, rest, nullptr) || rest.root != PathParts::Root::Relative) {
+      return std::string();
+    }
+    base.parts.insert(base.parts.end(), rest.parts.begin(), rest.parts.end());
+    std::string joined;
+    for (const std::string& part : lexicallyNormal(base)) {
+      joined += (joined.empty() || joined.back() == '/') ? part : "/" + part;
+    }
+    return joined;
+  }
+
+  // An asset path as a mod's USD layer authors it: relative to that layer, never a drive, a root, a share or a
+  // scheme. Checked before USD's resolver looks for it: resolving "\\host\share\x" opens a network session.
+  inline bool authoredPathAllowed(std::string_view authored, std::string* reason = nullptr) {
+    PathParts parts;
+    if (!splitPath(authored, parts, reason)) {
+      return false;
+    }
+    if (parts.root != PathParts::Root::Relative) {
+      return refuse(reason, "a mod names its files relative to its own USD file, never a drive or a share");
+    }
+    return true;
+  }
+
+  // True when `candidate` (absolute) lies in `folder` (absolute), lexically normal, at least one part deeper.
+  inline bool insideFolder(std::string_view candidate, std::string_view folder, std::string* reason = nullptr) {
+    PathParts file;
+    PathParts base;
+    if (!splitPath(candidate, file, reason)) {
+      return false;
+    }
+    if (file.root == PathParts::Root::Relative) {
+      return refuse(reason, "the path is not absolute");
+    }
+    for (const std::string& part : file.parts) {
+      if (trailingDotOrSpace(part)) {
+        return refuse(reason, "the path holds a name ending in a dot or a space");
+      }
+    }
+    if (!splitPath(folder, base, nullptr) || base.root == PathParts::Root::Relative) {
+      return refuse(reason, "the mod's folder is unknown");
+    }
+    if (!startsWithParts(lexicallyNormal(file), lexicallyNormal(base), 1)) {
+      return refuse(reason, "the path leaves the mod's folder");
+    }
+    return true;
+  }
+
+  // A config file a mod's graph may load as an option layer: an absolute path, without "." or "..", in a mod's
+  // folder below `modsRoot` (rtx-remix/mods), so at least two parts deeper: <mod>/<file>. The graph's parser has
+  // already kept each mod to its own folder; this holds whatever reaches the option manager.
+  inline bool configPathAllowed(std::string_view path, std::string_view modsRoot, std::string* reason = nullptr) {
+    PathParts file;
+    PathParts root;
+    if (!splitPath(path, file, reason)) {
+      return false;
+    }
+    if (file.root == PathParts::Root::Relative) {
+      return refuse(reason, "the path is not absolute");
+    }
+    for (const std::string& part : file.parts) {
+      if (part == "." || part == "..") {
+        return refuse(reason, "the path holds a \".\" or \"..\" part");
+      }
+      if (trailingDotOrSpace(part)) {
+        return refuse(reason, "the path holds a name ending in a dot or a space");
+      }
+    }
+    if (modsRoot.empty() || !splitPath(modsRoot, root, nullptr) || root.root == PathParts::Root::Relative) {
+      return refuse(reason, "the mods folder is unknown");
+    }
+    if (!startsWithParts(file.parts, lexicallyNormal(root), 2)) {
+      return refuse(reason, "the path is not a file in a mod's folder below rtx-remix/mods");
+    }
+    return true;
+  }
+
+  // ==============================================================================================================
+  // Options
+  // ==============================================================================================================
+
+  enum class ValueKind { Bool, Int, Float, FloatVector, IntVector, String, HashSet, HashVector, VirtualKeys };
+
+  struct OptionFacts {
+    std::string_view name;      // the full name, "rtx.atmosphere.sunSize"
+    ValueKind kind = ValueKind::Float;
+    bool userSetting = false;   // RtxOptionFlags::UserSetting: the player's choice (quality, upscaler, interface)
+    bool noSave = false;        // RtxOptionFlags::NoSave: runtime state (the menu, low-memory mode)
+    bool hasMin = false;        // an Int's declared range
+    bool hasMax = false;
+    double minValue = 0.0;
+    double maxValue = 0.0;
+  };
+
+  // How the scene looks: the sky, the weather, fog and volumetric light, exposure, tone mapping, bloom and the post
+  // effects. A content package may change these; what in them names a file, a key or a message, sizes memory or a
+  // loop without a bound, or is the player's own setting is refused by the rules below.
+  inline constexpr std::string_view kAllowedNamespaces[] = {
+    "rtx.atmosphere.", "rtx.weather.", "rtx.volumetrics.", "rtx.tonemap.", "rtx.autoExposure.", "rtx.bloom.",
+    "rtx.postfx.",
+  };
+
+  // Single options of the same kind outside those namespaces.
+  inline constexpr std::string_view kAllowedOptions[] = {
+    "rtx.skyBrightness", "rtx.emissiveIntensity", "rtx.fogColorScale", "rtx.maxFogDistance", "rtx.enableFog",
+    "rtx.fogIgnoreSky", "rtx.vertexColorStrength", "rtx.lightConversionIntensityFactor",
+  };
+
+  // A last name part ending so names a file, a folder or a pattern, a message, the interface language, a key or a
+  // capture, never a rendering value. (The 14 path options the GMod fixes keep from Lua, ADR 0112, are among them.)
+  inline constexpr std::string_view kRefusedEndings[] = {
+    "texture", "textures", "path", "file", "dir", "directory", "folder", "regex", "message", "language", "hotkey",
+    "keybinds", "stagename", "replacement",
+  };
+
+  // An integer applies only within a declared range at most this wide: a count or a size without one can exhaust
+  // video memory or hang the GPU, and a mode without one can index past its table.
+  inline constexpr double kMaxIntegerRange = 1024.0;
+
+  inline bool startsWithFolded(const std::string& folded, std::string_view prefix) {
+    return folded.compare(0, prefix.size(), foldAscii(prefix)) == 0;
+  }
+
+  inline bool endsWithFolded(const std::string& folded, std::string_view suffix) {
+    return folded.size() >= suffix.size() && folded.compare(folded.size() - suffix.size(), suffix.size(), foldAscii(suffix)) == 0;
+  }
+
+  // True when a layer a mod's graph acquired may apply this option.
+  inline bool optionAllowed(const OptionFacts& option, std::string* reason = nullptr) {
+    const std::string name = foldAscii(option.name);
+    bool listed = false;
+    for (const std::string_view allowed : kAllowedNamespaces) {
+      listed = listed || startsWithFolded(name, allowed);
+    }
+    for (const std::string_view allowed : kAllowedOptions) {
+      listed = listed || name == foldAscii(allowed);
+    }
+    if (!listed) {
+      return refuse(reason, "not a rendering option a mod may set");
+    }
+    if (name.find("debug") != std::string::npos) {
+      return refuse(reason, "a debugging option");
+    }
+    const std::string last = name.substr(name.find_last_of('.') + 1);
+    for (const std::string_view ending : kRefusedEndings) {
+      if (endsWithFolded(last, ending)) {
+        return refuse(reason, "it names a file, a folder, a message or a key");
+      }
+    }
+    if (option.userSetting) {
+      return refuse(reason, "the player's own setting");
+    }
+    if (option.noSave) {
+      return refuse(reason, "runtime state");
+    }
+    switch (option.kind) {
+    case ValueKind::Bool:
+    case ValueKind::Float:
+    case ValueKind::FloatVector:
+      return true;
+    case ValueKind::Int:
+      if (!option.hasMin || !option.hasMax || option.maxValue < option.minValue ||
+          option.maxValue - option.minValue > kMaxIntegerRange) {
+        return refuse(reason, "an integer without a declared range of at most 1024 values");
+      }
+      return true;
+    case ValueKind::IntVector:
+    case ValueKind::String:
+    case ValueKind::HashSet:
+    case ValueKind::HashVector:
+    case ValueKind::VirtualKeys:
+      break;
+    }
+    return refuse(reason, "text, lists, keys and integer vectors are not rendering values a mod may set");
+  }
+
+  // ==============================================================================================================
+  // Parsing
+  // ==============================================================================================================
+
+  // Runs a parse that may throw (std::stoull in the hash lists) and reports instead: a value that fails to parse is
+  // refused, never thrown through a graph, a layer's load or the Remix API.
+  template<typename Parse>
+  bool parsedWithoutThrow(Parse&& parse, std::string* error = nullptr) {
+    try {
+      parse();
+      return true;
+    } catch (const std::exception& e) {
+      if (error != nullptr) {
+        *error = e.what();
+      }
+    } catch (...) {
+      if (error != nullptr) {
+        *error = "an unknown error";
+      }
+    }
+    return false;
+  }
+
+}
