diff --git a/src/dxvk/rtx_render/rtx_vr_math.h b/src/dxvk/rtx_render/rtx_vr_math.h
index 27257bc5..110bbadc 100644
--- a/src/dxvk/rtx_render/rtx_vr_math.h
+++ b/src/dxvk/rtx_render/rtx_vr_math.h
@@ -101,9 +101,18 @@ namespace dxvk::vrmath {
     return project(p, { o.x+d.x*t, o.y+d.y*t, -depth });
   }
 
+  inline unsigned searchSteps(const std::array<double,2>& start,const std::array<double,2>& infinity,
+                              uint32_t width,uint32_t height,unsigned requested=0) {
+    if(requested) { return std::clamp(requested,1u,128u); }
+    if(!width||!height) { return 64; }
+    const double span=std::max(std::abs(start[0]-infinity[0])*width,std::abs(start[1]-infinity[1])*height);
+    return std::clamp(unsigned(std::ceil(span))+1,1u,128u);
+  }
+
   template<typename Depth>
   inline std::array<double, 2> warp(const Projection& p, const rtxvr_Eye& eye,
-                                  double u, double v, double unitsPerMetre, Depth depthAt, unsigned taps=64) {
+                                  double u, double v, double unitsPerMetre, Depth depthAt, unsigned taps=0,
+                                  uint32_t depthWidth=0,uint32_t depthHeight=0) {
     const auto infinity=project(p,eyeRay(eye,u,v));
     const double nearest=kNearestEyeDepthMetres*unitsPerMetre;
     const auto start=warpAtDepth(p,eye,u,v,nearest,unitsPerMetre);
@@ -115,7 +124,7 @@ namespace dxvk::vrmath {
       }
       settled=false;return uv;
     };
-    taps=std::clamp(taps,1u,128u);
+    taps=searchSteps(start,infinity,depthWidth,depthHeight,taps);
     double previousDepth=depthAt(start[0],start[1]);
     for(unsigned i=0;i<=taps;++i) {
       double s=1-double(i)/taps;
@@ -124,12 +133,16 @@ namespace dxvk::vrmath {
       auto uv=sample(s);
       const double rayDepth=s>0 ? nearest/s : 1e20;
       const double depth=depthAt(uv[0],uv[1]);
-      const double candidate=std::min(depth,previousDepth);
-      if(candidate<=rayDepth) {
+      double best=std::numeric_limits<double>::infinity();
+      std::array<double,2> closest{};
+      for(double candidate:{std::min(depth,previousDepth),std::max(depth,previousDepth)}) {
+        if(candidate>rayDepth) { continue; }
         bool settled=false;
         const auto hit=refine(warpAtDepth(p,eye,u,v,candidate,unitsPerMetre),settled);
-        if(settled&&depthAt(hit[0],hit[1])<=rayDepth*(1+1e-6)) { return hit; }
+        const double resolved=depthAt(hit[0],hit[1]);
+        if(settled&&resolved<=rayDepth*(1+1e-6)&&resolved<best) { best=resolved;closest=hit; }
       }
+      if(std::isfinite(best)) { return closest; }
       previousDepth=depth;
     }
     auto uv = project(p, eyeRay(eye, u, v));
