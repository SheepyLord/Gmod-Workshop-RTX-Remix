+  const float cloudT = sampleCloudGroundShadow_OptionB(
+      froxelWorldPosition, dirToLight, cb.atmosphereArgs, cb.isZUp != 0);
+  lightSample.radiance *= pow(cloudT, cb.atmosphereArgs.cloudShadowFactorStrength);
+}
