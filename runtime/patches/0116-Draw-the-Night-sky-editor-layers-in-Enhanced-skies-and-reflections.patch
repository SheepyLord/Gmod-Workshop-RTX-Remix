diff --git a/src/dxvk/rtx_render/rtx_fork_numos_night.cpp b/src/dxvk/rtx_render/rtx_fork_numos_night.cpp
new file mode 100644
index 000000000..db01dda61
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_numos_night.cpp
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: MIT
+#include "rtx_fork_numos_night.h"
+#include "numos/lib/atmosphere_args.h"
+#include "rtx_atmosphere.h"
+#include "rtx_context.h"
+#include "rtx_night_sky_layers.h"
+
+namespace dxvk {
+  // Enhanced uses the same cached DDS views and editor weights as Standard, independently
+  // of Standard's image/procedural choice. None of Standard's atmosphere passes run here.
+  NumosNightArgs prepareNumosNight(RtxContext& ctx, bool image, const numos::AtmosphereArgs& sky) {
+    NumosNightArgs n {};
+    n.flags = ctx.getCommonObjects()->metaAtmosphere().loadNightImage(&ctx, image);
+    if (image) n.flags |= kNumosNightImage;
+    n.weight = vec4(
+      nightsky::layerWeight(RtxAtmosphere::starMapStarBrightness()),
+      nightsky::layerWeight(RtxAtmosphere::starMapConstellationBrightness()),
+      nightsky::layerWeight(RtxAtmosphere::starMapGalaxyBrightness()),
+      nightsky::layerWeight(RtxAtmosphere::starMapNebulaBrightness()));
+    n.saturation = vec4(
+      nightsky::layerSaturation(RtxAtmosphere::starMapStarSaturation()),
+      nightsky::layerSaturation(RtxAtmosphere::starMapConstellationSaturation()),
+      nightsky::layerSaturation(RtxAtmosphere::starMapGalaxySaturation()),
+      nightsky::layerSaturation(RtxAtmosphere::starMapNebulaSaturation()));
+    n.ceiling = nightsky::layerCeiling(n.weight.x, n.weight.y, n.weight.z, n.weight.w);
+    n.brightness = std::max(0.f, RtxAtmosphere::starMapBrightness());
+    n.shootingChance = nightsky::shootingStarChance(RtxAtmosphere::shootingStarsPerMinute());
+    n.shootingBrightness = std::max(0.f, RtxAtmosphere::shootingStarBrightness());
+    n.moonGlow = std::max(0.f, RtxAtmosphere::haloMoonBrightness() * RtxAtmosphere::moonHaloMagnitude()
+      * RtxAtmosphere::moonHaloGlowStrength());
+    n.coronaBrightness = std::max(0.f, RtxAtmosphere::eclipseCoronaBrightness());
+
+    const Vector3 sun(sky.sunDirection.x, sky.sunDirection.y, sky.sunDirection.z);
+    if (RtxAtmosphere::eclipseEnable() && sun.y > 0.f && sky.sunAngularRadius > 0.f) {
+      for (const auto& m : sky.moons) {
+        if (m.enabled < .5f || m.angularRadius <= 0.f) continue;
+        const Vector3 moon(m.direction.x, m.direction.y, m.direction.z);
+        n.eclipseCoverage = std::max(n.eclipseCoverage, RtxAtmosphere::solarDiscCoverage(
+          sun, sky.sunAngularRadius, moon, m.angularRadius));
+      }
+    }
+    const float daylight = 1.f - n.eclipseCoverage * (1.f - std::clamp(RtxAtmosphere::eclipseTotalityLight(), 0.f, 1.f));
+    const vec2 twilight = numosNightTwilight(sun.y, daylight);
+    n.starFade = twilight.x;
+    n.deepFade = twilight.y;
+    n.moonFade = numosNightFade(0.f, .09f, -sun.y);
+    return n;
+  }
+}
diff --git a/src/dxvk/rtx_render/rtx_fork_numos_night.h b/src/dxvk/rtx_render/rtx_fork_numos_night.h
new file mode 100644
index 000000000..7536aa145
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_numos_night.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cstring>
+#include "numos/gpu.h"
+#include "numos/shaders.h"
+#include "numos/lib/atmosphere_args.h"
+#include "rtx/pass/numos/numos_night.h"
+
+namespace dxvk {
+  // IGpu receives opaque uniform bytes before the pass is identified. Remember only
+  // the four fields the sky-view bake needs, then verify the consuming pass and slice.
+  class NumosNightAir {
+  public:
+    using Region = numos::IGpu::ConstantsRegion;
+    void beginFrame(bool restore) {
+      m_restore = restore;
+      m_region = {};
+    }
+
+    void uploaded(Region region, const void* data) {
+      if (!m_restore || region.size != sizeof(numos::AtmosphereArgs)) return;
+      const auto* bytes = static_cast<const uint8_t*>(data);
+      std::memcpy(&m_inScatter, bytes + offsetof(numos::AtmosphereArgs, nightGlowInScatter), sizeof(m_inScatter));
+      std::memcpy(&m_referenceSun, bytes + offsetof(numos::AtmosphereArgs, nightSkyIlluminance), sizeof(m_referenceSun));
+      std::memcpy(&m_starGain, bytes + offsetof(numos::AtmosphereArgs, nightSkyGain), sizeof(m_starGain));
+      std::memcpy(&m_flags, bytes + offsetof(numos::AtmosphereArgs, nightSkyFlags), sizeof(m_flags));
+      m_region = region;
+    }
+
+    bool forSkyView(uint32_t pass, const numos::Binding& b, numos::vec3& light) const {
+      if (pass != uint32_t(numos::PassId::sky_view_lut) || b.kind != numos::BindingKind::ConstantBuffer ||
+          !m_region.buffer || b.resource != m_region.buffer || b.offset != m_region.offset || b.size != m_region.size)
+        return false;
+      const float share = numosMissingStarInScatter(m_flags, m_starGain);
+      if (share <= 0.f) return false;
+      light = m_inScatter + m_referenceSun * share;
+      return true;
+    }
+
+  private:
+    Region m_region {};
+    numos::vec3 m_inScatter {}, m_referenceSun {};
+    float m_starGain = 0.f;
+    uint32_t m_flags = 0u;
+    bool m_restore = false;
+  };
+
+  class RtxContext;
+  NumosNightArgs prepareNumosNight(RtxContext& ctx, bool image, const numos::AtmosphereArgs& sky);
+}
