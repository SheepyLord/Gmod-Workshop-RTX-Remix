-    const float candidate=min(depth,previousDepth);
-    if(candidate<=rayDepth) {
-      uv=atDepth(origin,ray,candidate);
+    float best=1e30;
+    float2 closest=uv;
+    for(uint candidateIndex=0;candidateIndex<2;++candidateIndex) {
+      if(candidateIndex==1&&depth==previousDepth) { break; }
