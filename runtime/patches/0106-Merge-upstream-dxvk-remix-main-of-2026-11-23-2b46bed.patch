+#include "rtx_visible_set_exporter.h"
+
+#include <algorithm>
+#include <cmath>
+#include <fstream>
+#include <unordered_map>
+
+#include <windows.h>
+
+#include "rtx_camera.h"
+#include "rtx_camera_manager.h"
+#include "rtx_instance_manager.h"
+#include "rtx_asset_replacer.h"
+#include "rtx_intersection_test.h"
