new file mode 100644
index 00000000..fcf5fc24
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_mod_texture_cache.cpp
@@ -0,0 +1,66 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// NV-DXVK: the mod texture cache (ADR 0195 of the GMod native loader project). See rtx_mod_texture_cache.h.
+
+#include "rtx_mod_texture_cache.h"
+
+#include "../../util/util_filesys.h"
+
+namespace dxvk {
+
+  std::filesystem::path ModTextureCache::folder() {
+    // Beside the mods folder: <game>\rtx-remix\mods comes from the game's working folder, while rootPath() is the
+    // executable's (bin\win64 in GMod).
+    std::filesystem::path mods = util::RtxFileSys::path(util::RtxFileSys::Mods).lexically_normal();
+    if (!mods.has_filename()) {
+      mods = mods.parent_path();
+    }
+    return mods.parent_path() / "cache" / "mod-textures";
+  }
+
+  ModTextureCache::ModTextureCache(const std::filesystem::path& modFile)
+    : m_store(ModTextureStore::cacheFileFor(folder(), std::filesystem::absolute(modFile).lexically_normal().parent_path())) {
+  }
+
+  Rc<AssetData> ModTextureCache::find(const std::string& resolvedPath) {
+    // The same path the partial loader would open: findAsset takes the resolved path as it is.
+    const std::filesystem::path path = std::filesystem::path(resolvedPath).lexically_normal().make_preferred();
+    if (ModTextureStore::lower(path.extension().wstring()) != L".dds") {
+      return nullptr;
+    }
+    ++m_lookups;
+    const std::wstring key = ModTextureStore::lower(path.wstring());
+    const auto known = m_found.find(key);
+    if (known != m_found.end()) {
+      ++m_repeats;
+      return known->second;
+    }
+
+    Rc<AssetData> loaded;
+    DdsAssetRecord record;
+    DdsAssetTail tail;
+    const auto loader = [&](const std::filesystem::path&, DdsAssetRecord& outRecord, DdsAssetTail& outTail) {
+      loaded = loadDdsAssetForCache(resolvedPath, ModTextureStore::kMaxTailBytes, outRecord, outTail);
+      return loaded != nullptr;
+    };
+    Rc<AssetData> asset;
+    switch (m_store.find(path, loader, record, tail)) {
+    case ModTextureStore::Result::Hit:
+      asset = restoreDdsAsset(resolvedPath, record, std::move(tail));
+      if (asset == nullptr) {
+        // A record this runtime cannot use: read the file (findAsset).
+        return nullptr;
+      }
+      break;
+    case ModTextureStore::Result::Miss:
+      asset = loaded;
+      break;
+    default:
+      return nullptr;
+    }
+    m_found.emplace(key, asset);
+    return asset;
+  }
+
+} // namespace dxvk
