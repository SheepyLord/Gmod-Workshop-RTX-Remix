 #. option rtx.atmosphere.sunDiskEnable
-#: src/dxvk/rtx_render/rtx_atmosphere.h:593
+#: src/dxvk/rtx_render/rtx_atmosphere.h:635
 msgid "Draw the sun's disc in the sky the camera sees: Sun Size across, darker at its edge, and reddened and dimmed by the air toward the horizon. Clouds cover it by their transmittance. Reflections and indirect light keep getting the sun from its light, so it never counts twice."
 msgstr "Activez ce paramètre pour dessiner le disque solaire dans le ciel vu par la caméra : son diamètre suit la « Taille du soleil », son bord est plus sombre, et l'atmosphère le rougit et l'assombrit vers l'horizon. Les nuages le couvrent selon leur transmittance. Les reflets et l'éclairage indirect continuent de recevoir la contribution solaire de sa source lumineuse, afin de ne pas compter le soleil deux fois."
 
 #. option rtx.atmosphere.sunDiskBrightness
-#: src/dxvk/rtx_render/rtx_atmosphere.h:597
+#: src/dxvk/rtx_render/rtx_atmosphere.h:639
 msgid "Scale on the sun disc's brightness [0..4]. At 1 its centre is held to 48 times the sun's illuminance: physically far brighter, already pure white on screen."
 msgstr "Ce réglage multiplie la luminosité du disque solaire [0..4]. À 1, son centre est maintenu à 48 fois l'éclairement solaire : le disque solaire est physiquement bien plus lumineux, mais son centre apparaît déjà d'un blanc pur à l'écran."
 
 #. option rtx.atmosphere.sunDiskLimbDarkening
-#: src/dxvk/rtx_render/rtx_atmosphere.h:600
+#: src/dxvk/rtx_render/rtx_atmosphere.h:642
 msgid "How much darker the sun disc's edge is than its centre [0..1]: u of I(mu) = 1 - u (1 - mu). 0.6 is the Sun's in visible light."
 msgstr "Ce réglage détermine à quel point le bord du disque solaire est plus sombre que son centre [0..1] : u dans I(mu) = 1 - u (1 - mu). 0.6 correspond au Soleil en lumière visible."
 
 #. option rtx.atmosphere.cirrusCoverage
-#: src/dxvk/rtx_render/rtx_atmosphere.h:603
+#: src/dxvk/rtx_render/rtx_atmosphere.h:645
 msgid "How much of the sky the high clouds cover [0..1]: cirrus, cirrostratus and cirrocumulus, a thin layer of ice at the high cloud height. 0 = none. The weathers set it."
 msgstr "Ce réglage définit la part du ciel couverte par les nuages élevés [0..1] : cirrus, cirrostratus et cirrocumulus, qui forment une fine couche de glace à haute altitude. 0 = aucun. Les préréglages météo la définissent."
 
 #. option rtx.atmosphere.cirrusAltitude
-#: src/dxvk/rtx_render/rtx_atmosphere.h:606
+#: src/dxvk/rtx_render/rtx_atmosphere.h:648
