-#: src/dxvk/rtx_render/rtx_atmosphere.h:606
+#: src/dxvk/rtx_render/rtx_atmosphere.h:648
 msgid "Height of the high cloud layer in km [2..20]. Cirrus forms at about 6 to 12 km."
 msgstr "上層雲の高度 (km) [2..20] です。巻雲は約 6~12 km にできます。"
 
 #. option rtx.atmosphere.cirrusFibrous
-#: src/dxvk/rtx_render/rtx_atmosphere.h:608
