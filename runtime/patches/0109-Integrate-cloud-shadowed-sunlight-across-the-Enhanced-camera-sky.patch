--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/numos/numos_sun_rays.comp.slang
@@ -0,0 +1,119 @@
+#include "rtx/pass/numos/numos_ray_args.h"
+#include "rtx/pass/raytrace_args.h"
+#include "rtx/concept/camera/camera.slangh"
+#include "numos/lib/aerial_perspective.slangh"
+
+layout(binding = NUMOS_RAYS_FRAME) ConstantBuffer<RaytraceArgs> frame;
+layout(binding = NUMOS_RAYS_SKY) ConstantBuffer<enhanced_AtmosphereArgs> sky;
+layout(binding = NUMOS_RAYS_CONTROLS) ConstantBuffer<NumosRayArgs> controls;
+layout(binding = NUMOS_RAYS_DEPTH) Texture2D<float> linearZ;
+layout(binding = NUMOS_RAYS_SUN_LUT) Texture2D<float4> sunLut;
+layout(binding = NUMOS_RAYS_SHADOW) Texture3D<float2> shadowMap;
+layout(binding = NUMOS_RAYS_SAMPLER) SamplerState clampSampler;
+layout(binding = NUMOS_RAYS_PREVIOUS) Texture2D<float4> previous;
+layout(rgba16f, binding = NUMOS_RAYS_OUTPUT) RWTexture2D<float4> result;
+
+bool hasSky(uint2 first, uint2 last) {
+  if (linearZ.Load(int3((first + last - 1u) / 2u, 0)) == frame.primaryDirectMissLinearViewZ) return true;
+  for (uint y = first.y; y < last.y; ++y)
+    for (uint x = first.x; x < last.x; ++x)
+      if (linearZ.Load(int3(x, y, 0)) == frame.primaryDirectMissLinearViewZ) return true;
+  return false;
+}
+
+float endOfSpan(float3 dir) {
+  // Clip in air kilometres, then in cloud kilometres. The two world scales are independently editable.
+  float lo, hi;
+  float3 airCenter = enhanced_getAirPlanetCenter(sky);
+  if (!enhanced_intersectSphere(0.xxx, dir, airCenter, sky.planetRadius + sky.atmosphereThickness, lo, hi)) return 0.f;
+  float end = numosAirKmToWorld(min(hi, controls.rangeKm), sky);
+  if (dir.y < 0.f && enhanced_intersectSphere(0.xxx, dir, airCenter, sky.planetRadius, lo, hi) && lo >= 0.f)
+    end = min(end, numosAirKmToWorld(lo, sky));
+  float top = sky.cloudShadowLive && sky.cloudEnabled > .5f && sky.cloudCoverageMean >= .01f
+    ? sky.cloudAltitude + sky.cloudThickness : 0.f;
+  if (sky.cloudCirrusShadowLive) top = max(top, sky.cloudCirrusAltitude);
+  if (!enhanced_intersectSphere(0.xxx, dir, enhanced_getCloudPlanetCenter(sky), sky.planetRadius + top, lo, hi)) return 0.f;
+  return min(end, numosKmToWorld(max(hi, 0.f), sky));
+}
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (any(id.xy >= uint2(controls.width, controls.height))) return;
+  uint2 first = id.xy * controls.divisor;
+  uint2 last = min(first + controls.divisor, frame.camera.resolution);
+  if (!hasSky(first, last)) {
+    result[id.xy] = float4(0, 0, 0, -1);
+    return;
+  }
+  float2 uv = (float2(first + last) * 0.5f) / float2(frame.camera.resolution);
+  CameraDirections ray = cameraScreenUVToDirection(frame.camera, uv, true);
+  bool zUp = sky.isZUp != 0u, flip = sky.flipUpAxis != 0u;
+  float3 dir = normalize(enhanced_worldToAtmosphereYUp(ray.worldDirection, zUp, flip));
+  float start = controls.nearHaze ? max(sky.apStartDistance, sky.apFroxelRange / max(abs(ray.viewDirection.z), 1e-5f)) : 0.f;
+  float end = endOfSpan(dir);
+  if (end <= start) {
+    result[id.xy] = 0.xxxx;
+    return;
+  }
+  float3 viewT = controls.nearHaze ? enhanced_apNearTransmittance(dir, start, sky) : 1.xxx;
+  float3 sunDir = normalize(sky.sunDirection);
+  enhanced_ApPhase phase = enhanced_apPhase(dot(dir, sunDir), sky);
+  float fogReference = enhanced_apCloudShadowMean(sky);
+  float3 clear = 0.xxx, loss = 0.xxx;
+  float shadedLength = 0.f, moment = 0.f, mass = 0.f;
+  // Cranley-Patterson rotation of a per-texel offset over stratified, near-biased intervals.
+  float jitter = frac(52.9829189f * frac(dot(float2(id.xy), float2(.06711056f, .00583715f))) +
+                      float(controls.frame & 4095u) * .618033989f);
+  float a = start;
+  for (uint i = 0u; i < controls.steps; ++i) {
+    float q = float(i + 1u) / float(controls.steps);
+    float b = lerp(start, end, q*q);
+    float distance = lerp(a, b, jitter);
+    float3 world = sky.cameraPosition + ray.worldDirection * distance;
+    enhanced_ApMediumSample m = enhanced_apSampleMedium(world, sky);
+    float3 sun = enhanced_evalSunShadowingClampedToSurface(numosAirToSkyFrame(m.hazePosition, sky),
+                                                           sunDir, sunLut, clampSampler, sky);
+    // The library lookup includes its wind-aligned cascades and the cirrus optical depth.
+    float visibility = enhanced_sampleCloudGroundShadowFromMap(world, sunDir, sky, zUp, shadowMap, clampSampler);
+    float3 scattering = m.atmosphere.rayleighScattering * phase.rayleigh + m.atmosphere.mieScattering * phase.mie;
+    float fog = controls.nearHaze ? m.fogScattering * phase.fog : 0.f;
+    float3 extinction = m.atmosphere.extinction + (controls.nearHaze ? m.fogExtinction : 0.f);
+    float ds = numosWorldToAirKm(b - a, sky);
+    float3 tau = extinction * ds, t = exp(-tau);
+    float3 weight = viewT * ds * select(tau > .001f, (1.f - t) / max(tau, 1e-7f), 1.f - .5f*tau);
+    float3 lit = weight * sun;
+    clear += lit * (scattering + fog);
+    // Far fog already uses the mean deck shadow. Only remove the direct light it still carries.
+    float3 missing = lit * (scattering * (1.f - visibility) + fog * max(fogReference - visibility, 0.f));
+    loss += missing;
+    float w = dot(missing, float3(.2126f, .7152f, .0722f));
+    mass += w;
+    moment += w * numosWorldToKm(distance, sky);
+    shadedLength += (1.f - visibility) * (b - a);
+    viewT *= t;
+    a = b;
+  }
+  float anchorKm = mass > 1e-9f ? moment / mass : numosWorldToKm(.5f * (start + end), sky);
+  float3 value = loss;
+  if (controls.debugView == 2u) value = clear;
+  if (controls.debugView == 3u) value = (shadedLength / (end - start)).xxx;
+  if (controls.debugView == 4u) value = float3(log2(1.f + numosWorldToAirKm(start, sky)),
+    log2(1.f + numosWorldToAirKm(end, sky)), 0.f) / log2(1.f + controls.rangeKm);
+  if (controls.historyValid && controls.debugView != 4u) {
+    float3 wind = enhanced_atmosphereYUpToWorld(float3(sky.cloudWindStepXKm, 0.f, sky.cloudWindStepZKm), zUp, flip);
+    float3 lastPoint = sky.cameraPosition + ray.worldDirection * numosKmToWorld(anchorKm, sky) - wind * sky.worldUnitsPerKm;
+    float4 clip = mul(frame.camera.prevWorldToProjectionJittered, float4(lastPoint, 1.f));
+    float2 prevUv = cameraNDCToScreenUV(frame.camera, clip.xy / max(clip.w, 1e-7f));
+    if (clip.w > 0.f && all(prevUv >= 0.f) && all(prevUv < 1.f)) {
+      int2 prevPixel = min(int2(prevUv * float2(frame.camera.resolution) / controls.divisor), int2(controls.width, controls.height) - 1);
+      float4 old = previous.Load(int3(prevPixel, 0));
+      if (old.a >= 0.f) {
+        float agree = saturate(1.f - abs(old.a - anchorKm) / max(1.f, .4f * anchorKm));
+        float3 limit = max(.35f * value, 1e-5f);
+        value = lerp(value, clamp(old.rgb, max(0.xxx, value - limit), value + limit), controls.historyWeight * agree);
+      }
+    }
+  }
+  result[id.xy] = float4(value, min(anchorKm, 65000.f));
+}
