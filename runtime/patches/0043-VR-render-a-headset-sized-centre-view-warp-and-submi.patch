+  bool RtxVr::projection(Matrix4& matrix,float& fov,float& aspect) {
+    std::lock_guard lock(m_requestMutex);
+    if (!m_active) { return false; }
+    matrix[0][0]=float(1/m_projection.tanX); matrix[1][1]=float(1/m_projection.tanY);
+    matrix[2][0]=0; matrix[2][1]=0;
+    fov=float(2*std::atan(m_projection.tanY)); aspect=float(m_projection.tanX/m_projection.tanY);
+    return true;
+  }
