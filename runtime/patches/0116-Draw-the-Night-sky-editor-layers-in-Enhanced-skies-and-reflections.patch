+       | (m_starMapNebula.view != nullptr ? kNumosNightNebula : 0u);
+}
+
+float RtxAtmosphere::solarDiscCoverage(const Vector3& sun, float sunRadius, const Vector3& moon, float moonRadius) {
+  const float area = discOverlapArea(sunRadius, moonRadius, angleBetween(sun, moon));
+  return std::clamp(area / (dxvk::kPi * sunRadius * sunRadius), 0.f, 1.f);
+}
+
+void RtxAtmosphere::bindNightImage(RtxContext& ctx, uint32_t stars, uint32_t galaxy, uint32_t nebula,
+                                   uint32_t constellations, uint32_t sampler) const {
+  ctx.bindResourceView(stars, m_starMap.view != nullptr ? m_starMap.view : m_skyTextureStandInView, nullptr);
+  ctx.bindResourceView(galaxy, m_starMapGalaxy.view != nullptr ? m_starMapGalaxy.view : m_skyTextureStandInView, nullptr);
+  ctx.bindResourceView(nebula, m_starMapNebula.view != nullptr ? m_starMapNebula.view : m_skyTextureStandInView, nullptr);
+  ctx.bindResourceView(constellations, m_starMapConstellations.view != nullptr ? m_starMapConstellations.view : m_skyTextureStandInView, nullptr);
+  ctx.bindResourceSampler(sampler, ctx.getResourceManager().getSampler(VK_FILTER_LINEAR, VK_SAMPLER_MIPMAP_MODE_NEAREST,
+    VK_SAMPLER_ADDRESS_MODE_REPEAT, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE));
