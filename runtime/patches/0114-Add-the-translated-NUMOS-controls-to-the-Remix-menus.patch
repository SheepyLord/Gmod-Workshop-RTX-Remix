+#: src/dxvk/rtx_render/rtx_atmosphere.h:259
 msgid "Strength of Sun."
 msgstr "Сила солнца."
 
 #. option rtx.atmosphere.sunElevation
-#: src/dxvk/rtx_render/rtx_atmosphere.h:259
+#: src/dxvk/rtx_render/rtx_atmosphere.h:260
 msgid "Sun elevation in degrees. Game-drivable per-frame; persists when saved unless overridden by a runtime push."
 msgstr "Высота солнца в градусах. Игра может задавать её каждый кадр; при сохранении значение записывается в конфигурацию, если его не переопределила передача во время работы."
 
