+LUA_FUNCTION(ToPBR_AllowScopeMaterials) {
+    LUA->CheckType(1, GarrysMod::Lua::Type::Table);
+    std::vector<std::string> names;
+    const size_t count = (std::min)(static_cast<size_t>(LUA->ObjLen(1)), MaterialPipeline::ToPBR::Scope::MaxNames);
+    names.reserve(count);
+    for (size_t i = 1; i <= count; ++i) {
+        LUA->PushNumber(static_cast<double>(i));
+        LUA->GetTable(1);
+        if (LUA->IsType(-1, GarrysMod::Lua::Type::String)) {
+            unsigned int length = 0;
+            const char* name = LUA->GetString(-1, &length);
+            if (name && length > 0 && length <= MaterialPipeline::ToPBR::Scope::MaxNameLength) names.emplace_back(name, length);
