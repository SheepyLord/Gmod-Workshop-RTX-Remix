+
+static size_t GetPackedSize(usdg::Type type, size_t count) {
+  const size_t typeSize = usdg::GetTypeSize(type);
+  const size_t size = typeSize * count;
+
+  if (typeSize == 1) {
+    // Align size to pack byte-sized types into dwords
+    return (size + 3) & ~3;
+  }
+
+  return size;
+}
