+static void checkSolarEclipse() {
+  numos::Renderer renderer;
+  numos::Settings sky;
+  sky.timeCycleEnable = false;
+  sky.realMoonEnabled = false;
+  for (auto& moon : sky.moons) moon.enabled = false;
+  sky.sunElevation = 40.f;
+  sky.sunRotation = 0.f;
+  sky.sunSize = 1.f;
+  auto& moon = sky.moons[0];
+  moon.enabled = true;
+  moon.elevation = 40.f;
+  moon.rotation = 0.f;
+  moon.angularDiameter = 1.6f;
+  moon.color = numos::Vector3(0.f); // a dark game moon still occults the Sun
+  auto sample = [&](float floor = 0.f, bool enabled = true) {
+    auto frame = sky;
+    const auto e = dxvk::applyNumosSolarEclipse(frame, renderer, 0.f, enabled, floor);
+    check(frame.sunIntensity == sky.sunIntensity * e.daylight && e.fullSun == sky.sunIlluminance * sky.sunIntensity,
+          "Scale incident sunlight and retain the full source for visible discs");
+    return e;
+  };
+  check(sample(.0006f).daylight == .0006f && sample().daylight == 0.f && sample().coverage == 1.f, "Totality floor");
+  check(sample(0.f, false).daylight == 1.f && sample(1.f).daylight == 1.f, "Disabled eclipse and full daylight floor");
+  moon.angularDiameter = .5f;
+  const auto annular = sample();
+  const double innerFlux = .5 * (1.25 - std::pow(.75, 1.5));
+  check(std::abs(annular.coverage - .25f) < 1e-5f && std::abs(annular.daylight - (1. - innerFlux)) < 1e-5,
+        "An annular eclipse removes more light than area from the bright centre");
+  moon.angularDiameter = sky.sunSize;
+  float previous = 0.f;
+  for (int step = 0; step <= 100; ++step) {
+    moon.elevation = sky.sunElevation + .01f * step;
+    const auto e = sample();
+    check(e.daylight >= previous && e.daylight - previous < .025f, "Continuous partial eclipse and egress");
+    previous = e.daylight;
+  }
+  moon.elevation = 45.f;
+  check(sample().daylight == 1.f && sample().coverage == 0.f, "Clear of contact");
+  moon.elevation = 40.2f;
+  moon.angularDiameter = .15f;
+  const auto single = sample();
+  sky.moons[1] = moon;
+  check(std::abs(sample().daylight - single.daylight) < 1e-6f, "Coincident moons cast one shadow");
+  sky.moons[1].elevation = 39.8f;
+  check(std::abs(sample().daylight - (2.f * single.daylight - 1.f)) < 1e-4f, "Disjoint silhouettes add");
+  sky.moons[1].enabled = false;
+  moon.angularDiameter = 2.f;
+  moon.elevation = sky.sunElevation = -.25f;
+  check(std::abs(sample().daylight - .5f) < 1e-4f, "Eclipse fades through the setting solar limb");
+  moon.elevation = sky.sunElevation = -2.f;
+  check(sample().daylight == 1.f, "An eclipse below the horizon leaves the night alone");
+
+  // Independent 601x601 integration of the real renderer's exported discs at this
