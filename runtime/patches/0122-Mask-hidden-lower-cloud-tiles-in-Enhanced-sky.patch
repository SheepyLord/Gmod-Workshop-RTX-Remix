diff --git a/scripts-common/numos_lower_shaders.py b/scripts-common/numos_lower_shaders.py
new file mode 100644
index 0000000000000000000000000000000000000000..25a9a5acce902bd04365b71bdc3ea1d2a5edd85f
--- /dev/null
+++ b/scripts-common/numos_lower_shaders.py
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: MIT
+"""Embed the host-masked lower cloud variants using the pinned NUMOS compiler recipe."""
+
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+
+def main(numos, compiler, wrapper, output, stock):
+    sys.path.insert(0, str(numos / 'tools'))
+    from build_shaders import FLAGS, variants
+    from gen_pass_table import reflect
+
+    source = numos / 'shaders' / 'numos' / 'passes'
+    binaries = output.parent / 'numos_lower_spirv'
+    binaries.mkdir(exist_ok=True)
+    jobs = []
+    # Insert the test at the entry, before any lane reaches a NUMOS workgroup barrier. The pinned
+    # compiler cannot call a [shader("compute")] entry from another compute entry.
+    entries = [
+        ('cloud_render', [], '(dispatchId - groupThreadId) / 8u, groupThreadId, dispatchId'),
+        ('cloud_denoise', ['LOWER_DENOISE'], 'groupId, groupThread, groupId * 8u + groupThread'),
+        ('cloud_cirrus_composite', ['LOWER_CIRRUS'], 'uint3(pixel / 8u, 0), uint3(pixel % 8u, 0), uint3(pixel, 0)'),
+    ]
+    for stem, mode, arguments in entries:
+        original = source / (stem + '.comp.slang')
+        code = original.read_text(encoding='utf-8')
+        entry = r'(\[shader\("compute"\)\]\s*\[numthreads\([^)]*\)\]\s*void main\([^)]*\)\s*\{)'
+        include = '#include "numos_lower/' + wrapper.name + '"\n'
+        code, count = re.subn(entry, lambda m: include + m.group(0) + '\n  if (skipLowerCloudGroup(' +
+                              arguments + ')) return;\n', code)
+        if count != 1:
+            raise ValueError(f'Expected one compute entry in {original.name}, found {count}')
+        wrapped = binaries / original.name
+        wrapped.write_text(code, encoding='utf-8', newline='\n')
+        for name, defines in variants(original):
+            jobs.append((name.split('.')[0], mode + defines, wrapped))
+
+    def compile_variant(job):
+        name, defines, wrapped = job
+        spv = binaries / (name + '.spv')
+        subprocess.run([str(compiler), str(wrapped), '-I', str(numos / 'shaders'),
+                        '-I', str(wrapper.parent.parent), *FLAGS, *('-D' + d for d in defines),
+                        '-o', str(spv)], check=True)
+        # NumosGpu binds the original pass descriptors, plus the tile map. Check the binary ABI
+        # rather than assuming a future library or compiler keeps the same live resources.
+        local, push, bindings = reflect(stock / (name + '.comp.spv'))
+        actual_local, actual_push, actual_bindings = reflect(spv)
+        expected = {b[:5] for b in bindings}
+        mask = (32, 0, 'SampledTexture', 'Tex2D', 33)  # R32ui, NUMOS_LOWER_TILE_INPUT
+        if (any(b[0] == mask[0] for b in bindings) or actual_local != local or actual_push != push
+                or {b[:5] for b in actual_bindings} != expected | {mask}):
+            raise ValueError(f'{name}: lower cloud shader differs from the pinned pass layout')
+        return name, spv.read_bytes()
+
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        variants_built = list(pool.map(compile_variant, jobs))
+    with output.open('w', encoding='ascii', newline='\n') as header:
+        header.write('// Generated from the pinned NUMOS variants.\n')
+        header.write('struct LowerCloudCode { const uint32_t* data; size_t words; };\n')
+        header.write('static LowerCloudCode lowerCloudCode(numos::PassId pass) {\n  switch (pass) {\n')
+        for name, binary in variants_built:
+            header.write('  case numos::PassId::' + name + ': {\n    static const uint32_t data[] = {\n')
+            words = [f'0x{n:08x}' for (n,) in struct.iter_unpack('<I', binary)]
+            for i in range(0, len(words), 12):
+                header.write('      ' + ','.join(words[i:i+12]) + ',\n')
+            header.write('    };\n    return { data, sizeof(data) / sizeof(*data) };\n  }\n')
+        header.write('  default: return {};\n  }\n}\n')
+
+
+if __name__ == '__main__':
+    main(*(Path(arg).resolve() for arg in sys.argv[1:]))
