@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: MIT
+//
+// The night sky editor (fork — the GMod native loader's ADR 0227). The night sky image is four layers
+// that the sky shader adds as Skyrim adds its sky layers, colour times alpha in gamma space, then
+// decodes (pow 2.2) and scales by rtx.atmosphere.starMapBrightness: the stars, the constellations'
+// bright stars, the galaxy band (the Milky Way) and the nebulae. Each layer now has a brightness and a
+// colour of its own, and the shooting stars a rate and a brightness. This is what the shader gets
+// from those options.
+//
+// Self-contained (no runtime headers), so tests/rtx/unit/test_night_sky_layers.cpp and the GMod
+// native loader's gate compile it alone.
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <string>
+
+namespace dxvk {
+namespace nightsky {
+  // The options' ranges: brightness as a multiple of the image's, colour from grey (0) through the
+  // image's (1) to twice as strong (2), shooting stars a minute.
+  constexpr float kMaxBrightness = 8.0f;
+  constexpr float kMaxSaturation = 2.0f;
+  constexpr float kMaxShootingStarsPerMinute = 15.0f;
+  // The sky shader draws at most one shooting star in each slot of this many seconds.
+  constexpr float kShootingStarSlotSeconds = 4.0f;
+
+  // The gamma-space weight of a layer of `brightness`: the shader adds the layers before it decodes
+  // them, so a layer alone at weight w comes out w^2.2 as bright. brightness^(1/2.2) makes it scale by
+  // `brightness` in linear light; at 1 the image is as it was. Not a number counts as 0.
+  inline float layerWeight(float brightness) {
+    if (!(brightness > 0.0f)) {
+      return 0.0f;
+    }
+    return std::pow(std::min(brightness, kMaxBrightness), 1.0f / 2.2f);
+  }
+
+  inline float layerSaturation(float saturation) {
+    if (!(saturation > 0.0f)) {
+      return 0.0f;
+    }
+    return std::min(saturation, kMaxSaturation);
+  }
+
+  // The gamma-space sum is held at 1, as Skyrim's 8-bit target holds it, so where layers overlap the
+  // image saturates at its white instead of adding up. A layer brightened past 1 raises that limit to
+  // its weight, so it can still reach its own brightness at the image's white.
+  inline float layerCeiling(float starWeight, float constellationWeight, float galaxyWeight, float nebulaWeight) {
+    return std::max({ 1.0f, starWeight, constellationWeight, galaxyWeight, nebulaWeight });
+  }
+
+  // The chance that one slot holds a shooting star, for an average of `perMinute`: 1.2 a minute (the
+  // sky's long-standing 8 % of slots) gives 0.08; 15 a minute fills every slot.
+  inline float shootingStarChance(float perMinute) {
+    if (!(perMinute > 0.0f)) {
+      return 0.0f;
+    }
+    return std::min(perMinute, kMaxShootingStarsPerMinute) * (kShootingStarSlotSeconds / 60.0f);
+  }
+
+  // The constellations' layer of a nebula texture: the file beside it with "_constellations" before
+  // the extension ("atmosphere/nebula.dds" -> "atmosphere/nebula_constellations.dds"). It shares the
+  // nebula's mapping and size, and comes from the same path option, so Lua can no more choose it than
+  // the nebula's (the RTX fixes refuse texture paths from Lua). "" stays "".
+  inline std::string constellationTexturePath(const std::string& nebulaPath) {
+    if (nebulaPath.empty()) {
+      return std::string();
+    }
+    std::string stem = nebulaPath;
+    if (stem.size() > 4) {
+      std::string extension = stem.substr(stem.size() - 4);
+      std::transform(extension.begin(), extension.end(), extension.begin(),
+                     [](unsigned char c) { return char(std::tolower(c)); });
+      if (extension == ".dds") {
+        stem.resize(stem.size() - 4);
+      }
+    }
+    return stem + "_constellations.dds";
+  }
+} // namespace nightsky
+} // namespace dxvk
