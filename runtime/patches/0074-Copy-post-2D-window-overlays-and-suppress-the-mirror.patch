+  void RtxVr::prepareWindowFrame(DxvkContext& ctx,const Rc<DxvkImage>& game) {
+    if(!windowWithoutMirror()) { return; }
+    applyOverlayRequests(ctx);
+    clearWindow(ctx,game);
+  }
