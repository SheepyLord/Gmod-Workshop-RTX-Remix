diff --git a/bridge/src/client/d3d9_query_result.h b/bridge/src/client/d3d9_query_result.h
new file mode 100644
index 000000000..cad984523
--- /dev/null
+++ b/bridge/src/client/d3d9_query_result.h
@@ -0,0 +1,116 @@
+/*
