diff --git a/tests/rtx/unit/test_repeated_mesh_blas.cpp b/tests/rtx/unit/test_repeated_mesh_blas.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9e3f96978bda19eecf46b148c638f2084573f9d4
--- /dev/null
+++ b/tests/rtx/unit/test_repeated_mesh_blas.cpp
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: MIT
+#include "../../../src/dxvk/rtx_render/rtx_repeated_mesh_blas.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <initializer_list>
+
+using dxvk::RepeatedMeshBuilds;
+using dxvk::RepeatedMeshCopies;
+
+static void check(bool ok, const char* what) {
+  if (!ok) {
+    std::fprintf(stderr, "%s\n", what);
+    std::exit(1);
+  }
+}
+
+static RepeatedMeshCopies copies(uint32_t count) {
+  RepeatedMeshCopies group;
+  for (uint32_t i = 0; i < count; ++i)
+    group.add(2, true);
+  return group;
+}
+
+int main() {
+  const auto props = copies(82);
+  RepeatedMeshBuilds mesh;
+  for (int pass = 0; pass < 100; ++pass)
+    mesh.recordBuild(10, 573, 82, 1000);
+  check(!mesh.considered(11), "stereo and secondary views count as one rebuilt frame");
+  mesh.recordBuild(12, 573, 82, 1000);
+  mesh.recordBuild(13, 573, 82, 1000);
+  check(!mesh.considered(14), "a clean frame breaks the rebuild streak");
+  mesh.recordBuild(14, 573, 82, 1000);
+  mesh.select(15, 573, 1000, props, true);
+  check(mesh.shared(), "the hot Modern House mesh shares a BLAS");
+  mesh.select(900, 573, 1000, copies(9), true);
+  check(mesh.shared(), "a shared mesh uses a lower retention threshold");
+  mesh.select(901, 573, 1000, copies(7), true);
+  check(!mesh.shared() && !mesh.considered(901), "a dispersed group releases and must requalify");
+
+  for (uint32_t f = 20; f < 30; ++f)
+    mesh.recordBuild(f, 573, 1, 1000);
+  check(!mesh.considered(30), "one rebuilt copy cannot take 81 clean copies out of a cached bucket");
+  check(!RepeatedMeshBuilds::enoughCopies(46, 10000, 1000), "keep the tiny geometry floor");
+  check(!RepeatedMeshBuilds::enoughCopies(573, 2, 1000), "protect small groups");
+  check(!RepeatedMeshBuilds::enoughCopies(1000, 82, 1000), "the existing large mesh policy owns the cutoff");
+  check(!RepeatedMeshBuilds::enoughCopies(573, 14, 1000) && RepeatedMeshBuilds::enoughCopies(573, 15, 1000),
+        "only duplicate triangle work counts");
+  check(!RepeatedMeshBuilds::enoughCopies(0, UINT64_MAX, UINT32_MAX) &&
+         RepeatedMeshBuilds::enoughCopies(UINT32_MAX - 1, UINT64_MAX, UINT32_MAX), "arithmetic bounds");
+
+  for (uint32_t f : {UINT32_MAX - 1, UINT32_MAX, 0u})
+    mesh.recordBuild(f, 573, 82, 1000);
+  check(mesh.considered(1) && !mesh.considered(2), "frame counter wrap and stale observations");
+  auto differentFlags = props;
+  differentFlags.add(3, true);
+  mesh.select(1, 573, 1000, differentFlags, true);
+  check(!mesh.shared(), "all copies must agree on the Vulkan geometry flags");
+  auto ineligible = props;
+  ineligible.add(2, false);
+  mesh.select(1, 573, 1000, ineligible, true);
+  check(!mesh.shared(), "one incompatible copy vetoes the whole geometry");
+  RepeatedMeshCopies sameOmm;
+  for (int i = 0; i < 82; ++i)
+    sameOmm.add(2, true, 0x1234, 1);
+  auto mixedOmm = sameOmm;
+  mixedOmm.add(2, true, 0x1235, 1);
+  mesh.select(1, 573, 1000, mixedOmm, true);
+  check(!mesh.shared(), "different opacity requests cannot share one geometry binding");
+  mixedOmm = sameOmm;
+  mixedOmm.add(2, true, 0x1234, 0);
+  mesh.select(1, 573, 1000, mixedOmm, true);
+  check(!mesh.shared(), "different micromap formats cannot share");
+  mixedOmm = sameOmm;
+  mixedOmm.add(2, true);
+  mesh.select(1, 573, 1000, mixedOmm, true);
+  check(!mesh.shared(), "an unbound instance cannot inherit another instance's opacity micromap");
+  auto exact = mesh;
+  exact.select(1, 573, 1000, sameOmm, true);
+  check(exact.shared(), "matching full-geometry requests retain their shared micromap");
+  exact.select(2, 573, 1000, mixedOmm, true);
+  check(!exact.shared() && !exact.considered(2), "a changed binding ends an existing shared group");
+  mesh.select(1, 573, 1000, props, false);
+  check(!mesh.shared(), "deformed or freshly updated vertices stay on the normal path");
+  mesh.select(1, 573, 1000, {}, true);
+  check(!mesh.shared(), "zero visible copies do no work");
+  int firstBlas, secondBlas, firstOmm, secondOmm;
+  dxvk::RepeatedMeshInputs inputs {};
+  inputs.positions = 10;
+  inputs.indices = 20;
+  inputs.vertexRevision = 9;
+  inputs.bones = 30;
+  inputs.micromapSource = 42;
+  inputs.micromapObject = &firstOmm;
+  inputs.triangles.pNext = &firstOmm;
+  inputs.triangles.vertexData.deviceAddress = 100;
+  inputs.triangles.indexData.deviceAddress = 200;
+  inputs.range.primitiveCount = 573;
+  dxvk::RepeatedMeshBuildRecord record { &firstBlas, inputs };
+  check(record.matches(&firstBlas, inputs), "identical object-space inputs can retain the built structure");
+  check(!record.matches(&secondBlas, inputs) && !record.matches(nullptr, inputs), "a different or retired BLAS cannot be reused");
+  auto changed = inputs;
+  ++changed.vertexRevision;
+  check(!record.matches(&firstBlas, changed), "a newer vertex revision cannot hit at the same address");
+  changed = inputs; ++changed.positions;
+  check(!record.matches(&firstBlas, changed), "position content can change at the same address");
+  changed = inputs; ++changed.indices;
+  check(!record.matches(&firstBlas, changed), "changed index topology");
+  changed = inputs; ++changed.bones;
+  check(!record.matches(&firstBlas, changed), "changed bone data");
+  changed = inputs; changed.micromapObject = &secondOmm;
+  check(!record.matches(&firstBlas, changed), "recreated micromap with the same source hash");
+  changed = inputs; ++changed.micromapSource;
+  check(!record.matches(&firstBlas, changed), "changed micromap source");
+  changed = inputs; changed.triangles.pNext = nullptr;
+  check(!record.matches(&firstBlas, changed), "removed geometry attachment");
+  changed = inputs; ++changed.triangles.vertexData.deviceAddress;
+  check(!record.matches(&firstBlas, changed), "renamed vertex buffer");
+  changed = inputs; ++changed.triangles.indexData.deviceAddress;
+  check(!record.matches(&firstBlas, changed), "renamed index buffer");
+  changed = inputs; ++changed.triangles.vertexStride;
+  check(!record.matches(&firstBlas, changed), "changed layout");
+  changed = inputs; ++changed.range.firstVertex;
+  check(!record.matches(&firstBlas, changed), "changed build range");
+  changed = inputs; ++changed.range.primitiveCount;
+  check(!record.matches(&firstBlas, changed), "changed primitive count");
+  changed = inputs; ++changed.buildFlags;
+  check(!record.matches(&firstBlas, changed), "changed build policy");
+  changed = inputs; ++changed.geometryFlags;
+  check(!record.matches(&firstBlas, changed), "changed opacity flags");
+  changed = inputs; ++changed.vertexShader;
+  check(!record.matches(&firstBlas, changed), "changed vertex shader");
+  auto missing = inputs; missing.positions = 0;
+  dxvk::RepeatedMeshBuildRecord unavailable { &firstBlas, missing };
+  check(!unavailable.matches(&firstBlas, missing), "unavailable position hashes are not proof of equality");
+  missing = inputs; missing.indices = 0;
+  unavailable.inputs = missing;
+  check(!unavailable.matches(&firstBlas, missing), "indexed geometry requires an index hash");
+  missing.triangles.indexType = VK_INDEX_TYPE_NONE_KHR;
+  unavailable.inputs = missing;
+  check(unavailable.matches(&firstBlas, missing), "non-indexed geometry has no index hash to compare");
+  record.owner = nullptr;
+  check(!record.matches(&firstBlas, inputs), "demotion clears the proof of identity");
+  return 0;
+}
