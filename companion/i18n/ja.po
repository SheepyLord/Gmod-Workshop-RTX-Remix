#: nativeloader/lua/nativeloader/menu/loading_status.lua:29
msgid "Workshop: updating add-ons"
msgstr "Workshop: アドオンを更新中"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:30
#, c-format
msgid "Workshop: fetching subscriptions (%s of %s)"
msgstr "Workshop: サブスクリプションを取得中 (%s / %s)"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:31
#, c-format
