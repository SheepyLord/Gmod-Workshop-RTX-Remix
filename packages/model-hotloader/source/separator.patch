+    progress("Reading the piece",.05f);
+    const auto& vertices=request.at("vertices");const auto& indices=request.at("indices");
+    const auto& triangleMaterials=request.at("triangle_materials");const auto& materials=request.at("materials");
+    if(!vertices.is_array()||!indices.is_array()||!triangleMaterials.is_array()||!materials.is_array())throw std::runtime_error("Invalid piece");
+    if(vertices.empty()||vertices.size()%8)throw std::runtime_error("Invalid piece vertices");
+    if(indices.empty()||indices.size()%3)throw std::runtime_error("Invalid piece triangles");
+    const size_t vertexCount=vertices.size()/8,triangleCount=indices.size()/3;
+    if(triangleMaterials.size()!=triangleCount)throw std::runtime_error("Every triangle of the piece needs a material");
+    if(materials.empty()||materials.size()>limits.materials)throw std::runtime_error("Invalid number of materials in the piece");
+    checkGeometryStorage(vertexCount,indices.size(),limits);
+    // Triangles grouped by material, in material order; only the vertices they use are kept.
+    std::vector<std::vector<uint32_t>> byMaterial(materials.size());
+    for(size_t t=0;t<triangleCount;t++){
+        auto m=whole(triangleMaterials[t],materials.size(),"triangle material");
+        std::array<uint32_t,3> tri{};for(int k=0;k<3;k++)tri[k]=uint32_t(whole(indices[t*3+k],vertexCount,"vertex index"));
+        if(tri[0]==tri[1]||tri[1]==tri[2]||tri[0]==tri[2])continue;
+        byMaterial[m].insert(byMaterial[m].end(),tri.begin(),tri.end());
+    }
+    Asset a;std::vector<uint32_t> remap(vertexCount,UINT32_MAX);
+    auto vertexAt=[&](uint32_t i){
+        if(remap[i]!=UINT32_MAX)return remap[i];
+        Vertex v;const size_t o=size_t(i)*8;
+        v.pos={number(vertices[o],"position"),number(vertices[o+1],"position"),number(vertices[o+2],"position")};
+        v.normal={number(vertices[o+3],"normal"),number(vertices[o+4],"normal"),number(vertices[o+5],"normal")};
+        v.u=number(vertices[o+6],"texture coordinate");v.v=number(vertices[o+7],"texture coordinate");
+        remap[i]=uint32_t(a.vertices.size());a.vertices.push_back(v);return remap[i];
+    };
+    Json outMaterials=Json::array(),parts=Json::array();std::map<std::string,std::string> stored;
+    for(size_t m=0;m<materials.size();m++){
+        if(byMaterial[m].empty())continue;
+        progress("Collecting materials",.1f+.2f*float(m)/float(materials.size()),{},m,materials.size());
+        const size_t slot=outMaterials.size();Json out=material(materials[m],slot);
+        auto hash=materials[m].value("base_texture",std::string());
+        if(!hash.empty()){
+            if(!validHash(hash))throw std::runtime_error("Invalid texture reference in the piece");
+            auto found=stored.find(hash);
+            if(found==stored.end()){
+                std::string kept;
+                // The character cache keeps each texture as <SHA-256 of the PNG>.png: embedding it unchanged keeps its key.
+                try{auto t=makeTexture(readFile(characterTextures/(wide(hash)+L".png"),MaxTextureFileBytes),limits.textureDimension);kept=t.hash;addTexture(a,std::move(t),out.value("name",std::string()));}
+                catch(const std::exception& e){warn(a,"Texture of "+out.value("name",std::string("a material"))+": "+e.what());}
+                found=stored.emplace(hash,kept).first;
+            }
+            out["base_texture"]=found->second;
+        }
+        outMaterials.push_back(out);
+        uint32_t first=uint32_t(a.indices.size());for(auto i:byMaterial[m])a.indices.push_back(vertexAt(i));
+        uint32_t count=uint32_t(a.indices.size())-first;
+        while(count){uint32_t n=std::min(count,60000u);parts.push_back({{"material",slot},{"first",first},{"count",n}});first+=n;count-=n;}
+    }
+    if(a.indices.empty())throw std::runtime_error("The piece has no triangles");
+    Json warnings=a.manifest.contains("warnings")?a.manifest["warnings"]:Json::array();
+    auto name=request.value("name",std::string("Piece"));
+    a.manifest={{"version",1},{"name",name},{"format","separator"},{"materials",outMaterials},{"parts",parts},{"warnings",warnings}};
+    if(request.contains("separated_from")&&request["separated_from"].is_object()){
+        const auto& s=request["separated_from"];Json from=Json::object();
+        for(auto key:{"kind","asset","model","pose"})if(s.contains(key)&&s[key].is_string()&&s[key].get<std::string>().size()<=260)from[key]=s[key];
+        for(auto key:{"skin","bodygroups"})if(s.contains(key)&&(s[key].is_number_integer()||s[key].is_string()))from[key]=s[key];
+        a.manifest["separated_from"]=from;
+    }
+    // Normals: a zero one takes its triangles'; tangents from the UVs, as the PMX importer derives them.
+    progress("Generating tangents",.32f);
+    std::vector<Vec> faces(a.vertices.size()),ts(a.vertices.size()),bs(a.vertices.size());
+    for(size_t i=0;i<a.indices.size();i+=3){
+        auto i0=a.indices[i],i1=a.indices[i+1],i2=a.indices[i+2];auto& p=a.vertices[i0];auto& q=a.vertices[i1];auto& s=a.vertices[i2];
+        Vec e=q.pos-p.pos,f=s.pos-p.pos,n=e.cross(f);for(auto k:{i0,i1,i2})faces[k]=faces[k]+n;
+        float u=q.u-p.u,v=q.v-p.v,u2=s.u-p.u,v2=s.v-p.v,d=u*v2-u2*v;if(std::abs(d)<1e-10f)continue;
+        Vec t=(e*v2-f*v)*(1/d),b=(f*u-e*u2)*(1/d);for(auto k:{i0,i1,i2}){ts[k]=ts[k]+t;bs[k]=bs[k]+b;}
+    }
+    for(size_t i=0;i<a.vertices.size();i++){
+        auto& v=a.vertices[i];if(v.normal.length()<1e-6f)v.normal=faces[i];v.normal=v.normal.normalized();
+        auto t=(ts[i]-v.normal*ts[i].dot(v.normal)).normalized();v.tangent={t.x,t.y,t.z,v.normal.cross(t).dot(bs[i])<0?-1.f:1.f};
+    }
+    progress("Analyzing materials",.4f);
+    analyzeMaterials(a,progress);
+    a.manifest["triangles"]=a.indices.size()/3;a.manifest["vertices"]=a.vertices.size();
+    warnLargeGeometry(a.manifest,a.vertices.size(),a.indices.size(),limits);
+    updateBounds(a);
+    return a;
+}
+PieceShape measurePiece(const Asset& a){
+    PieceShape shape;
+    // Welded by position (to a thousandth of a unit): UV and material seams are not openings.
+    struct Key{int64_t x,y,z;bool operator==(const Key& o)const{return x==o.x&&y==o.y&&z==o.z;}};
+    struct Hash{size_t operator()(const Key& k)const{return size_t(k.x*73856093^k.y*19349663^k.z*83492791);}};
+    std::unordered_map<Key,uint32_t,Hash> ids;std::vector<uint32_t> welded(a.vertices.size());
+    for(size_t i=0;i<a.vertices.size();i++){auto& p=a.vertices[i].pos;Key k{int64_t(std::llround(p.x*1000.)),int64_t(std::llround(p.y*1000.)),int64_t(std::llround(p.z*1000.))};
+        welded[i]=ids.emplace(k,uint32_t(ids.size())).first->second;}
+    std::unordered_map<uint64_t,uint32_t> edges;double volume=0;
+    for(size_t i=0;i<a.indices.size();i+=3){
+        std::array<uint32_t,3> w{welded[a.indices[i]],welded[a.indices[i+1]],welded[a.indices[i+2]]};
+        for(int k=0;k<3;k++){uint32_t x=w[k],y=w[(k+1)%3];if(x==y)continue;uint64_t key=uint64_t(std::min(x,y))<<32|std::max(x,y);edges[key]++;}
+        auto& p0=a.vertices[a.indices[i]].pos;auto& p1=a.vertices[a.indices[i+1]].pos;auto& p2=a.vertices[a.indices[i+2]].pos;
+        volume+=double(p0.dot(p1.cross(p2)))/6.0;
+    }
+    shape.edges=edges.size();for(auto& [key,uses]:edges)if(uses==1)shape.boundaryEdges++;
+    shape.volume=std::abs(volume);
+    try{
+        auto hull=makeFastHull(a);Vec c{0,0,0};for(auto& p:hull.points)c=c+p;c=c*(1.f/float(std::max<size_t>(1,hull.points.size())));
+        double h=0;for(size_t i=0;i+2<hull.indices.size();i+=3){auto& p0=hull.points[hull.indices[i]];auto& p1=hull.points[hull.indices[i+1]];auto& p2=hull.points[hull.indices[i+2]];h+=std::abs(double((p0-c).dot((p1-c).cross(p2-c))))/6.0;}
+        shape.hullVolume=h;
+    }catch(...){shape.hullVolume=0;}
+    return shape;
+}
+std::string automaticCollision(const Asset& a){
+    if(a.indices.size()<36)return "hull";
+    // A small piece (a hairpin, an earring) gains nothing from a decomposition: CoACD cuts it into slivers far below a
+    // unit, which the game's physics may refuse. Under 12 units across it keeps the fast hull.
+    Vec lo{INFINITY,INFINITY,INFINITY},hi{-INFINITY,-INFINITY,-INFINITY};
+    for(auto& v:a.vertices){lo={std::min(lo.x,v.pos.x),std::min(lo.y,v.pos.y),std::min(lo.z,v.pos.z)};hi={std::max(hi.x,v.pos.x),std::max(hi.y,v.pos.y),std::max(hi.z,v.pos.z)};}
+    if(std::max({hi.x-lo.x,hi.y-lo.y,hi.z-lo.z})<12.f)return "hull";
+    auto shape=measurePiece(a);
+    // An open shell (cloth, a hair card, most accessories): CoACD needs a closed surface to find its inside.
+    if(shape.edges==0||shape.boundaryEdges*50>shape.edges)return "hull";
+    if(shape.hullVolume<=0)return "hull";
+    // A closed piece that fills little of its hull is concave: a ring, a bow, a cup. One with almost no volume is a
+    // flat double layer (a sheet and its back-face copy): there is no inside for CoACD to find.
+    const double fill=shape.volume/shape.hullVolume;
+    return fill>=.02&&fill<.55?"balanced":"hull";
+}
+}
diff --git a/mmdhl/native/props/mesh_prop.hpp b/mmdhl/native/props/mesh_prop.hpp
new file mode 100644
--- /dev/null
+++ b/mmdhl/native/props/mesh_prop.hpp
@@ -0,0 +1,19 @@
+#pragma once
+// The mesh separator's job (kind "mesh"): a static prop from a piece of a model in the game, given as triangles in the
+// request: positions in Source units around the piece's origin, outward counter-clockwise; per material, an optional
+// texture from the character cache by its content hash and an optional Source material that draws the slot instead
+// (source_material). The request comes from the game module's PropFromMesh binding.
+#include "core.hpp"
+
+namespace props {
+// Builds the piece's asset (no collision yet). characterTextures is the character cache's texture folder.
+Asset meshAsset(const Json& request,const fs::path& characterTextures,const Limits& limits,const Progress& progress);
+// The collision a piece gets when the request asks for "auto": "balanced" (CoACD) for a closed piece, 12 units across
+// or more, that fills little of its outer hull (a ring, a bow), "hull" otherwise (a small piece, a compact piece, or an
+// open shell CoACD cannot close).
+std::string automaticCollision(const Asset& asset);
+// What automaticCollision measured: the piece's open (boundary) edges and edges, its enclosed volume and its fast
+// hull's volume.
+struct PieceShape { size_t boundaryEdges=0,edges=0; double volume=0,hullVolume=0; };
+PieceShape measurePiece(const Asset& asset);
+}
diff --git a/mmdhl/tests/mesh_prop_tests.cpp b/mmdhl/tests/mesh_prop_tests.cpp
new file mode 100644
--- /dev/null
+++ b/mmdhl/tests/mesh_prop_tests.cpp
@@ -0,0 +1,82 @@
+// The mesh separator's prop job (native/props/mesh_prop.hpp): a request's triangles become a valid static prop with
+// its materials (an embedded character texture, a Source material), the automatic collision choice (a compact box, a
+// concave closed ring, an open sheet), and invalid requests are refused. argv[1]: a scratch folder.
+#include "mesh_prop.hpp"
+#include <array>
+#include <iostream>
+#include <utility>
+using namespace props;
+static void check(bool ok,const std::string& why){if(!ok)throw std::runtime_error(why);}
+struct Builder {
+    Json vertices=Json::array(),indices=Json::array(),triangles=Json::array();
+    // An axis-aligned box, outward counter-clockwise (Source's +Z up), material m.
+    void box(Vec lo,Vec hi,unsigned m){
+        const unsigned base=unsigned(vertices.size()/8);
+        for(int i=0;i<8;i++){Vec p{i&1?hi.x:lo.x,i&2?hi.y:lo.y,i&4?hi.z:lo.z};for(float v:{p.x,p.y,p.z,0.f,0.f,0.f,float(i&1),float((i>>1)&1)})vertices.push_back(v);}
+        const unsigned faces[12][3]={{0,2,1},{1,2,3},{4,5,6},{5,7,6},{0,1,4},{1,5,4},{2,6,3},{3,6,7},{0,4,2},{2,4,6},{1,3,5},{3,7,5}};
+        for(auto& f:faces){for(int k=0;k<3;k++)indices.push_back(base+f[k]);triangles.push_back(m);}
+    }
+    // A flat n x n grid of quads at z, facing +Z, or -Z (a back-face copy) when flipped.
+    void sheet(int n,float z,bool flipped,unsigned m){
+        const unsigned base=unsigned(vertices.size()/8);
+        for(int j=0;j<=n;j++)for(int i=0;i<=n;i++)for(float v:{float(i),float(j),z,0.f,0.f,flipped?-1.f:1.f,float(i)/n,float(j)/n})vertices.push_back(v);
+        auto at=[&](int i,int j){return base+unsigned(j*(n+1)+i);};
+        for(int j=0;j<n;j++)for(int i=0;i<n;i++){
+            std::array<unsigned,6> t{at(i,j),at(i+1,j),at(i+1,j+1),at(i,j),at(i+1,j+1),at(i,j+1)};
+            if(flipped){std::swap(t[1],t[2]);std::swap(t[4],t[5]);}
+            for(auto k:t)indices.push_back(k);triangles.push_back(m);triangles.push_back(m);
+        }
+    }
+    Json request(Json materials)const{return {{"name","Piece"},{"vertices",vertices},{"indices",indices},{"triangle_materials",triangles},{"materials",materials}};}
+};
+static bool throws(const Json& request,const fs::path& textures){try{meshAsset(request,textures,fullTextureLimits(),{});}catch(const std::exception&){return true;}return false;}
+int main(int argc,char** argv){try{
+    check(argc>1,"Pass a scratch folder");
+    fs::path scratch=argv[1];fs::remove_all(scratch);fs::create_directories(scratch/"textures");
+    // A 2x2 RGBA PNG in the character cache's way: <SHA-256 of its bytes>.png.
+    static const uint8_t png[]={137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82,0,0,0,2,0,0,0,2,8,6,0,0,0,114,182,13,36,0,0,0,20,73,68,65,84,120,218,99,56,161,161,241,95,227,132,198,127,6,24,3,0,72,196,8,93,121,124,77,129,0,0,0,0,73,69,78,68,174,66,96,130};
+    const std::string hash=sha256(std::span<const uint8_t>(png,sizeof png));writeAtomic(scratch/"textures"/(hash+".png"),std::span<const uint8_t>(png,sizeof png));
+    Json materials=Json::array({{{"name","cloth"},{"base_texture",hash},{"source_material","mmd/0123456789abcdef/cloth"},{"color",{1,1,1,1}},{"two_sided",true}},
+        {{"name","metal"},{"source_material","models/props_c17/metalladder001"},{"specular",{.5,.5,.5}},{"shininess",40}},{{"name","unused"}}});
+    // A box (cloth) beside a box (metal); the third material has no triangle.
+    Builder b;b.box({-2,-1,-1},{0,1,1},0);b.box({0,-1,-1},{2,1,1},1);
+    auto a=meshAsset(b.request(materials),scratch/"textures",fullTextureLimits(),{});
+    check(a.indices.size()==72&&a.vertices.size()==16,"Geometry not kept");
+    check(a.manifest["materials"].size()==2,"An unused material was kept");
+    check(a.manifest["materials"][0]["source_material"]=="mmd/0123456789abcdef/cloth"&&a.manifest["materials"][1]["source_material"]=="models/props_c17/metalladder001","Source materials lost");
+    check(a.textures.size()==1&&a.manifest["materials"][0]["base_texture"]==a.textures[0].hash&&a.manifest["materials"][1]["base_texture"]=="","The character texture was not embedded");
+    check(a.manifest["parts"].size()==2&&a.manifest["parts"][1]["first"]==36,"Parts not grouped by material");
+    for(auto& v:a.vertices)check(std::abs(v.normal.length()-1)<1e-3f,"A zero normal was not replaced");
+    check(automaticCollision(a)=="hull","Two boxes side by side are compact");
+    // Through the static prop pipeline: collision, save, load.
+    makeCollision(a,"hull",{});auto id=saveAsset(scratch/"static",a,{},fullTextureLimits());
+    auto loaded=loadAsset(scratch/"static",id,fullTextureLimits());
+    check(loaded.indices.size()==72&&loaded.manifest["materials"][1]["source_material"]=="models/props_c17/metalladder001","The saved piece differs");
+    // A missing texture: a warning and no texture, not a failure.
+    Json missing=materials;missing[0]["base_texture"]=std::string(64,'a');
+    auto m=meshAsset(b.request(missing),scratch/"textures",fullTextureLimits(),{});
+    check(m.textures.empty()&&m.manifest["materials"][0]["base_texture"]==""&&!m.manifest["warnings"].empty(),"A missing texture was not reported");
+    // A closed ring that fills little of its hull is concave: CoACD.
+    Builder ring;ring.box({-10,-10,0},{10,-8,1},1);ring.box({-10,8,0},{10,10,1},1);ring.box({-10,-8,0},{-8,8,1},1);ring.box({8,-8,0},{10,8,1},1);
+    auto r=meshAsset(ring.request(materials),scratch/"textures",fullTextureLimits(),{});auto shape=measurePiece(r);
+    check(shape.boundaryEdges==0&&shape.volume>0&&shape.hullVolume>shape.volume,"The ring was measured wrongly");
+    check(automaticCollision(r)=="balanced","A concave ring did not get a decomposition ("+std::to_string(shape.volume/shape.hullVolume)+")");
+    // The same ring a tenth of the size (2 units across, a hairpin's size) keeps the fast hull.
+    Builder small;small.box({-1,-1,0},{1,-.8f,.1f},1);small.box({-1,.8f,0},{1,1,.1f},1);small.box({-1,-.8f,0},{-.8f,.8f,.1f},1);small.box({.8f,-.8f,0},{1,.8f,.1f},1);
+    check(automaticCollision(meshAsset(small.request(materials),scratch/"textures",fullTextureLimits(),{}))=="hull","A small concave piece got a decomposition");
+    // An open sheet keeps the fast hull; so does a sheet with its back-face copy (closed, but without volume).
+    Builder open;open.sheet(4,0,false,0);
+    check(automaticCollision(meshAsset(open.request(materials),scratch/"textures",fullTextureLimits(),{}))=="hull","An open sheet got a decomposition");
+    Builder layered;layered.sheet(4,0,false,0);layered.sheet(4,0,true,1);
+    auto l=meshAsset(layered.request(materials),scratch/"textures",fullTextureLimits(),{});
+    check(measurePiece(l).boundaryEdges==0&&automaticCollision(l)=="hull","A sheet with its back-face copy got a decomposition");
+    // Refused requests.
+    auto bad=b.request(materials);bad["indices"][0]=999;check(throws(bad,scratch/"textures"),"A vertex index out of range was accepted");
+    bad=b.request(materials);bad["triangle_materials"][0]=7;check(throws(bad,scratch/"textures"),"A material out of range was accepted");
+    bad=b.request(materials);bad["materials"][0]["source_material"]="../../cfg/autoexec";check(throws(bad,scratch/"textures"),"A parent folder in a source material was accepted");
+    bad=b.request(materials);bad["vertices"][0]=1e30;check(throws(bad,scratch/"textures"),"A position out of range was accepted");
+    bad=b.request(materials);bad["triangle_materials"].erase(0);check(throws(bad,scratch/"textures"),"A triangle without material was accepted");
+    bad=b.request(materials);bad["materials"][0]["base_texture"]="../x";check(throws(bad,scratch/"textures"),"An invalid texture reference was accepted");
+    std::cout<<"Mesh separator props: materials, embedded texture, save and load, automatic collision ("<<shape.volume/shape.hullVolume<<" for the ring), refusals passed\n";
+    return 0;
+}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
