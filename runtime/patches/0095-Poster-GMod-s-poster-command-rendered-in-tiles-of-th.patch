+// The poster's PNG writer (ADR 0226 of the GMod native loader project): Windows' own PNG encoder (WIC), fed rows of
+// 8-bit BGR a block at a time, so a poster of hundreds of megapixels is compressed as it goes.
+#pragma once
+#include <cstddef>
