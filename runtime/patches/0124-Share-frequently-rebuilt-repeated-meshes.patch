+  bool AccelManager::selectRepeatedBlases(const InstanceManager& instanceManager, uint32_t frame,
+                                         uint32_t minimum, bool ommsActive) {
+    bool evaluate = false;
+    for (auto it = m_repeatedBlases.begin(); it != m_repeatedBlases.end(); ) {
+      auto& candidate = it->second;
+      if (!candidate.history.shared() && !candidate.history.recent(frame)) {
+        it = m_repeatedBlases.erase(it);
+      } else {
+        candidate.visible = {};
+        evaluate |= candidate.history.considered(frame);
+        ++it;
+      }
+    }
+    if (!evaluate)
+      return false;
+
+    // Count the live TLAS inputs, including renderer-created instances absent from the linked set.
+    // The micromap manager looks up an unsplit request by source hash and checks its format and triangle count.
+    // Every member here has the same BlasEntry and triangle count. Compare the actual requests for this pass.
+    for (const RtInstance* instance : instanceManager.getInstanceTable()) {
+      if (instance->isHidden() || instance->isMarkedForGC() || instance->getVkInstance().mask == 0)
+        continue;
+      auto it = m_repeatedBlases.find(instance->getBlas());
+      if (it == m_repeatedBlases.end() || !it->second.history.considered(frame))
+        continue;
+      const bool compatible = instance->surface.instancesToObject == nullptr && instance->getBillboardCount() == 0;
+      if (compatible && ommsActive && OpacityMicromapManager::usesOpacityMicromap(*instance) &&
+          instance->surface.alphaBlendDissolve == AlphaBlendDissolve::None) {
+        const OmmRequest request(*instance, instanceManager);
+        it->second.visible.add(instance->getGeometryFlags(), true, request.ommSrcHash, int32_t(request.ommFormat));
+      } else {
+        it->second.visible.add(instance->getGeometryFlags(), compatible);
+      }
+    }
+
+    bool newlyShared = false;
+    for (auto& item : m_repeatedBlases) {
+      auto& candidate = item.second;
+      if (!candidate.history.considered(frame))
+        continue;
+      if (!candidate.visible.count) {
+        // There is no visible placement to retire the shared BLAS in the merged-instance loop.
+        if (candidate.history.shared())
+          returnDynamicBlasToPool(*item.first, m_blasPool);
+        candidate.lastBuild.owner = nullptr;
+        candidate.history.select(frame, 0, minimum, candidate.visible, false);
+        continue;
+      }
+      const BlasEntry& mesh = *item.first;
+      const bool wasShared = candidate.history.shared();
+      const uint32_t triangles = mesh.modifiedGeometryData.calculatePrimitiveCount();
+      const bool rigid = mesh.input.getSkinningState().numBones == 0 && mesh.frameLastUpdated != frame;
+      candidate.history.select(frame, triangles, minimum, candidate.visible, rigid);
+      if (wasShared != candidate.history.shared()) {
+        candidate.lastBuild.owner = nullptr;
+        newlyShared |= candidate.history.shared();
+        Logger::debug(str::format("Repeated mesh BLAS ", candidate.history.shared() ? "shared" : "released",
+          ": ", triangles, " triangles, ", candidate.visible.count, " visible instances"));
+      }
+    }
+    return newlyShared;
+  }
