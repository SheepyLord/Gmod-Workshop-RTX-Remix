diff --git a/scripts-common/numos_host_headers.py b/scripts-common/numos_host_headers.py
new file mode 100644
index 000000000..069008641
--- /dev/null
+++ b/scripts-common/numos_host_headers.py
@@ -0,0 +1,60 @@
+"""Build the Enhanced sky's host headers. NUMOS's standalone compute passes use the original headers."""
+from pathlib import Path
+import re
+import sys
+
+INCLUDE = re.compile(r'^[ \t]*#include "(numos/(?:host|lib)/[^"]+)"', re.M)
+DECLARATION = re.compile(
+    r'^(?:struct\s+(\w+)|(?:static\s+)?const\s+\w+\s+(\w+)|(?:inline\s+)?\w+\s+(\w+)\s*\()',
+    re.M)
+MACRO = re.compile(r'^#(?:define|ifdef|ifndef)\s+(\w+)|^#if\s+defined\((\w+)\)', re.M)
+# These textures and the two feature gates belong to the host, rather than to the library.
+HOST_NAMES = set("""
+AtmosphereTransmittanceLut AtmosphereMultiscatteringLut AtmosphereSkyViewLut AtmosphereSkyViewSampler
+AtmosphereCloudSkyTransmittanceLut AtmosphereCloudShadowMap AtmosphereCloudNoise3DSampler
+AtmosphereCloudSecondaryLut NightSkyStarCells NightSkyStars NightSkyMilkyWay NightSkyStarlightLow NightSkyMoon
+ATMOSPHERE_AVAILABLE ATMOSPHERE_TRANSMITTANCE_LUT_AVAILABLE NIGHT_SKY_AVAILABLE
+""".split())
+# Keep comments, licence headers and include paths byte-for-byte.
+TOKEN = re.compile(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\])*"|\b[A-Za-z_]\w*\b', re.S)
+
+
+def host_headers(source):
+    headers = {}
+    pending = ['numos/host/numos_host.slangh']
+    while pending:
+        name = pending.pop()
+        if name not in headers:
+            headers[name] = (source / name).read_text(encoding='utf-8')
+            pending.extend(INCLUDE.findall(headers[name]))
+    return headers
+
+
+def host_names(headers):
+    names = HOST_NAMES.copy()
+    for contents in headers.values():
+        code = re.sub(r'//[^\n]*|/\*.*?\*/', '', contents, flags=re.S)
+        for pattern in (DECLARATION, MACRO):
+            names.update(word for match in pattern.findall(code) for word in match if word)
+    # The public numos* interface and NUMOS_* constants already have their own prefix.
+    return {word for word in names if not word.lower().startswith('numos')}
+
+
+def prefix(contents, names):
+    return TOKEN.sub(lambda match: 'enhanced_' + match[0] if match[0] in names else match[0], contents)
+
+
+def generate(source, destination):
+    headers = host_headers(source)
+    names = host_names(headers)
+    for name, contents in headers.items():
+        data = ('// Generated for the Remix host with Enhanced sky identifiers.\n' + prefix(contents, names)).encode()
+        output = destination / name
+        if not output.is_file() or output.read_bytes() != data:
+            output.parent.mkdir(parents=True, exist_ok=True)
+            output.write_bytes(data)
+
+
+if __name__ == '__main__':
+    generate(Path(sys.argv[1]), Path(sys.argv[2]))
+    Path(sys.argv[3]).write_text('Enhanced sky host headers\n', encoding='utf-8')
