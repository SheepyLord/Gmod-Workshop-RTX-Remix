diff --git a/src/dxvk/rtx_render/rtx_fork_rcas.cpp b/src/dxvk/rtx_render/rtx_fork_rcas.cpp
index 3716728da936d6004421037385fcc580dc60dd4b..d69dedfb8dfc4e8fbfbfbab5df567be32849e7d4 100644
--- a/src/dxvk/rtx_render/rtx_fork_rcas.cpp
+++ b/src/dxvk/rtx_render/rtx_fork_rcas.cpp
@@ -81,7 +81,7 @@ namespace dxvk {

   namespace fork_hooks {

-    void dispatchRcasSharpening(RtxContext& ctx, const Resources::RaytracingOutput& rtOutput) {
+    void dispatchRcasSharpening(RtxContext& ctx, Resources::RaytracingOutput& rtOutput) {
       // FSR runs RCAS inside its own upscale dispatch, and NIS has its own
       // sharpening stage, so the standalone pass is only for the upscalers that
       // do not sharpen at all.
@@ -104,19 +104,12 @@ namespace dxvk {

       ctx.getCommonObjects()->metaRCAS().dispatch(
