+void applyAtmosphereCloudShadowVolume(inout RAB_LightSample lightSample, uint lightIdx, vec3 froxelWorldPosition)
+{
+  if (cb.skyMode != 1 || cb.atmosphereArgs.cloudVoxelShadowsEnable == 0u || lightIdx == RTXDI_INVALID_LIGHT_INDEX)
