+// Reflection and transmission can leave the scene on different rays. Read the
+// current post-depth air along each final segment, then haze the common camera leg.
+void numosReflectedGround(uint2 slot, inout SkyCompositeInput input) {
+  [unroll] for (uint path = 0; path < 2; ++path) {
+    const uint4 record = SkyGroundPaths.Load(int4(slot, path, 0));
+    if (record.w == 0u) continue;
+    const float3 weight = unpackAttenuation(record.w) / cb.skyRadianceScale;
+    const float2 first = unpackFloat2x16(record.x);
+    const float2 second = unpackFloat2x16(record.y);
+    const float3 originKm = float3(first, second.x);
+    const float3 dir = unsignedOctahedralToSphereDirection(float2(unpack16(record.z)) / 65535.f);
+    const float3 view = enhanced_worldToAtmosphereYUp(dir, skyArgs.isZUp != 0u, skyArgs.flipUpAxis != 0u);
+    NumosGroundHit hit = numosSkyGround(originKm, view, skyArgs);
+    hit.km = second.y;
+    hit.ground = originKm + view * hit.km;
+    float3 origin = skyArgs.cameraPosition + numosKmYUpToWorld(originKm, skyArgs);
+    const float distance = numosKmToWorld(hit.km, skyArgs);
+    const float nearLength = min(skyArgs.apFroxelRange, distance);
+    float3 nearT, farT;
+    const float3 nearS = numosAirSegment(cb.camera, skyArgs, origin, dir, nearLength, 8u, .5f,
+      SkyHazeFroxelLighting, SkyHazeFroxelAux, SkyHazeSampler, enhanced_AtmosphereTransmittanceLut,
+      enhanced_AtmosphereMultiscatteringLut, enhanced_AtmosphereCloudShadowMap, enhanced_AtmosphereCloudNoise3DSampler, nearT);
+    const float3 farS = numosAirSegment(cb.camera, skyArgs, origin + dir * nearLength, dir, distance - nearLength, 16u, .5f,
+      SkyHazeFroxelLighting, SkyHazeFroxelAux, SkyHazeSampler, enhanced_AtmosphereTransmittanceLut,
+      enhanced_AtmosphereMultiscatteringLut, enhanced_AtmosphereCloudShadowMap, enhanced_AtmosphereCloudNoise3DSampler, farT);
+    float4 cloud = float4(0.xxx, 1.f);
+    if (skyArgs.cloudSecondaryLutEnable != 0u)
+      cloud = enhanced_sampleCloudDomeLutSmooth(enhanced_AtmosphereCloudSecondaryLut, enhanced_AtmosphereSkyViewSampler,
+                                               enhanced_cloudDomeDirToUv(view), 0.f);
+    const float3 layer = weight * (cloud.rgb + cloud.a * (nearS + nearT * farS));
+    input.reflectedGroundLayer += layer;
+    input.radiance += layer + weight * cloud.a * nearT * farT * numosBareGround(originKm, view, hit, skyArgs);
+  }
+}
