diff --git a/src/dxvk/rtx_render/rtx_vr_policy.h b/src/dxvk/rtx_render/rtx_vr_policy.h
index 28022761..186b32cb 100644
--- a/src/dxvk/rtx_render/rtx_vr_policy.h
+++ b/src/dxvk/rtx_render/rtx_vr_policy.h
@@ -65,4 +65,29 @@ namespace dxvk::vrpolicy {
   };
   enum class Upscaler : int { Dlss=1,Taau=3 };
   inline Upscaler upscaler(bool supported) { return supported?Upscaler::Dlss:Upscaler::Taau; }
+
+  // V6's ladder. V1's fixed preset is the top step, so an unchanged session renders as it did.
+  constexpr float kQualityMinScale=.25f, kQualityMaxScale=1.5f;
+  constexpr int kQualityMaxBounceLimit=16;
+  constexpr int kTopDlss=1, kTopMinBounces=1, kTopMaxBounces=4;
+  constexpr uint32_t kTopFlags=RTXVR_QUALITY_VOLUMETRICS|RTXVR_QUALITY_FINE_CLOUDS;
+  constexpr uint32_t kFineCloudSamples=32u, kCoarseCloudSamples=16u;
+  constexpr uint32_t kQualityFlagMask=RTXVR_QUALITY_VOLUMETRICS|RTXVR_QUALITY_FINE_CLOUDS;
+
+  inline bool validQuality(const rtxvr_Quality& q) {
+    return q.structSize==sizeof(q) && q.renderScale==q.renderScale &&
+           q.renderScale>=kQualityMinScale && q.renderScale<=kQualityMaxScale &&
+           q.dlssQuality>=0 && q.dlssQuality<=3 &&
+           q.pathMinBounces>=0 && q.pathMaxBounces<=kQualityMaxBounceLimit &&
+           q.pathMinBounces<=q.pathMaxBounces && !(q.flags&~kQualityFlagMask);
+  }
+  inline rtxvr_Quality topQuality(float renderScale) {
+    rtxvr_Quality q {};
+    q.structSize=sizeof(q); q.renderScale=renderScale; q.dlssQuality=kTopDlss;
+    q.pathMinBounces=kTopMinBounces; q.pathMaxBounces=kTopMaxBounces; q.flags=kTopFlags;
+    return q;
+  }
+  inline uint32_t cloudSamples(uint32_t flags) {
+    return (flags&RTXVR_QUALITY_FINE_CLOUDS)?kFineCloudSamples:kCoarseCloudSamples;
+  }
 }
diff --git a/tests/rtx/unit/test_vr_math.cpp b/tests/rtx/unit/test_vr_math.cpp
index 559113bf..362d272f 100644
--- a/tests/rtx/unit/test_vr_math.cpp
+++ b/tests/rtx/unit/test_vr_math.cpp
@@ -351,6 +351,31 @@ int main() {
   require(dxvk::vrtiming::covered(4,4,coverage)==0, "empty pass interval");
   require(dxvk::vrtiming::external(size_t(dxvk::vrtiming::Stage::SubmitBegin)) && dxvk::vrtiming::external(size_t(dxvk::vrtiming::Stage::OverlayBegin)) && !dxvk::vrtiming::external(size_t(dxvk::vrtiming::Stage::RasterBegin)),
     "external compositor intervals are not labelled CPU idle");
+  {
+    using namespace dxvk::vrpolicy;
+    // The top step is V1's fixed preset, so an untouched session renders as it always did.
+    auto top=topQuality(1.f);
+    require(validQuality(top),"the top step is a valid step");
+    require(top.dlssQuality==1&&top.pathMinBounces==1&&top.pathMaxBounces==4,"the top step is V1's preset");
+    require(top.flags==(RTXVR_QUALITY_VOLUMETRICS|RTXVR_QUALITY_FINE_CLOUDS),"the top step keeps both costly effects");
+    require(cloudSamples(top.flags)==32u&&cloudSamples(0u)==16u,"coarse clouds halve the sample count");
+    auto bad=top; bad.structSize=sizeof(bad)-4;
+    require(!validQuality(bad),"a step of another size is refused");
+    bad=top; bad.renderScale=.24f; require(!validQuality(bad),"a scale below the floor is refused");
+    bad.renderScale=1.51f; require(!validQuality(bad),"a scale above the ceiling is refused");
+    bad.renderScale=std::numeric_limits<float>::quiet_NaN();
+    require(!validQuality(bad),"a scale that is not a number is refused");
+    bad=top; bad.renderScale=.25f; require(validQuality(bad),"the floor itself is a step");
+    bad.renderScale=1.5f; require(validQuality(bad),"the ceiling itself is a step");
+    bad=top; bad.dlssQuality=-1; require(!validQuality(bad),"a DLSS mode below ultra performance is refused");
+    bad.dlssQuality=4; require(!validQuality(bad),"DLSS Auto is not a ladder step");
+    bad=top; bad.pathMinBounces=5; bad.pathMaxBounces=4;
+    require(!validQuality(bad),"a minimum above the maximum is refused");
+    bad=top; bad.pathMaxBounces=17; require(!validQuality(bad),"more bounces than the limit are refused");
+    bad=top; bad.pathMinBounces=-1; require(!validQuality(bad),"negative bounces are refused");
+    bad=top; bad.flags|=0x4u; require(!validQuality(bad),"an unknown effect flag is refused");
+    bad=top; bad.flags=0; require(validQuality(bad),"the lowest effects are a step");
+  }
