+// Expands an 8-pixel row into the x-bit positions of an 8x4 Morton block.
+uint mortonBlockRowMask(uint mask)
+{
+  mask = (mask | (mask << 12)) & 0x000F000Fu;
+  return (mask | (mask << 2)) & 0x00330033u;
+}
+
+// Returns the valid Morton bits of a clipped 8x4 block.
+uint mortonBlockBoundsMask(uint width, uint height)
+{
+  const uint rowMask = mortonBlockRowMask((1u << width) - 1u);
+  uint mask = height > 0 ? rowMask : 0u;
+  mask |= height > 1 ? rowMask << 2 : 0u;
+  mask |= height > 2 ? rowMask << 8 : 0u;
+  mask |= height > 3 ? rowMask << 10 : 0u;
+  return mask;
+}
