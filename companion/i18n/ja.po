msgstr "未確認"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:363
msgid "Yes"
msgstr "はい"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:363
msgid "No"
msgstr "いいえ"

