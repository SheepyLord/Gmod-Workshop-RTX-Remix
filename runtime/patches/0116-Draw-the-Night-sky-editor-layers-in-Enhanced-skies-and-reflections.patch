+static const uint kNumosNightImage = 16u;
+
+// Solid-angle means in fractions of the reference sun's illuminance per steradian:
+// Gaia 1.1319039114e-9 / the default NightSky HD band 4.0827687348e-4.
+static const float kNumosNightImageScale = 2.772392915e-6f;
+
+struct NumosNightArgs {
+  vec4 weight;       // stars, constellations, galaxy, nebula
+  vec4 saturation;
+  float ceiling;
+  float brightness;
+  float shootingChance;
+  float shootingBrightness;
+  float moonGlow;
+  float coronaBrightness;
+  float eclipseCoverage;
+  uint flags;
+  float starFade;
+  float deepFade;
+  float moonFade;
+  float padding;
+};
+
+inline float numosNightFade(float start, float full, float depth) {
+  const float f = (depth - start) / (full - start);
+  const float t = f <= 0.f ? 0.f : (f >= 1.f ? 1.f : f);
+  return t * t * (3.f - 2.f * t);
+}
+
+inline vec2 numosNightTwilight(float sunY, float daylight) {
+  const float totality = 1.f - numosNightFade(.001f, .006f, daylight);
+  const float early = numosNightFade(.02f, .15f, -sunY);
+  const float deep = numosNightFade(.14f, .30f, -sunY);
+  return vec2(early > totality ? early : totality, deep > totality ? deep : totality);
+}
+
+// NUMOS includes half of 80 S10 in the hemispherical light scattered by the air.
+// Its celestial assets, night gate, reference illuminance and star gain apply as in the pin.
+inline float numosMissingStarInScatter(uint nightFlags, float starGain) {
+  return (nightFlags & 11u) == 9u ? (40.f * 6.61e-12f) * starGain : 0.f;
+}
