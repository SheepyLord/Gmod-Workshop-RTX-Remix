+#pragma once
+
+// NV-DXVK: the mod texture cache's store (ADR 0195 of the GMod native loader project). Self-contained (Windows and
+// the standard library only), so the project's gate compiles and runs tests/rtx/unit/test_mod_texture_store.cpp
+// against it; rtx_mod_texture_cache.cpp is the runtime's side.
+//
+// One store per USD mod and load: it reads the mod's cache file, answers find() for each texture file the mod's
+// materials name, and save() writes the file back when anything differs. An entry holds what the partial DDS loader
+// read from a file (its record) and the bytes of its smallest mips (its tail), and is used only while the file has
+// the same size, last write time, change time and NTFS file id, which one directory listing per folder gives. A file
+// whose folder entry may be stale (several hard links), or whose file system has no change times, is always read.
+
+#include <windows.h>
+
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace dxvk {
+
+  // What the partial DDS loader reads from a file's headers.
+  struct DdsAssetRecord {
+    uint64_t fileSize = 0;
+    uint64_t dataOffset = 0;
+    uint64_t dataSize = 0;
+    uint64_t sizeOfAllLevels = 0;
+    uint32_t format = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t depth = 0;
+    int32_t levels = 0;
+    int32_t layers = 0;
+    int32_t faces = 0;
+    std::vector<uint64_t> levelSizes;  // one per level
+    int64_t lastWriteTime = 0;         // std::filesystem::last_write_time's ticks (FILETIME)
+
+    bool operator==(const DdsAssetRecord& o) const {
+      return fileSize == o.fileSize && dataOffset == o.dataOffset && dataSize == o.dataSize &&
+             sizeOfAllLevels == o.sizeOfAllLevels && format == o.format && width == o.width && height == o.height &&
+             depth == o.depth && levels == o.levels && layers == o.layers && faces == o.faces &&
+             levelSizes == o.levelSizes && lastWriteTime == o.lastWriteTime;
+    }
+  };
+
+  // The bytes data(0, level) gives for each of a texture's smallest mips, the ones a new texture uploads first.
+  struct DdsAssetTail {
+    uint32_t firstLevel = UINT32_MAX;  // UINT32_MAX: none kept
+    std::vector<uint8_t> bytes;        // the levels from firstLevel to the last, back to back
+  };
+
+  class ModTextureStore {
+  public:
+    // The cache file's format version. Raise it whenever what an entry means changes (the DDS parser, the number of
+    // mips a new texture uploads first, the record's fields): every older file is then ignored and rewritten.
+    static constexpr uint32_t kVersion = 1;
+    // Tails larger than this (a texture without a full mip chain) are not kept; such mips are read from the file.
+    static constexpr size_t kMaxTailBytes = 64 * 1024;
+
+    // A file as one folder listing describes it; a change to its data or its times changes one of these.
+    struct Stamp {
+      uint64_t size = 0;
+      int64_t lastWriteTime = 0;
+      int64_t changeTime = 0;
+      uint64_t fileId = 0;
+      bool operator==(const Stamp& o) const {
+        return size == o.size && lastWriteTime == o.lastWriteTime && changeTime == o.changeTime && fileId == o.fileId;
+      }
+    };
+
+    struct Counters {
+      uint32_t hits = 0;      // from the cache: the file not read
+      uint32_t misses = 0;    // read from the file (new, changed, or kept nothing usable)
+      uint32_t unkept = 0;    // of the misses: not kept (several hard links, or the file changed while read)
+      uint32_t unlisted = 0;  // not in its folder's listing (or no change time): left to the caller
+      uint32_t folders = 0;   // folder listings
+      bool loaded = false;    // a valid cache file was read
+      bool ignored = false;   // a cache file was there but of another version, or damaged
+      bool saved = false;     // the cache file was written
+      bool saveFailed = false;
+      double listMs = 0;
+      double readMs = 0;
+      double saveMs = 0;
+    };
+
+    enum class Result { Hit, Miss, Unlisted, Failed };
+
+    // Reads the file; reads nothing a file system will not stamp.
+    // loader(path, record, tail): reads the file as the runtime does, false when it is not a texture it can use.
+    using Loader = std::function<bool(const std::filesystem::path&, DdsAssetRecord&, DdsAssetTail&)>;
+
+    explicit ModTextureStore(std::filesystem::path cacheFile)
+      : m_cacheFile(std::move(cacheFile)) {
+      read();
+    }
+
+    // The cache file of the mod in modFolder, in cacheFolder: <folder name>-<hash of the folder's path>.bin.
+    static std::filesystem::path cacheFileFor(const std::filesystem::path& cacheFolder, const std::filesystem::path& modFolder) {
+      const std::wstring key = lower(std::filesystem::absolute(modFolder).lexically_normal().wstring());
+      wchar_t hex[17];
+      swprintf(hex, 17, L"%016llx", static_cast<unsigned long long>(fnv1a(key.data(), key.size() * sizeof(wchar_t))));
+      return cacheFolder / (std::filesystem::absolute(modFolder).lexically_normal().filename().wstring() + L"-" + hex + L".bin");
+    }
+
+    // The record and tail for this file: kept ones when the file is unchanged (Hit), else what loader read (Miss).
+    Result find(const std::filesystem::path& file, const Loader& loader, DdsAssetRecord& record, DdsAssetTail& tail) {
+      const std::filesystem::path path = file.lexically_normal();
+      const Stamp* stamp = stampOf(path);
+      if (stamp == nullptr) {
+        ++m_counters.unlisted;
+        return Result::Unlisted;
+      }
+      const std::wstring key = lower(path.wstring());
+      auto entry = m_entries.find(key);
+      if (entry != m_entries.end() && entry->second.stamp == *stamp) {
+        record = entry->second.record;
+        tail = entry->second.tail;
+        m_used.insert(key);
+        ++m_counters.hits;
+        return Result::Hit;
+      }
+      Entry fresh;
+      if (!loader(path, fresh.record, fresh.tail)) {
+        return Result::Failed;
+      }
+      ++m_counters.misses;
+      record = fresh.record;
+      tail = fresh.tail;
+      fresh.stamp = *stamp;
+      if (tail.bytes.size() > kMaxTailBytes) {
+        fresh.tail = DdsAssetTail {};
+      }
+      if (sameFile(path, *stamp) && fresh.record.lastWriteTime == stamp->lastWriteTime && fresh.record.fileSize == stamp->size) {
+        m_entries[key] = std::move(fresh);
+        m_used.insert(key);
+        m_changed = true;
+      } else {
+        ++m_counters.unkept;
+        if (entry != m_entries.end()) {
+          m_entries.erase(entry);
+          m_changed = true;
+        }
+      }
+      return Result::Miss;
+    }
+
+    // Writes the cache file when this load used anything other than exactly what it read; drops unused entries.
+    void save() {
+      if (!m_changed && m_used.size() == m_readEntries) {
+        return;
+      }
+      const auto started = std::chrono::steady_clock::now();
+      std::vector<uint8_t> payload;
+      uint32_t count = 0;
+      for (const auto& key : m_used) {
+        const auto it = m_entries.find(key);
+        if (it == m_entries.end()) {
+          continue;
+        }
+        const Entry& e = it->second;
+        put(payload, uint32_t(key.size()));
+        putBytes(payload, key.data(), key.size() * sizeof(wchar_t));
+        put(payload, e.stamp.size);
+        put(payload, e.stamp.lastWriteTime);
+        put(payload, e.stamp.changeTime);
+        put(payload, e.stamp.fileId);
+        const DdsAssetRecord& r = e.record;
+        put(payload, r.fileSize);
+        put(payload, r.dataOffset);
+        put(payload, r.dataSize);
+        put(payload, r.sizeOfAllLevels);
+        put(payload, r.format);
+        put(payload, r.width);
+        put(payload, r.height);
+        put(payload, r.depth);
+        put(payload, r.levels);
+        put(payload, r.layers);
+        put(payload, r.faces);
+        put(payload, r.lastWriteTime);
+        for (const uint64_t size : r.levelSizes) {
+          put(payload, size);
+        }
+        put(payload, e.tail.firstLevel);
+        put(payload, uint32_t(e.tail.bytes.size()));
+        putBytes(payload, e.tail.bytes.data(), e.tail.bytes.size());
+        ++count;
+      }
+      std::vector<uint8_t> bytes;
+      putBytes(bytes, kMagic, sizeof(kMagic));
+      put(bytes, kVersion);
+      put(bytes, count);
+      put(bytes, uint64_t(payload.size()));
+      put(bytes, fnv1a(payload.data(), payload.size()));
+      putBytes(bytes, payload.data(), payload.size());
+
+      std::error_code error;
+      std::filesystem::create_directories(m_cacheFile.parent_path(), error);
+      const std::filesystem::path temporary = m_cacheFile.wstring() + L".tmp";
+      bool written = false;
+      {
+        std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+        if (out) {
+          out.write(reinterpret_cast<const char*>(bytes.data()), std::streamsize(bytes.size()));
+          written = bool(out.flush());
+        }
+      }
+      // The old file stays until the new one is complete: a crash leaves one or the other, never a mix.
+      if (written && MoveFileExW(temporary.c_str(), m_cacheFile.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+        m_counters.saved = true;
+      } else {
+        DeleteFileW(temporary.c_str());
+        m_counters.saveFailed = true;
+      }
+      m_counters.saveMs = msSince(started);
+    }
+
+    const Counters& counters() const { return m_counters; }
+    const std::filesystem::path& cacheFile() const { return m_cacheFile; }
+
+    static std::wstring lower(const std::wstring& text) {
+      if (text.empty()) {
+        return text;
+      }
+      std::wstring out(text.size(), L'\0');
+      const int written = LCMapStringEx(LOCALE_NAME_INVARIANT, LCMAP_LOWERCASE, text.data(), int(text.size()),
+                                        out.data(), int(out.size()), nullptr, nullptr, 0);
+      if (written <= 0) {
+        return text;
+      }
+      out.resize(size_t(written));
+      return out;
+    }
+
+  private:
+    static constexpr char kMagic[8] = { 'N', 'L', 'M', 'O', 'D', 'T', 'E', 'X' };
+
+    struct Entry {
+      Stamp stamp;
+      DdsAssetRecord record;
+      DdsAssetTail tail;
+    };
+
+    struct Listing {
+      bool valid = false;
+      std::unordered_map<std::wstring, Stamp> files;  // lowercase file name -> stamp
+    };
+
+    struct Reader {
+      const uint8_t* at;
+      const uint8_t* end;
+      bool ok = true;
+      void take(void* out, size_t size) {
+        if (!ok || size_t(end - at) < size) {
+          ok = false;
+          return;
+        }
+        std::memcpy(out, at, size);
+        at += size;
+      }
+      template<typename T> T get() {
+        T value {};
+        take(&value, sizeof(T));
+        return value;
+      }
+    };
+
+    static double msSince(std::chrono::steady_clock::time_point from) {
+      return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - from).count();
+    }
+
+    static uint64_t fnv1a(const void* data, size_t size) {
+      const uint8_t* bytes = static_cast<const uint8_t*>(data);
+      uint64_t hash = 14695981039346656037ull;
+      for (size_t i = 0; i < size; ++i) {
+        hash = (hash ^ bytes[i]) * 1099511628211ull;
+      }
+      return hash;
+    }
+
+    template<typename T> static void put(std::vector<uint8_t>& out, const T& value) {
+      putBytes(out, &value, sizeof(T));
+    }
+
+    static void putBytes(std::vector<uint8_t>& out, const void* data, size_t size) {
+      const uint8_t* from = static_cast<const uint8_t*>(data);
+      out.insert(out.end(), from, from + size);
+    }
+
+    static int64_t ticks(const LARGE_INTEGER& value) { return int64_t(value.QuadPart); }
+    static int64_t ticks(const FILETIME& value) {
+      return int64_t((uint64_t(value.dwHighDateTime) << 32) | value.dwLowDateTime);
+    }
+
+    void read() {
+      const auto started = std::chrono::steady_clock::now();
+      std::ifstream file(m_cacheFile, std::ios::binary);
+      if (!file) {
+        return;
+      }
+      const std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+      Reader reader { bytes.data(), bytes.data() + bytes.size() };
+      char magic[8] = {};
+      reader.take(magic, sizeof(magic));
+      const uint32_t version = reader.get<uint32_t>();
+      const uint32_t count = reader.get<uint32_t>();
+      const uint64_t payloadSize = reader.get<uint64_t>();
+      const uint64_t payloadHash = reader.get<uint64_t>();
+      if (!reader.ok || std::memcmp(magic, kMagic, sizeof(magic)) != 0 || version != kVersion ||
+          payloadSize != uint64_t(reader.end - reader.at) || fnv1a(reader.at, size_t(payloadSize)) != payloadHash) {
+        m_counters.ignored = true;
+        return;
+      }
+      std::unordered_map<std::wstring, Entry> entries;
+      for (uint32_t i = 0; i < count && reader.ok; ++i) {
+        const uint32_t chars = reader.get<uint32_t>();
+        if (chars == 0 || chars > 32768) {
+          reader.ok = false;
+          break;
+        }
+        std::wstring key(chars, L'\0');
+        reader.take(key.data(), chars * sizeof(wchar_t));
+        Entry e;
+        e.stamp.size = reader.get<uint64_t>();
+        e.stamp.lastWriteTime = reader.get<int64_t>();
+        e.stamp.changeTime = reader.get<int64_t>();
+        e.stamp.fileId = reader.get<uint64_t>();
+        DdsAssetRecord& r = e.record;
+        r.fileSize = reader.get<uint64_t>();
+        r.dataOffset = reader.get<uint64_t>();
+        r.dataSize = reader.get<uint64_t>();
+        r.sizeOfAllLevels = reader.get<uint64_t>();
+        r.format = reader.get<uint32_t>();
+        r.width = reader.get<uint32_t>();
+        r.height = reader.get<uint32_t>();
+        r.depth = reader.get<uint32_t>();
+        r.levels = reader.get<int32_t>();
+        r.layers = reader.get<int32_t>();
+        r.faces = reader.get<int32_t>();
+        r.lastWriteTime = reader.get<int64_t>();
+        if (!reader.ok || r.levels <= 0 || r.levels > 32) {
+          reader.ok = false;
+          break;
+        }
+        r.levelSizes.resize(size_t(r.levels));
+        for (auto& size : r.levelSizes) {
+          size = reader.get<uint64_t>();
+        }
+        e.tail.firstLevel = reader.get<uint32_t>();
+        const uint32_t tailBytes = reader.get<uint32_t>();
+        if (!reader.ok || tailBytes > kMaxTailBytes) {
+          reader.ok = false;
+          break;
+        }
+        e.tail.bytes.resize(tailBytes);
+        reader.take(e.tail.bytes.data(), tailBytes);
+        entries[std::move(key)] = std::move(e);
+      }
+      if (!reader.ok || reader.at != reader.end) {
+        m_counters.ignored = true;
+        return;
+      }
+      m_entries = std::move(entries);
+      m_readEntries = m_entries.size();
+      m_counters.loaded = true;
+      m_counters.readMs = msSince(started);
+    }
+
+    const Stamp* stampOf(const std::filesystem::path& file) {
+      const std::filesystem::path folder = file.parent_path();
+      auto [it, added] = m_listings.try_emplace(lower(folder.wstring()));
+      Listing& listing = it->second;
+      if (added) {
+        const auto started = std::chrono::steady_clock::now();
+        ++m_counters.folders;
+        HANDLE handle = CreateFileW(folder.c_str(), FILE_LIST_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                    nullptr, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr);
+        if (handle != INVALID_HANDLE_VALUE) {
+          std::vector<uint64_t> buffer(64 * 1024 / sizeof(uint64_t));  // 8-byte aligned for the records
+          listing.valid = true;
+          for (;;) {
+            if (!GetFileInformationByHandleEx(handle, FileIdBothDirectoryInfo, buffer.data(), DWORD(buffer.size() * sizeof(uint64_t)))) {
+              if (GetLastError() != ERROR_NO_MORE_FILES) {
+                listing.valid = false;
+                listing.files.clear();
+              }
+              break;
+            }
+            const uint8_t* at = reinterpret_cast<const uint8_t*>(buffer.data());
+            for (;;) {
+              const auto* info = reinterpret_cast<const FILE_ID_BOTH_DIR_INFO*>(at);
+              // Folders and links (whose entry describes the link, not its target) are never stamped.
+              if (!(info->FileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT))) {
+                Stamp stamp;
+                stamp.size = uint64_t(info->EndOfFile.QuadPart);
+                stamp.lastWriteTime = ticks(info->LastWriteTime);
+                stamp.changeTime = ticks(info->ChangeTime);
+                stamp.fileId = uint64_t(info->FileId.QuadPart);
+                listing.files[lower(std::wstring(info->FileName, info->FileNameLength / sizeof(wchar_t)))] = stamp;
+              }
+              if (info->NextEntryOffset == 0) {
+                break;
+              }
+              at += info->NextEntryOffset;
+            }
+          }
+          CloseHandle(handle);
+        }
+        m_counters.listMs += msSince(started);
+      }
+      if (!listing.valid) {
+        return nullptr;
+      }
+      const auto found = listing.files.find(lower(file.filename().wstring()));
+      // A file system without change times (FAT) gives too little to trust: such files are always read.
+      return found == listing.files.end() || found->second.changeTime == 0 ? nullptr : &found->second;
+    }
+
+    // The file itself, opened for its attributes alone (no data access), is what the listing said, with one name:
+    // the folder entry of a file with several hard links can be stale.
+    static bool sameFile(const std::filesystem::path& file, const Stamp& stamp) {
+      HANDLE handle = CreateFileW(file.c_str(), FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                  nullptr, OPEN_EXISTING, 0, nullptr);
+      if (handle == INVALID_HANDLE_VALUE) {
+        return false;
+      }
+      BY_HANDLE_FILE_INFORMATION info {};
+      const bool ok = GetFileInformationByHandle(handle, &info) != FALSE;
+      CloseHandle(handle);
+      return ok && info.nNumberOfLinks == 1 &&
+             ((uint64_t(info.nFileSizeHigh) << 32) | info.nFileSizeLow) == stamp.size &&
+             ((uint64_t(info.nFileIndexHigh) << 32) | info.nFileIndexLow) == stamp.fileId &&
+             ticks(info.ftLastWriteTime) == stamp.lastWriteTime;
+    }
+
+    std::filesystem::path m_cacheFile;
+    std::unordered_map<std::wstring, Entry> m_entries;      // lowercase normalized path -> entry
+    std::unordered_set<std::wstring> m_used;                // entries this load used or made
+    std::unordered_map<std::wstring, Listing> m_listings;   // lowercase folder -> listing
+    size_t m_readEntries = 0;
+    bool m_changed = false;
+    Counters m_counters;
+  };
+
+} // namespace dxvk
