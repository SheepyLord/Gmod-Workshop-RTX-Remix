diff --git a/src/dxvk/rtx_render/rtx_vr_timing.h b/src/dxvk/rtx_render/rtx_vr_timing.h
new file mode 100644
index 00000000..a894e01f
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_vr_timing.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <vector>
+
+namespace dxvk::vrtiming {
+  enum class Stage : uint32_t {
+    FrameBegin, PathBegin, DemodulateBegin, DenoiseBegin, ComposeBegin,
+    UpscaleBegin, PostBegin, WarpBegin, MirrorBegin, CaptureBegin,
+    SubmitBegin, RasterBegin, OverlayBegin, FrameEnd, Count
+  };
+  constexpr size_t kStages=static_cast<size_t>(Stage::Count);
+  constexpr size_t kPasses=kStages-1;
+  constexpr std::array<const char*,kPasses> kNames {
+    "scene_prepare_as", "path_volumetrics", "demodulation", "denoising", "composition",
+    "upscaling", "post_tonemap", "eye_warp", "mirror", "capture_transfers",
+    "steamvr_submit_span", "late_raster", "overlay_transfer_span"
+  };
+  struct Interval { uint64_t begin=0,end=0; };
+  inline uint64_t covered(uint64_t begin,uint64_t end,const std::vector<Interval>& ordered) {
+    if (end<=begin) { return 0; }
+    uint64_t total=0,cursor=begin;
+    for (const auto& range:ordered) {
+      if (range.end<=cursor) { continue; }
+      if (range.begin>=end) { break; }
+      const auto first=std::max(cursor,range.begin),last=std::min(end,range.end);
+      if (last>first) { total+=last-first; cursor=last; }
+    }
+    return total;
+  }
+  constexpr bool external(size_t pass) { return pass==10 || pass==12; }
+}
