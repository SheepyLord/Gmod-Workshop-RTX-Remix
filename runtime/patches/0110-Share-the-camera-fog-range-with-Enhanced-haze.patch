@@ -0,0 +1,32 @@
+// The ordinary composite has its original instruction stream. Shared ray passes can also encounter the bounded medium.
+#pragma once
+#ifdef COMPOSITE_SKY_PROVIDER
+#if !COMPOSITE_SKY_PROVIDER
+#define NUMOS_STOCK_COMPOSITE_ATTENUATION
+#endif
+#endif
+#ifdef NUMOS_STOCK_COMPOSITE_ATTENUATION
+#include "rtxdi/rtxdi-sdk/include/volumetrics/rtx/algorithm/volume_lighting.slangh"
+#else
+#define calcVolumetricAttenuation stockVolumetricAttenuation
+#include "rtxdi/rtxdi-sdk/include/volumetrics/rtx/algorithm/volume_lighting.slangh"
+#undef calcVolumetricAttenuation
+
+float3 calcVolumetricAttenuation(VolumeArgs volume, Optional<VolumeDefinitionCamera> camera,
+  bool infiniteRay, float distance, float3 origin, float3 direction, float density = 1.f) {
+  if (volume.enable == NUMOS_VOLUME_BOUNDED) {
+    // Clip first, then let the original routine intersect the user's atmosphere or evaluate homogeneous fog.
+    float3 center = volume.cameras[froxelVolumeMain].translatedWorldOffset;
+    if (camera.hasValue) center = worldToTranslatedWorld(camera.value, center);
+    float entry, exit;
+    raySphereIntersect(origin, direction, center, volume.froxelMaxDistance * volume.froxelMaxDistance, entry, exit);
+    float a = max(0.f, entry);
+    float b = infiniteRay ? exit : min(exit, distance);
+    if (b <= a) return 1.xxx;
+    origin += a * direction;
+    distance = b - a;
+    infiniteRay = false;
+  }
+  return stockVolumetricAttenuation(volume, camera, infiniteRay, distance, origin, direction, density);
+}
+#endif
