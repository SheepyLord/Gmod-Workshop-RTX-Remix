   }
 }
 int main() {
-  {
-    using namespace dxvk::vrmath;
-    auto depth=[](double u,double v) {return int(u*3)==0&&int(v*3)==1?2.:10.;};
-    auto colours=[](bool thin,bool invert) {return [=](int x,int y) {
-      const bool foreground=(x<2&&y>=2&&y<4)||(thin&&x==2&&y==2);
-      const double c=foreground!=invert?0.:1.;return Colour3{c,c,c};
-    };};
-    require(colourGuidedCoverageDepth(depth,colours(false,false),1,1,3,3,6,6)==10.,"background-like colour is not moved at foreground disparity");
-    require(colourGuidedCoverageDepth(depth,colours(true,false),1,1,3,3,6,6)==2.,"one reconstructed dark foreground pixel retains near coverage");
-    require(colourGuidedCoverageDepth(depth,colours(true,true),1,1,3,3,6,6)==2.,"bright foreground over dark background also retains coverage");
-    unsigned colourReads=0;
-    auto countColour=[&](int,int) {++colourReads;return Colour3{};};
-    require(colourGuidedCoverageDepth([](double,double){return 10.;},countColour,1,1,3,3,6,6)==10.&&colourReads==0,
-      "smooth depth does not execute colour guidance");
-  }
   require(dxvk::vrmath::colourCoverageDepth([](double u,double) {return u<.5?1.5:10.;},.5,.5,100,100)==1.5,"thin colour coverage receives its neighbouring near depth");
   require(dxvk::vrmath::colourCoverageDepth([](double u,double) {return 10.+u;},.5,.5,100,100)==10.5,"smooth depth gradients are not dilated");
   require(dxvk::vrmath::colourCoverageDepth([](double,double) {return 0.;},.5,.5,100,100)==1e20,"invalid depth remains far");
