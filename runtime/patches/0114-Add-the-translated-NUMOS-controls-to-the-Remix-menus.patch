+msgstr "Gain du disque lunaire"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:677
+#, c-format
+msgid "In force: stars x%.3g, moonlight x%.3g, moon discs x%.3g"
+msgstr "Multiplicateurs actifs : étoiles x%.3g, clair de lune x%.3g, disques lunaires x%.3g"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:680 src/dxvk/rtx_render/rtx_numos_ui_fields.inl:170
