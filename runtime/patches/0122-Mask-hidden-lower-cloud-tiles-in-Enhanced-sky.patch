+++ b/src/dxvk/shaders/rtx/pass/numos/numos_lower_tiles.comp.slang
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: MIT
+#include "rtx/pass/numos/numos_lower_tiles.h"
+#include "rtx/pass/raytrace_args.h"
+#include "rtx/concept/camera/camera.slangh"
+#include "numos/lib/atmosphere_args.h"
+
+layout(binding = NUMOS_LOWER_FRAME) ConstantBuffer<RaytraceArgs> frame;
+layout(binding = NUMOS_LOWER_SKY) ConstantBuffer<enhanced_AtmosphereArgs> sky;
+layout(binding = NUMOS_LOWER_DEPTH) Texture2D<float> linearZ;
+layout(binding = NUMOS_LOWER_TILE_OUTPUT, r32ui) RWTexture2D<uint> tiles;
+
+groupshared uint visible;
+
+float elevation(float3 direction)
+{
+  const float up = sky.isZUp != 0 ? direction.z : direction.y;
+  return sky.flipUpAxis != 0 ? -up : up;
+}
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void main(uint2 tile : SV_GroupID, uint2 lane : SV_GroupThreadID, uint index : SV_GroupIndex)
+{
+  if (index == 0) visible = 0;
+  GroupMemoryBarrierWithGroupSync();
+
+  uint2 size;
+  linearZ.GetDimensions(size.x, size.y);
+  const uint2 start = tile * NUMOS_LOWER_TILE_PIXELS;
+  bool hit = false;
+  for (uint y = lane.y; y < NUMOS_LOWER_TILE_PIXELS && !hit; y += 8)
+  {
+    for (uint x = lane.x; x < NUMOS_LOWER_TILE_PIXELS && !hit; x += 8)
+    {
+      const uint2 p = start + uint2(x, y);
+      if (all(p < size) && linearZ.Load(int3(p, 0)) == frame.primaryDirectMissLinearViewZ)
+      {
+        // The composite rejects PSR misses as well. Keeping those here is conservative, including sparse pixels.
+        // Colour and motion vectors use the jittered and unjittered directions respectively.
+        hit = elevation(cameraPixelCoordinateToDirection(frame.camera, int2(p)).worldDirection) <= 0.f ||
+              elevation(cameraPixelCoordinateToDirection(frame.camera, int2(p), false).worldDirection) <= 0.f;
+      }
+    }
+  }
+  if (hit) InterlockedOr(visible, 1u);
+  GroupMemoryBarrierWithGroupSync();
+
+  if (index == 0 && visible != 0)
+  {
+    const int2 last = int2((size - 1u) / NUMOS_LOWER_TILE_PIXELS);
+    // One tile covers the shifted quarter-rate grid, its neighbour samples and the denoiser's three-pixel apron.
+    for (int y = max(int(tile.y) - 1, 0); y <= min(int(tile.y) + 1, last.y); ++y)
+      for (int x = max(int(tile.x) - 1, 0); x <= min(int(tile.x) + 1, last.x); ++x)
+        InterlockedOr(tiles[int2(x, y)], 1u);
+  }
+}
