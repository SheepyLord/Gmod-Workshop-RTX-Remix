+  int RtxVr::overlayWindow(uint64_t handle,uint32_t flags) {
+    if(!handle||!vrpolicy::validWindowFlags(flags)) { return RTXVR_E_ARGUMENT; }
+    std::lock_guard lock(m_requestMutex);
+    if(!m_active) { return RTXVR_E_NOT_RUNNING; }
+    if(m_overlayRequests.size()>=16&&!m_overlayRequests.count(handle)) { return RTXVR_E_RESOURCES; }
+    m_overlayRequests[handle]={0,0,flags};
+    if(flags) { m_windowSources[handle]=flags; } else { m_windowSources.erase(handle); }
+    m_windowNoMirror=std::any_of(m_windowSources.begin(),m_windowSources.end(),[](const auto& v) { return v.second&RTXVR_WINDOW_NO_MIRROR; });
+    return RTXVR_OK;
   }
 
