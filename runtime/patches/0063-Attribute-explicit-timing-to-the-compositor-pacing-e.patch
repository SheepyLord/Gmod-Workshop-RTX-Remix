From be2acc73a01bc55c0b182c407641d2a531dcb037 Mon Sep 17 00:00:00 2001
From: SheepyLord <37598021+SheepyLord@users.noreply.github.com>
Date: Tue, 10 Nov 2026 12:58:39 -0700
Subject: [PATCH] Attribute explicit timing to the compositor pacing epoch

Co-Authored-By: Codex <noreply@openai.com>
---
 src/dxvk/rtx_render/rtx_vr.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/dxvk/rtx_render/rtx_vr.cpp b/src/dxvk/rtx_render/rtx_vr.cpp
index d0d84da9..4a765673 100644
--- a/src/dxvk/rtx_render/rtx_vr.cpp
+++ b/src/dxvk/rtx_render/rtx_vr.cpp
@@ -712,11 +712,14 @@ namespace dxvk {
 
   void RtxVr::beforeSubmission() {
     std::unique_lock calls(m_openVrMutex,std::try_to_lock);
-    if (!calls.owns_lock() || !active() || !m_compositor || m_timingFrame==m_device->getCurrentFrameId()) { return; }
+    if (!calls.owns_lock() || !active() || !m_compositor) { return; }
+    uint64_t epoch=m_device->getCurrentFrameId();
+    if (m_frame.flags&RTXVR_START_RENDER_PACING) { std::lock_guard lock(m_requestMutex); epoch=m_status.renderWaitCalls; }
+    if (m_timingFrame==epoch) { return; }
     SubmissionLock queue(m_device);
     const auto error=m_compositor->SubmitExplicitTimingData();
     if (error!=vr::VRCompositorError_None) { Logger::warn(str::format("RTX VR explicit timing error: ",int(error))); }
-    m_timingFrame=m_device->getCurrentFrameId();
+    m_timingFrame=epoch;
   }
 
   void RtxVr::captureImage(RtxContext& ctx,const Rc<DxvkImage>& image,const std::filesystem::path& path,bool depth) {
-- 
