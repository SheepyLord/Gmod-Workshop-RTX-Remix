+    std::vector<uint8_t> readFile(const std::string& path) {
+      std::ifstream file(path, std::ios::binary);
+      if (!file) {
+        return {};
+      }
+      return std::vector<uint8_t>((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    }
