@@ -27,6 +28,29 @@ static void check(bool condition, const std::string& message) {
 int main() {
   using namespace dxvk;
   using namespace enhancedSky;
+  const float sunRadius = .545f * .5f * 3.14159265f / 180.f;
+  const float pixelAngle = .0003f;
+  check(numosSunDiscCentre(sunRadius) == 48.f && numosSunDiscCentre(.0001f) == 48.f,
+        "A normal or subpixel sun peaks at 48 times daylight");
+  check(std::abs(numosSunDiscCentre(.3f) * .8f * numosDiscSolidAngle(.3f) - 1.f) < 1.e-6f,
+        "A large, dimmer disc retains its physical radiance");
+  const float rimWidth = numosDiscRimWidth(pixelAngle, std::sin(sunRadius));
+  for (int i = -2; i <= 2; ++i)
+    check(std::abs(numosDiscCoverage(.5f * i * pixelAngle, rimWidth)
+                   - (.5f + i * .25f)) < 1.e-6f, "Two traced pixels across the rim");
+  check(numosDiscRimWidth(.00001f, 1.f) == .02f,
+        "Resolved discs retain the library's two-percent rim floor");
+  check(std::abs(numosMoonSampleOffset(sunRadius, sunRadius, rimWidth, .5f) - (sunRadius - .5f * pixelAngle)) < 1.e-7f &&
+        numosMoonSampleOffset(0.f, .000087f, .00024f, .86f) == 0.f,
+        "A partially covered pixel shades the visible lunar surface, even on a subpixel moon");
+  check(numosMoonDiscGain(20.f, 1.f) == 1.f && numosMoonDiscGain(1.f, 0.f) == 0.f,
+        "Dim lunar detail stays linear and an unlit moon stays dark");
+  float previous = 0.f;
+  for (float peak : {24.f, 48.f, 120.f, 1200.f, 12000.f}) {
+    const float visible = peak * numosMoonDiscGain(peak, 1.f);
+    check(visible > previous && visible <= 48.f, "Lunar highlights retain contrast below the cap");
+    previous = visible;
+  }
   for (bool vr : { false, true }) {
     check(effectiveSkyMode(SkyMode::SkyboxRasterization, vr) == SkyMode::SkyboxRasterization, "Raster sky");
     check(effectiveSkyMode(SkyMode::Numos, vr) == SkyMode::Numos, "Standard sky");
