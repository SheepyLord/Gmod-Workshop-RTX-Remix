@@ -42,6 +45,7 @@ float searchNear(float3 origin,float3 ray,float2 infinity,uint2 depthSize) {
     local=min(local,TileMinimum.Load(int3(x,y,0)));
   }
   return clamp(local,global,cb.centre.z);
