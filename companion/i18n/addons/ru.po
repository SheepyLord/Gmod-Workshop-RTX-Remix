#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:437
msgid "Materials that use $selfillum incorrectly may be misclassified."
msgstr "Материалы с некорректным использованием $selfillum могут быть классифицированы ошибочно."

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:439
msgid "Debug Options"
msgstr "Параметры отладки"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:442
msgid "Shows debug messages in console for categorization activity (useful for troubleshooting)."
msgstr "Выводит в консоль отладочную информацию о классификации для поиска проблем."

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:444
msgid "Manual Controls"
msgstr "Ручное управление"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:446
msgid "Scan Now"
msgstr "Сканировать сейчас"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:450
msgid "Manually parse BSP and categorize world textures, decals, and emissive materials."
msgstr "Вручную разбирает BSP и классифицирует текстуры мира, декали и светящиеся материалы."

