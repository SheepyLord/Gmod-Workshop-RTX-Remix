--- a/src/dxvk/rtx_render/rtx_vr.h
+++ b/src/dxvk/rtx_render/rtx_vr.h
@@ -100,6 +100,7 @@ namespace dxvk {
     uint64_t m_cameraFrame=~uint64_t(0), m_cameraGeneration=0;
     rtxvr_StartInfo m_requested {}, m_frame {};
     vrmath::Projection m_projection {}, m_frameProjection {};
+    double m_nearestDepth=vrmath::kNearestEyeDepthMetres,m_frameNearestDepth=vrmath::kNearestEyeDepthMetres;
     vrmath::PoseRing m_poses;
     rtxvr_FramePose m_framePose {};
