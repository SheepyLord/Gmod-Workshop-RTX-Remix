+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+#pragma once
+
+// NV-DXVK: how an idle worker of a low-latency WorkerThreadPool waits (runtime patch 0105 of the GMod native loader
+// project). Self-contained (the standard library only), so the project's gate compiles and runs
+// tests/rtx/unit/test_worker_idle.cpp against it; util_threadpool.h is the pool's side.
+//
+// The pool's low-latency mode, which the geometry workers use (D3D9Rtx::GeometryProcessor), let an idle worker poll
+// its queue, try to steal and yield without end: each worker kept a whole core busy from its first task to the end of
+// the process, in the main menu too. A worker now polls as before for kWorkerSpinWindow after its last task, so the
+// draws of a frame keep their latency, and then sleeps until a task is counted or the pool stops.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+
+namespace dxvk {
+
+  // How long an idle low-latency worker keeps polling after its last task before it sleeps. Long against waking a
+  // sleeping thread (tens of microseconds), so a pause between draws that ends with a wake-up grows by a few percent at
+  // most, and short against a frame (4 to 16 ms), so the workers sleep between the frames' draws and in menus.
+  inline constexpr std::chrono::microseconds kWorkerSpinWindow { 1000 };
+
+  // One worker's rounds without a task: when its window started.
+  class WorkerSpin {
+  public:
+    using Clock = std::chrono::steady_clock;
+
+    // The worker ran a task: its next round without one starts a new window.
+    void worked() {
+      m_idle = false;
+    }
+
+    // A round found no task: true while the window lasts (the worker yields and polls again), false once it is over.
+    // A worker woken from its sleep keeps its old window, so a wake-up that finds no task sleeps again at once.
+    bool keepPolling() {
+      return keepPolling(Clock::now());
+    }
+
+    bool keepPolling(Clock::time_point now) {
+      if (!m_idle) {
+        m_idle = true;
+        m_since = now;
+      }
+      return now - m_since < kWorkerSpinWindow;
+    }
+
+  private:
+    bool m_idle = false;
+    Clock::time_point m_since {};
+  };
+
+  // Where the workers sleep once their window is over. Mutex and Condition are the pool's own kinds (dxvk::mutex and
+  // dxvk::condition_variable); the unit test uses the standard ones.
+  template<typename Mutex, typename Condition>
+  class WorkerSleep {
+  public:
+    // A worker: sleeps until ready() holds (a task counted, or the pool stopping). It counts itself as a sleeper before
+    // ready() is tested under the lock, and wake() reads that count after the scheduler counted its task, both
+    // sequentially consistent: either ready() sees the task, or wake() sees the sleeper and notifies under the lock,
+    // which the sleeper holds from its test until it waits. No task is left waiting for a worker that sleeps.
+    template<typename Ready>
+    void sleep(const Ready& ready) {
+      std::unique_lock<Mutex> lock(m_mutex);
+      m_sleepers.fetch_add(1);
+      m_condition.wait(lock, ready);
+      m_sleepers.fetch_sub(1);
+    }
+
+    // The scheduler, after it queued and counted a task: wakes one sleeper, or every sleeper for workers that cannot
+    // take each other's tasks. While no worker sleeps it reads one atomic and takes no lock.
+    void wake(bool all) {
+      if (m_sleepers.load() == 0) {
+        return;
+      }
+      std::lock_guard<Mutex> lock(m_mutex);
+      if (all) {
+        m_condition.notify_all();
+      } else {
+        m_condition.notify_one();
+      }
+    }
+
+    // The pool stops, its flag already set: every sleeper wakes and sees it.
+    void stop() {
+      std::lock_guard<Mutex> lock(m_mutex);
+      m_condition.notify_all();
+    }
+
+    // Workers asleep or about to sleep.
+    uint32_t sleepers() const {
+      return m_sleepers.load();
+    }
+
+  private:
+    Mutex m_mutex;
+    Condition m_condition;
+    std::atomic<uint32_t> m_sleepers { 0 };
+  };
+
+}
