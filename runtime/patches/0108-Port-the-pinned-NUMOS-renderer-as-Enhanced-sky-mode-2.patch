--- /dev/null
+++ b/tests/rtx/unit/test_enhanced_sky.cpp
@@ -0,0 +1,78 @@
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <set>
+#include <string>
+
+#include "../../../src/dxvk/rtx_render/rtx_numos_policy.h"
+#include "../../../src/dxvk/rtx_render/rtx_numos_settings.h"
+#include "../../../src/dxvk/rtx_render/rtx_numos_weather.h"
+#include "../../../src/dxvk/rtx_render/rtx_sky_mode.h"
+
+namespace dxvk {
+  Logger Logger::s_instance("test_enhanced_sky.log");
+}
+
+static void check(bool condition, const std::string& message) {
+  if (!condition) {
+    std::fprintf(stderr, "%s\n", message.c_str());
+    std::exit(1);
+  }
+}
+
+int main() {
+  using namespace dxvk;
+  using namespace enhancedSky;
+  for (bool vr : { false, true }) {
+    check(effectiveSkyMode(SkyMode::SkyboxRasterization, vr) == SkyMode::SkyboxRasterization, "Raster sky");
+    check(effectiveSkyMode(SkyMode::Numos, vr) == SkyMode::Numos, "Standard sky");
+    check(effectiveSkyMode(SkyMode::Enhanced, vr) == (vr ? SkyMode::Numos : SkyMode::Enhanced), "Enhanced sky");
+  }
+
+  std::set<std::string> keys;
+  for (size_t i = 0; i < NumosSettings::count(); ++i) {
+    const auto& info = *NumosSettings::entry(i).pInfo;
+    const auto suffix = settingName(info.key);
+    check(!suffix.empty(), info.key);
+    const std::string key = std::string("rtx.atmosphere.numos.") + info.key.substr(sizeof("rtx.atmosphere.") - 1);
+    check(key == std::string(category) + "." + suffix, info.key);
+    const auto* registered = RtxOptionImpl::getOptionByFullName(key);
+    if (numos::isDeprecated(info)) {
+      check(!registered, key);
+    } else {
+      check(registered && registered->getFullName() == key && keys.insert(key).second, key);
+    }
+  }
+  check(keys.size() == 221, "Expected all settings of the pinned NUMOS library");
+  check(!RtxOptionImpl::getOptionByFullName(std::string(weatherCategory) + ".presetDirectory"), "Preset path");
+  check(NumosWeather::preset.getFullName() == "rtx.atmosphere.numos.weather.preset", "Weather namespace");
+
+  using P = numos::WeatherPreset;
+  numos::Settings base {};
+  base.cloudDensity = 9.5f;
+  base.worldScale = 0.125f;
+  for (unsigned i = 0; i < unsigned(P::Count); ++i) {
+    const P which = P(i);
+    const auto name = numos::weatherPresetName(which);
+    check(findPreset(name) == which, name);
+    Weather weather;
+    const auto got = weather.update(base, name, false, "Storm", "", 1, 10, 0);
+    const auto want = numos::weatherPreset(which, base);
+    check(got.cloudCoverageMean == want.cloudCoverageMean && got.fogVisibilityMeters == want.fogVisibilityMeters &&
+          got.worldScale == base.worldScale, name);
+  }
+  check(findPreset(" ../Fair.conf ,  unknown, fAiR , Storm") == P::Fair, "Game ID preference");
+  Weather weather;
+  auto got = weather.update(base, "../unknown.conf", true, "", "", -1, 3, 0);
+  check(got.cloudDensity == base.cloudDensity, "Unbound weather retains live settings");
+  const auto fair = numos::weatherPreset(P::Fair, base);
+  const auto fog = numos::weatherPreset(P::Fog, base);
+  got = weather.update(base, "Storm", true, "Fog", "Fair", 0.5f, 20, 0);
+  const auto middle = numos::blendWeather(fair, fog, 0.5f);
+  check(got.fogVisibilityMeters == middle.fogVisibilityMeters, "Game controls the blend");
+  got = weather.update(base, "Fair", false, "Fog", "", -1, 4, 0);
+  check(got.cloudCoverageMean == middle.cloudCoverageMean, "Interrupted blend starts at displayed weather");
+  got = weather.update(base, "Fair", false, "Fog", "", -1, 4, 4);
+  check(got.cloudCoverageMean == fair.cloudCoverageMean, "Manual transition reaches Fair");
+  std::puts("Enhanced sky modes, 221 registered settings and eleven weather presets passed");
+}
