+#. option rtx.waterSim.sludge.enable
+#: src/dxvk/rtx_render/rtx_water_sim.h:71
+msgid "Disturbances open sludge (rtx.sludgeTextures) into water."
+msgstr "Les perturbations dégagent la boue (rtx.sludgeTextures) pour faire apparaître l'eau."
+
+#. option rtx.waterSim.sludge.holeSize
+#: src/dxvk/rtx_render/rtx_water_sim.h:72
+msgid "Size of the hole a disturbance opens, in disturbance radii."
+msgstr "Taille du trou qu'ouvre une perturbation, en rayons de perturbation."
+
+#. option rtx.waterSim.sludge.holeLifetimeSeconds
+#: src/dxvk/rtx_render/rtx_water_sim.h:73
+msgid "Time for a hole to close to about a third, from its edges."
+msgstr "Temps qu'il faut à un trou pour se refermer, depuis ses bords, jusqu'à environ un tiers."
+
+#. option rtx.waterSim.sludge.waterTransmittance
+#: src/dxvk/rtx_render/rtx_water_sim.h:74
+msgid "Color of the light through the water under the sludge after waterMeasurementDistanceMeters."
+msgstr "Couleur de la lumière qui traverse l'eau sous la boue, après waterMeasurementDistanceMeters."
+
+#. option rtx.waterSim.sludge.waterMeasurementDistanceMeters
+#: src/dxvk/rtx_render/rtx_water_sim.h:75
+msgid "Distance at which light through the water under the sludge takes the waterTransmittance color."
+msgstr "Distance à laquelle la lumière qui traverse l'eau sous la boue prend la couleur waterTransmittance."
+
+#. option rtx.waterSim.enable
+#: src/dxvk/rtx_render/rtx_water_sim.h:82
+msgid "Runs the water simulation on animated water."
+msgstr "Exécute la simulation de l'eau sur l'eau animée."
+
+#. option rtx.waterSim.resolution
+#: src/dxvk/rtx_render/rtx_water_sim.h:83
+msgid "Cells along each side of the simulated area, which follows the camera."
+msgstr "Nombre de cellules sur chaque côté de la zone simulée, qui suit la caméra."
+
+#. option rtx.waterSim.cellSizeMeters
+#: src/dxvk/rtx_render/rtx_water_sim.h:84
+msgid "Size of one cell, so that the simulated area is resolution times this wide."
+msgstr "Taille d'une cellule : la zone simulée mesure la résolution multipliée par cette valeur."
+
+#. option rtx.waterSim.waveSpeedMetersPerSecond
+#: src/dxvk/rtx_render/rtx_water_sim.h:85
+msgid "How fast ripples travel across the water."
+msgstr "Vitesse à laquelle les ondulations se propagent sur l'eau."
+
+#. option rtx.waterSim.rippleLifetimeSeconds
+#: src/dxvk/rtx_render/rtx_water_sim.h:86
+msgid "Time for ripples to fade to about a third while the water settles back to rest."
+msgstr "Temps qu'il faut aux ondulations pour s'atténuer jusqu'à environ un tiers, pendant que l'eau revient au repos."
+
+#. option rtx.waterSim.maxHeightMeters
+#: src/dxvk/rtx_render/rtx_water_sim.h:87
+msgid "The highest a wave rises or the deepest a splash digs, which also bounds the parallax search."
+msgstr "Hauteur maximale que peut atteindre une vague, ou profondeur maximale que peut creuser une éclaboussure ; borne aussi la recherche de parallaxe."
+
+#. option rtx.waterSim.parallaxMaxSteps
+#: src/dxvk/rtx_render/rtx_water_sim.h:88
+msgid "Height samples a view ray takes at grazing angles to find the waves, a quarter of them looking straight down, and 0 for no parallax."
+msgstr "Nombre d'échantillons de hauteur qu'un rayon de vue prend aux angles rasants pour trouver les vagues (un quart en regardant droit vers le bas) ; 0 pour aucune parallaxe."
+
+#. option rtx.waterSim.silhouettes
+#: src/dxvk/rtx_render/rtx_water_sim.h:89
+msgid "Banks and objects hide the wave troughs behind them, at the cost of a short ray for each water pixel that looks into a trough."
+msgstr "Les berges et les objets masquent les creux des vagues situés derrière eux, au prix d'un rayon court pour chaque pixel d'eau qui regarde dans un creux."
+
+#. option rtx.waterSim.restDepthMeters
+#: src/dxvk/rtx_render/rtx_water_sim.h:90
+msgid "How far below the water mesh the water rests, so that the water line follows the shore (needs silhouettes)."
+msgstr "Profondeur, sous le maillage de l'eau, à laquelle l'eau se trouve au repos, pour que la ligne d'eau suive le rivage (nécessite « Silhouettes »)."
+
+#. option rtx.waterSim.detail
+#: src/dxvk/rtx_render/rtx_water_sim.h:93
+msgid "Wind waves and droplet rings replace the material's normal maps."
+msgstr "Les vagues de vent et les anneaux de gouttes remplacent les cartes de normales du matériau."
+
+#. option rtx.waterSim.waveSlope
+#: src/dxvk/rtx_render/rtx_water_sim.h:94
+msgid "Steepness of the wind waves: 0.01 to 0.02 calm, about 0.05 breezy, 0.08 and more choppy."
+msgstr "Pente des vagues de vent : 0.01 à 0.02 pour une eau calme, environ 0.05 pour une brise, 0.08 et plus pour une eau agitée."
+
+#. option rtx.waterSim.wavePeakLengthMeters
+#: src/dxvk/rtx_render/rtx_water_sim.h:95
+msgid "Length of the largest wind waves, with shorter ones down to a sixth of it."
+msgstr "Longueur des plus grandes vagues de vent, les plus courtes descendant jusqu'à un sixième de celle-ci."
+
+#. option rtx.waterSim.wavePeriodSeconds
+#: src/dxvk/rtx_render/rtx_water_sim.h:96
+msgid "Time for the largest wind wave to pass a point, which sets how fast all wind waves move."
+msgstr "Temps que met la plus grande vague de vent à passer en un point ; il fixe la vitesse de toutes les vagues de vent."
+
+#. option rtx.waterSim.waveDirectionDegrees
+#: src/dxvk/rtx_render/rtx_water_sim.h:97
+msgid "Direction the wind waves travel, measured from the first axis of the water plane."
+msgstr "Direction dans laquelle se déplacent les vagues de vent, mesurée depuis le premier axe du plan de l'eau."
+
+#. option rtx.waterSim.waveSpread
+#: src/dxvk/rtx_render/rtx_water_sim.h:98
+msgid "How widely the wind waves spread around their direction, from 0 (all along it) to 1 (every way)."
+msgstr "Dispersion des vagues de vent autour de leur direction, de 0 (toutes dans cette direction) à 1 (dans tous les sens)."
+
+#. option rtx.waterSim.swellSlope
+#: src/dxvk/rtx_render/rtx_water_sim.h:99
+msgid "Steepness of the long, gentle swell that keeps calm water alive."
+msgstr "Pente de la houle longue et douce qui garde l'eau calme vivante."
+
+#. option rtx.waterSim.swellLengthMeters
+#: src/dxvk/rtx_render/rtx_water_sim.h:100
+msgid "Length of the swell waves."
+msgstr "Longueur des vagues de houle."
+
+#. option rtx.waterSim.gustSizeMeters
+#: src/dxvk/rtx_render/rtx_water_sim.h:101
+msgid "Size of the calmer and rougher patches that gusts make on the water."
+msgstr "Taille des zones plus calmes et plus agitées que les rafales créent sur l'eau."
+
+#. option rtx.waterSim.rings.tileSizeMeters
+#: src/dxvk/rtx_render/rtx_water_sim.h:106
+msgid "Size of one tile of the droplet texture on the water."
+msgstr "Taille d'une tuile de la texture de gouttes sur l'eau."
+
+#. option rtx.waterSim.rings.slope
+#: src/dxvk/rtx_render/rtx_water_sim.h:107
+msgid "Steepness of the rings."
+msgstr "Pente des anneaux."
+
+#. option rtx.waterSim.rings.rain
+#: src/dxvk/rtx_render/rtx_water_sim.h:108
+msgid "Rings everywhere, from 0 (only where splashes land) to 1 (rain)."
+msgstr "Anneaux partout, de 0 (seulement là où retombent les éclaboussures) à 1 (pluie)."
+
