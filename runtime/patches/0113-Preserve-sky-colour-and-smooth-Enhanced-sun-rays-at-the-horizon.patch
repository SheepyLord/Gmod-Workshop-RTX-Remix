+
+// Keep at least a quarter of each sky channel (two stops) while preserving the spectrum of the removed light.
+inline float numosRayRemovalFactor(vec3 sky, vec3 requested) {
+  const vec3 budget = sky * 0.75f;
+  float factor = 1.f;
+  if (requested.x > budget.x) factor = budget.x / requested.x;
+  if (requested.y * factor > budget.y) factor = budget.y / requested.y;
+  if (requested.z * factor > budget.z) factor = budget.z / requested.z;
+  return factor;
+}
+
+// Sine of the planet limb as seen from the eye. Keep metre-scale heights precise at planet scale.
+inline float numosRayHorizonMu(float radiusKm, float altitudeKm) {
+  const float h = altitudeKm > 0.f ? altitudeKm : 0.f;
+  return -sqrt(h * (2.f * radiusKm + h)) / (radiusKm + h);
+}
