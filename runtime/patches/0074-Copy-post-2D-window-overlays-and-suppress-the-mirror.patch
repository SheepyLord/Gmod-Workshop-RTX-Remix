 namespace dxvk::vrpolicy {
   inline bool sdkCallsEnabled(uint32_t flags) { return !(flags&RTXVR_START_NO_SUBMIT); }
+  inline bool validWindowFlags(uint32_t flags) {
+    return !(flags&~(RTXVR_WINDOW_SHOW|RTXVR_WINDOW_NO_MIRROR))&&
+      (!(flags&RTXVR_WINDOW_NO_MIRROR)||(flags&RTXVR_WINDOW_SHOW));
+  }
+  inline std::pair<uint32_t,uint32_t> windowSize(uint32_t width,uint32_t height) {
+    if(!width||!height) { return {}; }
+    const auto w=std::min(width,1920u);
+    return {w,std::max(1u,uint32_t(uint64_t(height)*w/width))};
+  }
   template<typename Action,typename Error>
   bool resources(Action action,Error error) {
     try { action();return true; }
