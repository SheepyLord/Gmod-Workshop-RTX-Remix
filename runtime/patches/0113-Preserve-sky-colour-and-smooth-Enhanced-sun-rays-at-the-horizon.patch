-  // Cranley-Patterson rotation of a per-texel offset over stratified, near-biased intervals.
-  float jitter = frac(52.9829189f * frac(dot(float2(id.xy), float2(.06711056f, .00583715f))) +
-                      float(controls.frame & 4095u) * .618033989f);
   float a = start;
   for (uint i = 0u; i < controls.steps; ++i) {
     float q = float(i + 1u) / float(controls.steps);
     float b = lerp(start, end, q*q);
+    // Use the renderer's 128x128x64 spatiotemporal blue noise at ray-grid resolution. Each
+    // stratum gets its own sample, and advances through consecutive slices across frames.
+    uint2 noisePixel = (id.xy + i * uint2(37, 73)) & 127u;
+    float noise = blueNoise.Load(int4(noisePixel, (controls.frame + 17u * i) & 63u, 0));
+    float jitter = (noise * 255.f + .5f) / 256.f;
     float distance = lerp(a, b, jitter);
     float3 world = sky.cameraPosition + ray.worldDirection * distance;
     enhanced_ApMediumSample m = enhanced_apSampleMedium(world, sky);
@@ -106,13 +121,25 @@ void main(uint3 id : SV_DispatchThreadID) {
     float4 clip = mul(frame.camera.prevWorldToProjectionJittered, float4(lastPoint, 1.f));
     float2 prevUv = cameraNDCToScreenUV(frame.camera, clip.xy / max(clip.w, 1e-7f));
     if (clip.w > 0.f && all(prevUv >= 0.f) && all(prevUv < 1.f)) {
-      int2 prevPixel = min(int2(prevUv * float2(frame.camera.resolution) / controls.divisor), int2(controls.width, controls.height) - 1);
-      float4 old = previous.Load(int3(prevPixel, 0));
-      if (old.a >= 0.f) {
-        float agree = saturate(1.f - abs(old.a - anchorKm) / max(1.f, .4f * anchorKm));
-        float3 limit = max(.35f * value, 1e-5f);
-        value = lerp(value, clamp(old.rgb, max(0.xxx, value - limit), value + limit), controls.historyWeight * agree);
+      float2 grid = prevUv * float2(frame.camera.resolution) / controls.divisor - .5f;
+      int2 center = int2(floor(grid + .5f));
+      float3 wx = rayHistoryWeights(grid.x - center.x);
+      float3 wy = rayHistoryWeights(grid.y - center.y);
+      float3 delta = 0.xxx;
+      [unroll] for (int y = 0; y < 3; ++y) {
+        [unroll] for (int x = 0; x < 3; ++x) {
+          int2 tap = center + int2(x - 1, y - 1);
+          if (any(tap < 0) || any(tap >= int2(controls.width, controls.height))) continue;
+          float4 old = previous.Load(int3(tap, 0));
+          if (old.a <= 0.f) continue;
+          // The anchor is a sampled light centroid. Small changes are noise, large ratios a different column.
+          float agreement = smoothstep(.2f, .65f, min(old.a, anchorKm) / max(max(old.a, anchorKm), 1e-5f));
+          // The unshadowed integral bounds the deficit even when a fresh jitter sample happens to see zero shadow.
+          float3 history = controls.debugView <= 1u ? min(old.rgb, clear) : old.rgb;
+          delta += wx[x] * wy[y] * agreement * (history - value);
+        }
       }
+      value += controls.historyWeight * delta;
     }
   }
   result[id.xy] = float4(value, min(anchorKm, 65000.f));
