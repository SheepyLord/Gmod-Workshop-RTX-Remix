+namespace dxvk {
+  namespace {
+    constexpr ImGuiSliderFlags kClamp = ImGuiSliderFlags_AlwaysClamp;
+    const float kAuto = std::numeric_limits<float>::quiet_NaN();
+    bool presetWindowOpen = false; // Present thread only.
+
+    struct FieldText {
+      const char* label;
+      const char* help;
+    };
+    const FieldText& fieldText(const numos::SettingInfo& info) {
+      static const std::unordered_map<std::string, FieldText> fields{
+#define NUMOS_UI_FIELD(key, label, help) {key, {label, help}},
+#include "rtx_numos_ui_fields.inl"
+#undef NUMOS_UI_FIELD
+      };
+      auto name = enhancedSky::settingName(info.key);
+      if (name.size() > 6 && name.compare(0, 4, "moon") == 0 && name[5] == '.')
+        name.erase(4, 1);
+      return fields.at(name);
+    }
+
+    bool sameField(const numos::Settings& a, const numos::Settings& b, const numos::SettingInfo& info) {
+      size_t size = 0;
+      switch (info.type) {
+      case numos::SettingType::Bool:
+        size = sizeof(bool);
+        break;
+      case numos::SettingType::Float:
+        size = sizeof(float);
+        break;
+      case numos::SettingType::Int:
+        size = sizeof(int32_t);
+        break;
+      case numos::SettingType::Uint:
+        size = sizeof(uint32_t);
+        break;
+      case numos::SettingType::Vec3:
+        size = sizeof(numos::Vector3);
+        break;
+      }
+      return std::memcmp(reinterpret_cast<const char*>(&a) + info.offset,
+                         reinterpret_cast<const char*>(&b) + info.offset, size) == 0;
+    }
+
+    // A preset can fix a field to its default. Probe it over two different base weathers to distinguish that case.
+    bool presetOwns(numos::WeatherPreset preset, size_t index) {
+      using P = numos::WeatherPreset;
+      if (preset == P::Count)
+        return false;
+      static const auto masks = [] {
+        std::array<std::vector<bool>, size_t(P::Count)> result;
+        const numos::Settings defaults{};
+        numos::Settings moved = defaults;
+        auto perturb = numos::weatherFromSettings(moved);
+        size_t count = 0;
+        const auto* fields = numos::weatherFields(count);
+        for (size_t i = 0; i < count; ++i) {
+          float& v = perturb.*(fields[i].member);
+          v = fields[i].kind == numos::WeatherFieldKind::Flag ? float(v == 0.f) : v * 1.37f + 0.731f;
+        }
+        numos::applyWeather(perturb, moved);
+        for (size_t i = 0; i < result.size(); ++i) {
+          auto a = defaults, b = moved;
+          numos::applyWeather(numos::weatherPreset(P(i), defaults), a);
+          numos::applyWeather(numos::weatherPreset(P(i), moved), b);
+          for (const auto& field : numos::settingInfos()) {
+            result[i].push_back(!sameField(a, defaults, field) ||
+                                (!sameField(defaults, moved, field) && sameField(a, b, field)));
+          }
+        }
+        return result;
+      }();
+      return masks[size_t(preset)][index];
+    }
+
+    const char* presetLabel(numos::WeatherPreset preset) {
+      static const char* names[] = {"Clear sky", "Fair weather", "Partly cloudy", "Cloudy",
+                                    "Overcast",  "Haze",         "Fog",           "Storm",
+                                    "Drizzle",   "Altostratus",  "Cirrus",        "Custom settings"};
+      static_assert(std::size(names) == size_t(numos::WeatherPreset::Count) + 1);
+      return names[size_t(preset)];
+    }
+
+    const char* gameWeatherLabel(const std::string& ids) {
+      const auto preset = enhancedSky::findPreset(ids);
+      return preset == numos::WeatherPreset::Count ? ids.c_str() : fork_hooks::translateUiText(presetLabel(preset));
+    }
+
+    void companionNote() {
+      ImGui::TextWrapped("The RTX Remix tab's Sky and weather and Enhanced sky editor pages also set these values. "
+                         "Changing weather or look, or starting a map, applies the companion settings again.");
+    }
+
+    class Pages {
+    public:
+      explicit Pages(DxvkContext* ctx) {
+        ctx->getCommonObjects()->metaNumos().readUiStatus(status);
+      }
+      NumosUiStatus status;
+
+      enum class Kind { Auto, Color, SpeedMetersPerSecond };
+
+      void weatherNote() const {
+        if (status.ready && status.preset != numos::WeatherPreset::Count)
+          ImGui::TextWrapped("The %s preset controls settings marked as weather.",
+                             fork_hooks::translateUiText(presetLabel(status.preset)));
+      }
+
+      bool overriddenByWeather(const NumosSettings::Entry& e) const {
+        return status.ready && (presetOwns(status.preset, size_t(e.pInfo - numos::settingInfos().data())) ||
+                                !sameField(status.base, status.shown, *e.pInfo));
+      }
+
+      template <typename T> T shownValue(const NumosSettings::Entry& e) const {
+        return *reinterpret_cast<const T*>(reinterpret_cast<const char*>(&status.shown) + e.pInfo->offset);
+      }
+
+      template <typename T, typename Draw>
+      void widget(bool weather, RtxOption<T>* option, T value, const char* help, Draw draw) {
+        ImGui::BeginDisabled(weather);
+        {
+          RemixGui::RtxOptionUxWrapper wrapper(option, help);
+          if (draw(value) && !weather) {
+            RemixGui::CheckRtxOptionPopups(option);
+            option->setDeferred(value);
+          }
+        }
+        ImGui::EndDisabled();
+        if (weather) {
+          ImGui::SameLine();
+          ImGui::TextDisabled("weather");
+          RemixGui::SetTooltipToLastWidgetOnHover(
+              "This value follows a preset. To edit it, select Custom settings and turn off Follow game weather.");
+        }
+      }
+
+      void drawEntry(const NumosSettings::Entry& e, const char* label, float speed, float mn, float mx,
+                     const char* format, Kind kind, const char* help = nullptr) {
+        const auto& info = *e.pInfo;
+        if (!help)
+          help = fieldText(info).help;
+        const float unitScale = kind == Kind::SpeedMetersPerSecond ? 1000.f : 1.f;
+        const bool hasMin = info.minValue != numos::NUMOS_NO_MIN;
+        const bool hasMax = info.maxValue != numos::NUMOS_NO_MAX;
+        if (std::isnan(mn) && std::isnan(mx) && !hasMin && !hasMax) {
+          mn = mx = 0.f; // ImGui's unlimited drag.
+        } else {
+          const float low = hasMin ? info.minValue * unitScale : -std::numeric_limits<float>::max();
+          const float high = hasMax ? info.maxValue * unitScale : std::numeric_limits<float>::max();
+          mn = std::isnan(mn) ? low : std::max(low, mn);
+          mx = std::isnan(mx) ? high : std::min(high, mx);
+        }
+        const bool weather = overriddenByWeather(e);
+        ImGui::PushID(e.option());
+        if (auto* o = e.pBoolOption) {
+          widget(weather, o, weather ? shownValue<bool>(e) : o->get(), help,
+                 [&](bool& v) { return RemixGui::Checkbox(label, &v); });
+        } else if (auto* o = e.pFloatOption) {
+          const bool ms = kind == Kind::SpeedMetersPerSecond;
+          const bool bounded = hasMin && hasMax && mn < mx;
+          const float defaultStep = bounded ? std::max((mx - mn) / 1000.f, 1e-5f)
+                                            : std::max(std::abs(o->getDefaultValue()) * unitScale * .01f, 1e-4f);
+          const float step = std::isnan(speed) ? defaultStep : speed;
+          widget(weather, o, weather ? shownValue<float>(e) : o->get(), help, [&](float& v) {
+            float display = ms ? v * 1000.f : v;
+            const bool changed = RemixGui::DragFloat(label, &display, step, mn, mx,
+                                                     ms       ? "%.1f m/s"
+                                                     : format ? format
+                                                              : "%.4g",
+                                                     kClamp);
+            v = ms ? display * .001f : display;
+            return changed;
+          });
+        } else if (e.pIntOption || e.pUintOption) {
+          const float step = std::isnan(speed) ? 1.f : speed;
+          const int lo = int(std::clamp(double(mn), double(INT_MIN), double(INT_MAX)));
+          const int hi = int(std::clamp(double(mx), double(INT_MIN), double(INT_MAX)));
+          if (auto* o = e.pIntOption) {
+            widget(weather, o, weather ? shownValue<int32_t>(e) : o->get(), help,
+                   [&](int32_t& v) { return RemixGui::DragInt(label, &v, step, lo, hi, "%d", kClamp); });
+          } else {
+            auto* u = e.pUintOption;
+            widget(weather, u, weather ? shownValue<uint32_t>(e) : u->get(), help, [&](uint32_t& v) {
+              int display = int(std::min(v, uint32_t(INT_MAX)));
+              const bool changed = RemixGui::DragInt(label, &display, step, lo, hi, "%d", kClamp);
+              v = uint32_t(std::max(0, display));
+              return changed;
+            });
+          }
+        } else if (auto* o = e.pVec3Option) {
+          Vector3 value = o->getCopy();
+          if (weather) {
+            const auto v = shownValue<numos::Vector3>(e);
+            value = Vector3(v.x, v.y, v.z);
+          }
+          const bool tint = kind == Kind::Color || (kind == Kind::Auto && isColorName(info.key));
+          widget(weather, o, value, help, [&](Vector3& v) {
+            return tint ? RemixGui::ColorEdit3(label, v.data, ImGuiColorEditFlags_Float | ImGuiColorEditFlags_HDR)
+                        : RemixGui::DragFloat3(label, v.data, std::isnan(speed) ? .01f : speed, mn, mx,
+                                               format ? format : "%.4g", kClamp);
+          });
+        }
+        ImGui::PopID();
+      }
+
+      bool isColorName(const std::string& name) {
+        for (const char* word : {"Color", "color", "Tint", "tint", "Albedo", "albedo", "Illuminance"}) {
+          if (name.find(word) != std::string::npos) {
+            return true;
+          }
+        }
+        return false;
+      }
