-        { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
-        { 0, 0, 0 },
-        rtOutput.m_finalOutputExtent);
+      rtOutput.advancePostFxColor();
     }

   } // namespace fork_hooks
