+                           " materials=", s.materials, " materials_ms=", uint64_t(s.materialsMs + 0.5),
+                           " textures=", s.textures, " usd_ms=", uint64_t(s.usdMs + 0.5),
+                           " find_ms=", uint64_t(s.findMs + 0.5), " preload_ms=", uint64_t(s.preloadMs + 0.5),
+                           " meshes=", s.meshes, " meshes_ms=", uint64_t(s.meshesMs + 0.5),
+                           " lights=", s.lights, " lights_ms=", uint64_t(s.lightsMs + 0.5)));
+  // NV-DXVK start: the mod texture cache (ADR 0195)
+  if (m_textureCache) {
+    const auto& c = m_textureCache->counters();
+    Logger::info(str::format("[RTX Mod Texture Cache] mod=", name, " lookups=", m_textureCache->lookups(), " repeats=", m_textureCache->repeats(),
+                             " hits=", c.hits, " misses=", c.misses, " unkept=", c.unkept, " unlisted=", c.unlisted, " folders=", c.folders,
+                             " list_ms=", uint64_t(c.listMs + 0.5), " read_ms=", uint64_t(c.readMs + 0.5),
+                             " save_ms=", uint64_t(c.saveMs + 0.5), " loaded=", c.loaded ? 1 : 0, " ignored=", c.ignored ? 1 : 0,
+                             " saved=", c.saved ? 1 : 0, " save_failed=", c.saveFailed ? 1 : 0));
+  }
+  // NV-DXVK end
+}
