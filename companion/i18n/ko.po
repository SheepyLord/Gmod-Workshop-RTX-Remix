# Translations of the GMod native loader companion (the RTX Remix tab, the guide).
# Edit msgstr only; see companion/i18n/README.md. An empty msgstr shows the English.
msgid ""
msgstr ""
"Project-Id-Version: GMod native loader companion\n"
"Language: ko\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: nativeloader/lua/autorun/!!!!nativeloader_engine_guard.lua:137
#, c-format
msgid "%s, in the add-on %s"
msgstr "%s(애드온 %s)"

#: nativeloader/lua/autorun/!!!!nativeloader_engine_guard.lua:140
#, c-format
msgid ""
"The last start of Garry's Mod did not get past starting Lua. It stopped in %s.\n"
"If that happens again, disable that add-on."
msgstr ""
"지난번 Garry's Mod 시작이 Lua 시작 단계를 넘지 못하고 %s에서 멈췄습니다.\n"
"다시 발생하면 그 애드온을 비활성화하세요."

