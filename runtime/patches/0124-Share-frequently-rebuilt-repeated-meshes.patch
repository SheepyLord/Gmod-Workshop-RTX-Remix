   // --- Incremental BLAS build caching ---
   // Scene generation from InstanceManager when the BLAS was last built.
   uint64_t m_lastProcessedGeneration = UINT64_MAX;
diff --git a/src/dxvk/rtx_render/rtx_repeated_mesh_blas.h b/src/dxvk/rtx_render/rtx_repeated_mesh_blas.h
new file mode 100644
index 0000000000000000000000000000000000000000..d485ca40b7ffa3aa25c1eab1dedd6b83d07e7c1f
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_repeated_mesh_blas.h
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cstdint>
+#include <tuple>
+#include <vulkan/vulkan_core.h>
+
+namespace dxvk {
+
+  // A pass counts only distinct ray-visible instances. A second eye evaluates its own set.
+  struct RepeatedMeshCopies {
+    uint32_t count = 0;
+    uint32_t geometryFlags = 0;
+    uint64_t micromapSource = 0;
+    int32_t micromapFormat = -1; // No binding request.
+    bool compatible = true;
+
+    void add(uint32_t flags, bool eligible, uint64_t source = 0, int32_t format = -1) {
+      if (count == 0) {
+        geometryFlags = flags;
+        micromapSource = source;
+        micromapFormat = format;
+      }
+      compatible &= eligible && flags == geometryFlags && source == micromapSource && format == micromapFormat;
+      ++count;
+    }
+  };
+
+  // Object-space inputs of one unsplit triangle geometry. Transforms of individual placements live in the TLAS.
+  struct RepeatedMeshInputs {
+    uint32_t vertexRevision = 0;
+    uint64_t positions = 0;
+    uint64_t indices = 0;
+    uint64_t bones = 0;
+    uint64_t vertexShader = 0;
+    uint64_t micromapSource = 0;
+    const void* micromapObject = nullptr;
+    VkBuildAccelerationStructureFlagsKHR buildFlags = 0;
+    VkGeometryFlagsKHR geometryFlags = 0;
+    VkAccelerationStructureGeometryTrianglesDataKHR triangles {};
+    VkAccelerationStructureBuildRangeInfoKHR range {};
+
+    auto fields() const {
+      return std::tie(vertexRevision, positions, indices, bones, vertexShader, micromapSource, micromapObject,
+        buildFlags, geometryFlags, triangles.pNext, triangles.vertexFormat, triangles.vertexData.deviceAddress,
+        triangles.vertexStride, triangles.maxVertex, triangles.indexType, triangles.indexData.deviceAddress,
+        triangles.transformData.deviceAddress, range.primitiveCount, range.primitiveOffset, range.firstVertex, range.transformOffset);
+    }
+  };
+
+  struct RepeatedMeshBuildRecord {
+    const void* owner = nullptr;
+    RepeatedMeshInputs inputs {};
+
+    bool matches(const void* liveOwner, const RepeatedMeshInputs& current) const {
+      // Zero is Remix's unavailable content hash. Non-indexed meshes do not need an index hash.
+      const bool knownContent = current.positions != 0 && (current.triangles.indexType == VK_INDEX_TYPE_NONE_KHR || current.indices != 0);
+      return knownContent && liveOwner && owner == liveOwner && inputs.fields() == current.fields();
+    }
+  };
+
+  class RepeatedMeshBuilds {
+  public:
+    // Count triangles beyond the first copy, in units of the normal promotion threshold.
+    static bool enoughCopies(uint32_t triangles, uint64_t copies, uint32_t minimum, bool retaining = false) {
+      const uint32_t units = retaining ? 4 : 8;
+      if (triangles < 100 || triangles >= minimum || copies < units)
+        return false;
+      // The TLAS count is 32-bit. Saturate a larger linked-set size before multiplying.
+      const uint64_t extraCopies = copies - 1 > UINT32_MAX ? UINT32_MAX : copies - 1;
+      return extraCopies * triangles >= uint64_t(units) * minimum;
+    }
+
+    void recordBuild(uint32_t frame, uint32_t triangles, uint32_t rebuiltCopies, uint32_t minimum) {
+      if (!enoughCopies(triangles, rebuiltCopies, minimum) || (m_streak && frame == m_lastBuild))
+        return;
+      if (m_streak && frame - m_lastBuild == 1) {
+        if (m_streak < kFramesToShare)
+          ++m_streak;
+      } else {
+        m_streak = 1;
+      }
+      m_lastBuild = frame;
+    }
+
+    bool recent(uint32_t frame) const { return m_streak && frame - m_lastBuild <= 1; }
+    bool considered(uint32_t frame) const { return m_shared || (m_streak == kFramesToShare && recent(frame)); }
+    bool shared() const { return m_shared; }
+
+    void select(uint32_t frame, uint32_t triangles, uint32_t minimum, const RepeatedMeshCopies& copies, bool rigid) {
+      const bool next = considered(frame) && rigid && copies.compatible &&
+                        enoughCopies(triangles, copies.count, minimum, m_shared);
+      if (m_shared && !next)
+        m_streak = 0;
+      m_shared = next;
+    }
+
+  private:
+    static constexpr uint8_t kFramesToShare = 3;
+    uint32_t m_lastBuild = 0;
+    uint8_t m_streak = 0;
+    bool m_shared = false;
+  };
+
+}
