--- a/src/dxvk/rtx_render/rtx_context.cpp
+++ b/src/dxvk/rtx_render/rtx_context.cpp
@@ -954,6 +954,24 @@ namespace dxvk {
           blitImageHelper(this, srcImage, targetImage, VkFilter::VK_FILTER_NEAREST);
         }
 
+        // NV-DXVK start: HUD-less frame generation input (GMod)
+        // The swapchain's copy of its back buffer gets the same image, and no UI is drawn over it: DLSS frame
+        // generation keeps the UI in place where the back buffer differs from it (rtx_dlfg_hudless.h).
+        if (isDLFGEnabled()) {
+          auto& hudlessHandoff = m_common->metaDLFG().hudless();
+          uint64_t hudlessGeneration = 0;
+          const Rc<DxvkImage> hudless = hudlessHandoff.source(hudlessGeneration);
+          if (hudless != nullptr
+           && hudless->info().extent == targetImage->info().extent
+           && hudless->info().format == targetImage->info().format
+           && hudless->info().sampleCount == VK_SAMPLE_COUNT_1_BIT) {
+            ScopedGpuProfileZone(this, "DLFG HUD-less copy");
+            blitImageHelper(this, srcImage, hudless, VkFilter::VK_FILTER_NEAREST);
+            hudlessHandoff.mark(m_device->getCurrentFrameId(), hudlessGeneration);
+          }
+        }
+        // NV-DXVK end
+
         }
         // NV-DXVK start: VR true stereo
         }
