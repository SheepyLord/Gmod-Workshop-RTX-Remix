diff --git a/src/dxvk/rtx_render/rtx_vr_png.h b/src/dxvk/rtx_render/rtx_vr_png.h
new file mode 100644
index 00000000..87a95930
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_vr_png.h
@@ -0,0 +1,46 @@
+﻿// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+namespace dxvk::vrpng {
+  inline void word(std::vector<uint8_t>& out, uint32_t v) {
+    for (int i=24; i>=0; i-=8) { out.push_back(uint8_t(v>>i)); }
+  }
+  inline void chunk(std::vector<uint8_t>& out, const char* type, const std::vector<uint8_t>& data) {
+    word(out,uint32_t(data.size()));
+    const size_t begin=out.size();
+    out.insert(out.end(),type,type+4); out.insert(out.end(),data.begin(),data.end());
+    uint32_t crc=~0u;
+    for (size_t i=begin; i<out.size(); ++i) {
+      crc^=out[i];
+      for (int b=0; b<8; ++b) { crc=(crc>>1)^((0u-(crc&1))&0xedb88320u); }
+    }
+    word(out,~crc);
+  }
+  inline bool save(const std::filesystem::path& path, uint32_t w, uint32_t h, const uint8_t* rgba) {
+    std::vector<uint8_t> raw; raw.reserve((size_t(w)*4+1)*h);
+    uint32_t a=1,b=0;
+    for (uint32_t y=0; y<h; ++y) {
+      raw.push_back(0);
+      raw.insert(raw.end(),rgba+size_t(y)*w*4,rgba+size_t(y+1)*w*4);
+    }
+    for (auto v:raw) { a=(a+v)%65521; b=(b+a)%65521; }
+    std::vector<uint8_t> z {0x78,0x01};
+    for (size_t start=0; start<raw.size();) {
+      const uint16_t len=uint16_t(std::min(size_t(65535),raw.size()-start));
+      z.push_back(start+len==raw.size()?1:0);
+      z.push_back(uint8_t(len)); z.push_back(uint8_t(len>>8));
+      z.push_back(uint8_t(~len)); z.push_back(uint8_t((~len)>>8));
+      z.insert(z.end(),raw.begin()+start,raw.begin()+start+len); start+=len;
+    }
+    word(z,(b<<16)|a);
+    std::vector<uint8_t> png {137,80,78,71,13,10,26,10}, header;
+    word(header,w); word(header,h); header.insert(header.end(),{8,6,0,0,0});
+    chunk(png,"IHDR",header); chunk(png,"IDAT",z); chunk(png,"IEND",{});
+    std::ofstream file(path,std::ios::binary); file.write(reinterpret_cast<const char*>(png.data()),png.size());
+    return bool(file);
+  }
+}
diff --git a/src/dxvk/shaders/rtx/pass/vr/vr_warp.comp.slang b/src/dxvk/shaders/rtx/pass/vr/vr_warp.comp.slang
new file mode 100644
index 00000000..4926e14c
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/vr/vr_warp.comp.slang
@@ -0,0 +1,45 @@
+﻿// SPDX-License-Identifier: MIT
+#include "rtx/pass/vr/vr_warp.h"
+[[vk::binding(0)]] Texture2D<float4> Centre;
+[[vk::binding(1)]] Texture2D<float> Depth;
+[[vk::binding(2)]] RWTexture2D<float4> Eye;
+layout(push_constant) ConstantBuffer<VrWarpArgs> cb;
+float2 project(float3 p) {
+  return float2(0.5 + p.x/(-p.z)/(2*cb.centre.x), 0.5 - p.y/(-p.z)/(2*cb.centre.y));
+}
+float readDepth(float2 uv) {
+  uint w,h; Depth.GetDimensions(w,h);
+  int2 p=clamp(int2(uv*float2(w,h)),int2(0),int2(w-1,h-1));
+  const float z=abs(Depth.Load(int3(p,0)));
+  return isfinite(z) && z>0 ? z : 1e20;
+}
+float4 colour(float2 uv) {
+  uint w,h; Centre.GetDimensions(w,h);
+  float2 pos=uv*float2(w,h)-0.5;
+  int2 base=int2(floor(pos)); float2 f=frac(pos);
+  int2 hi=int2(w-1,h-1);
+  return lerp(lerp(Centre.Load(int3(clamp(base,int2(0),hi),0)), Centre.Load(int3(clamp(base+int2(1,0),int2(0),hi),0)), f.x),
+              lerp(Centre.Load(int3(clamp(base+int2(0,1),int2(0),hi),0)), Centre.Load(int3(clamp(base+int2(1,1),int2(0),hi),0)), f.x), f.y);
+}
+[shader("compute")]
+[numthreads(16,16,1)]
+void main(uint2 id:SV_DispatchThreadID) {
+  uint w,h; Eye.GetDimensions(w,h);
+  if (any(id>=uint2(w,h))) { return; }
+  const float2 uvEye=(float2(id)+0.5)/float2(w,h);
+  const float3 eyeRay=float3(lerp(cb.tangents.x,cb.tangents.y,uvEye.x),-lerp(cb.tangents.z,cb.tangents.w,uvEye.y),-1);
+  const float3 ray=float3(dot(cb.eyeRow0.xyz,eyeRay),dot(cb.eyeRow1.xyz,eyeRay),dot(cb.eyeRow2.xyz,eyeRay));
+  const float3 origin=float3(cb.eyeRow0.w,cb.eyeRow1.w,cb.eyeRow2.w);
+  float2 uv=project(ray);
+  float2 farUv=uv;
+  float farDepth=0;
+  for (int step=0; step<8; ++step) {
+    const float depth=readDepth(uv);
+    const float t=(depth+origin.z)/(-ray.z);
+    const float2 next=project(float3(origin.xy+ray.xy*t,-depth));
+    if (depth>farDepth) { farDepth=depth; farUv=next; }
+    if (length(next-uv)<1e-6) { farUv=next; break; }
+    uv=next;
+  }
+  Eye[id]=colour(saturate(farUv));
+}
