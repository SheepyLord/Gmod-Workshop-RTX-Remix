+      void showAllSettings() {
+        static char filter[128] = {};
+        ImGui::InputText("Search###NumosSettingsFilter", filter, sizeof(filter));
+        RemixGui::SetTooltipToLastWidgetOnHover("Search by option key, label or description.");
+        std::string lastMoon;
+        for (size_t i = 0; i < NumosSettings::count(); ++i) {
+          const auto& e = NumosSettings::entry(i);
+          if (!e.option())
+            continue;
+          const auto& text = fieldText(*e.pInfo);
+          const auto key = e.option()->getFullName();
+          if (!containsNoCase(key, filter) && !containsNoCase(fork_hooks::translateUiText(text.label), filter) &&
+              !containsNoCase(fork_hooks::translateUiText(text.help), filter))
+            continue;
+          const auto name = enhancedSky::settingName(e.pInfo->key);
+          if (name.size() > 6 && name[5] == '.' && name.compare(0, 4, "moon") == 0 && lastMoon != name.substr(0, 5)) {
+            lastMoon = name.substr(0, 5);
+            ImGui::Text("Moon %u", unsigned(name[4] - '0'));
+          }
+          drawEntry(e, text.label, kAuto, kAuto, kAuto, nullptr, Kind::Auto);
+        }
+      }
