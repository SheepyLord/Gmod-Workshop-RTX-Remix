+  int RtxVr::setQuality(const rtxvr_Quality* quality) {
+    if (!quality || !vrpolicy::validQuality(*quality)) { return RTXVR_E_ARGUMENT; }
+    std::lock_guard lock(m_requestMutex);
+    if (!m_active) { return RTXVR_E_NOT_RUNNING; }
+    if (quality->renderScale!=m_requested.renderScale) {
+      // The centre view follows the scale at once, as it does for an IPD change; the eye images
+      // are the render thread's, and applyQuality reallocates them.
+      vrmath::Projection p;
+      if (!vrmath::centreProjection(m_requested.eyes,m_requested.eyeWidth,m_requested.eyeHeight,
+            quality->renderScale,p,m_nearestDepth)) { return RTXVR_E_ARGUMENT; }
+      m_requested.renderScale=quality->renderScale; m_projection=p;
+    }
+    m_quality=*quality; ++m_qualityGeneration;
+    return RTXVR_OK;
+  }
+
+  void RtxVr::applyQuality(RtxContext& ctx) {
+    rtxvr_Quality wanted; uint64_t generation;
+    {
+      std::lock_guard lock(m_requestMutex);
+      if (!m_layer || m_qualityGeneration==m_renderQualityGeneration) { return; }
+      wanted=m_quality; generation=m_qualityGeneration;
+    }
+    RtxOptions::qualityDLSS.setDeferred(static_cast<DLSSProfile>(wanted.dlssQuality),m_layer);
+    RtxOptions::pathMinBounces.setDeferred(static_cast<uint8_t>(wanted.pathMinBounces),m_layer);
+    RtxOptions::pathMaxBounces.setDeferred(static_cast<uint8_t>(wanted.pathMaxBounces),m_layer);
+    RtxGlobalVolumetrics::enable.setDeferred((wanted.flags&RTXVR_QUALITY_VOLUMETRICS)!=0,m_layer);
+    const uint32_t samples=vrpolicy::cloudSamples(wanted.flags);
+    RtxAtmosphere::cloudViewSamples.setDeferred(samples,m_layer);
+    RtxAtmosphere::cloudViewSamplesMax.setDeferred(samples*2u,m_layer);
+    RtxOptionManager::applyPendingValues(m_device,false);
+    const VkExtent3D size {std::max(1u,uint32_t(std::ceil(m_frame.eyeWidth*wanted.renderScale))),
+      std::max(1u,uint32_t(std::ceil(m_frame.eyeHeight*wanted.renderScale))),1};
+    if (m_eyes[0].image==nullptr || m_eyes[0].image->info().extent.width!=size.width ||
+        m_eyes[0].image->info().extent.height!=size.height) {
+      // The eye images are submitted; nothing may still be reading them when they go.
+      ctx.flushCommandList();
+      for (auto& eye:m_eyes) { testAllocation(AllocationTestSite::Eye);eye=makeImage(ctx,size); }
+    }
+    m_appliedQuality=wanted; m_renderQualityGeneration=generation;
+    {
+      std::lock_guard lock(m_requestMutex);
+      m_status.qualityRenderScale=wanted.renderScale; m_status.qualityDlss=wanted.dlssQuality;
+      m_status.qualityMinBounces=wanted.pathMinBounces; m_status.qualityMaxBounces=wanted.pathMaxBounces;
+      m_status.qualityFlags=wanted.flags; ++m_status.qualityChanges;
+    }
+    Logger::info(str::format("RTX VR quality: scale ",wanted.renderScale,", DLSS ",wanted.dlssQuality,
+      ", bounces ",wanted.pathMinBounces,"-",wanted.pathMaxBounces,", flags ",wanted.flags,
+      ", eyes ",size.width,"x",size.height));
+  }
+
   int RtxVr::pushPose(const rtxvr_FramePose* pose) {
     if (!pose || pose->structSize!=sizeof(*pose) || (pose->flags&~RTXVR_POSE_SCRIPTED) || !finitePose(*pose)) { return RTXVR_E_ARGUMENT; }
     std::lock_guard lock(m_requestMutex);
