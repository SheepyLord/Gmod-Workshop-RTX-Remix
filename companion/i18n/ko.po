msgstr "오른손"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:321
msgid "Left hand"
msgstr "왼손"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:322
msgid "Movement direction"
msgstr "이동 방향"

