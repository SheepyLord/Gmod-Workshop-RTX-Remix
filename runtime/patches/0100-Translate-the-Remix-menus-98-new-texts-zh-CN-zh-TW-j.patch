+msgstr "设置此选项层的混合强度阈值。"
+
+#: src/dxvk/imgui/dxvk_imgui_development_settings.cpp:661
+msgid "Contents"
+msgstr "内容"
+
+#: src/dxvk/imgui/dxvk_imgui_development_settings.cpp:675
+msgid "UI Options"
+msgstr "界面选项"
+
+#: src/dxvk/imgui/dxvk_imgui_development_settings.cpp:684
+msgid "Compact UI"
+msgstr "紧凑界面"
+
+#: src/dxvk/imgui/dxvk_imgui_development_settings.cpp:690
+msgid "Always Developer Menu"
+msgstr "始终显示开发者菜单"
+
+#: src/dxvk/imgui/dxvk_imgui_development_settings.cpp:692
