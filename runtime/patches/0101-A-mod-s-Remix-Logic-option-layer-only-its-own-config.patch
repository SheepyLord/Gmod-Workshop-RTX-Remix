+*/
+// A Remix Logic graph's option layer from a mod, through the real option manager (runtime patch 0101 of the GMod
+// native loader project): RtxOptionManager::acquireModLayer loads a config file only from a mod's folder below
+// rtx-remix/mods, the layer applies only rendering options, and a value that fails to parse is refused (here and
+// through readOption, the Remix API's path) instead of thrown. rtx_mod_layer_policy.h's own rules are in
+// test_mod_layer_policy.cpp.
+
+#include "../../../src/dxvk/rtx_render/rtx_option.h"
+#include "../../../src/dxvk/rtx_render/rtx_option_layer.h"
+#include "../../../src/dxvk/rtx_render/rtx_option_manager.h"
+#include "../../../src/util/config/config.h"
+#include "../../../src/util/util_filesys.h"
+
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace dxvk {
+  // Logger needed by some shared code used in this Unit Test. Without a level: a log file opened during static
+  // initialization asks RtxFileSys for its folder before RtxFileSys's own statics exist, and the mods folder the test
+  // needs would read empty (the runtime opens its log only after RtxFileSys::init).
+  Logger Logger::s_instance("test_mod_option_layer.log", LogLevel::None);
+
+namespace mod_option_layer_test {
+
+  int g_checks = 0;
+  int g_failures = 0;
+
+  void check(bool condition, const char* what, int line) {
+    ++g_checks;
+    if (!condition) {
+      ++g_failures;
+      std::printf("FAIL line %d: %s\n", line, what);
+    }
+  }
+#define CHECK(condition) check((condition), #condition, __LINE__)
+
+  class ModLayerTestOptions {
+  public:
+    // Allowed: a rendering float and a ranged integer in the sky's namespace.
+    RTX_OPTION("rtx.atmosphere", float, modLayerTestFloat, 1.0f, "A rendering value a mod's layer may set.");
+    RTX_OPTION_ARGS("rtx.atmosphere", int32_t, modLayerTestDay, 80, "A ranged integer a mod's layer may set.",
+      args.minValue = 1;
+      args.maxValue = 365);
+    // Refused: text named as a file, an integer without a range, the player's setting, a hash list and an option
+    // outside the rendering namespaces.
+    RTX_OPTION("rtx.atmosphere", std::string, modLayerTestTexture, "", "A path a mod's layer may not set.");
+    RTX_OPTION("rtx.atmosphere", int32_t, modLayerTestSamples, 32, "A count without a range.");
+    RTX_OPTION_ARGS("rtx.atmosphere", float, modLayerTestUserFloat, 1.0f, "The player's setting.",
+      args.flags = RtxOptionFlags::UserSetting);
+    RTX_OPTION("rtx", fast_unordered_set, modLayerTestHashes, {}, "A hash list.");
+    RTX_OPTION("rtx", float, modLayerTestScale, 1.0f, "Outside the rendering namespaces.");
+  };
+
+  void write(const std::filesystem::path& path, const std::string& text) {
+    std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+    stream.write(text.data(), static_cast<std::streamsize>(text.size()));
+  }
+
+  void checkDefaults() {
+    CHECK(ModLayerTestOptions::modLayerTestFloat() == 1.0f);
+    CHECK(ModLayerTestOptions::modLayerTestDay() == 80);
+    CHECK(ModLayerTestOptions::modLayerTestTexture().empty());
+    CHECK(ModLayerTestOptions::modLayerTestSamples() == 32);
+    CHECK(ModLayerTestOptions::modLayerTestUserFloat() == 1.0f);
+    CHECK(!ModLayerTestOptions::modLayerTestHashes.containsHash(0x10));
+    CHECK(ModLayerTestOptions::modLayerTestScale() == 1.0f);
+  }
+
+  void run() {
+    RtxOptionLayer::initializeSystemLayers();
+    RtxOptionImpl::setInitialized(true);
+    RtxOptionManager::markOptionsWithCallbacksDirty();
+    RtxOptionManager::applyPendingValues(nullptr, true);
+    checkDefaults();
+
+    const std::filesystem::path mods = std::filesystem::absolute(util::RtxFileSys::path(util::RtxFileSys::Mods)).lexically_normal();
+    const std::filesystem::path folder = mods / "mod_option_layer_test";
+    std::filesystem::create_directories(folder);
+    const std::filesystem::path file = folder / "opts.conf";
+    write(file,
+          "rtx.atmosphere.modLayerTestFloat = 2.5\n"
+          "rtx.atmosphere.modLayerTestDay = 200\n"
+          "rtx.atmosphere.modLayerTestTexture = \\\\host.invalid\\share\\m.dds\n"
+          "rtx.atmosphere.modLayerTestSamples = 100000\n"
+          "rtx.atmosphere.modLayerTestUserFloat = 3.0\n"
+          "rtx.modLayerTestHashes = 0x10, zz\n"
+          "rtx.modLayerTestScale = 4.0\n");
+    write(mods / "opts.conf", "rtx.atmosphere.modLayerTestFloat = 7.0\n");
+
+    // Refused before any file is read: a share, a file elsewhere, a relative path, a file beside the mods rather
+    // than in a mod's folder, a way out with "..".
+    const std::vector<std::string> refused = {
+      "\\\\host.invalid\\share\\opts.conf", "C:\\Windows\\win.ini", "opts.conf", (mods / "opts.conf").u8string(),
+      (folder / ".." / ".." / "opts.conf").u8string(), (folder / "opts.conf:stream").u8string(),
+    };
+    for (const std::string& path : refused) {
+      const RtxOptionLayerKey key { 10000, path };
+      CHECK(RtxOptionManager::acquireModLayer(path, key, 1.0f, 0.1f) == nullptr);
+      CHECK(RtxOptionManager::getLayer(key) == nullptr);
+    }
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    checkDefaults();
+
+    // A file in the mod's folder: only the rendering values apply; the rest count as rejected keys.
+    const std::string config = file.u8string();
+    const RtxOptionLayerKey key { 10000, config };
+    RtxOptionLayer* layer = RtxOptionManager::acquireModLayer(config, key, 1.0f, 0.1f);
+    CHECK(layer != nullptr);
+    if (layer == nullptr) {
+      return;
+    }
+    CHECK(layer->isModLayer());
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    CHECK(ModLayerTestOptions::modLayerTestFloat() == 2.5f);
+    CHECK(ModLayerTestOptions::modLayerTestDay() == 200);
+    CHECK(ModLayerTestOptions::modLayerTestTexture().empty());
+    CHECK(ModLayerTestOptions::modLayerTestSamples() == 32);
+    CHECK(ModLayerTestOptions::modLayerTestUserFloat() == 1.0f);
+    CHECK(!ModLayerTestOptions::modLayerTestHashes.containsHash(0x10));
+    CHECK(ModLayerTestOptions::modLayerTestScale() == 1.0f);
+    for (const char* name : { "rtx.atmosphere.modLayerTestTexture", "rtx.atmosphere.modLayerTestSamples",
+                              "rtx.atmosphere.modLayerTestUserFloat", "rtx.modLayerTestHashes", "rtx.modLayerTestScale" }) {
+      CHECK(layer->isKeyRejected(name));
+    }
+    CHECK(!layer->isKeyRejected("rtx.atmosphere.modLayerTestFloat"));
+    // A second component on the same file shares the layer; code never takes a mod's layer.
+    CHECK(RtxOptionManager::acquireModLayer(config, key, 1.0f, 0.1f) == layer);
+    RtxOptionManager::releaseLayer(layer);
+    CHECK(RtxOptionManager::acquireLayer(config, key, 1.0f, 0.1f, false, nullptr) == nullptr);
+    // Reloading the file applies the same rules.
+    CHECK(layer->reload());
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    CHECK(ModLayerTestOptions::modLayerTestFloat() == 2.5f);
+    CHECK(ModLayerTestOptions::modLayerTestScale() == 1.0f);
+    RtxOptionManager::releaseLayer(layer);
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    CHECK(RtxOptionManager::getLayer(key) == nullptr);
+    checkDefaults();
+
+    // Any layer: a hash list that fails to parse is rejected whole, nothing thrown.
+    Config bad;
+    bad.setOption(std::string("rtx.modLayerTestHashes"), std::string("0x10, zz"));
+    bad.setOption(std::string("rtx.modLayerTestScale"), std::string("4.0"));
+    const RtxOptionLayerKey codeKey { 20000, "ModOptionLayerTestCode" };
+    const RtxOptionLayer* codeLayer = RtxOptionManager::acquireLayer("", codeKey, 1.0f, 0.1f, false, &bad);
+    CHECK(codeLayer != nullptr && !codeLayer->isModLayer());
+    if (codeLayer != nullptr) {
+      CHECK(codeLayer->isKeyRejected("rtx.modLayerTestHashes"));
+      RtxOptionManager::applyPendingValues(nullptr, false);
+      CHECK(!ModLayerTestOptions::modLayerTestHashes.containsHash(0x10));
+      CHECK(ModLayerTestOptions::modLayerTestScale() == 4.0f);
+      RtxOptionManager::releaseLayer(codeLayer);
+      RtxOptionManager::applyPendingValues(nullptr, false);
+    }
+
+    // The Remix API's path (SetConfigVariable reads with readOption): false and the layer as it was.
+    Config apiBad;
+    apiBad.setOption(std::string("rtx.modLayerTestHashes"), std::string("zz"));
+    CHECK(!ModLayerTestOptions::modLayerTestHashesObject().readOption(apiBad, RtxOptionLayer::getUserLayer()));
+    Config apiGood;
+    apiGood.setOption(std::string("rtx.modLayerTestHashes"), std::string("0x10"));
+    CHECK(ModLayerTestOptions::modLayerTestHashesObject().readOption(apiGood, RtxOptionLayer::getUserLayer()));
+    CHECK(!ModLayerTestOptions::modLayerTestHashesObject().readOption(apiBad, RtxOptionLayer::getUserLayer()));
+    RtxOptionManager::applyPendingValues(nullptr, false);
+    CHECK(ModLayerTestOptions::modLayerTestHashes.containsHash(0x10));
+
+    std::error_code error;
+    std::filesystem::remove_all(folder, error);
+    std::filesystem::remove(mods / "opts.conf", error);
+  }
+
+}  // namespace mod_option_layer_test
+}  // namespace dxvk
+
+int main() {
+  using namespace dxvk::mod_option_layer_test;
+  try {
+    run();
+  } catch (const dxvk::DxvkError& error) {
+    std::printf("FAILED mod option layer: %s\n", error.message().c_str());
+    return 1;
+  } catch (const std::exception& e) {
+    std::printf("FAILED mod option layer with an exception: %s\n", e.what());
+    return 1;
+  }
+  if (g_failures != 0) {
+    std::printf("FAILED mod option layer: %d of %d checks\n", g_failures, g_checks);
+    return 1;
+  }
+  std::printf("PASS mod option layer: %d checks\n", g_checks);
+  return 0;
+}
