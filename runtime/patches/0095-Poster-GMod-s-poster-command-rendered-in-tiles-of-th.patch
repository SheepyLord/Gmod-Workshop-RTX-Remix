new file mode 100644
index 000000000..c47ca08cc
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_poster.h
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: MIT
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// The poster (ADR 0226 of the GMod native loader project): GMod's `poster` command under RTX. The game's own poster
+// renders tiles through sheared projections, which Remix's camera manager rejects, and reads back the raster image.
+// Here the runtime renders the poster itself: the game keeps drawing its ordinary view, and while a poster is made
+// the main, view model and sky cameras' projections are narrowed to one tile's window of that view (a tile has the
+// window's size, so no upscaler, denoiser or render target changes size). Each tile is traced for a number of
+// frames with its history reset at its first, its last frame is read back, and the tiles are blended over their
+// overlaps into one picture, written as a PNG on a thread of its own. Meanwhile the runtime's clock stands still,
+// exposure keeps its value and the lens effects and motion blur are left out, so neighbouring tiles match.
+#pragma once
+#include <atomic>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+#include "rtx_common_object.h"
+#include "rtx_poster_api.h"
+#include "rtx_poster_exports.h"
+#include "rtx_poster_math.h"
+#include "../dxvk_buffer.h"
+#include "../dxvk_image.h"
+#include "../../util/util_matrix.h"
+#include "../../util/util_vector.h"
+
+namespace dxvk {
+  class RtxContext;
+
+  class RtxPoster : public CommonDeviceObject {
+  public:
+    explicit RtxPoster(DxvkDevice* device);
+    ~RtxPoster();
+    void onDestroy() override;
+
+    // Any thread: d3d9.dll's rtxposter_* exports.
+    int start(const rtxposter_Request* request);
+    void cancel();
+    int status(rtxposter_Status* out);
+
+    // The render thread.
+    // True while this frame's views belong to a tile: the camera manager narrows the main, view model and sky
+    // cameras' projections to the tile's window. Their field of view and the culling frustum stay the game's.
+    bool active() const { return m_narrowing; }
+    void narrow(Matrix4& viewToProjection) const { poster::narrowProjection(viewToProjection, m_window); }
+    // The tile's window, for the passes that build their own screen-aligned directions (the physical sky's
+    // clouds and aerial perspective).
+    bool window(poster::Window& out) const {
+      if (!m_narrowing) { return false; }
+      out = m_window;
+      return true;
+    }
+    // How many poster pixels a window pixel spans, so textures and the sky are sampled for the poster's size.
+    float pixelScale() const { return m_narrowing ? m_pixelScale : 1.0f; }
+    // While a poster renders, exposure adaptation, motion blur and the lens effects hold: every tile is lit and
+    // finished like its neighbours, and a vignette belongs to a whole picture, not to each of its tiles.
+    bool holdsEffects() const { return m_narrowing; }
+    // A ray traced frame begins (before its frame setup): starts a requested poster, checks that the view and the
+    // window stay as they were. True when this frame begins a tile, whose history must start afresh.
+    bool beginFrame(RtxContext& ctx, VkExtent3D outputExtent);
+    // The traced frame's picture before its UI (what is blitted to the game's target): a tile's last frame is kept.
+    void endFrame(RtxContext& ctx, const Rc<DxvkImage>& picture);
+
+  private:
+    struct Job;
+    struct Request { uint32_t multiplier = 0, framesPerTile = RTXPOSTER_DEFAULT_FRAMES, flags = 0; std::wstring path; };
+
+    void startJob(RtxContext& ctx, VkExtent3D extent);
+    void capture(RtxContext& ctx, const Rc<DxvkImage>& picture, uint32_t tile);
+    void fail(int error, const std::string& why);
+    void stopNarrowing();
+    bool jobFailed();
+    static void onReadback(const std::shared_ptr<Job>& job, uint32_t tile, const Rc<DxvkBuffer>& buffer);
+    static void writePoster(std::shared_ptr<Job> job);
+
+    std::mutex m_mutex;                     // the request, the status fields and m_job's pointer
+    bool m_requested = false;
+    Request m_request;
+    std::atomic<bool> m_cancel { false };
+    uint32_t m_generation = 0;
+    int32_t m_lastError = RTXPOSTER_OK;     // a poster that failed before it had a job (its size, its memory)
+    std::string m_lastErrorText;
+    std::wstring m_path;
+    // The poster rendering or being written, or the last one. Only the render thread replaces it (under m_mutex);
+    // its readbacks and its writer hold their own references.
+    std::shared_ptr<Job> m_job;
+
+    // The render thread only.
+    bool m_narrowing = false;
+    poster::Window m_window;
+    float m_pixelScale = 1.0f;
+    uint32_t m_tile = 0, m_frame = 0, m_framesPerTile = RTXPOSTER_DEFAULT_FRAMES;
+    std::atomic<uint32_t> m_statusTile { 0 }, m_statusFrame { 0 };
+    Vector3 m_startPosition, m_startDirection;
+    Rc<DxvkImage> m_captureImage;
+  };
+}
diff --git a/src/dxvk/rtx_render/rtx_poster_api.h b/src/dxvk/rtx_render/rtx_poster_api.h
new file mode 100644
index 000000000..cac56995d
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_poster_api.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT */
+/* The poster (ADR 0226 of the GMod native loader project): d3d9.dll's rtxposter_* exports. A picture several times
+   the window's size, path traced in tiles of the window's own size and written as one PNG. Plain C; the loader
+   project keeps a byte-identical copy as engine_guard/rtxposter_api.h for the module that calls it. */
+#ifndef RTXPOSTER_API_H
+#define RTXPOSTER_API_H
+#include <stdint.h>
+#include <wchar.h>
+
+#define RTXPOSTER_API_VERSION 1u
+#define RTXPOSTER_PATH_CHARS 520u
+#define RTXPOSTER_DEFAULT_FRAMES 64u   /* frames a tile is traced before it is kept, when framesPerTile is 0 */
+
+#define RTXPOSTER_SAVE_TILES 0x1u      /* also write each tile beside the poster: <name>_tile_<column>_<row>.png */
+
+typedef struct rtxposter_Request {
+  uint32_t structSize;                    /* sizeof(rtxposter_Request) */
+  uint32_t multiplier;                    /* 1 to 16: the poster is the window's size times this */
+  uint32_t framesPerTile;                 /* 4 to 4096 frames per tile; 0 for RTXPOSTER_DEFAULT_FRAMES */
+  uint32_t flags;                         /* RTXPOSTER_* */
+  wchar_t  path[RTXPOSTER_PATH_CHARS];    /* the PNG to write: an absolute path, written as <path>.part and renamed */
+} rtxposter_Request;
+
+enum { RTXPOSTER_STATE_IDLE = 0, RTXPOSTER_STATE_STARTING = 1, RTXPOSTER_STATE_RENDERING = 2, RTXPOSTER_STATE_WRITING = 3,
+       RTXPOSTER_STATE_DONE = 4, RTXPOSTER_STATE_FAILED = 5 };
+
+enum { RTXPOSTER_OK = 0, RTXPOSTER_E_VERSION = 1, RTXPOSTER_E_ARGUMENT = 2, RTXPOSTER_E_NO_DEVICE = 3,
+       RTXPOSTER_E_BUSY = 4, RTXPOSTER_E_VR = 5, RTXPOSTER_E_SIZE = 6, RTXPOSTER_E_MEMORY = 7, RTXPOSTER_E_MOVED = 8,
+       RTXPOSTER_E_RESIZED = 9, RTXPOSTER_E_CAPTURE = 10, RTXPOSTER_E_WRITE = 11, RTXPOSTER_E_CANCELLED = 12 };
+
+typedef struct rtxposter_Status {
+  uint32_t structSize;                    /* sizeof(rtxposter_Status) */
+  uint32_t state;                         /* RTXPOSTER_STATE_* */
+  uint32_t generation;                    /* how many posters were started; 0 before the first */
+  int32_t  lastError;                     /* RTXPOSTER_E_* of the last poster that failed; 0 when it did not */
+  uint32_t width, height;                 /* the poster's size */
+  uint32_t columns, rows;                 /* its tiles across and down */
+  uint32_t tilesDone;                     /* tiles traced and kept */
+  uint32_t frame, framesPerTile;          /* the current tile's frames so far, and how many it gets */
+  uint32_t reserved;
+  char     lastErrorText[256];            /* why it failed, in English */
+  wchar_t  path[RTXPOSTER_PATH_CHARS];    /* the poster; a file there once the state is DONE */
+} rtxposter_Status;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef uint32_t (*rtxposter_GetApiVersionFn)(void);
+typedef int (*rtxposter_StartFn)(const rtxposter_Request*);      /* RTXPOSTER_OK, or why it cannot start */
+typedef void (*rtxposter_CancelFn)(void);                         /* ends the poster at its next frame */
+typedef int (*rtxposter_GetStatusFn)(rtxposter_Status*);         /* RTXPOSTER_OK or RTXPOSTER_E_ARGUMENT */
+#ifdef __cplusplus
+}
+#endif
+#endif
