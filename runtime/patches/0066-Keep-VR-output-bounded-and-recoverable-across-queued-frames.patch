diff --git a/src/dxvk/rtx_render/rtx_vr_policy.h b/src/dxvk/rtx_render/rtx_vr_policy.h
new file mode 100644
index 00000000..ca716fd3
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_vr_policy.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <atomic>
+#include <filesystem>
+#include <exception>
+#include <utility>
+#include <cstdint>
+#include "../../util/util_error.h"
+
+namespace dxvk::vrpolicy {
+  template<typename Action,typename Error>
+  bool resources(Action action,Error error) {
+    try { action();return true; }
+    catch(const DxvkError& e) { error(e.message()); }
+    catch(const std::exception& e) { error(e.what()); }
+    return false;
+  }
+  inline bool cameraReady(uint64_t frame,uint64_t generation,uint64_t cameraFrame,uint64_t cameraGeneration) {
+    return frame==cameraFrame&&generation==cameraGeneration;
+  }
+  class CanvasOwner {
+    std::atomic<const void*> m_context {nullptr};
+  public:
+    void set(const void* context) { m_context.store(context,std::memory_order_release); }
+    bool owns(const void* context) const { return context&&m_context.load(std::memory_order_acquire)==context; }
+  };
+  enum class WaitResult { Ready,Skip,Fail };
+  class WaitPolicy {
+    double m_failureSince=-1;
+  public:
+    WaitResult result(int code,double seconds) {
+      if(!code) { m_failureSince=-1;return WaitResult::Ready; }
+      if(code==101) { m_failureSince=-1;return WaitResult::Skip; }
+      if(code!=1) { return WaitResult::Fail; }
+      if(m_failureSince<0) { m_failureSince=seconds; }
+      return seconds-m_failureSince>=5 ? WaitResult::Fail : WaitResult::Skip;
+    }
+  };
+  constexpr size_t kMaxRecordings=1024;
+  template<typename Queue> size_t boundRecordings(Queue& queue) {
+    size_t removed=0;
+    while(queue.size()>kMaxRecordings) { queue.pop_front();++removed; }
+    return removed;
+  }
+  struct CaptureRequest {
+    std::filesystem::path folder;
+    uint32_t what=0;
+    void clear() { folder.clear();what=0; }
+    std::pair<std::filesystem::path,uint32_t> consume() { return {folder,std::exchange(what,0u)}; }
+  };
+  enum class Upscaler : int { Dlss=1,Taau=3 };
+  inline Upscaler upscaler(bool supported) { return supported?Upscaler::Dlss:Upscaler::Taau; }
+}
