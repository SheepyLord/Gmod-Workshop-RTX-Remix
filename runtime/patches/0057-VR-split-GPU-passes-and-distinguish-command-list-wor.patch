-        m_status.gpuMsWarp=float((data[5].timestamp.time-data[4].timestamp.time)*factor);
-        m_status.gpuMsOther=std::max(0.f,m_status.gpuMsTotal-m_status.gpuMsPathTrace-m_status.gpuMsUpscale-m_status.gpuMsWarp);
+    const auto index=static_cast<size_t>(stage);
+    if (stage==vrtiming::Stage::FrameBegin) {
+      if (m_armTiming) {
