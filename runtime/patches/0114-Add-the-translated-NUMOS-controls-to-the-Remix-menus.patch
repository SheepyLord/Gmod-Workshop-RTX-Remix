+      void setting(const char* key, const char* label, float speed = kAuto, float mn = kAuto, float mx = kAuto,
+                   const char* format = nullptr, Kind kind = Kind::Auto, const char* help = nullptr) {
+        if (const auto* e = NumosSettings::findBySuffix(key); e && e->option())
+          drawEntry(*e, label, speed, mn, mx, format, kind, help);
+      }
+      void color(const char* key, const char* label) {
+        setting(key, label, kAuto, kAuto, kAuto, nullptr, Kind::Color);
+      }
+      void speedMs(const char* key, const char* label, float speed, float mn, float mx) {
+        setting(key, label, speed, mn, mx, nullptr, Kind::SpeedMetersPerSecond);
+      }
+      void choice(const char* key, const char* label, const int* values, const char* const* names, int count,
+                  const char* help = nullptr) {
+        const auto* e = NumosSettings::findBySuffix(key);
+        if (!e || !e->pIntOption)
+          return;
+        const bool weather = overriddenByWeather(*e);
+        int v = weather ? shownValue<int32_t>(*e) : e->pIntOption->get();
+        ImGui::PushID(e->option());
+        widget(weather, e->pIntOption, v, help ? help : fieldText(*e->pInfo).help, [&](int& value) {
+          int selected = -1;
+          for (int i = 0; i < count; ++i)
+            if (values[i] == value)
+              selected = i;
+          if (!ImGui::Combo(label, &selected, names, count))
+            return false;
+          value = values[selected];
+          return true;
+        });
+        ImGui::PopID();
+      }
+      void userSetting(const char* key, const char* label, const char* help, float speed = kAuto, float mn = kAuto,
+                       float mx = kAuto, const char* format = nullptr) {
+        setting(key, label, speed, mn, mx, format, Kind::Auto, help);
+      }
+      void userChoice(const char* key, const char* label, const char* help, const int* values, const char* const* names,
+                      int count) {
+        choice(key, label, values, names, count, help);
+      }
+      bool boolValue(const char* key) {
+        const auto* e = NumosSettings::findBySuffix(key);
+        return e && e->pBoolOption && (overriddenByWeather(*e) ? shownValue<bool>(*e) : e->pBoolOption->get());
+      }
+      float floatValue(const char* key) {
+        const auto* e = NumosSettings::findBySuffix(key);
+        return e && e->pFloatOption ? (overriddenByWeather(*e) ? shownValue<float>(*e) : e->pFloatOption->get()) : 0.f;
+      }
