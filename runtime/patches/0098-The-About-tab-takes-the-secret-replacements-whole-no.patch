diff --git a/tests/rtx/unit/test_secret_handoff.cpp b/tests/rtx/unit/test_secret_handoff.cpp
new file mode 100644
index 000000000..59303dfe8
--- /dev/null
+++ b/tests/rtx/unit/test_secret_handoff.cpp
@@ -0,0 +1,165 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// The asset replacer's secret replacements handed to the About tab (runtime patch 0098 of the GMod native loader
+// project): the tab takes a whole published map, never one DXVK's command thread is still filling.
+// Standalone: cl /EHsc /std:c++17 /W4 /WX test_secret_handoff.cpp
+
+#include "../../../src/dxvk/rtx_render/rtx_secret_handoff.h"
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+using namespace dxvk;
+
+namespace {
+  int g_checks = 0;
+  int g_failures = 0;
+
+  void check(bool condition, const char* what, int line) {
+    ++g_checks;
+    if (!condition) {
+      ++g_failures;
+      std::printf("FAIL line %d: %s\n", line, what);
+    }
+  }
+#define CHECK(condition) check((condition), #condition, __LINE__)
+
+  struct Secret {
+    std::string name;
+    uint64_t generation = 0;
+  };
+  // As the runtime's SecretReplacements: a hash map of vectors.
+  using Map = std::unordered_map<uint64_t, std::vector<Secret>>;
+  using Handoff = SecretHandoff<Map>;
+
+  size_t keysOf(uint64_t generation) {
+    return static_cast<size_t>(generation % 16 + 1);
+  }
+
+  Map makeMap(uint64_t generation, size_t keys) {
+    Map map;
+    for (size_t key = 0; key < keys; ++key) {
+      map[key].push_back(Secret { "secret " + std::to_string(key), generation });
+      map[key].push_back(Secret { "variant " + std::to_string(key), generation });
+    }
+    return map;
+  }
+
+  void testNothingBeforeAPublish() {
+    Handoff handoff;
+    CHECK(!handoff.pending());
+    CHECK(handoff.take().empty());
+    CHECK(!handoff.pending());
+  }
+
+  void testAPublishedMapIsTakenOnce() {
+    Handoff handoff;
+    handoff.publish(makeMap(1, 3), true);
+    CHECK(handoff.pending());
+    const Map taken = handoff.take();
+    CHECK(taken.size() == 3);
+    CHECK(taken.at(2).size() == 2);
+    CHECK(taken.at(2)[1].name == "variant 2");
+    CHECK(!handoff.pending());
+    // The tab rebuilds only when a map is pending; another take still gives a whole copy.
+    CHECK(handoff.take().size() == 3);
+  }
+
+  void testALoadWithoutSecretsIsNotPending() {
+    Handoff handoff;
+    handoff.publish(makeMap(1, 2), true);
+    CHECK(handoff.take().size() == 2);
+    // A reload that found no secret replacement: as before, the tab keeps what it built.
+    handoff.publish(Map {}, false);
+    CHECK(!handoff.pending());
+  }
+
+  void testTheNewestPublishWins() {
+    Handoff handoff;
+    handoff.publish(makeMap(1, 1), true);
+    handoff.publish(makeMap(2, 4), true);
+    CHECK(handoff.pending());
+    const Map taken = handoff.take();
+    CHECK(taken.size() == 4);
+    CHECK(taken.at(0)[0].generation == 2);
+  }
+
+  void testACopyOutlivesTheNextPublish() {
+    Handoff handoff;
+    handoff.publish(makeMap(1, 5), true);
+    // Bound as the About tab binds it (const auto& to the returned copy).
+    const Map& taken = handoff.take();
+    handoff.publish(makeMap(2, 1), true);
+    CHECK(taken.size() == 5);
+    CHECK(taken.at(4)[0].generation == 1);
+    CHECK(handoff.pending());
+  }
+
+  // The command thread publishes while the present thread takes, as when mods finish loading during the first
+  // frames. Every map the taker gets is whole: one generation throughout, every key of it, never an older one.
+  void testThreads() {
+    Handoff handoff;
+    constexpr uint64_t kPublishes = 3000;
+    std::atomic<bool> done { false };
+    std::atomic<int> torn { 0 };
+    std::atomic<int> taken { 0 };
+    std::thread taker([&] {
+      uint64_t last = 0;
+      while (!done.load(std::memory_order_acquire) || handoff.pending()) {
+        if (!handoff.pending()) {
+          std::this_thread::yield();
+          continue;
+        }
+        const Map map = handoff.take();
+        ++taken;
+        if (map.empty()) {
+          ++torn;
+          continue;
+        }
+        const uint64_t generation = map.begin()->second.front().generation;
+        bool whole = map.size() == keysOf(generation) && generation >= last;
+        for (const auto& [key, secrets] : map) {
+          whole = whole && secrets.size() == 2 && secrets[0].generation == generation &&
+                  secrets[1].generation == generation && secrets[0].name == "secret " + std::to_string(key);
+        }
+        if (!whole) {
+          ++torn;
+        }
+        last = generation;
+      }
+    });
+    for (uint64_t generation = 1; generation <= kPublishes; ++generation) {
+      handoff.publish(makeMap(generation, keysOf(generation)), true);
+    }
+    done.store(true, std::memory_order_release);
+    taker.join();
+    CHECK(torn.load() == 0);
+    CHECK(taken.load() >= 1);
+    CHECK(!handoff.pending());
+    // The last publish is what the tab holds now.
+    const Map last = handoff.take();
+    CHECK(last.size() == keysOf(kPublishes));
+    CHECK(last.at(0)[0].generation == kPublishes);
+  }
+}
+
+int main() {
+  testNothingBeforeAPublish();
+  testAPublishedMapIsTakenOnce();
+  testALoadWithoutSecretsIsNotPending();
+  testTheNewestPublishWins();
+  testACopyOutlivesTheNextPublish();
+  testThreads();
+  if (g_failures) {
+    std::printf("FAIL secret handoff: %d of %d checks\n", g_failures, g_checks);
+    return 1;
+  }
+  std::printf("PASS secret handoff: %d checks\n", g_checks);
+  return 0;
+}
