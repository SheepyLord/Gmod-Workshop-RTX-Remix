+  if(slot<p.materialVisible.size()&&!p.materialVisible[slot])continue;
+  float alpha=p.snapshot&&slot<p.snapshot->materials.size()?p.snapshot->materials[slot].alpha:mat.alpha;if(alpha<=.0001f)continue;
