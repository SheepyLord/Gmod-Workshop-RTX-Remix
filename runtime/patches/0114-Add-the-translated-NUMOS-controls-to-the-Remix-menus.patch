+msgid "Units Per Meter"
+msgstr "Единиц на метр"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:801 src/dxvk/rtx_render/rtx_numos_ui_fields.inl:146
+msgid "Ground Level: Auto"
+msgstr "Автоопределение уровня земли"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:802 src/dxvk/rtx_render/rtx_numos_ui_fields.inl:148
+msgid "Ground Smoothing"
+msgstr "Сглаживание уровня земли"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:804
+#, c-format
+msgid "Ground level in use: %.1f (%s)"
+msgstr "Текущий уровень земли: %.1f (%s)"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:805
+msgid "configured"
+msgstr "измерен"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:805
+msgid "measured"
+msgstr "задан"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:807 src/dxvk/rtx_render/rtx_numos_ui_fields.inl:147
+msgid "Ground Level (world units)"
+msgstr "Уровень земли (единицы мира)"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:809
+msgid "Set to Here"
+msgstr "Взять текущее положение"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:826
+msgid "Use the current viewer height as atmospheric ground. Exit freecam and stand at normal ground level first."
+msgstr "Использует текущую высоту наблюдателя как уровень земли атмосферы. Сначала выйдите из свободной камеры и встаньте на обычную землю."
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:831
+msgid "Camera override (advanced)"
+msgstr "Переопределение камеры (расширенное)"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:832 src/dxvk/rtx_render/rtx_numos_ui_fields.inl:204
+msgid "Use Camera World Override"
+msgstr "Переопределить позицию камеры"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:833 src/dxvk/rtx_render/rtx_numos_ui_fields.inl:37
+msgid "Camera World Override"
+msgstr "Переопределённая позиция камеры"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:837
+msgid "Diagnostics"
+msgstr "Диагностика"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:838
+msgid "Signal World Change"
+msgstr "Сообщить о смене мира"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:842
+msgid "Changes rtx.atmosphere.numos.worldChangeCount, as a game integration does after a load. The automatic ground level is then measured again."
+msgstr "Меняет rtx.atmosphere.numos.worldChangeCount, как при загрузке игры, и повторяет автоматическое измерение уровня земли."
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:845
+#, c-format
+msgid "World changes: %u"
+msgstr "Смен мира: %u"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:846 src/dxvk/rtx_render/rtx_numos_ui_fields.inl:38
+msgid "Anchor Cut Threshold"
+msgstr "Порог скачка точки привязки"
