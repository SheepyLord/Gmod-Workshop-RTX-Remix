+// A tent with a small quadratic shoulder. At rest this still filters some of the neighbouring
+// histories; at fractional reprojections it reconstructs around the true previous pixel centre.
+float3 rayHistoryWeights(float f) {
+  float2 sides = float2(.5f - f, .5f + f);
+  sides = lerp(max(float2(-f, f), 0.xx), .5f * sides * sides, .5f);
+  return float3(sides.x, 1.f - sides.x - sides.y, sides.y);
+}
