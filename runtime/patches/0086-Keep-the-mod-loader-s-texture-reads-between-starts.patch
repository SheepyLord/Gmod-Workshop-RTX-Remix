diff --git a/tests/rtx/unit/test_mod_texture_store.cpp b/tests/rtx/unit/test_mod_texture_store.cpp
new file mode 100644
index 00000000..92d33044
--- /dev/null
+++ b/tests/rtx/unit/test_mod_texture_store.cpp
@@ -0,0 +1,289 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// The mod texture cache's store (ADR 0195 of the GMod native loader project): a later load reads no unchanged file,
+// and any change to a file, a damaged or foreign cache file, or a file whose folder entry may be stale is read again.
+// Standalone: cl /EHsc /std:c++17 /W4 /WX test_mod_texture_store.cpp, run with a scratch folder as its argument.
+
+#include "../../../src/dxvk/rtx_render/rtx_mod_texture_store.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+
+using namespace dxvk;
+namespace fs = std::filesystem;
+
+namespace {
+  int g_checks = 0;
+  int g_failures = 0;
+
+  void check(bool condition, const char* what, int line) {
+    ++g_checks;
+    if (!condition) {
+      ++g_failures;
+      std::printf("FAIL line %d: %s\n", line, what);
+    }
+  }
+#define CHECK(condition) check((condition), #condition, __LINE__)
+
+  std::vector<uint8_t> randomBytes(size_t size, uint32_t seed) {
+    std::mt19937 engine(seed);
+    std::vector<uint8_t> bytes(size);
+    for (auto& b : bytes) {
+      b = uint8_t(engine());
+    }
+    return bytes;
+  }
+
+  void writeFile(const fs::path& path, const std::vector<uint8_t>& bytes) {
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    out.write(reinterpret_cast<const char*>(bytes.data()), std::streamsize(bytes.size()));
+  }
+
+  std::vector<uint8_t> readFile(const fs::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    return std::vector<uint8_t>((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+  }
+
+  FILETIME lastWrite(const fs::path& path) {
+    WIN32_FILE_ATTRIBUTE_DATA data {};
+    GetFileAttributesExW(path.c_str(), GetFileExInfoStandard, &data);
+    return data.ftLastWriteTime;
+  }
+
+  void setLastWrite(const fs::path& path, const FILETIME& time) {
+    HANDLE handle = CreateFileW(path.c_str(), FILE_WRITE_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                                OPEN_EXISTING, 0, nullptr);
+    SetFileTime(handle, nullptr, nullptr, &time);
+    CloseHandle(handle);
+  }
+
+  constexpr size_t kTail = 256;
+
+  // As the runtime's loader: a record of the file and its last kTail bytes, counted.
+  struct FakeLoader {
+    int calls = 0;
+    size_t tailSize = kTail;
+    bool operator()(const fs::path& path, DdsAssetRecord& record, DdsAssetTail& tail) {
+      ++calls;
+      const std::vector<uint8_t> bytes = readFile(path);
+      if (bytes.size() < 16) {
+        return false;
+      }
+      const FILETIME time = lastWrite(path);
+      record = DdsAssetRecord {};
+      record.fileSize = bytes.size();
+      record.levels = 1;
+      record.layers = 1;
+      record.faces = 1;
+      record.width = 16;
+      record.height = 16;
+      record.levelSizes = { bytes.size() };
+      record.lastWriteTime = int64_t((uint64_t(time.dwHighDateTime) << 32) | time.dwLowDateTime);
+      tail.firstLevel = 0;
+      const size_t take = (std::min)(tailSize, bytes.size());
+      tail.bytes.assign(bytes.end() - take, bytes.end());
+      return true;
+    }
+  };
+
+  struct Load {
+    ModTextureStore store;
+    FakeLoader loader;
+    explicit Load(const fs::path& cache) : store(cache) {}
+    ModTextureStore::Result find(const fs::path& file, DdsAssetTail* outTail = nullptr) {
+      DdsAssetRecord record;
+      DdsAssetTail tail;
+      ModTextureStore::Loader call = [this](const fs::path& p, DdsAssetRecord& r, DdsAssetTail& t) { return loader(p, r, t); };
+      const auto result = store.find(file, call, record, tail);
+      if (outTail) {
+        *outTail = tail;
+      }
+      return result;
+    }
+  };
+
+  std::vector<uint8_t> lastBytes(const fs::path& file) {
+    const std::vector<uint8_t> bytes = readFile(file);
+    return std::vector<uint8_t>(bytes.end() - (std::min)(kTail, bytes.size()), bytes.end());
+  }
+}
+
+int main(int argc, char** argv) {
+  const fs::path scratch = fs::absolute(argc > 1 ? fs::path(argv[1]) : fs::temp_directory_path() / "mod_texture_store_test");
+  std::error_code error;
+  fs::remove_all(scratch, error);
+  const fs::path mod = scratch / L"Mods" / L"Some Mod";
+  const fs::path textures = mod / L"SubUSDs" / L"textures";
+  fs::create_directories(textures);
+  const fs::path cacheFolder = scratch / L"cache";
+  const fs::path cache = ModTextureStore::cacheFileFor(cacheFolder, mod);
+  const fs::path a = textures / L"A.dds", b = textures / L"b.dds", c = textures / L"c.dds", d = textures / L"d.dds";
+  writeFile(a, randomBytes(8192, 1));
+  writeFile(b, randomBytes(8192, 2));
+  writeFile(c, randomBytes(4096, 3));
+
+  // The cache file is named after the mod folder, whatever its case.
+  CHECK(ModTextureStore::lower(ModTextureStore::cacheFileFor(cacheFolder, scratch / L"MODS" / L"some mod").wstring()) ==
+        ModTextureStore::lower(cache.wstring()));
+  CHECK(cache.filename().wstring().rfind(L"Some Mod-", 0) == 0);
+
+  // First load: every file read, the cache written.
+  {
+    Load load(cache);
+    CHECK(!load.store.counters().loaded);
+    DdsAssetTail tail;
+    CHECK(load.find(a, &tail) == ModTextureStore::Result::Miss);
+    CHECK(tail.bytes == lastBytes(a));
+    CHECK(load.find(b) == ModTextureStore::Result::Miss);
+    CHECK(load.find(c) == ModTextureStore::Result::Miss);
+    CHECK(load.find(textures / L"missing.dds") == ModTextureStore::Result::Unlisted);
+    CHECK(load.loader.calls == 3);
+    CHECK(load.store.counters().folders == 1);
+    load.store.save();
+    CHECK(load.store.counters().saved);
+    CHECK(fs::exists(cache));
+  }
+
+  // Second load: nothing read, the same records and tails; nothing to write.
+  const auto cacheTime = fs::last_write_time(cache);
+  {
+    Load load(cache);
+    CHECK(load.store.counters().loaded);
+    DdsAssetTail tail;
+    // Another spelling of the same path is the same entry.
+    CHECK(load.find(textures / L"." / L"a.DDS", &tail) == ModTextureStore::Result::Hit);
+    CHECK(tail.bytes == lastBytes(a));
+    CHECK(load.find(b, &tail) == ModTextureStore::Result::Hit);
+    CHECK(tail.bytes == lastBytes(b));
+    CHECK(load.find(c) == ModTextureStore::Result::Hit);
+    CHECK(load.loader.calls == 0);
+    load.store.save();
+    CHECK(!load.store.counters().saved);
+    CHECK(fs::last_write_time(cache) == cacheTime);
+  }
+
+  // New content of the same size with the old write time put back: the change time still tells.
+  {
+    const FILETIME before = lastWrite(b);
+    writeFile(b, randomBytes(8192, 20));
+    setLastWrite(b, before);
+    Load load(cache);
+    DdsAssetTail tail;
+    CHECK(load.find(a) == ModTextureStore::Result::Hit);
+    CHECK(load.find(b, &tail) == ModTextureStore::Result::Miss);
+    CHECK(tail.bytes == lastBytes(b));
+    CHECK(load.find(c) == ModTextureStore::Result::Hit);
+    CHECK(load.loader.calls == 1);
+    load.store.save();
+    CHECK(load.store.counters().saved);
+  }
+  {
+    Load load(cache);
+    DdsAssetTail tail;
+    CHECK(load.find(b, &tail) == ModTextureStore::Result::Hit);
+    CHECK(tail.bytes == lastBytes(b));
+  }
+
+  // A file replaced by another with the same bytes and write time: another file id.
+  {
+    const std::vector<uint8_t> bytes = readFile(c);
+    const FILETIME before = lastWrite(c);
+    fs::remove(c);
+    writeFile(c, bytes);
+    setLastWrite(c, before);
+    Load load(cache);
+    CHECK(load.find(c) == ModTextureStore::Result::Miss);
+  }
+
+  // A file with two names is read at every load: its folder entry can be stale.
+  {
+    writeFile(d, randomBytes(4096, 4));
+    CHECK(CreateHardLinkW((scratch / L"d-link.dds").c_str(), d.c_str(), nullptr) != FALSE);
+    for (int pass = 0; pass < 2; ++pass) {
+      Load load(cache);
+      CHECK(load.find(d) == ModTextureStore::Result::Miss);
+      CHECK(load.store.counters().unkept == 1);
+      load.find(a);
+      load.find(b);
+      load.find(c);
+      load.store.save();
+    }
+  }
+
+  // Entries no texture asked for are dropped when the cache is written.
+  {
+    writeFile(textures / L"e.dds", randomBytes(2048, 5));
+    Load load(cache);
+    CHECK(load.find(a) == ModTextureStore::Result::Hit);
+    CHECK(load.find(textures / L"e.dds") == ModTextureStore::Result::Miss);
+    load.store.save();
+    CHECK(load.store.counters().saved);
+  }
+  {
+    Load load(cache);
+    CHECK(load.find(a) == ModTextureStore::Result::Hit);
+    CHECK(load.find(textures / L"e.dds") == ModTextureStore::Result::Hit);
+    CHECK(load.find(b) == ModTextureStore::Result::Miss);
+    // An unchanged set of files, one fewer: written again without the one.
+    load.store.save();
+  }
+
+  // A tail too large to keep is used but not kept; the record still is.
+  {
+    writeFile(textures / L"big.dds", randomBytes(ModTextureStore::kMaxTailBytes * 2, 6));
+    Load load(cache);
+    load.loader.tailSize = ModTextureStore::kMaxTailBytes * 2;
+    DdsAssetTail tail;
+    CHECK(load.find(textures / L"big.dds", &tail) == ModTextureStore::Result::Miss);
+    CHECK(tail.bytes.size() == ModTextureStore::kMaxTailBytes * 2);
+    load.store.save();
+  }
+  {
+    Load load(cache);
+    DdsAssetTail tail;
+    CHECK(load.find(textures / L"big.dds", &tail) == ModTextureStore::Result::Hit);
+    CHECK(tail.firstLevel == UINT32_MAX && tail.bytes.empty());
+    load.store.save();
+  }
+
+  // A damaged, shortened or foreign cache file is ignored: every file is read again, and the file rewritten.
+  const std::vector<uint8_t> good = readFile(cache);
+  for (int damage = 0; damage < 4; ++damage) {
+    std::vector<uint8_t> bytes = good;
+    switch (damage) {
+    case 0: bytes[bytes.size() / 2] ^= 0x40; break;          // payload
+    case 1: bytes.resize(bytes.size() - 7); break;            // shortened
+    case 2: bytes[8] ^= 0x01; break;                         // version
+    case 3: bytes[0] = 'X'; break;                           // magic
+    }
+    writeFile(cache, bytes);
+    Load load(cache);
+    CHECK(!load.store.counters().loaded);
+    CHECK(load.store.counters().ignored);
+    CHECK(load.find(a) == ModTextureStore::Result::Miss);
+    load.store.save();
+    CHECK(load.store.counters().saved);
+    Load again(cache);
+    CHECK(again.store.counters().loaded);
+    CHECK(again.find(a) == ModTextureStore::Result::Hit);
+  }
+
+  // A cache folder that cannot be written leaves the load as it was.
+  {
+    Load load(scratch / L"a-file" / L"cache.bin");
+    writeFile(scratch / L"a-file", randomBytes(16, 7));
+    CHECK(load.find(a) == ModTextureStore::Result::Miss);
+    load.store.save();
+    CHECK(load.store.counters().saveFailed);
+  }
+
+  fs::remove_all(scratch, error);
+  if (g_failures != 0) {
+    std::printf("FAILED mod texture store: %d of %d checks\n", g_failures, g_checks);
+    return 1;
+  }
+  std::printf("PASS mod texture store: %d checks\n", g_checks);
+  return 0;
+}
