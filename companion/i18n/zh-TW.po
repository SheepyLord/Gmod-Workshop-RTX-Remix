msgstr "護甲"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:8
msgid "Ammo"
msgstr "彈藥"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:21
msgid "The VR module is missing or could not load. Reinstall the RTX package, then restart Garry's Mod."
msgstr "VR 模組遺失或無法載入。請重新安裝 RTX 套件，再重新啟動 Garry's Mod。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:22
msgid "The VR module has an incompatible API. Update the RTX package and restart Garry's Mod."
msgstr "VR 模組的 API 不相容。請更新 RTX 套件並重新啟動 Garry's Mod。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:23
msgid "This Remix runtime has no VR output. Update the RTX package and restart Garry's Mod."
msgstr "此 Remix 執行階段不支援 VR 輸出。請更新 RTX 套件並重新啟動 Garry's Mod。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:24
msgid "The VR add-on could not start. Reinstall the RTX package and try again."
msgstr "VR 附加元件無法啟動。請重新安裝 RTX 套件後再試。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:25
msgid "V1 supports single-player and the listen-server host. Start a local game to use VR."
msgstr "V1 僅支援單人遊戲和本機伺服器主機。請啟動本機遊戲以使用 VR。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:26
msgid "Exit VRMod before starting RTX VR. Only one add-on can control the view."
msgstr "啟動 RTX VR 前請退出 VRMod。同一時間只能由一個附加元件控制視角。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:27
msgid "Exit gVRMod before starting RTX VR. Only one add-on can control the view."
msgstr "啟動 RTX VR 前請退出 gVRMod。同一時間只能由一個附加元件控制視角。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:28
msgid "SteamVR could not start VR. Check the headset connection and SteamVR, then try again."
msgstr "SteamVR 無法啟動 VR。請檢查頭戴裝置連線與 SteamVR 後再試。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:29
msgid "SteamVR is not installed. Install SteamVR in Steam, connect the headset, then try again."
msgstr "尚未安裝 SteamVR。請在 Steam 中安裝 SteamVR，連接頭戴裝置後重試。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:30
msgid "SteamVR ended the VR session. The flat game's settings have been restored."
msgstr "SteamVR 已結束 VR 工作階段。一般螢幕遊戲的設定已還原。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:31
msgid "Waiting for headset tracking. Check that the base stations can see the headset."
msgstr "正在等待頭戴裝置追蹤。請確認基地台能看見頭戴裝置。"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:33
msgid "VR is off"
msgstr "VR 已關閉"

#: nativeloader/lua/autorun/client/nativeloader_vr.lua:33
