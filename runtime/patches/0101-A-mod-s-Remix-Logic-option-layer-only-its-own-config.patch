+  void testOptionsAModMaySet() {
+    // The options the review named (finding 1), each refused whatever kind it is given: the 14 path options the GMod
+    // fixes keep from Lua (ADR 0112), the water rings' texture, the splash, captures, keys, the interface language,
+    // the replacement switches and the sky probe.
+    const char* const named[] = {
+      "rtx.atmosphere.moonAlbedoTexture", "rtx.atmosphere.moonNormalTexture", "rtx.atmosphere.starMapTexture",
+      "rtx.atmosphere.starMapGalaxyTexture", "rtx.atmosphere.starMapNebulaTexture", "rtx.baseGameModPathRegex",
+      "rtx.baseGameModRegex", "rtx.cameraSequence.filePath", "rtx.captureInstanceStageName",
+      "rtx.captureTimestampReplacement", "rtx.neuralRadianceCache.cudaDllDepsDirectoryPath",
+      "rtx.nsight.graphicsCaptureInstallPath", "rtx.nsight.graphicsCaptureOutputDir",
+      "rtx.nsight.graphicsCaptureOutputFile", "rtx.waterSim.rings.texture", "rtx.welcomeMessage",
+      "rtx.splashMessageDisplayTimeSeconds", "rtx.hideSplashMessage", "rtx.captureInstances", "rtx.captureMaxFrames",
+      "rtx.capture.correctBakedTransforms", "rtx.captureHotKey", "rtx.remixMenuKeyBinds", "rtx.crashHotkey",
+      "rtx.gpuCrashHotkey", "rtx.enableCrashHotkey", "rtx.freeCam.keyMoveForward", "rtx.gui.language",
+      "rtx.enableReplacementAssets", "rtx.enableReplacementLights", "rtx.enableReplacementMaterials",
+      "rtx.enableReplacementMeshes", "rtx.enableReplacementInstancerMeshRendering", "rtx.skyProbeSide",
+      "rtx.ignoreTextures", "rtx.showUI", "rtx.graph.enable", "rtx.enableRaytracing", "rtx.geometryAssetHashRuleString",
+      "rtx.gmod.fallbackMods", "rtx.neuralRadianceCache.enableCustomNetworkConfig", "rtx.automation.disableBlockingDialogBoxes",
+    };
+    for (const char* name : named) {
+      for (const ValueKind kind : { ValueKind::Bool, ValueKind::Float, ValueKind::String }) {
+        CHECK(!optionAllowed(facts(name, kind)));
+      }
+      CHECK(!optionAllowed(ranged(name, 0, 60)));
+    }
+    // What a mod's layer is for: the sky, the weather, fog, exposure, tone mapping, bloom, post effects.
+    for (const char* name : { "rtx.atmosphere.sunSize", "rtx.atmosphere.sunDiskEnable", "rtx.volumetrics.enable",
+                              "rtx.tonemap.exposureBias", "rtx.autoExposure.enabled", "rtx.postfx.vignetteIntensity",
+                              "rtx.weather.precipitation.intensity", "rtx.skyBrightness", "rtx.emissiveIntensity",
+                              "rtx.fogColorScale", "rtx.maxFogDistance", "rtx.enableFog", "rtx.fogIgnoreSky",
+                              "rtx.vertexColorStrength", "rtx.lightConversionIntensityFactor", "RTX.ATMOSPHERE.SUNSIZE" }) {
+      CHECK(optionAllowed(facts(name, ValueKind::Float)));
+      CHECK(optionAllowed(facts(name, ValueKind::Bool)));
+      CHECK(optionAllowed(facts(name, ValueKind::FloatVector)));
+    }
+    // Look-alike names are not listed ones.
+    CHECK(!optionAllowed(facts("rtx.atmospherex.sunSize", ValueKind::Float)));
+    CHECK(!optionAllowed(facts("rtx.skyBrightnessScale", ValueKind::Float)));
+    CHECK(!optionAllowed(facts("atmosphere.sunSize", ValueKind::Float)));
+    CHECK(!optionAllowed(facts("", ValueKind::Float)));
+    // In the listed namespaces: no text, list, key or integer vector; no debugging option; nothing named as a file.
+    for (const ValueKind kind : { ValueKind::String, ValueKind::HashSet, ValueKind::HashVector, ValueKind::VirtualKeys,
+                                  ValueKind::IntVector }) {
+      CHECK(!optionAllowed(facts("rtx.atmosphere.sunSize", kind)));
+    }
+    CHECK(!optionAllowed(facts("rtx.atmosphere.debugDispatchSkyLuts", ValueKind::Bool)));
+    CHECK(!optionAllowed(ranged("rtx.atmosphere.aerialPerspectiveSceneShadowDebug", 0, 2)));
+    CHECK(!optionAllowed(facts("rtx.atmosphere.cloudNoiseTexture", ValueKind::Float)));
+    CHECK(!optionAllowed(facts("rtx.postfx.lutFile", ValueKind::Float)));
+    // An integer only with a declared range of at most 1024 values: counts and sizes without one exhaust memory or
+    // hang the GPU, modes without one index past their tables.
+    CHECK(optionAllowed(ranged("rtx.atmosphere.dayOfYear", 1, 365)));
+    CHECK(optionAllowed(ranged("rtx.atmosphere.aerialPerspectiveLutResolution", 8, 256)));
+    CHECK(optionAllowed(ranged("rtx.bloom.steps", 1, 8)));
+    CHECK(optionAllowed(ranged("rtx.bloom.steps", 0, 1024)));
+    CHECK(!optionAllowed(ranged("rtx.bloom.steps", 0, 1025)));
+    CHECK(!optionAllowed(ranged("rtx.volumetrics.restirFroxelDepthSlices", 1, 65535)));
+    CHECK(!optionAllowed(ranged("rtx.bloom.steps", 8, 1)));  // a max below the min (an unsigned max read as -1)
+    CHECK(!optionAllowed(facts("rtx.atmosphere.cloudViewSamples", ValueKind::Int)));
+    CHECK(!optionAllowed(facts("rtx.weather.precipitation.maxParticles", ValueKind::Int)));
+    CHECK(!optionAllowed(facts("rtx.tonemap.tonemapOperator", ValueKind::Int)));
+    OptionFacts onlyMin = facts("rtx.postfx.motionBlurSampleCount", ValueKind::Int);
+    onlyMin.hasMin = true;
+    onlyMin.minValue = 1;
+    CHECK(!optionAllowed(onlyMin));
+    // Never the player's own settings or runtime state.
+    OptionFacts user = ranged("rtx.volumetrics.froxelDepthSlices", 1, 64);
+    user.userSetting = true;
+    CHECK(!optionAllowed(user));
+    OptionFacts userFloat = facts("rtx.postfx.motionBlurIntensity", ValueKind::Float);
+    userFloat.userSetting = true;
+    CHECK(!optionAllowed(userFloat));
+    OptionFacts runtime = facts("rtx.atmosphere.sunSize", ValueKind::Bool);
+    runtime.noSave = true;
+    CHECK(!optionAllowed(runtime));
+    std::string reason;
+    CHECK(!optionAllowed(facts("rtx.welcomeMessage", ValueKind::String), &reason));
+    CHECK(reason == "not a rendering option a mod may set");
+  }
+
+  // The file the review's reproduction loads through RtxOptionLayerAction: only the rendering option applies.
+  void testTheReviewsLayerFile() {
+    struct Entry { OptionFacts option; bool applies; };
+    const std::vector<Entry> file = {
+      { facts("rtx.ignoreTextures", ValueKind::HashSet), false },                              // = zz
+      { facts("rtx.neuralRadianceCache.cudaDllDepsDirectoryPath", ValueKind::String), false }, // = \\host\share
+      { facts("rtx.atmosphere.moonAlbedoTexture", ValueKind::String), false },                 // = \\host\share\m.dds
+      { facts("rtx.welcomeMessage", ValueKind::String), false },                               // = %s%s%s%s
+      { ranged("rtx.splashMessageDisplayTimeSeconds", 0, 60), false },                         // = 2147483647
+      { facts("rtx.captureHotKey", ValueKind::VirtualKeys), false },
+      { facts("rtx.atmosphere.sunSize", ValueKind::Float), true },                             // = 1.2
+    };
+    for (const Entry& entry : file) {
+      CHECK(optionAllowed(entry.option) == entry.applies);
+    }
+  }
+
+  void testValuesThatFailToParse() {
+    std::string error;
+    CHECK(!parsedWithoutThrow([]() { (void)std::stoull("zz", nullptr, 16); }, &error));
+    CHECK(!error.empty());
+    CHECK(parsedWithoutThrow([]() { (void)std::stoull("0x1F", nullptr, 16); }));
+    CHECK(!parsedWithoutThrow([]() { (void)std::stoull("99999999999999999999999", nullptr, 16); }, &error));
+    volatile int code = 42;  // read at run time, so the throw below is not seen to be certain
+    CHECK(!parsedWithoutThrow([&code]() { if (code != 0) { throw static_cast<int>(code); } }, &error));
+    CHECK(error == "an unknown error");
+    // As the runtime reads a hash list: into a copy, kept only whole, so a bad entry leaves the value as it was.
+    std::vector<uint64_t> value = { 1 };
+    std::vector<uint64_t> parsed = value;
+    const bool whole = parsedWithoutThrow([&parsed]() {
+      for (const char* text : { "0x2", "zz", "0x3" }) {
+        parsed.push_back(std::stoull(text, nullptr, 16));
+      }
+    });
+    if (whole) {
+      value = parsed;
+    }
+    CHECK(!whole);
+    CHECK(value.size() == 1 && value[0] == 1);
+  }
+}
+
+int main() {
+  testAuthoredPaths();
+  testInsideTheModsFolder();
+  testConfigPaths();
+  testOptionsAModMaySet();
+  testTheReviewsLayerFile();
+  testValuesThatFailToParse();
+  if (g_failures != 0) {
+    std::printf("FAILED mod layer policy: %d of %d checks\n", g_failures, g_checks);
+    return 1;
+  }
+  std::printf("PASS mod layer policy: %d checks\n", g_checks);
+  return 0;
+}
