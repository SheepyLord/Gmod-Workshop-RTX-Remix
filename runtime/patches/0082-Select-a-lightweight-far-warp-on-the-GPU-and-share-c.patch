+  const int2 lo=clamp(int2(floor(saturate(min(start,infinity))*float2(depthSize)/float2(8,4))),int2(0),tileHi);
+  const int2 hi=clamp(int2(floor(saturate(max(start,infinity))*float2(depthSize)/float2(8,4))),int2(0),tileHi);
   float local=cb.centre.z;
   // Every possible intersection lies on this segment. Its tile rectangle is conservative,
