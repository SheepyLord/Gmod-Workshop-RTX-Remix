     const auto start=warpAtDepth(p,eye,u,v,nearest,unitsPerMetre);
     auto refine=[&](std::array<double,2> uv, bool& settled) {
       for(unsigned i=0;i<8;++i) {
diff --git a/tests/rtx/unit/test_vr_math.cpp b/tests/rtx/unit/test_vr_math.cpp
index e4750017..853196a9 100644
--- a/tests/rtx/unit/test_vr_math.cpp
+++ b/tests/rtx/unit/test_vr_math.cpp
@@ -127,6 +127,18 @@ int main() {
   rtxvr_Eye parallel[] {eye(0,-.032),eye(0,.032)};
   Projection finite;
   require(centreProjection(parallel,2016,2240,1,finite), "parallel-eye near projection accepted");
+  for(double distance:{.2,.3,.5}) for(const auto& side:parallel) {
+    unsigned missing=0;
+    const double halfWidth=.04,halfHeight=.05;
+    for(double x:{-halfWidth,halfWidth}) for(double y:{-halfHeight,halfHeight}) {
+      const auto uv=project(finite,{x,y,-distance});
+      missing+=uv[0]<0||uv[0]>1||uv[1]<0||uv[1]>1;
+      const auto ray=eyeRay(side,(x-side.eyeToHead.m[0][3])/distance*.5+.5,.5-y/distance*.5);
+      const auto centre=warpAtDepth(finite,side,(x-side.eyeToHead.m[0][3])/distance*.5+.5,.5-y/distance*.5,distance,1);
+      missing+=centre[0]<0||centre[0]>1||centre[1]<0||centre[1]>1||!std::isfinite(ray.z);
+    }
+    require(!missing,"held prop at 0.2, 0.3 or 0.5 metres is covered in either eye");
+  }
   require(std::abs(finite.tanX-1-.032/kNearestEyeDepthMetres)<1e-7,
     "parallel-eye margin is half-IPD divided by nearest axial depth");
   require(p.tanX>=1.1917535, "infinite toe-in extremum remains covered when translation moves it inward");
@@ -145,9 +157,9 @@ int main() {
     index[0].tanLeft=-1.5383247137f;index[0].tanRight=1.0495523214f;index[0].tanTop=-1.4038075209f;index[0].tanBottom=1.411382556f;
     index[1].tanLeft=-1.049559474f;index[1].tanRight=1.541975141f;index[1].tanTop=-1.411364913f;index[1].tanBottom=1.406647086f;
