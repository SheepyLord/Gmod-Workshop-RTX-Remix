+      bool containsNoCase(const std::string& text, const std::string& needle) {
+        if (needle.empty()) {
+          return true;
+        }
+        auto it = std::search(text.begin(), text.end(), needle.begin(), needle.end(),
+                              [](char a, char b) { return std::tolower(uint8_t(a)) == std::tolower(uint8_t(b)); });
+        return it != text.end();
+      }
