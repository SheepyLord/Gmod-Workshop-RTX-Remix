--- a/src/dxvk/rtx_render/rtx_vr_math.h
+++ b/src/dxvk/rtx_render/rtx_vr_math.h
@@ -109,37 +109,50 @@ namespace dxvk::vrmath {
     return std::clamp(unsigned(std::ceil(span))+1,1u,128u);
   }
 
+  template<typename Depth>
+  inline double colourCoverageDepth(Depth depthAt,double u,double v,uint32_t width,uint32_t height) {
+    auto valid=[](double z) { return std::isfinite(z)&&std::abs(z)>0 ? std::abs(z) : 1e20; };
+    const double centre=valid(depthAt(u,v));
+    if(!width||!height) { return centre; }
+    double nearest=centre;
+    for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x) {
+      nearest=std::min(nearest,valid(depthAt(u+double(x)/width,v+double(y)/height)));
+    }
+    return nearest<centre*.9 ? nearest : centre;
+  }
+
   template<typename Depth>
   inline std::array<double, 2> warp(const Projection& p, const rtxvr_Eye& eye,
                                   double u, double v, double unitsPerMetre, Depth depthAt, unsigned taps=0,
-                                  uint32_t depthWidth=0,uint32_t depthHeight=0) {
+                                  uint32_t depthWidth=0,uint32_t depthHeight=0,bool colourCoverage=true) {
+    auto read=[&](double x,double y) { return colourCoverage ? colourCoverageDepth(depthAt,x,y,depthWidth,depthHeight) : depthAt(x,y); };
     const auto infinity=project(p,eyeRay(eye,u,v));
     const double nearest=kNearestEyeDepthMetres*unitsPerMetre;
     const auto start=warpAtDepth(p,eye,u,v,nearest,unitsPerMetre);
     auto refine=[&](std::array<double,2> uv, bool& settled) {
       for(unsigned i=0;i<8;++i) {
-        const auto next=warpAtDepth(p,eye,u,v,depthAt(uv[0],uv[1]),unitsPerMetre);
+        const auto next=warpAtDepth(p,eye,u,v,read(uv[0],uv[1]),unitsPerMetre);
         if(std::hypot(next[0]-uv[0],next[1]-uv[1])<1e-6) { settled=true;return next; }
         uv=next;
       }
       settled=false;return uv;
     };
     taps=searchSteps(start,infinity,depthWidth,depthHeight,taps);
-    double previousDepth=depthAt(start[0],start[1]);
+    double previousDepth=read(start[0],start[1]);
     for(unsigned i=0;i<=taps;++i) {
       double s=1-double(i)/taps;
       auto sample=[&](double inverse) { return std::array<double,2>{
         infinity[0]+(start[0]-infinity[0])*inverse,infinity[1]+(start[1]-infinity[1])*inverse}; };
       auto uv=sample(s);
       const double rayDepth=s>0 ? nearest/s : 1e20;
-      const double depth=depthAt(uv[0],uv[1]);
+      const double depth=read(uv[0],uv[1]);
       double best=std::numeric_limits<double>::infinity();
       std::array<double,2> closest{};
       for(double candidate:{std::min(depth,previousDepth),std::max(depth,previousDepth)}) {
         if(candidate>rayDepth) { continue; }
         bool settled=false;
         const auto hit=refine(warpAtDepth(p,eye,u,v,candidate,unitsPerMetre),settled);
-        const double resolved=depthAt(hit[0],hit[1]);
+        const double resolved=read(hit[0],hit[1]);
         if(settled&&resolved<=rayDepth*(1+1e-6)&&resolved<best) { best=resolved;closest=hit; }
       }
       if(std::isfinite(best)) { return closest; }
@@ -150,7 +163,7 @@ namespace dxvk::vrmath {
     double farDepth = 0;
     // No visible intersection was resolved: retain an observed background sample at a disocclusion.
     for (int i = 0; i < 8; ++i) {
-      const double z = depthAt(uv[0], uv[1]);
+      const double z = read(uv[0], uv[1]);
       const auto next = warpAtDepth(p, eye, u, v, z, unitsPerMetre);
       if (z > farDepth) { farDepth = z; farUv = uv; }
       if (std::hypot(next[0]-uv[0], next[1]-uv[1]) < 1e-6) { return next; }
