{
  "item": "3829070317",
  "package": {
    "id": "gmod-rtx-remix",
    "name": "RTX Remix for Garry's Mod",
    "title": "RTX Remix for Garry's Mod (native loader package)",
    "type": "effects",
    "tags": [
      "realism"
    ],
    "description": "Native package for the GMod native loader: the RTX Remix runtime, the RTX fixes and ReShade for RTX sessions. This shipment needs loader 0.10.0 or later (bin\\win64\\winmm.dll) and a native-loader\\config.json that allowlists this item. It includes early client rendering compatibility checks on supported stock builds and process-only stock D3D9 selection for RTX. It supports verified RTX client scripts on multiplayer servers with sv_allowcslua 0 and automatic backup and migration of supported previous RTXLauncher installations. With loader 0.11.0 it also picks lighter Remix settings for smaller NVIDIA GPUs and keeps local crash evidence. GMod does not mount this item itself; the loader deploys it."
  },
  "parts": [
    {
      "name": "runtime",
      "build": "package_runtime",
      "args": [
        "--runtime",
        "out/inputs/runtime/files",
        "--dxvk-conf",
        "out/inputs/runtime/layers/classic_remix_defaults.conf",
        "--dxvk-conf",
        "out/inputs/runtime/layers/compiler_threads.conf",
        "--tier-conf",
        "medium",
        "out/inputs/runtime/layers/medium.conf",
        "--tier-conf",
        "low",
        "out/inputs/runtime/layers/low.conf",
        "--env",
        "DXVK_FORCE_WINDOWED=1"
      ]
    },
    {
