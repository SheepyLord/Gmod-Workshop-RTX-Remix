--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/vr/vr_depth_range.comp.slang
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: MIT
+[[vk::binding(0)]] Texture2D<float> TileMinimum;
+[[vk::binding(1)]] RWTexture2D<float> FrameMinimum;
+groupshared uint groupMinimum;
+[shader("compute")]
+[numthreads(256,1,1)]
+void main(uint lane:SV_GroupIndex) {
+  uint w,h;TileMinimum.GetDimensions(w,h);
+  float nearest=1e20;
+  for(uint i=lane;i<w*h;i+=256) {
+    nearest=min(nearest,TileMinimum.Load(int3(i%w,i/w,0)));
+  }
+  if(lane==0) { groupMinimum=asuint(1e20); }
+  GroupMemoryBarrierWithGroupSync();
+  const float waveMinimum=WaveActiveMin(nearest);
+  if(WaveIsFirstLane()) { uint ignored;InterlockedMin(groupMinimum,asuint(waveMinimum),ignored); }
+  GroupMemoryBarrierWithGroupSync();
+  if(lane==0) { FrameMinimum[uint2(0,0)]=asfloat(groupMinimum); }
+}
