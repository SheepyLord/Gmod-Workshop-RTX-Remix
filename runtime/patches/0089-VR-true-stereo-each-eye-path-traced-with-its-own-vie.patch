diff --git a/src/dxvk/dxvk_device.cpp b/src/dxvk/dxvk_device.cpp
index 3acff68b..7dd3dfd5 100644
--- a/src/dxvk/dxvk_device.cpp
+++ b/src/dxvk/dxvk_device.cpp
@@ -605,6 +605,32 @@ namespace dxvk {
     return *m_textureManager;
   }
 
+  // NV-DXVK start: VR true stereo
+  void DxvkObjects::createRightEyeState() {
+    if (m_rightEye) { return; }
+    auto eye = std::make_unique<RightEyeState>();
+    eye->resources = std::make_unique<Resources>(m_device);
+    // The TLAS, noise, sky probe and matte belong to the frame, not to a view: the default state keeps them.
+    eye->resources->shareGlobalsWith(&m_rtResources);
+    m_rightEye = std::move(eye);
+    // A pass registers its frame and resize events with the state getResources() returns while it is made.
+    vreye::Scope right(1);
+    m_rightEye->restirgi = std::make_unique<DxvkReSTIRGIRayQuery>(m_device);
+    m_rightEye->rayReconstruction = std::make_unique<DxvkRayReconstruction>(m_device);
+    m_rightEye->nrc = std::make_unique<NeuralRadianceCache>(m_device);
+    m_rightEye->sharc = std::make_unique<SpatiallyHashedRadianceCache>(m_device);
+    Logger::info("RTX VR true stereo: the right eye's view state was made");
+  }
+
+  void DxvkObjects::releaseRightEyeState() {
+    if (!m_rightEye) { return; }
+    m_device->waitForIdle();
+    if (m_rightEye->rayReconstruction) { m_rightEye->rayReconstruction->onDestroy(); }
+    m_rightEye.reset();
+    Logger::info("RTX VR true stereo: the right eye's view state was released");
+  }
+  // NV-DXVK end
+
   void DxvkObjects::onDestroy() {
     // NV-DXVK start: Retire VR before common query/image allocators are destroyed
     metaVr().onDestroy();
