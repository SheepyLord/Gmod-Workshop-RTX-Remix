+
+    template<typename Table, size_t SlotSize>
+    void writeGpuSlot(
+        Table& table,
+        uint32_t index,
+        const std::array<unsigned char, SlotSize>& value
+    ) {
+      std::memcpy(
+        table.shadow.data() + size_t(index) * SlotSize,
+        value.data(),
+        SlotSize
+      );
+      table.uploads.markSlot(index);
+    }
