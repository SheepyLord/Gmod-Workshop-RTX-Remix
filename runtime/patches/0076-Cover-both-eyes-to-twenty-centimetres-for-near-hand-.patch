+          out.tanX=std::max(out.tanX,std::abs((e.eyeToHead.m[0][3]+t*ray.x)/nearestDepth));
+          out.tanY=std::max(out.tanY,std::abs((e.eyeToHead.m[1][3]+t*ray.y)/nearestDepth));
         }
       }
       // Inverse Jacobian at the eye's optical centre: preserve density even with cant and roll.
