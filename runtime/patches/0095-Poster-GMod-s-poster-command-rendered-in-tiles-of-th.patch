diff --git a/tests/rtx/unit/test_poster_math.cpp b/tests/rtx/unit/test_poster_math.cpp
new file mode 100644
index 000000000..4f0583f1f
--- /dev/null
+++ b/tests/rtx/unit/test_poster_math.cpp
@@ -0,0 +1,314 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// The poster's arithmetic (ADR 0226 of the GMod native loader project): tiles that cover the poster with their
+// overlap, each tile's narrowed projection and direction basis, and the composer that blends them.
+// Standalone: cl /EHsc /std:c++17 /W4 /WX test_poster_math.cpp
+
+#include "../../../src/dxvk/rtx_render/rtx_poster_math.h"
+
+#include <cstdio>
+#include <random>
+
+using namespace dxvk::poster;
+
+namespace {
+  int g_checks = 0;
+  int g_failures = 0;
+
+  void check(bool condition, const char* what, int line) {
+    ++g_checks;
+    if (!condition) {
+      ++g_failures;
+      if (g_failures < 40) { std::printf("FAIL line %d: %s\n", line, what); }
+    }
+  }
+#define CHECK(condition) check((condition), #condition, __LINE__)
+
+  bool near(double a, double b, double tolerance = 1e-9) { return std::abs(a - b) <= tolerance; }
+
+  // A column-major matrix as the runtime's: m[column][row], clip = m * view.
+  struct Matrix { double m[4][4] {}; double* operator[](int i) { return m[i]; } const double* operator[](int i) const { return m[i]; } };
+
+  // Direct3D's PerspectiveFovLH (w = z) or PerspectiveFovRH (w = -z), column-major.
+  Matrix perspective(double tanHalfY, double aspect, double nearZ, double farZ, bool leftHanded) {
+    Matrix p;
+    p[0][0] = 1 / (tanHalfY * aspect);
+    p[1][1] = 1 / tanHalfY;
+    const double range = farZ / (farZ - nearZ);
+    if (leftHanded) {
+      p[2][2] = range; p[2][3] = 1; p[3][2] = -nearZ * range;
+    } else {
+      p[2][2] = -range; p[2][3] = -1; p[3][2] = -nearZ * range;
+    }
+    return p;
+  }
+
+  void apply(const Matrix& m, const double v[4], double out[4]) {
+    for (int row = 0; row < 4; ++row) {
+      out[row] = 0;
+      for (int column = 0; column < 4; ++column) { out[row] += m[column][row] * v[column]; }
+    }
+  }
+
+  void testTileCounts() {
+    CHECK(tileCount(100, 100, 10) == 1);
+    CHECK(tileCount(50, 100, 10) == 1);
+    CHECK(tileCount(200, 100, 0) == 2);
+    CHECK(tileCount(200, 100, 1) == 3);   // two tiles cannot share a pixel and still cover twice the width
+    CHECK(tileCount(400, 100, 0) == 4);
+    CHECK(tileCount(400, 100, 20) == 5);
+    CHECK(tileCount(100, 0, 0) == 0);
+    // Every layout: the first tile starts at 0, the last ends on the edge, neighbours share at least the overlap
+    // and never a whole tile, so every pixel is covered.
+    const uint32_t tiles[] = { 64, 100, 641, 1280, 1920, 2560, 3840 };
+    for (uint32_t tile : tiles) {
+      for (uint32_t multiplier = 1; multiplier <= 16; ++multiplier) {
+        for (uint32_t overlap : { 0u, 1u, 16u, tile / 16, tile / 4 }) {
+          const uint32_t total = tile * multiplier;
+          const uint32_t count = tileCount(total, tile, overlap);
+          bool ok = tileOrigin(0, count, total, tile) == 0 && tileOrigin(count - 1, count, total, tile) + tile == total;
+          for (uint32_t i = 0; i + 1 < count; ++i) {
+            const uint32_t a = tileOrigin(i, count, total, tile), b = tileOrigin(i + 1, count, total, tile);
+            ok = ok && b > a && a + tile >= b + overlap && a + tile >= b;
+          }
+          if (multiplier > 1 && overlap == 0) { ok = ok && count == multiplier; }
+          CHECK(ok);
+        }
+      }
+    }
+  }
+
+  void testLayouts() {
+    Layout layout;
+    std::string why;
+    CHECK(!makeLayout(1920, 1080, 0, 64, layout, why) && !why.empty());
+    CHECK(!makeLayout(1920, 1080, 17, 64, layout, why));
+    CHECK(!makeLayout(63, 1080, 2, 64, layout, why));
+    CHECK(makeLayout(1920, 1080, 1, 64, layout, why));
+    CHECK(layout.columns == 1 && layout.rows == 1 && layout.overlap == 0 && layout.width == 1920 && layout.height == 1080);
+    CHECK(makeLayout(1920, 1080, 2, defaultOverlap(1920, 1080), layout, why));
+    CHECK(layout.width == 3840 && layout.height == 2160 && layout.columns == 3 && layout.rows == 3);
+    CHECK(layout.overlap == 67 && layout.tiles() == 9);
+    CHECK(makeLayout(3840, 2160, 4, defaultOverlap(3840, 2160), layout, why));
+    CHECK(layout.width == 15360 && layout.height == 8640 && layout.columns == 5 && layout.rows == 5);
+    // 16384 across and down at most: 4 x 4K is 15360 x 8640, 5 x 4K is 19200 across.
+    CHECK(makeLayout(3840, 2160, 4, 135, layout, why) && layout.width == 15360);
+    CHECK(!makeLayout(3840, 2160, 5, 135, layout, why) && why.find("16384") != std::string::npos);
+    CHECK(makeLayout(1920, 1080, 8, 67, layout, why) && layout.width == 15360 && layout.height == 8640);
+    CHECK(!makeLayout(1920, 1080, 9, 67, layout, why));
+    CHECK(makeLayout(1024, 576, 16, 36, layout, why) && layout.width == 16384 && layout.height == 9216);
+    CHECK(!makeLayout(1280, 720, 16, 45, layout, why));   // 20480 across: wider than the sky matte's viewport
+    CHECK(!makeLayout(2048, 256, 16, 16, layout, why));   // 32768 x 4096: few pixels, but too wide
+    // The overlap never exceeds a quarter of the window's short side.
+    CHECK(makeLayout(640, 360, 3, 1000, layout, why) && layout.overlap == 90);
+    CHECK(defaultOverlap(640, 360) == 22 && defaultOverlap(200, 100) == 16 && defaultOverlap(16000, 9000) == 256);
+    CHECK(near(pixelScale(layout), 3.0));
+  }
+
+  // A poster pixel's centre in the poster's ndc, and the same point's ndc in a tile holding it.
+  void pixelNdc(uint32_t x, uint32_t y, uint32_t width, uint32_t height, double& nx, double& ny) {
+    nx = -1.0 + 2.0 * (x + 0.5) / width;
+    ny = 1.0 - 2.0 * (y + 0.5) / height;
+  }
+
+  void testWindowsAndProjections() {
+    Layout layout;
+    std::string why;
+    CHECK(makeLayout(1280, 720, 3, 45, layout, why));
+    // The windows of a 1 x 1 layout are the whole view.
+    Layout single;
+    CHECK(makeLayout(1280, 720, 1, 45, single, why));
+    const Window whole = tileWindow(single, 0);
+    CHECK(whole.x0 == -1 && whole.x1 == 1 && whole.y0 == -1 && whole.y1 == 1);
+
+    std::mt19937 random(7);
+    std::uniform_real_distribution<double> unit(0.0, 1.0);
+    for (bool leftHanded : { true, false }) {
+      const Matrix full = perspective(std::tan(0.5 * 1.3), 16.0 / 9.0, 4.0, 30000.0, leftHanded);
+      for (uint32_t index = 0; index < layout.tiles(); ++index) {
+        Matrix tile = full;
+        const Window window = tileWindow(layout, index);
+        narrowProjection(tile, window);
+        const Origin origin = tileOrigin(layout, index);
+        // Depth and w rows untouched.
+        bool depth = true;
+        for (int column = 0; column < 4; ++column) {
+          depth = depth && tile[column][2] == full[column][2] && tile[column][3] == full[column][3];
+        }
+        CHECK(depth);
+        // A point the full view puts at a poster pixel the tile holds lands on the tile's own pixel.
+        bool pixels = true, inside = true;
+        for (int sample = 0; sample < 200; ++sample) {
+          const uint32_t tx = uint32_t(unit(random) * layout.tileWidth) % layout.tileWidth;
+          const uint32_t ty = uint32_t(unit(random) * layout.tileHeight) % layout.tileHeight;
+          double px, py;
+          pixelNdc(origin.x + tx, origin.y + ty, layout.width, layout.height, px, py);
+          // The view-space point at depth z that the full projection puts at (px, py).
+          const double z = 10.0 + unit(random) * 1000.0;
+          // In front of the camera: view z is +z left-handed, -z right-handed, and the clip w is z for both.
+          double v[4] = { px * z / full[0][0], py * z / full[1][1], leftHanded ? z : -z, 1 };
+          double clip[4];
+          apply(tile, v, clip);
+          double expectX, expectY;
+          pixelNdc(tx, ty, layout.tileWidth, layout.tileHeight, expectX, expectY);
+          pixels = pixels && near(clip[0] / clip[3], expectX, 1e-7) && near(clip[1] / clip[3], expectY, 1e-7);
+          inside = inside && clip[0] / clip[3] > -1 && clip[0] / clip[3] < 1;
+        }
+        CHECK(pixels);
+        CHECK(inside);
+      }
+    }
+    // The windows together cover the poster: each poster pixel lies in at least one window.
+    bool covered = true;
+    for (uint32_t y = 0; y < layout.height; y += 37) {
+      for (uint32_t x = 0; x < layout.width; x += 41) {
+        double nx, ny;
+        pixelNdc(x, y, layout.width, layout.height, nx, ny);
+        bool any = false;
+        for (uint32_t index = 0; index < layout.tiles() && !any; ++index) {
+          const Window window = tileWindow(layout, index);
+          any = nx >= window.x0 && nx <= window.x1 && ny >= window.y0 && ny <= window.y1;
+        }
+        covered = covered && any;
+      }
+    }
+    CHECK(covered);
+  }
+
+  void testBasis() {
+    const double forward[3] = { 0, 0, 1 }, right[3] = { 1, 0, 0 }, up[3] = { 0, 1, 0 };
+    const double tanX = std::tan(0.5 * 1.6), tanY = std::tan(0.5 * 1.0);
+    Layout layout;
+    std::string why;
+    CHECK(makeLayout(1920, 1080, 4, 67, layout, why));
+    bool same = true, unitForward = true;
+    for (uint32_t index = 0; index < layout.tiles(); ++index) {
+      const Window window = tileWindow(layout, index);
+      const Basis basis = windowBasis(forward, right, up, tanX, tanY, window);
+      unitForward = unitForward && near(basis.forward[2], 1.0);
+      for (double x : { -1.0, -0.3, 0.0, 0.8, 1.0 }) {
+        for (double y : { -1.0, 0.25, 1.0 }) {
+          // The full view's direction at the poster ndc this tile ndc stands for.
+          const double fx = (window.x0 + window.x1) / 2 + x * (window.x1 - window.x0) / 2;
+          const double fy = (window.y0 + window.y1) / 2 + y * (window.y1 - window.y0) / 2;
+          for (int i = 0; i < 3; ++i) {
+            const double tileDirection = basis.forward[i] + basis.right[i] * x + basis.up[i] * y;
+            const double fullDirection = forward[i] + right[i] * fx * tanX + up[i] * fy * tanY;
+            same = same && near(tileDirection, fullDirection, 1e-12);
+          }
+        }
+      }
+    }
+    CHECK(same);
+    CHECK(unitForward);
+    // A 1 x 1 layout's basis is the whole view's.
+    const Basis whole = windowBasis(forward, right, up, tanX, tanY, Window {});
+    CHECK(near(whole.right[0], tanX) && near(whole.up[1], tanY) && near(whole.forward[0], 0) && near(whole.forward[1], 0));
+  }
+
+  void testWeights() {
+    bool rising = true, bounded = true;
+    for (uint32_t n : { 1u, 2u, 3u, 67u, 256u, 1000u }) {
+      uint32_t previous = 0;
+      for (uint32_t i = 0; i < n; ++i) {
+        const uint32_t a = Composer::weight(i, n);
+        bounded = bounded && a <= 256 && (n == 1 ? a == 128 : true);
+        rising = rising && (i == 0 || a >= previous);
+        previous = a;
+      }
+      CHECK(Composer::weight(0, n) <= 128 && Composer::weight(n - 1, n) >= 128);
+    }
+    CHECK(rising);
+    CHECK(bounded);
+    for (int value : { 0, 1, 127, 128, 254, 255 }) {
+      bool exact = true;
+      for (uint32_t a = 0; a <= 256; ++a) { exact = exact && Composer::mix(uint8_t(value), uint8_t(value), a) == value; }
+      CHECK(exact);  // mixing a pixel with itself leaves it as it is
+    }
+    CHECK(Composer::mix(0, 255, 0) == 0 && Composer::mix(0, 255, 256) == 255 && Composer::mix(0, 200, 128) == 100);
+  }
+
+  // Tiles cut out of one picture compose back into exactly that picture, whatever the overlaps.
+  void testComposerReassemblesAPicture() {
+    for (uint32_t multiplier : { 1u, 2u, 3u }) {
+      Layout layout;
+      std::string why;
+      CHECK(makeLayout(97, 71, multiplier, 9, layout, why));
+      std::vector<uint8_t> picture(size_t(layout.width) * layout.height * 4);
+      std::mt19937 random(multiplier);
+      for (auto& byte : picture) { byte = uint8_t(random()); }
+      Composer composer;
+      CHECK(composer.begin(layout, why));
+      const size_t pitch = size_t(layout.tileWidth) * 4 + 12;  // rows further apart than a row, as a readback may be
+      std::vector<uint8_t> tile(pitch * layout.tileHeight);
+      for (uint32_t index = 0; index < layout.tiles(); ++index) {
+        const Origin origin = tileOrigin(layout, index);
+        for (uint32_t y = 0; y < layout.tileHeight; ++y) {
+          std::memcpy(tile.data() + y * pitch, picture.data() + (size_t(origin.y + y) * layout.width + origin.x) * 4,
+                      size_t(layout.tileWidth) * 4);
+        }
+        CHECK(composer.addTile(index, tile.data(), pitch));
+      }
+      CHECK(composer.complete());
+      bool same = true;
+      for (size_t i = 0; i < size_t(layout.width) * layout.height; ++i) {
+        // BGR out of RGBA.
+        same = same && composer.pixels()[i * 3] == picture[i * 4 + 2] && composer.pixels()[i * 3 + 1] == picture[i * 4 + 1]
+          && composer.pixels()[i * 3 + 2] == picture[i * 4];
+      }
+      CHECK(same);
+    }
+  }
+
+  // Flat tiles of different values: a pixel only one tile covers is that tile's value, an overlap pixel lies
+  // between its tiles' values, and across an overlap the value moves steadily from one tile's to the next.
+  void testComposerBlendsOverlaps() {
+    Layout layout;
+    std::string why;
+    CHECK(makeLayout(200, 100, 2, 40, layout, why));
+    CHECK(layout.columns == 3 && layout.rows == 3);
+    Composer composer;
+    CHECK(composer.begin(layout, why));
+    CHECK(!composer.addTile(1, nullptr, 0));  // out of order
+    std::vector<uint8_t> tile(size_t(layout.tileWidth) * layout.tileHeight * 4);
+    auto value = [](uint32_t index) { return uint8_t(20 + index * 25); };
+    for (uint32_t index = 0; index < layout.tiles(); ++index) {
+      for (size_t i = 0; i < tile.size(); i += 4) { tile[i] = tile[i + 1] = tile[i + 2] = value(index); tile[i + 3] = 255; }
+      CHECK(composer.addTile(index, tile.data(), size_t(layout.tileWidth) * 4));
+    }
+    CHECK(!composer.addTile(layout.tiles(), tile.data(), 0));
+    const uint8_t* pixels = composer.pixels();
+    auto at = [&](uint32_t x, uint32_t y) { return pixels[(size_t(y) * layout.width + x) * 3]; };
+    // Tile origins across: 0, 100, 200 (tile 200 wide, poster 400): neighbours share 100 pixels.
+    CHECK(tileOrigin(1, 3, 400, 200) == 100 && tileOrigin(2, 3, 400, 200) == 200);
+    CHECK(at(10, 10) == value(0) && at(390, 10) == value(2) && at(10, 190) == value(6) && at(390, 190) == value(8));
+    bool steady = true;
+    for (uint32_t x = 100; x + 1 < 200; ++x) { steady = steady && at(x + 1, 10) >= at(x, 10); }
+    CHECK(steady);
+    CHECK(at(100, 10) <= value(0) + 2 && at(199, 10) >= value(1) - 2);
+    bool between = true;
+    for (uint32_t y = 0; y < layout.height; y += 3) {
+      for (uint32_t x = 0; x < layout.width; x += 3) { between = between && at(x, y) >= value(0) && at(x, y) <= value(8); }
+    }
+    CHECK(between);
+    composer.release();
+    CHECK(!composer.complete() && composer.pixels() == nullptr);
+  }
+}
+
+int main() {
+  testTileCounts();
+  testLayouts();
+  testWindowsAndProjections();
+  testBasis();
+  testWeights();
+  testComposerReassemblesAPicture();
+  testComposerBlendsOverlaps();
+  if (g_failures) {
+    std::printf("FAIL poster math: %d of %d checks\n", g_failures, g_checks);
+    return 1;
+  }
+  std::printf("PASS poster math: %d checks\n", g_checks);
+  return 0;
+}
-- 
