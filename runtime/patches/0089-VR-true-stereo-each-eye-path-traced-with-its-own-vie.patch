+// NV-DXVK start: VR true stereo
+void RtxAtmosphere::fitAerialPerspective(RtxContext& ctx, const RtCamera& eyeCamera, float left, float right, float top,
+                                         float bottom, AtmosphereArgs& args) {
+  // The shader's direction for screen ndc (x, y) is forward + right * x + up * y. An off-centre frustum is that
+  // with forward shifted, so the eye's volume needs nothing else; its forward component along the optical axis
+  // stays one, which the slice mapping relies on.
+  rtxvr_Eye edges {};
+  edges.tanLeft = left; edges.tanRight = right; edges.tanTop = top; edges.tanBottom = bottom;
+  const Vector3 f = eyeCamera.getDirection(/*freecam=*/true);
+  const Vector3 r = eyeCamera.getRight(/*freecam=*/true);
+  const Vector3 u = eyeCamera.getUp(/*freecam=*/true);
+  vrmath::Vec3 forward {}, rightScaled {}, upScaled {};
+  vrmath::eyeFrustumBasis(edges, { f.x, f.y, f.z }, { r.x, r.y, r.z }, { u.x, u.y, u.z }, forward, rightScaled, upScaled);
+  m_apCameraPosition = eyeCamera.getPosition(/*freecam=*/false);
+  m_apCameraForward = Vector3(float(forward.x), float(forward.y), float(forward.z));
+  m_apCameraRight = Vector3(float(rightScaled.x), float(rightScaled.y), float(rightScaled.z));
+  m_apCameraUp = Vector3(float(upScaled.x), float(upScaled.y), float(upScaled.z));
+  args.cameraPosition = m_apCameraPosition;
+  args.cameraForward = m_apCameraForward;
+  args.cameraRight = m_apCameraRight;
+  args.cameraUp = m_apCameraUp;
+  if (RtxOptions::skyMode() != SkyMode::Numos || !RtxAtmosphere::aerialPerspective()) {
+    return;
+  }
+  Rc<DxvkContext> context(&ctx);
+  dispatchAerialPerspectiveLut(context);
+  context->emitMemoryBarrier(0,
+    VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+    VK_ACCESS_SHADER_WRITE_BIT,
+    VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR,
+    VK_ACCESS_SHADER_READ_BIT);
+}
+// NV-DXVK end
+
 // In-scatter toward the camera in RGB, mean transmittance in A. Camera-frustum-fitted, so it is
 // rebuilt every frame rather than on parameter change; consumed by the composite to haze geometry.
 void RtxAtmosphere::createAerialPerspectiveLut(Rc<DxvkContext> ctx, uint32_t sizeXY, uint32_t sizeZ) {
@@ -2900,15 +2935,18 @@ void RtxAtmosphere::onFrameAdvanceForCloudHistory(uint32_t currentFrameId) {
