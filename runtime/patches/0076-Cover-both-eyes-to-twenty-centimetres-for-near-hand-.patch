From 891200bdb0d4d2b36e26f144c4b860bd90670487 Mon Sep 17 00:00:00 2001
From: SheepyLord <37598021+SheepyLord@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:49:52 -0700
Subject: [PATCH] Cover both eyes to twenty centimetres for near-hand
 measurements

Co-Authored-By: Codex <noreply@openai.com>
---
 src/dxvk/rtx_render/rtx_vr.cpp    | 20 +++++++++++++-------
 src/dxvk/rtx_render/rtx_vr.h      |  1 +
 src/dxvk/rtx_render/rtx_vr_math.h | 19 +++++++++++--------
 tests/rtx/unit/test_vr_math.cpp   | 16 ++++++++++++++--
 4 files changed, 39 insertions(+), 17 deletions(-)

diff --git a/src/dxvk/rtx_render/rtx_vr.cpp b/src/dxvk/rtx_render/rtx_vr.cpp
index d9a76280..e579cd0c 100644
--- a/src/dxvk/rtx_render/rtx_vr.cpp
+++ b/src/dxvk/rtx_render/rtx_vr.cpp
@@ -75,17 +75,23 @@ namespace dxvk {
   int RtxVr::start(const rtxvr_StartInfo* info) {
     if (!info || info->structSize!=sizeof(*info)) { return RTXVR_E_ARGUMENT; }
     if (info->apiVersion!=RTXVR_API_VERSION) { return RTXVR_E_VERSION; }
+    double nearest=vrmath::kNearestEyeDepthMetres;
+    const auto overrideNear=env::getEnvVar("RTX_VR_TEST_NEAR_METRES");
+    if(!overrideNear.empty()) {
+      std::istringstream parse(overrideNear);char tail=0;
+      if(!(parse>>nearest)||(parse>>tail)||!std::isfinite(nearest)||nearest<.2||nearest>.5) { return RTXVR_E_ARGUMENT; }
+    }
     vrmath::Projection p;
     if ((info->flags & ~(RTXVR_START_NO_SUBMIT|RTXVR_START_NO_MIRROR|RTXVR_START_RENDER_PACING)) ||
         (!(info->flags&RTXVR_START_NO_SUBMIT) && !info->getGenericInterface) ||
         !std::isfinite(info->worldUnitsPerMetre) || info->worldUnitsPerMetre<=0 || info->worldUnitsPerMetre>10000 ||
         !std::isfinite(info->refreshHz) || info->refreshHz<=0 || info->refreshHz>1000 ||
-        !vrmath::centreProjection(info->eyes,info->eyeWidth,info->eyeHeight,info->renderScale,p)) {
+        !vrmath::centreProjection(info->eyes,info->eyeWidth,info->eyeHeight,info->renderScale,p,nearest)) {
       return RTXVR_E_ARGUMENT;
     }
     std::lock_guard lock(m_requestMutex);
     if (m_active) { return RTXVR_E_ALREADY; }
-    m_requested=*info; m_projection=p; ++m_generation;
+    m_requested=*info; m_projection=p;m_nearestDepth=nearest; ++m_generation;
     m_poseTimings.clear(); m_poses.clear(); m_latestPose=0; m_consumedPose=0; m_overlayRequests.clear(); m_captureRequest.clear();
     m_windowSources.clear();m_windowNoMirror=false;
     m_status={}; m_status.structSize=sizeof(m_status); m_status.state=RTXVR_STATE_STARTING;
@@ -120,7 +126,7 @@ namespace dxvk {
     std::lock_guard lock(m_requestMutex);
     if (!m_active) { return RTXVR_E_NOT_RUNNING; }
     vrmath::Projection p;
-    if (!vrmath::centreProjection(eyes,m_requested.eyeWidth,m_requested.eyeHeight,m_requested.renderScale,p)) { return RTXVR_E_ARGUMENT; }
+    if (!vrmath::centreProjection(eyes,m_requested.eyeWidth,m_requested.eyeHeight,m_requested.renderScale,p,m_nearestDepth)) { return RTXVR_E_ARGUMENT; }
     std::copy(eyes,eyes+2,m_requested.eyes); m_projection=p;
     return RTXVR_OK;
   }
@@ -170,7 +176,7 @@ namespace dxvk {
   bool RtxVr::projection(Matrix4& matrix,float& fov,float& aspect) {
     std::lock_guard lock(m_requestMutex);
     if (!m_active || !m_latestPose) { return false; }
-    m_frame=m_requested; m_frameProjection=m_projection;
+    m_frame=m_requested; m_frameProjection=m_projection;m_frameNearestDepth=m_nearestDepth;
     m_cameraFrame=m_device->getCurrentFrameId(); m_cameraGeneration=m_generation;
     matrix[0][0]=float(1/m_frameProjection.tanX); matrix[1][1]=float(1/m_frameProjection.tanY);
     matrix[2][0]=0; matrix[2][1]=0;
@@ -371,7 +377,7 @@ namespace dxvk {
       std::lock_guard lock(m_requestMutex);
       generation=m_generation; requested=m_active;
       if (m_cameraFrame!=m_device->getCurrentFrameId() || m_cameraGeneration!=generation) {
-        m_frame=m_requested; m_frameProjection=m_projection;
+        m_frame=m_requested; m_frameProjection=m_projection;m_frameNearestDepth=m_nearestDepth;
       }
     }
     if (generation!=m_renderGeneration || !requested) {
@@ -628,7 +634,7 @@ namespace dxvk {
     uint32_t maxSteps=0;
     for(const auto& eye:m_frame.eyes) for(double u:{0.,1.}) for(double v:{0.,1.}) {
       const auto start=vrmath::warpAtDepth(m_frameProjection,eye,u,v,
-        vrmath::kNearestEyeDepthMetres*m_frame.worldUnitsPerMetre,m_frame.worldUnitsPerMetre);
+        m_frameNearestDepth*m_frame.worldUnitsPerMetre,m_frame.worldUnitsPerMetre);
       const auto infinity=vrmath::project(m_frameProjection,vrmath::eyeRay(eye,u,v));
       maxSteps=std::max(maxSteps,vrmath::searchSteps(start,infinity,depth->imageInfo().extent.width,
         depth->imageInfo().extent.height,m_warpSearchTaps));
@@ -655,7 +661,7 @@ namespace dxvk {
       args.eyeRow1={m[1][0],m[1][1],m[1][2],m[1][3]*m_frame.worldUnitsPerMetre};
       args.eyeRow2={m[2][0],m[2][1],m[2][2],m[2][3]*m_frame.worldUnitsPerMetre};
       args.centre={float(m_frameProjection.tanX),float(m_frameProjection.tanY),
-        float(vrmath::kNearestEyeDepthMetres*m_frame.worldUnitsPerMetre),float(m_warpSearchTaps)};
+        float(m_frameNearestDepth*m_frame.worldUnitsPerMetre),float(m_warpSearchTaps)};
       ctx.changeImageLayout(m_eyes[i].image,VK_IMAGE_LAYOUT_GENERAL);
       ctx.bindResourceView(0,view,nullptr); ctx.bindResourceView(1,m_depthCoverage.view,nullptr); ctx.bindResourceView(2,m_eyes[i].view,nullptr);
       ctx.bindShader(VK_SHADER_STAGE_COMPUTE_BIT,VrWarpShader::getShader());
diff --git a/src/dxvk/rtx_render/rtx_vr.h b/src/dxvk/rtx_render/rtx_vr.h
