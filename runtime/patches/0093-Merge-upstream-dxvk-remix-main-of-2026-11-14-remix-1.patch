+static inline std::string Canonize(const std::string& path) {
+  std::string canonPath;
+  for (auto it = path.begin(); it != path.end(); ++it) {
+    auto c = *it;
+
+    if (canonPath.empty() && (c == '/' || c == '\\' || c == '.')) {
+      continue;
+    }
+
+    switch (c) {
+    case '[':
+      // Start over
+      canonPath.clear();
+      break;
+    case ']':
+      // Skip it
+      break;
+    case '/':
+      c = '\\';
+    default:
+      canonPath.push_back(c);
+    }
+  }
+
+  return canonPath;
+}
