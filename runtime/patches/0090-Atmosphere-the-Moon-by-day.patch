diff --git a/src/dxvk/rtx_render/rtx_moon_daylight.h b/src/dxvk/rtx_render/rtx_moon_daylight.h
new file mode 100644
index 00000000..d065df24
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_moon_daylight.h
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: MIT
+//
+// The Moon by day (fork — the GMod native loader's ADR 0207). While the sun is up the sky's
+// in-scatter lies in front of a moon and its light is added to it (evalSkyRadiance), so how bright
+// the disc is decides how it shows: a pale disc over the blue, or a white sticker. The disc is drawn
+// by evalTexturedMoon's Lunar-Lambert law (0.75 Lommel-Seeliger + 0.25 Lambert), which keeps a
+// partial Moon far brighter than the real one: at a quarter the drawn Moon gives 37% of its full
+// light, the real one 9% (its rough, shadowed surface and the opposition surge make the full Moon
+// stand out). At night that is lost above the exposure's white point; by day it would make a
+// crescent several times brighter than the blue sky around it. So by day each moon's light is
+// scaled to the real Moon's phase law, and the night keeps the drawn one.
+//
+// Self-contained (no runtime headers), so tests/rtx/unit/test_moon_daylight.cpp and the GMod
+// native loader's gate compile it alone.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace dxvk {
+namespace moondaylight {
+  constexpr double kPi = 3.14159265358979323846;
+
+  // The phase angle in radians (0 at full, pi at new) of a moon at `phase` (0 new, 0.25 first
+  // quarter, 0.5 full), as evalTexturedMoon takes it.
+  inline double phaseAngle(double phase) {
+    const double turn = phase - std::floor(phase);
+    return std::abs(kPi - 2.0 * kPi * turn);
+  }
+
+  // The real Moon's light at phase angle `a` as a fraction of the full Moon's: its V magnitude grows
+  // by 0.026 |a| + 4e-9 a^4 with a in degrees (Allen's Astrophysical Quantities; Krisciunas and
+  // Schaefer 1991). Fitted to about 150 degrees.
+  inline double realMoonLight(double a) {
+    const double degrees = std::abs(a) * 180.0 / kPi;
+    const double d2 = degrees * degrees;
+    return std::pow(10.0, -0.4 * (0.026 * degrees + 4.0e-9 * d2 * d2));
+  }
+
+  // The drawn Moon's light at phase angle `a` as a fraction of its full light: evalTexturedMoon's
+  // Lunar-Lambert term over the disc. Lommel-Seeliger integrates to the classic
+  // 1 - sin(a/2) tan(a/2) ln(cot(a/4)), Lambert to (sin a + (pi - a) cos a) / pi; at full the first
+  // averages 1 over the disc, the second 2/3.
+  inline double drawnMoonLight(double a) {
+    a = std::clamp(std::abs(a), 0.0, kPi);
+    if (a >= kPi - 1e-6) {
+      return 0.0;  // new: nothing lit faces the viewer
+    }
+    double lommelSeeliger = 1.0;
+    if (a > 1e-6) {
+      lommelSeeliger = 1.0 - std::sin(0.5 * a) * std::tan(0.5 * a) * std::log(1.0 / std::tan(0.25 * a));
+    }
+    const double lambert = (std::sin(a) + (kPi - a) * std::cos(a)) / kPi;
+    const double atFull = 0.75 + 0.25 * (2.0 / 3.0);
+    return std::max(0.75 * lommelSeeliger + 0.25 * (2.0 / 3.0) * lambert, 0.0) / atFull;
+  }
+
+  // Where the real law's fit ends. The ratio below is smallest about here (0.107); nearer new the
+  // drawn sliver vanishes faster than the fitted law, and the ratio would climb back, so it holds.
+  constexpr double kLawLimit = 150.0 * kPi / 180.0;
+
+  // The scale on a moon's light while the sun is up, so it is as bright as the real Moon at its
+  // phase: 1 at full, 0.40 gibbous (0.35 or 0.65), 0.25 at a quarter, 0.15 for a crescent (0.15 or
+  // 0.85), 0.107 within a twelfth of a turn of new. Never above 1: the day's Moon is never brighter
+  // than the night's.
+  inline float daytimeLightScale(float phase) {
+    const double a = std::min(phaseAngle(phase), kLawLimit);
+    const double drawn = drawnMoonLight(a);
+    if (!(drawn > 0.0)) {
+      return 1.0f;
+    }
+    return float(std::clamp(realMoonLight(a) / drawn, 0.0, 1.0));
+  }
+} // namespace moondaylight
+} // namespace dxvk
