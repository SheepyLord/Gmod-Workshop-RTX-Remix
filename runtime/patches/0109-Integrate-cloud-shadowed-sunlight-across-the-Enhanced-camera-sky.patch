+#pragma once
+
+#include "rtx/utility/shader_types.h"
+
+#define NUMOS_RAYS_FRAME      0
+#define NUMOS_RAYS_SKY        1
+#define NUMOS_RAYS_CONTROLS   2
+#define NUMOS_RAYS_DEPTH      3
+#define NUMOS_RAYS_SUN_LUT    4
+#define NUMOS_RAYS_SHADOW     5
+#define NUMOS_RAYS_SAMPLER    6
+#define NUMOS_RAYS_PREVIOUS   7
+#define NUMOS_RAYS_OUTPUT     8
+
+struct NumosRayArgs {
+  uint divisor;
+  uint steps;
+  uint frame;
+  uint debugView;
+  float rangeKm;
+  float historyWeight;
+  float strength;
+  uint nearHaze;
+  uint historyValid;
+  uint active;
+  uint width;
+  uint height;
+};
diff --git a/src/dxvk/shaders/rtx/pass/numos/numos_sun_rays.comp.slang b/src/dxvk/shaders/rtx/pass/numos/numos_sun_rays.comp.slang
