diff --git a/src/dxvk/shaders/rtx/pass/numos/numos_ground.slangh b/src/dxvk/shaders/rtx/pass/numos/numos_ground.slangh
new file mode 100644
index 000000000..acfa787a6
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/numos/numos_ground.slangh
@@ -0,0 +1,106 @@
+// Copyright 2026 Kim2091 (Sparkles)
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+// The NUMOS ground and cloud datums are camera-relative Y-up kilometres. Keep
+// the small altitude out of the subtraction of two nearly equal planet radii.
+struct NumosGroundHit {
+  float coverage;
+  float km;
+  float3 ground;
+  float3 skyDir;
+};
+
+NumosGroundHit numosGroundHit(float3 origin, float3 dir, float altitude, float radius, float pixelAngle) {
+  const float3 radial = origin + float3(0.f, radius + altitude, 0.f);
+  const float3 up = normalize(radial);
+  const float h = max(0.f, altitude + origin.y + dot(origin.xz, origin.xz) / max(length(radial) + radial.y, 1.f));
+  const float c = h * (2.f * radius + h);
+  const float limb = -sqrt(c) / (radius + h);
+  const float mu = dot(up, dir);
+  const float width = max(1e-6f, pixelAngle * sqrt(saturate(1.f - limb * limb)));
+  NumosGroundHit hit;
+  hit.coverage = saturate(.5f + (limb - mu) / width);
+  hit.skyDir = dir;
+  float3 groundDir = dir;
+  if (hit.coverage > 0.f && hit.coverage < 1.f) {
+    const float3 horizontal = normalize(dir - mu * up);
+    const float skyMu = limb + .5f * width * (1.f - hit.coverage);
+    const float groundMu = limb - .5f * width * hit.coverage;
+    hit.skyDir = horizontal * sqrt(saturate(1.f - skyMu * skyMu)) + up * skyMu;
+    groundDir = horizontal * sqrt(saturate(1.f - groundMu * groundMu)) + up * groundMu;
+  }
+  const float b = -(radius + h) * min(dot(groundDir, up), limb);
+  hit.km = c / max(b + sqrt(max(0.f, b*b - c)), 1e-12f);
+  hit.ground = origin + groundDir * hit.km;
+  return hit;
+}
+
+NumosGroundHit numosSkyGround(float3 origin, float3 dir, enhanced_AtmosphereArgs args) {
+  return numosGroundHit(origin, dir, max(args.cameraAltitudeKm, 0.f), args.planetRadius, args.skyPixelAngle);
+}
+
+// Pinned evalSkyGroundRadiance's Lambertian surface, before view extinction.
+// Ground shadow coordinates use the cloud datum, which can differ from the sky's.
+float3 numosBareGround(float3 origin, float3 dir, NumosGroundHit hit, enhanced_AtmosphereArgs args) {
+  const float3 groundPos = hit.ground;
+  const float3 groundUp = normalize(groundPos + float3(0.f, args.planetRadius + max(args.cameraAltitudeKm, 0.f), 0.f));
+  float keyLightCloudT = 1.f;
+  if (args.cloudEnabled > .5f && args.cloudCoverageMean >= .01f && args.cloudShadowLive != 0u) {
+    const NumosGroundHit cloudHit = numosGroundHit(origin, dir, max(args.cameraWorldPosYUpKm.y, 0.f),
+                                                  args.planetRadius, args.skyPixelAngle);
+    if (cloudHit.coverage > 0.f) {
+      const float opticalDepth = enhanced_cloudShadowMapSunOpticalDepth(enhanced_AtmosphereCloudShadowMap,
+        enhanced_AtmosphereCloudNoise3DSampler, args.cameraWorldPosYUpKm + cloudHit.ground,
+        enhanced_getCloudPlanetCenterWorldKm(args), args);
+      keyLightCloudT = lerp(1.f, exp(-opticalDepth * args.cloudDensity), args.cloudShadowStrength);
+    }
+  }
+
+  // Sun on the ground.
+  const vec3 sunDirYUp = normalize(args.sunDirection);
+  const float cosSun = dot(sunDirYUp, groundUp);
+  vec3 sunIrradiance = vec3(0.0f);
+  if (cosSun > 0.0f) {
+    sunIrradiance = args.sunIlluminance * cosSun
+                  * enhanced_evalSunShadowingClampedToSurface(groundPos, sunDirYUp, enhanced_AtmosphereTransmittanceLut,
+                                                     enhanced_AtmosphereSkyViewSampler, args);
+    if (args.cloudKeyLight == 0u) {
+      sunIrradiance *= keyLightCloudT;
+    }
+  }
+  // Moonlight on the ground, through the same air.
+  [unroll] for (uint mi = 0u; mi < enhanced_MAX_MOONS; ++mi) {
+    if (((args.moonSkyLightMask >> mi) & 1u) == 0u) {
+      continue;
+    }
+    const vec3 moonDirYUp = normalize(args.moons[mi].direction);
+    const float cosMoon = dot(moonDirYUp, groundUp);
+    if (cosMoon > 0.0f) {
+      sunIrradiance += args.moons[mi].illuminance * cosMoon
+                     * enhanced_evalSunShadowingClampedToSurface(groundPos, moonDirYUp, enhanced_AtmosphereTransmittanceLut,
+                                                        enhanced_AtmosphereSkyViewSampler, args)
+                     * (args.cloudKeyLight == mi + 1u ? keyLightCloudT : 1.0f);
+    }
+  }
+
+  // Sky on the ground: irradiance / pi of the upper hemisphere (relative to the local up).
+  const float kMu0 = 0.2113249f, kMu1 = 0.7886751f;
+  const vec3 tangent = normalize(cross(groundUp, abs(groundUp.y) < 0.99f ? vec3(0.0f, 1.0f, 0.0f) : vec3(1.0f, 0.0f, 0.0f)));
+  const vec3 bitangent = cross(groundUp, tangent);
+  vec3 skyIrradianceOverPi = vec3(0.0f);
+  [unroll]
+  for (int i = 0; i < 4; ++i) {
+    const float phi = (float(i) + 0.5f) * (0.5f * enhanced_kPi);
+    const vec3 h = tangent * cos(phi) + bitangent * sin(phi);
+    const vec3 d0 = normalize(h * sqrt(1.0f - kMu0 * kMu0) + groundUp * kMu0);
+    const vec3 d1 = normalize(h * sqrt(1.0f - kMu1 * kMu1) + groundUp * kMu1);
+    skyIrradianceOverPi += kMu0 * enhanced_sampleSkyAmbientForVolume(d0, args, enhanced_AtmosphereSkyViewLut,
+                                                            enhanced_AtmosphereCloudSkyTransmittanceLut, enhanced_AtmosphereSkyViewSampler)
+                         + kMu1 * enhanced_sampleSkyAmbientForVolume(d1, args, enhanced_AtmosphereSkyViewLut,
+                                                            enhanced_AtmosphereCloudSkyTransmittanceLut, enhanced_AtmosphereSkyViewSampler);
+  }
+  skyIrradianceOverPi *= 0.25f;
+
+  return args.groundAlbedo * (sunIrradiance * (1.0f / enhanced_kPi) + skyIrradianceOverPi);
+}
