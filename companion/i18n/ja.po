#: nativeloader/lua/nativeloader/menu/loading_status.lua:22
#, c-format
msgid "%s file lookups answered from memory"
msgstr "%s 件のファイル検索をメモリから応答"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:24
