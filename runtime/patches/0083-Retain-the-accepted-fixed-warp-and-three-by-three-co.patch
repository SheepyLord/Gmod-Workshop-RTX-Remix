diff --git a/src/dxvk/shaders/rtx/pass/vr/vr_warp_fixed.comp.slang b/src/dxvk/shaders/rtx/pass/vr/vr_warp_fixed.comp.slang
index 9c9b3671..de3517c3 100644
--- a/src/dxvk/shaders/rtx/pass/vr/vr_warp_fixed.comp.slang
+++ b/src/dxvk/shaders/rtx/pass/vr/vr_warp_fixed.comp.slang
@@ -1,3 +1,83 @@
 // SPDX-License-Identifier: MIT
-#define VR_FIXED_WARP 1
-#include "rtx/pass/vr/vr_warp.comp.slang"
+#include "rtx/pass/vr/vr_warp_fixed.h"
+[[vk::binding(0)]] Texture2D<float4> Centre;
+[[vk::binding(1)]] Texture2D<float> Depth;
+[[vk::binding(2)]] RWTexture2D<float4> Eye;
+layout(push_constant) ConstantBuffer<VrWarpFixedArgs> cb;
+float2 project(float3 p) {
+  return float2(0.5 + p.x/(-p.z)/(2*cb.centre.x), 0.5 - p.y/(-p.z)/(2*cb.centre.y));
+}
+float readDepth(float2 uv) {
+  uint w,h; Depth.GetDimensions(w,h);
+  int2 p=clamp(int2(uv*float2(w,h)),int2(0),int2(w-1,h-1));
+  const float z=abs(Depth.Load(int3(p,0)));
+  return isfinite(z) && z>0 ? z : 1e20;
+}
+float4 colour(float2 uv) {
+  uint w,h; Centre.GetDimensions(w,h);
+  float2 pos=uv*float2(w,h)-0.5;
+  int2 base=int2(floor(pos)); float2 f=frac(pos);
+  int2 hi=int2(w-1,h-1);
+  return lerp(lerp(Centre.Load(int3(clamp(base,int2(0),hi),0)), Centre.Load(int3(clamp(base+int2(1,0),int2(0),hi),0)), f.x),
+              lerp(Centre.Load(int3(clamp(base+int2(0,1),int2(0),hi),0)), Centre.Load(int3(clamp(base+int2(1,1),int2(0),hi),0)), f.x), f.y);
+}
+float2 atDepth(float3 origin,float3 ray,float depth) {
+  const float t=(depth+origin.z)/(-ray.z);
+  return project(float3(origin.xy+ray.xy*t,-depth));
+}
+float2 nearestSample(float3 origin,float3 ray) {
+  const float2 infinity=project(ray);
+  const float2 start=atDepth(origin,ray,cb.centre.z);
+  uint depthWidth,depthHeight;Depth.GetDimensions(depthWidth,depthHeight);
+  const float span=max(abs(start.x-infinity.x)*depthWidth,abs(start.y-infinity.y)*depthHeight);
+  const uint taps=cb.centre.w>0 ? clamp(uint(cb.centre.w),1u,128u) : clamp(uint(ceil(span))+1,1u,128u);
+  float previousDepth=readDepth(start);
+  for(uint i=0;i<=taps;++i) {
+    float s=1-float(i)/float(taps);
+    float2 uv=lerp(infinity,start,s);
+    const float rayDepth=s>0 ? cb.centre.z/s : 1e20;
+    const float depth=readDepth(uv);
+    // Carry a surface across the interval containing its edge, rather than stepping past it.
+    float best=1e30;
+    float2 closest=uv;
+    for(uint candidateIndex=0;candidateIndex<2;++candidateIndex) {
+      if(candidateIndex==1&&depth==previousDepth) { break; }
+      const float candidate=candidateIndex==0?min(depth,previousDepth):max(depth,previousDepth);
+      if(candidate>rayDepth) { continue; }
+      float2 hit=atDepth(origin,ray,candidate);
+      for(uint j=0;j<8;++j) {
+        const float2 next=atDepth(origin,ray,readDepth(hit));
+        if(length(next-hit)<1e-6) {
+          const float resolved=readDepth(next);
+          if(resolved<=rayDepth*(1+1e-6)&&resolved<best) { best=resolved;closest=next; }
+          break;
+        }
+        hit=next;
+      }
+    }
+    if(best<1e30) { return closest; }
+    previousDepth=depth;
+  }
+  float2 uv=infinity;
+  float2 farUv=uv;
+  float farDepth=0;
+  for(uint step=0;step<8;++step) {
+    const float depth=readDepth(uv);
+    const float2 next=atDepth(origin,ray,depth);
+    if(depth>farDepth) { farDepth=depth;farUv=uv; }
+    if(length(next-uv)<1e-6) { return next; }
+    uv=next;
+  }
+  return farUv;
+}
+[shader("compute")]
+[numthreads(16,16,1)]
+void main(uint2 id:SV_DispatchThreadID) {
+  uint w,h; Eye.GetDimensions(w,h);
+  if (any(id>=uint2(w,h))) { return; }
+  const float2 uvEye=(float2(id)+0.5)/float2(w,h);
+  const float3 eyeRay=float3(lerp(cb.tangents.x,cb.tangents.y,uvEye.x),-lerp(cb.tangents.z,cb.tangents.w,uvEye.y),-1);
+  const float3 ray=float3(dot(cb.eyeRow0.xyz,eyeRay),dot(cb.eyeRow1.xyz,eyeRay),dot(cb.eyeRow2.xyz,eyeRay));
+  const float3 origin=float3(cb.eyeRow0.w,cb.eyeRow1.w,cb.eyeRow2.w);
+  Eye[id]=colour(saturate(nearestSample(origin,ray)));
+}
