@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+namespace dxvk::vreye {
+  // VR true stereo traces each eye with its own view state. The eye a thread is tracing selects that state:
+  // -1 is the centre (flat rendering, the warp, and the frame's once-per-frame work), 0 the left eye, which
+  // keeps the default view state, and 1 the right eye. Only the render thread sets it.
+  inline thread_local int g_active = -1;
+
+  inline int active() { return g_active; }
+
+  class Scope {
+  public:
+    explicit Scope(int eye) : m_previous(g_active) { g_active = eye; }
+    ~Scope() { g_active = m_previous; }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+  private:
+    int m_previous;
+  };
+}
