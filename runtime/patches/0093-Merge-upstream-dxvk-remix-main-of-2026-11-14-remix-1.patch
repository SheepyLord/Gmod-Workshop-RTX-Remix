+const AssetDesc*
+GetAssetDesc(
+    PackageHandle handle,
+    uint32_t assetIdx)
+{
+    return castFromApi<dxvk::AssetPackage>(handle).
+        getAssetDesc(assetIdx);
+}
+
+USDG_API
+const BlobDesc*
+GetDataBlobDesc(
+    PackageHandle handle,
+    uint32_t blobIdx)
+{
+    return castFromApi<dxvk::AssetPackage>(handle).
+        getDataBlobDesc(blobIdx);
+}
