diff --git a/src/dxvk/rtx_render/rtx_poster_math.h b/src/dxvk/rtx_render/rtx_poster_math.h
new file mode 100644
index 000000000..667a4b5b1
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_poster_math.h
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: MIT
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// The poster (ADR 0226 of the GMod native loader project): a picture several times the window's size, path traced
+// as tiles of the window's own size, so no upscaler, denoiser or render target ever changes size. Each tile is the
+// game's view narrowed to a window of it, neighbouring tiles overlap and are blended over the overlap.
+// Everything here is plain arithmetic, testable without a device (tests/rtx/unit/test_poster_math.cpp).
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <new>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace dxvk::poster {
+  constexpr uint32_t kMaxMultiplier = 16;
+  // 16384 x 16384: the composed picture is held as 8-bit BGR (at most 768 MiB) while it is written, and the sky
+  // matte's viewport, stretched to the whole poster for a tile, stays within the 16384 every GPU allows.
+  constexpr uint64_t kMaxPixels = 16384ull * 16384ull;
+  constexpr uint32_t kMaxSide = 16384;
+  constexpr uint32_t kMinWindowSide = 64;
+
+  struct Layout {
+    uint32_t tileWidth = 0, tileHeight = 0;  // the window: every tile is rendered at its size
+    uint32_t width = 0, height = 0;          // the poster: the multiplier times the window
+    uint32_t columns = 0, rows = 0;          // tiles across and down
+    uint32_t overlap = 0;                    // the least overlap of neighbouring tiles, in pixels
+    uint32_t tiles() const { return columns * rows; }
+  };
+
+  // The overlap a poster's tiles get: a sixteenth of the window's short side, from 16 to 256 pixels. Enough for the
+  // upscaler's and the denoiser's edge pixels and most of the bloom; well under half a tile.
+  inline uint32_t defaultOverlap(uint32_t windowWidth, uint32_t windowHeight) {
+    return std::clamp(std::min(windowWidth, windowHeight) / 16u, 16u, 256u);
+  }
+
+  // How many tiles of `tile` pixels cover `total` with at least `overlap` pixels shared by neighbours.
+  inline uint32_t tileCount(uint32_t total, uint32_t tile, uint32_t overlap) {
+    if (tile == 0) { return 0; }
+    if (total <= tile) { return 1; }
+    const uint32_t stride = tile - std::min(overlap, tile - 1);
+    return 1 + (total - tile + stride - 1) / stride;
+  }
+
+  // The first pixel of tile `index` of `count`: the tiles spread evenly from 0 to total - tile, so the last one ends
+  // on the poster's edge and no neighbours share fewer pixels than the overlap tileCount was given.
+  inline uint32_t tileOrigin(uint32_t index, uint32_t count, uint32_t total, uint32_t tile) {
+    if (count <= 1 || total <= tile) { return 0; }
+    const uint64_t span = uint64_t(total) - tile;
+    return uint32_t((span * index + (count - 1) / 2) / (count - 1));
+  }
+
+  inline bool makeLayout(uint32_t windowWidth, uint32_t windowHeight, uint32_t multiplier, uint32_t overlap,
+                         Layout& out, std::string& why) {
+    out = {};
+    if (multiplier < 1 || multiplier > kMaxMultiplier) {
+      why = "the multiplier must be 1 to " + std::to_string(kMaxMultiplier);
+      return false;
+    }
+    if (windowWidth < kMinWindowSide || windowHeight < kMinWindowSide) {
+      why = "the window is too small";
+      return false;
+    }
+    const uint64_t width = uint64_t(windowWidth) * multiplier, height = uint64_t(windowHeight) * multiplier;
+    if (width > kMaxSide || height > kMaxSide || width * height > kMaxPixels) {
+      why = "a poster of " + std::to_string(width) + " x " + std::to_string(height) + " is larger than 16384 x 16384";
+      return false;
+    }
+    out.tileWidth = windowWidth;
+    out.tileHeight = windowHeight;
+    out.width = uint32_t(width);
+    out.height = uint32_t(height);
+    out.overlap = multiplier == 1 ? 0 : std::min(overlap, std::min(windowWidth, windowHeight) / 4);
+    out.columns = tileCount(out.width, out.tileWidth, out.overlap);
+    out.rows = tileCount(out.height, out.tileHeight, out.overlap);
+    return true;
+  }
+
+  struct Origin { uint32_t x = 0, y = 0; };
+
+  // Tiles go in reading order: left to right, then the next row down.
+  inline Origin tileOrigin(const Layout& layout, uint32_t index) {
+    const uint32_t column = index % layout.columns, row = index / layout.columns;
+    return { tileOrigin(column, layout.columns, layout.width, layout.tileWidth),
+             tileOrigin(row, layout.rows, layout.height, layout.tileHeight) };
+  }
+
+  // A tile's window into the poster's normalized device coordinates: x to the right and y up, each -1 to 1, the
+  // poster's top row of pixels at y = 1.
+  struct Window { double x0 = -1, x1 = 1, y0 = -1, y1 = 1; };
+
+  inline Window tileWindow(const Layout& layout, uint32_t index) {
+    const Origin origin = tileOrigin(layout, index);
+    Window window;
+    window.x0 = -1.0 + 2.0 * origin.x / layout.width;
+    window.x1 = -1.0 + 2.0 * (double(origin.x) + layout.tileWidth) / layout.width;
+    window.y1 = 1.0 - 2.0 * origin.y / layout.height;
+    window.y0 = 1.0 - 2.0 * (double(origin.y) + layout.tileHeight) / layout.height;
+    return window;
+  }
+
+  // Narrows a projection matrix to a window: what the matrix put at the window's centre lands at the tile's, and
+  // the window's edges on the tile's. Column-major (m[column][row], clip = m * view), as the runtime's matrices are;
+  // only the clip x and y rows change, so depth, w and anything compared on them (the view model's planes) stay.
+  template<typename Matrix>
+  inline void narrowProjection(Matrix& m, const Window& window) {
+    using T = std::decay_t<decltype(m[0][0])>;
+    const double sx = 2.0 / (window.x1 - window.x0), sy = 2.0 / (window.y1 - window.y0);
+    const double cx = (window.x0 + window.x1) / 2, cy = (window.y0 + window.y1) / 2;
+    for (int column = 0; column < 4; ++column) {
+      const double w = double(m[column][3]);
+      m[column][0] = T(sx * (double(m[column][0]) - cx * w));
+      m[column][1] = T(sy * (double(m[column][1]) - cy * w));
+    }
+  }
+
+  // The direction basis of a screen-aligned pass for a window of the view: a pixel at the tile's ndc (x, y) looks
+  // along forward + right * x + up * y. The inputs are the camera's unit vectors and the whole view's tangents of
+  // its half angles; the forward component along the optical axis stays one, as those passes' slices need.
+  struct Basis { double forward[3], right[3], up[3]; };
+
+  inline Basis windowBasis(const double forward[3], const double right[3], const double up[3],
+                           double tanHalfX, double tanHalfY, const Window& window) {
+    const double cx = (window.x0 + window.x1) / 2 * tanHalfX, cy = (window.y0 + window.y1) / 2 * tanHalfY;
+    const double hx = (window.x1 - window.x0) / 2 * tanHalfX, hy = (window.y1 - window.y0) / 2 * tanHalfY;
+    Basis basis {};
+    for (int i = 0; i < 3; ++i) {
+      basis.forward[i] = forward[i] + right[i] * cx + up[i] * cy;
+      basis.right[i] = right[i] * hx;
+      basis.up[i] = up[i] * hy;
+    }
+    return basis;
+  }
+
+  // How many poster pixels one window pixel spans across and down: what a pixel's angle is divided by for texture
+  // and sky detail, so the poster gets the detail of its own size.
+  inline double pixelScale(const Layout& layout) {
+    return layout.tileHeight ? double(layout.height) / layout.tileHeight : 1.0;
+  }
+
+  // Composes the tiles into the poster, given in reading order. A row of tiles is first joined across, each tile
+  // fading in over its overlap with the one on its left; the row then fades in over its overlap with the row above.
+  // Every pixel of an overlap is therefore a bilinear mix of the tiles that cover it, and a pixel only one tile
+  // covers is that tile's. The poster is 8-bit BGR, rows top-down, as Windows' PNG encoder takes it.
+  class Composer {
+  public:
+    bool begin(const Layout& layout, std::string& why) {
+      m_layout = layout;
+      m_next = 0;
+      try {
+        m_poster.assign(size_t(layout.width) * layout.height * 3, 0);
+        m_strip.assign(size_t(layout.width) * layout.tileHeight * 3, 0);
+      } catch (const std::bad_alloc&) {
+        m_poster.clear(); m_poster.shrink_to_fit();
+        m_strip.clear(); m_strip.shrink_to_fit();
+        why = "not enough memory for a poster of " + std::to_string(layout.width) + " x " + std::to_string(layout.height);
+        return false;
+      }
+      return true;
+    }
+
+    // The next tile, RGBA8 rows top-down `rowPitch` bytes apart. False when it is not the tile expected next.
+    bool addTile(uint32_t index, const uint8_t* rgba, size_t rowPitch) {
+      if (index != m_next || index >= m_layout.tiles() || m_poster.empty()) { return false; }
+      const uint32_t columns = m_layout.columns, column = index % columns, row = index / columns;
+      const uint32_t w = m_layout.tileWidth, h = m_layout.tileHeight, width = m_layout.width;
+      const Origin origin = tileOrigin(m_layout, index);
+      // Across: the overlap with the tile on the left, in this tile's pixels.
+      const uint32_t fade = column == 0 ? 0
+        : tileOrigin(column - 1, columns, width, w) + w - origin.x;
+      for (uint32_t y = 0; y < h; ++y) {
+        const uint8_t* source = rgba + size_t(y) * rowPitch;
+        uint8_t* target = m_strip.data() + (size_t(y) * width + origin.x) * 3;
+        for (uint32_t x = 0; x < w; ++x, source += 4, target += 3) {
+          if (x < fade) {
+            const uint32_t a = weight(x, fade);
+            target[0] = mix(target[0], source[2], a);
+            target[1] = mix(target[1], source[1], a);
+            target[2] = mix(target[2], source[0], a);
+          } else {
+            target[0] = source[2]; target[1] = source[1]; target[2] = source[0];
+          }
+        }
+      }
+      if (column + 1 == columns) { addStrip(row, origin.y); }
+      ++m_next;
+      return true;
+    }
+
+    bool complete() const { return !m_poster.empty() && m_next == m_layout.tiles(); }
+    uint32_t nextTile() const { return m_next; }
+    const Layout& layout() const { return m_layout; }
+    const uint8_t* pixels() const { return m_poster.data(); }
+    void release() {
+      m_poster.clear(); m_poster.shrink_to_fit();
+      m_strip.clear(); m_strip.shrink_to_fit();
+      m_next = 0;
+    }
+
+    // The weight, out of 256, of pixel i of an overlap n pixels wide: from just over 0 to just under 256 across it.
+    static uint32_t weight(uint32_t i, uint32_t n) { return uint32_t((uint64_t(2 * i + 1) * 256) / (2ull * n)); }
+    static uint8_t mix(uint8_t from, uint8_t to, uint32_t a) {
+      return uint8_t((uint32_t(from) * (256 - a) + uint32_t(to) * a + 128) >> 8);
+    }
+
+  private:
+    void addStrip(uint32_t row, uint32_t top) {
+      const uint32_t h = m_layout.tileHeight, width = m_layout.width;
+      const uint32_t fade = row == 0 ? 0
+        : tileOrigin(row - 1, m_layout.rows, m_layout.height, h) + h - top;
+      const size_t rowBytes = size_t(width) * 3;
+      for (uint32_t y = 0; y < h; ++y) {
+        const uint8_t* source = m_strip.data() + size_t(y) * rowBytes;
+        uint8_t* target = m_poster.data() + size_t(top + y) * rowBytes;
+        if (y < fade) {
+          const uint32_t a = weight(y, fade);
+          for (size_t i = 0; i < rowBytes; ++i) { target[i] = mix(target[i], source[i], a); }
+        } else {
+          std::memcpy(target, source, rowBytes);
+        }
+      }
+    }
+
+    Layout m_layout {};
+    uint32_t m_next = 0;
+    std::vector<uint8_t> m_poster, m_strip;
+  };
+}
diff --git a/src/dxvk/rtx_render/rtx_poster_png.cpp b/src/dxvk/rtx_render/rtx_poster_png.cpp
new file mode 100644
index 000000000..2f06142fd
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_poster_png.cpp
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: MIT
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// The poster's PNG writer (ADR 0226 of the GMod native loader project): Windows Imaging Component's PNG encoder.
+// COM and WIC are reached through ole32.dll at run time, so d3d9.dll links nothing new; the GUIDs are spelled out
+// here for the same reason.
+#include "rtx_poster_png.h"
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <wincodec.h>
+#include <algorithm>
+#include <cstdio>
+
+namespace dxvk::poster {
+  namespace {
+    // CLSID_WICImagingFactory1, GUID_ContainerFormatPng and GUID_WICPixelFormat24bppBGR (wincodec.h).
+    const GUID kImagingFactory = { 0xcacaf262, 0x9370, 0x4615, { 0xa1, 0x3b, 0x9f, 0x55, 0x39, 0xda, 0x4c, 0x0a } };
+    const GUID kPngContainer = { 0x1b7cfaf4, 0x713f, 0x473c, { 0xbb, 0xcd, 0x61, 0x37, 0x42, 0x5f, 0xae, 0xaf } };
+    const GUID kBgr24 = { 0x6fddc324, 0x4e03, 0x4bfe, { 0xb1, 0x85, 0x3d, 0x77, 0x76, 0x8d, 0xc9, 0x0c } };
+
+    template<typename T> struct Released {
+      T* p = nullptr;
+      ~Released() { if (p) { p->Release(); } }
+      T** operator&() { return &p; }
+      T* operator->() const { return p; }
+    };
+
+    std::string failed(const char* what, HRESULT result) {
+      char text[96];
+      std::snprintf(text, sizeof(text), "%s failed (0x%08lX)", what, static_cast<unsigned long>(result));
+      return text;
+    }
+  }
+
+  bool writePng(const std::wstring& path, uint32_t width, uint32_t height, const uint8_t* pixels, size_t stride,
+                std::string& why) {
+    using CoInitializeExFn = HRESULT(WINAPI*)(LPVOID, DWORD);
+    using CoUninitializeFn = void(WINAPI*)();
+    using CoCreateInstanceFn = HRESULT(WINAPI*)(REFCLSID, LPUNKNOWN, DWORD, REFIID, LPVOID*);
+    HMODULE ole = LoadLibraryW(L"ole32.dll");
+    if (!ole) { why = "ole32.dll could not be loaded"; return false; }
+    const auto coInitialize = reinterpret_cast<CoInitializeExFn>(GetProcAddress(ole, "CoInitializeEx"));
+    const auto coUninitialize = reinterpret_cast<CoUninitializeFn>(GetProcAddress(ole, "CoUninitialize"));
+    const auto coCreate = reinterpret_cast<CoCreateInstanceFn>(GetProcAddress(ole, "CoCreateInstance"));
+    if (!coInitialize || !coUninitialize || !coCreate) { FreeLibrary(ole); why = "COM is not available"; return false; }
+    // This thread is the poster's own; another apartment already set on it (RPC_E_CHANGED_MODE) still serves WIC.
+    const HRESULT apartment = coInitialize(nullptr, COINIT_MULTITHREADED);
+    bool written = false;
+    {
+      Released<IWICImagingFactory> factory;
+      Released<IWICStream> stream;
+      Released<IWICBitmapEncoder> encoder;
+      Released<IWICBitmapFrameEncode> frame;
+      Released<IPropertyBag2> options;
+      HRESULT result = coCreate(kImagingFactory, nullptr, CLSCTX_INPROC_SERVER, __uuidof(IWICImagingFactory),
+                                reinterpret_cast<void**>(&factory));
+      if (FAILED(result)) { why = failed("creating the imaging factory", result); }
+      else if (FAILED(result = factory->CreateStream(&stream))) { why = failed("creating a stream", result); }
+      else if (FAILED(result = stream->InitializeFromFilename(path.c_str(), GENERIC_WRITE))) {
+        why = failed("opening the file", result);
+      }
+      else if (FAILED(result = factory->CreateEncoder(kPngContainer, nullptr, &encoder))) { why = failed("creating the PNG encoder", result); }
+      else if (FAILED(result = encoder->Initialize(stream.p, WICBitmapEncoderNoCache))) { why = failed("starting the PNG", result); }
+      else if (FAILED(result = encoder->CreateNewFrame(&frame, &options))) { why = failed("adding the picture", result); }
+      else if (FAILED(result = frame->Initialize(options.p))) { why = failed("setting up the picture", result); }
+      else if (FAILED(result = frame->SetSize(width, height))) { why = failed("setting the size", result); }
+      else {
+        WICPixelFormatGUID format = kBgr24;
+        result = frame->SetPixelFormat(&format);
+        if (FAILED(result) || format != kBgr24) {
+          why = FAILED(result) ? failed("setting the pixel format", result) : "the PNG encoder does not take 24-bit BGR";
+        } else {
+          // At most 64 MiB a call, whole rows.
+          const uint32_t block = uint32_t(std::max<size_t>(1, (size_t(64) << 20) / std::max<size_t>(stride, 1)));
+          bool rows = true;
+          for (uint32_t y = 0; y < height && rows; y += block) {
+            const uint32_t count = std::min(block, height - y);
+            result = frame->WritePixels(count, UINT(stride), UINT(stride * count),
+                                        const_cast<BYTE*>(pixels + size_t(y) * stride));
+            if (FAILED(result)) { why = failed("writing rows", result); rows = false; }
+          }
+          if (rows) {
+            if (FAILED(result = frame->Commit())) { why = failed("finishing the picture", result); }
+            else if (FAILED(result = encoder->Commit())) { why = failed("finishing the PNG", result); }
+            else if (FAILED(result = stream->Commit(STGC_DEFAULT))) { why = failed("writing the file", result); }
+            else { written = true; }
+          }
+        }
+      }
+    }
+    if (SUCCEEDED(apartment)) { coUninitialize(); }
+    FreeLibrary(ole);
+    return written;
+  }
+}
