+// SPDX-License-Identifier: MIT
+// Run the production masked workgroup's early return without allocating a whole weather simulation.
+struct TestAtmosphere {
+  float cloudEnabled, cloudCoverageMean, cloudLayer2CoverageMean;
+  uint cloudLayer2Enable, cloudViewSamples, cloudScreenInterleave, cloudRenderFrameIdx;
+};
+typedef TestAtmosphere AtmosphereArgs;
+ConstantBuffer<AtmosphereArgs> atmosphereArgs;
+RWTexture2D<float4> cloudRenderOutput;
+RWTexture2D<float4> cloudDepthOutput;
+RWTexture2D<float4> cloudStateOutput;
+RWTexture2D<float4> cloudFreshColor;
+RWTexture2D<float4> cloudFreshDepth;
+RWTexture2D<float2> cloudFreshAux;
+RWTexture2D<uint> cloudFallbackTiles;
+static const uint kCloudRebuildBlock = 2;
+static const uint kCloudFallbackTilePixels = 16;
+static const float kNoSurfaceKm = 1000000;
+// The test runner reflects its own resource slots. The runtime build verifies the pinned binary layout.
+#ifndef CLOUD_SCREEN_MARCH_ONLY
+#define CLOUD_SCREEN_MARCH_ONLY 0
+#endif
+#ifndef CLOUD_SCREEN_REBUILD
+#define CLOUD_SCREEN_REBUILD 0
+#endif
+#ifndef CLOUD_SCREEN_FALLBACK
+#define CLOUD_SCREEN_FALLBACK 0
+#endif
+#define layout(x)
+#include "numos_lower/lower_cloud.slangh"
+#undef layout
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void main(uint3 group : SV_GroupID, uint3 lane : SV_GroupThreadID, uint3 id : SV_DispatchThreadID)
+{
+  skipLowerCloudGroup(group, lane, id);
+}
