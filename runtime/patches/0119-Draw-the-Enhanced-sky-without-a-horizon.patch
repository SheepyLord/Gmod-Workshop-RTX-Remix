diff --git a/src/dxvk/rtx_render/rtx_fork_numos_horizon.h b/src/dxvk/rtx_render/rtx_fork_numos_horizon.h
new file mode 100644
index 000000000..631affcd2
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_numos_horizon.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include "numos/renderer.h"
+#include "rtx/concept/camera/camera.h"
+#include <cstring>
+
+namespace dxvk {
+  // Reflect each frame about its own eye. Projection, jitter and view-space Z
+  // keep their signs. NUMOS reconstructs rays with matrices, without a cross product.
+  inline void setNumosAntipodeCamera(numos::FrameInputs& inputs, Camera camera) {
+    auto matrix = [](const mat4& packed) {
+      Matrix4 result;
+      std::memcpy(result.data, packed.m, sizeof(packed));
+      return result;
+    };
+    // Form clip-to-clip through the relative eye transform. Cancelling two
+    // large world-space projections loses enough precision to shift cloud history.
+    const Matrix4d prevToWorld(matrix(camera.prevViewToWorld));
+    Matrix4d relative = Matrix4d(matrix(camera.prevWorldToView)) * Matrix4d(matrix(camera.viewToWorld));
+    relative[3] *= -1.0;
+    relative[3].w = 1.0;
+    auto oppositeReprojection = [&](const mat4& previous, const mat4& unproject) {
+      const Matrix4d previousProjection = Matrix4d(matrix(previous)) * prevToWorld;
+      return Matrix4(previousProjection * relative * Matrix4d(matrix(unproject)));
+    };
+    camera.projectionToPrevProjection = oppositeReprojection(camera.prevWorldToProjection, camera.projectionToView);
+    camera.projectionToPrevProjectionJittered = oppositeReprojection(camera.prevWorldToProjectionJittered, camera.projectionToViewJittered);
+    Matrix4 flip;
+    flip[0][0] = flip[1][1] = flip[2][2] = -1.f;
+    Matrix4 prevEyeReflection = flip;
+    prevEyeReflection[3] = matrix(camera.prevViewToWorld)[3] * 2.f;
+    prevEyeReflection[3][3] = 1.f;
+    camera.worldToView = flip * matrix(camera.worldToView);
+    camera.viewToWorld = matrix(camera.viewToWorld) * flip;
+    camera.worldToProjectionJittered = matrix(camera.viewToProjectionJittered) * matrix(camera.worldToView);
+    camera.projectionToWorldJittered = matrix(camera.viewToWorld) * matrix(camera.projectionToViewJittered);
+    camera.translatedWorldToView = flip * matrix(camera.translatedWorldToView);
+    camera.translatedWorldToProjectionJittered = matrix(camera.translatedWorldToProjectionJittered) * flip;
+    camera.projectionToTranslatedWorld = flip * matrix(camera.projectionToTranslatedWorld);
+    camera.prevWorldToView = flip * matrix(camera.prevWorldToView);
+    camera.prevViewToWorld = matrix(camera.prevViewToWorld) * flip;
+    camera.prevWorldToProjection = matrix(camera.prevWorldToProjection) * prevEyeReflection;
+    camera.prevWorldToProjectionJittered = matrix(camera.prevWorldToProjectionJittered) * prevEyeReflection;
+    camera.prevTranslatedWorldToView = flip * matrix(camera.prevTranslatedWorldToView);
+    camera.prevTranslatedWorldToProjection = matrix(camera.prevTranslatedWorldToProjection) * flip;
+    static_assert(sizeof(camera) == sizeof(inputs.camera));
+    std::memcpy(&inputs.camera, &camera, sizeof(camera));
+    std::memcpy(inputs.viewToWorld, &camera.viewToWorld, sizeof(inputs.viewToWorld));
+    inputs.cameraForward = inputs.cameraForward * -1.f;
+    inputs.opaqueTlas = 0;
+    inputs.localLights = nullptr;
+    inputs.localLightCount = 0;
+    inputs.groundPointCount = 0;
+    inputs.lightningStrike = false;
+  }
+
+  inline numos::Settings numosAntipodeSettings(numos::Settings settings, float groundLevel) {
+    settings.aerialPerspective = false;
+    settings.groundLevelAuto = false;
+    settings.groundLevelWorldUnits = groundLevel;
+    settings.lightningEnable = false;
+    settings.nightSkyStars = false;
+    settings.cloudSecondaryLutEnable = false;
+    return settings;
+  }
+}
