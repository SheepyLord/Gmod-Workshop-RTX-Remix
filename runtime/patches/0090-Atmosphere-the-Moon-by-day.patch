+// SPDX-License-Identifier: MIT
+// The Moon by day (fork — the GMod native loader's ADR 0207): the scale on a moon's light while the
+// sun is up, the real Moon's phase law over the drawn Moon's.
+#include "../../../src/dxvk/rtx_render/rtx_moon_daylight.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+
+namespace {
+  int checks = 0;
+
+  void require(bool good, const char* name) {
+    ++checks;
+    if (!good) {
+      std::fprintf(stderr, "FAILED: %s\n", name);
+      std::exit(1);
+    }
+  }
+
+  bool near(double value, double expected, double tolerance) {
+    return std::abs(value - expected) <= tolerance;
+  }
+
+  // The drawn law by brute force: evalTexturedMoon's Lunar-Lambert term (without its pixel-wide
+  // terminator smoothing) summed over a grid on the disc of a smooth sphere lit from phase angle a.
+  double drawnByGrid(double a) {
+    const int n = 801;
+    double sum = 0.0;
+    for (int j = 0; j < n; ++j) {
+      for (int i = 0; i < n; ++i) {
+        const double x = -1.0 + 2.0 * (i + 0.5) / n;
+        const double y = -1.0 + 2.0 * (j + 0.5) / n;
+        const double r2 = x * x + y * y;
+        if (r2 >= 1.0) {
+          continue;
+        }
+        const double z = std::sqrt(1.0 - r2);
+        const double cosI = x * std::sin(a) + z * std::cos(a);
+        if (cosI <= 0.0) {
+          continue;
+        }
+        sum += 0.75 * 2.0 * cosI / (cosI + z) + 0.25 * cosI;
+      }
+    }
+    return sum;
+  }
+}
+
+int main() {
+  using namespace dxvk::moondaylight;
+  constexpr double kDegree = kPi / 180.0;
+
+  require(near(phaseAngle(0.5), 0.0, 1e-12), "full is phase angle 0");
+  require(near(phaseAngle(0.0), kPi, 1e-12) && near(phaseAngle(1.0), kPi, 1e-12), "new is phase angle pi");
+  require(near(phaseAngle(0.25), 0.5 * kPi, 1e-12) && near(phaseAngle(0.75), 0.5 * kPi, 1e-12),
+          "both quarters are phase angle pi / 2");
+  require(near(phaseAngle(1.25), phaseAngle(0.25), 1e-12) && near(phaseAngle(-0.75), phaseAngle(0.25), 1e-12),
+          "the phase wraps by whole turns");
+
+  // The closed forms against the disc itself.
+  const double fullGrid = drawnByGrid(0.0);
+  for (double degrees : { 20.0, 54.0, 90.0, 126.0, 150.0 }) {
+    const double a = degrees * kDegree;
+    char name[96];
+    std::snprintf(name, sizeof(name), "drawn law matches the disc at %.0f degrees", degrees);
+    require(near(drawnMoonLight(a), drawnByGrid(a) / fullGrid, 0.01), name);
+  }
+  require(near(drawnMoonLight(0.0), 1.0, 1e-12) && drawnMoonLight(kPi) == 0.0, "drawn law runs from 1 to 0");
+
+  // The real Moon: a quarter about a tenth of full (magnitude -10 against -12.7).
+  require(near(realMoonLight(0.0), 1.0, 1e-12), "real law is 1 at full");
+  require(near(realMoonLight(90.0 * kDegree), 0.091, 0.002), "real quarter Moon is 9% of full");
+
+  // The day's scale at the companion's phases.
+  require(daytimeLightScale(0.5f) == 1.0f, "full Moon by day as by night");
+  require(near(daytimeLightScale(0.35f), 0.397, 0.005) && near(daytimeLightScale(0.65f), 0.397, 0.005),
+          "gibbous Moon by day at 0.40");
+  require(near(daytimeLightScale(0.25f), 0.2485, 0.005) && near(daytimeLightScale(0.75f), 0.2485, 0.005),
+          "quarter Moon by day at a quarter");
+  require(near(daytimeLightScale(0.15f), 0.146, 0.005) && near(daytimeLightScale(0.85f), 0.146, 0.005),
+          "crescent Moon by day at 0.15");
+  require(near(daytimeLightScale(0.0f), 0.107, 0.003) && near(daytimeLightScale(1.0f), 0.107, 0.003),
+          "new Moon by day held at the law's limit");
+
+  // Never above 1, never below the limit's value, never rising towards new.
+  float previous = 1.0f;
+  for (int step = 0; step <= 500; ++step) {
+    const float phase = 0.5f - 0.5f * float(step) / 500.0f;
+    const float scale = daytimeLightScale(phase);
+    require(std::isfinite(scale) && scale <= 1.0f && scale >= 0.1f, "scale stays within [0.1, 1]");
+    require(scale <= previous + 1e-6f, "scale never rises from full towards new");
+    require(near(scale, daytimeLightScale(1.0f - phase), 1e-6), "waxing and waning alike");
+    previous = scale;
+  }
+
+  std::printf("PASS moon daylight: %d checks\n", checks);
+  return 0;
+}
