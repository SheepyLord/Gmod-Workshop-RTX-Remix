+// SPDX-License-Identifier: MIT
+#pragma once
+
+#define NUMOS_LOWER_TILE_PIXELS 32
+#define NUMOS_LOWER_FRAME       0
+#define NUMOS_LOWER_DEPTH       1
+#define NUMOS_LOWER_TILE_OUTPUT 2
+#define NUMOS_LOWER_SKY         3
+// The pinned NUMOS screen-cloud shaders use slots 0 through 31.
+#define NUMOS_LOWER_TILE_INPUT 32
