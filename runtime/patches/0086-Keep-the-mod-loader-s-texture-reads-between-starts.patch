@@ -0,0 +1,50 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+#pragma once
+
+// NV-DXVK: the mod texture cache (ADR 0195 of the GMod native loader project).
+//
+// At every start a USD mod's material walk opened each texture file its materials name twice: once to read its DDS
+// headers and once to copy its five smallest mips, the ones a new texture uploads first, and it did so again for every
+// further material naming the same file. The field's mods name about 25,500 textures in 16,700 files. This cache keeps
+// per mod what those reads produced (ModTextureStore, in rtx-remix\cache\mod-textures) and makes the same assets from
+// it while the files are unchanged, so a later start opens none of them. Deleting the folder is always safe.
+
+#include <filesystem>
+#include <string>
+#include <unordered_map>
+
+#include "rtx_asset_data_manager.h"
+#include "rtx_mod_texture_store.h"
+
+namespace dxvk {
+
+  class ModTextureCache {
+  public:
+    // modFile: the mod's mod.usda. Reads the mod's cache file, if any.
+    explicit ModTextureCache(const std::filesystem::path& modFile);
+
+    // The asset findAsset's partial DDS loader makes for this resolved texture path, from the cache when the file is
+    // unchanged; nullptr for a path this cache does not handle (the caller then uses findAsset).
+    Rc<AssetData> find(const std::string& resolvedPath);
+
+    // Writes the cache file when this load used anything other than what it read.
+    void save() { m_store.save(); }
+
+    const ModTextureStore::Counters& counters() const { return m_store.counters(); }
+    uint32_t lookups() const { return m_lookups; }
+    uint32_t repeats() const { return m_repeats; }
+    const std::filesystem::path& cacheFile() const { return m_store.cacheFile(); }
+
+    // <game>\rtx-remix\cache\mod-textures
+    static std::filesystem::path folder();
+
+  private:
+    ModTextureStore m_store;
+    std::unordered_map<std::wstring, Rc<AssetData>> m_found;  // this load's assets, by lowercase normalized path
+    uint32_t m_lookups = 0;
+    uint32_t m_repeats = 0;
+  };
+
+} // namespace dxvk
