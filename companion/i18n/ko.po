#: nativeloader/lua/autorun/nativeloader_sky.lua:1407
#: nativeloader/lua/autorun/nativeloader_sky.lua:1533
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:276
msgid "The Remix API is not available in this session, so these settings cannot be applied. Run nativeloader_status for details."
msgstr "이번 세션에서는 Remix API를 사용할 수 없어 이 설정들을 적용할 수 없습니다. 자세한 내용은 nativeloader_status를 실행하세요."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1411
#, c-format
msgid "On this map %s keeps a sky of its own, such as space, that no time of day or weather fits. It keeps that sky until a setting here is changed; your settings then replace it until the next map."
msgstr "이 맵에서는 %s이(가) 우주처럼 시간대나 날씨가 어울리지 않는 고유한 하늘을 유지합니다. 여기서 설정을 변경할 때까지 그 하늘을 유지하며, 변경하면 다음 맵까지 이 메뉴의 설정으로 대체합니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1413
#, c-format
msgid "On this map %s also sets the sky. It keeps its sky while Follow the map's sun is ticked and nothing here is changed; otherwise your settings here replace it."
msgstr "이 맵의 하늘도 %s이(가) 설정합니다. '맵의 태양 따르기'가 선택되어 있고 여기서 설정을 변경하지 않은 동안에는 해당 하늘을 유지하며, 그렇지 않으면 이 메뉴의 설정으로 대체합니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1421
#: nativeloader/lua/nativeloader/enhanced_editor_panel.lua:130
msgid "Enhanced sky is unavailable in VR. The RTX sky uses Standard."
msgstr "VR에서는 향상 모드를 사용할 수 없습니다. RTX 하늘은 표준 모드로 표시됩니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1446
msgid "This map"
msgstr "이 맵"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1450
msgid "Remembered for this map. Automatic shows the sky of the map's RTX version where it has one, else the choice under Other maps."
msgstr "이 맵에 대해 기억됩니다. '자동'은 맵의 RTX 버전에 고유한 하늘이 있으면 그 하늘을, 없으면 '다른 맵'의 선택을 표시합니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1451
msgid "This map has no sky of its own to switch to."
msgstr "이 맵에는 전환할 고유한 하늘이 없습니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1452
msgid "Other maps"
msgstr "다른 맵"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1453
#: nativeloader/lua/nativeloader/map_sky.lua:222
msgid "RTX sky"
msgstr "RTX 하늘"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1454
msgid "Their own sky"
msgstr "맵 고유의 하늘"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1455
msgid "The RTX sky has a sun, clouds, stars and a moon, and lights the map from them. A map's own sky shows its sky textures and, where it has one, its 3D skybox."
msgstr "RTX 하늘에는 태양, 구름, 별, 달이 있고, 이것들이 맵을 비춥니다. 맵 고유의 하늘은 하늘 텍스처와, 있다면 3D 스카이박스를 표시합니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1456
msgid "Say which sky shows"
msgstr "표시되는 하늘 알리기"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1457
msgid "A chat line at each map's start says which sky shows and how to switch."
msgstr "각 맵이 시작될 때 채팅에 어떤 하늘이 표시되는지와 전환 방법을 한 줄로 알립니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1458
msgid "Sky quality"
msgstr "하늘 품질"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1458
msgid "Standard"
msgstr "표준"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1458
msgid "Enhanced"
msgstr "향상"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1459
msgid "Enhanced, the default, adds denser clouds, sun rays and lit mist when the RTX sky is showing. Choose Standard for the Night sky editor's layers and shooting stars."
msgstr "향상(기본값)은 RTX 하늘이 표시될 때 더 짙은 구름과 햇살 기둥, 빛을 받은 옅은 안개를 더합니다. 밤하늘 편집기의 레이어와 별똥별을 쓰려면 표준을 선택하세요."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1460
msgid "Enhanced detail"
msgstr "향상 모드 품질"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1461
#: nativeloader/lua/nativeloader/map_sky.lua:222
msgid "Automatic"
msgstr "자동"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1461
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:81
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:221
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:244
#: nativeloader/lua/autorun/client/nativeloader_vr.lua:314
#: nativeloader/lua/autorun/client/nativeloader_vr.lua:366
msgid "High"
msgstr "높음"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1461
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:81
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:221
msgid "Medium"
msgstr "중간"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1461
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:81
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:221
#: nativeloader/lua/autorun/client/nativeloader_vr.lua:314
#: nativeloader/lua/autorun/client/nativeloader_vr.lua:367
msgid "Low"
msgstr "낮음"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1462
msgid "Automatic uses the loader's performance tier for clouds and mist."
msgstr "자동으로 설정하면 로더의 성능 등급에 따라 구름과 안개의 품질이 결정됩니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1463
msgid "Shape clouds, air and light in the Enhanced sky editor. Both skies use Moon size and Moon brightness from the Night sky editor."
msgstr "향상 하늘 편집기에서 구름과 대기, 빛을 조절하세요. 달의 크기와 밝기는 두 하늘 모두 밤하늘 편집기의 설정을 따릅니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1468
msgid "Time of day, weather and the night sky are the RTX sky's. On a map that shows another sky, changing one of them shows the RTX sky until the next map starts."
msgstr "시각, 날씨, 밤하늘은 RTX 하늘의 설정입니다. 다른 하늘을 표시하는 맵에서 이 중 하나를 변경하면 다음 맵이 시작될 때까지 RTX 하늘이 표시됩니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1469
msgid "No horizon"
msgstr "지평선 없음"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1470
msgid "For maps that float in the sky or in space: below the horizon the sky goes on, with clouds, the stars and the moon, instead of the haze of a ground."
msgstr "하늘이나 우주에 떠 있는 맵용입니다. 지평선 아래에는 지면의 연무 대신 하늘이 이어지고, 구름과 별과 달이 보입니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1471
msgid "Follow the map's sun"
msgstr "맵의 태양 따르기"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1472
msgid "Puts the sun where the map's own sun is; on a map whose add-on sets its own sky, such as Modern House RTX, keeps that sky. Moving Time of day or Sun direction turns this off."
msgstr "태양을 맵 자체의 태양 위치에 맞춥니다. Modern House RTX처럼 애드온이 자체 하늘을 설정하는 맵에서는 해당 하늘을 유지합니다. 시각이나 태양 방향을 변경하면 이 옵션이 꺼집니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1473
msgid "Time of day"
msgstr "시각"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1477
#, c-format
msgid "Now %s"
msgstr "현재 %s"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1495
msgid "Sun direction"
msgstr "태양 방향"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1496
msgid "Turns the sun's path around the sky."
msgstr "태양의 이동 경로를 수평으로 회전합니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1497
#: nativeloader/lua/autorun/nativeloader_sky.lua:1537
msgid "Time passes"
msgstr "시간 흐름"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1498
msgid "Day length (min)"
msgstr "하루 길이(분)"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1499
msgid "Time passes is on by default. A whole day takes 20 real minutes; untick Time passes to stop the clock."
msgstr "시간 흐름은 기본으로 켜져 있습니다. 하루는 실제 시간으로 20분입니다. 시간 흐름을 끄면 시계가 멈춥니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1500
msgid "Sky update interval (s)"
msgstr "하늘 갱신 간격(초)"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1501
msgid "How often the sun, moon, stars and weather move, in seconds: 0.02 is 50 times a second, 0 is every frame. A longer interval costs a little less frame time, but the sky moves in steps."
msgstr "해, 달, 별, 날씨를 갱신하는 간격(초)입니다. 0.02는 초당 50번, 0은 매 프레임입니다. 간격을 늘리면 프레임 시간이 조금 줄지만 하늘이 끊기듯 움직입니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1502
msgid "Season"
msgstr "계절"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1503
#: nativeloader/lua/autorun/nativeloader_sky.lua:1560
msgid "Moon"
msgstr "달"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1504
msgid "Moon by day"
msgstr "낮의 달"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1505
msgid "How bright the moon is while the sun is up. At 1 it is as bright as the real Moon: a pale disc over the blue sky, a quarter clear in the afternoon, a crescent faint near the sun. Higher makes it stand out; 0 hides it by day."
msgstr "해가 떠 있는 동안 달의 밝기입니다. 1이면 실제 달과 같은 밝기로, 파란 하늘 위에 연한 원반으로 보입니다. 상현달은 오후에 또렷이 보이고, 초승달은 해 가까이에서 희미하게 보입니다. 값을 높이면 더 눈에 띄고, 0이면 낮에는 달을 숨깁니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1506
msgid "Eclipse"
msgstr "일식·월식"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1507
msgid "Eclipse progress"
msgstr "식 진행"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1508
msgid "From first contact (0) to the middle (100): a lunar eclipse is total from 70, a solar one from 90. An eclipse sets the moon's phase, and the time if the sun is on the wrong side of the horizon for it."
msgstr "첫 접촉(0)부터 식의 최대(100)까지입니다. 월식은 70부터, 일식은 90부터 개기식입니다. 식을 고르면 달의 위상이 정해지고, 태양이 지평선 반대쪽에 있으면 시각도 바뀝니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1509
#: nativeloader/lua/autorun/nativeloader_sky.lua:1539
msgid "Night sky"
msgstr "밤하늘"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1510
msgid "Night sky image: sharp stars, a galaxy and nebulae, turning with the time and the season."
msgstr "밤하늘 이미지: 선명한 별, 은하, 성운이 시각과 계절에 따라 회전합니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1511
msgid "The Night sky editor, next to this page, sets how each part of the night sky looks."
msgstr "이 페이지 옆의 ‘밤하늘 편집기’에서 밤하늘의 각 요소가 어떻게 보일지 설정합니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1512
msgid "Weather"
msgstr "날씨"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1513
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:285
#: nativeloader/lua/autorun/client/nativeloader_menu.lua:289
msgid "(leave to Remix)"
msgstr "(Remix에 맡김)"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1515
msgid "Clouds, haze, fog, rain and snow, from Remix's own weather presets."
msgstr "Remix 자체의 날씨 프리셋으로 표현하는 구름, 연무, 안개, 비, 눈입니다."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1516
msgid "Weather change (s)"
msgstr "날씨 전환(초)"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1517
msgid "How long a change of weather takes."
msgstr "날씨가 바뀌는 데 걸리는 시간."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1518
msgid "Reset the sky and weather"
msgstr "하늘과 날씨 초기화"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1531
msgid "Enhanced uses Moon size and Moon brightness from this page. Brightness changes the lunar disc. Adjust moonlight on the ground in the Enhanced sky editor."
msgstr "향상 모드에서도 이 페이지의 달 크기와 밝기를 사용합니다. 밝기는 달 표면에 적용됩니다. 땅을 비추는 달빛은 향상 하늘 편집기에서 조절하세요."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1535
msgid "How each part of the night sky looks. Brightness: 1 is as drawn, 0 hides it. Colour: 0 is grey, 1 as drawn, 2 stronger. Look up at the night sky while you drag."
msgstr "밤하늘 각 요소의 모습입니다. 밝기: 1은 원래대로, 0은 숨김. 색: 0은 회색, 1은 원래대로, 2는 더 진하게. 슬라이더를 움직이면서 밤하늘을 올려다보세요."

#: nativeloader/lua/autorun/nativeloader_sky.lua:1536
msgid "Go to night"
msgstr "밤으로 이동"

#: nativeloader/lua/autorun/nativeloader_sky.lua:1538
msgid "Untick Time passes to keep the night while you edit."
