+float3 numosCompositeSkyPixel(uint2 pixel, float3 direction, float3 dome, bool layerOnly, out float coverage) {
+  const float3 view = normalize(enhanced_worldToAtmosphereYUp(direction, skyArgs.isZUp != 0u, skyArgs.flipUpAxis != 0u));
+  NumosGroundHit hit = {};
+  if ((numosNight.flags & kNumosFiniteGround) != 0u)
+    hit = numosSkyGround(0.xxx, view, skyArgs);
+
+  float3 upper = 0.xxx;
+  float upperCloud = 0.f;
+  if (hit.coverage < 1.f) {
+    const float3 skyWorld = hit.coverage > 0.f ? normalize(numosKmYUpToWorld(hit.skyDir, skyArgs)) : direction;
+    const float3 background = layerOnly ? 0.xxx : (cb.skyHostOverride ? dome * cb.skyRadianceScale
+      : numosVisibleSky(skyWorld, skyArgs, skyArgs.isZUp, false, numosNight));
+    upper = compositeOverSkyInternal(pixel, background, true, 0.f, upperCloud);
+  }
+  coverage = upperCloud;
+  if (hit.coverage == 0.f) return upper;
+
+  const float3 ground = layerOnly ? 0.xxx : numosBareGround(0.xxx, view, hit, skyArgs);
+  float lowerCloud;
+  const float3 lower = compositeOverSkyInternal(pixel, ground, false, numosKmToWorld(hit.km, skyArgs), lowerCloud);
+  coverage = lerp(upperCloud, lowerCloud, hit.coverage);
+  return lerp(upper, lower, hit.coverage);
+}
