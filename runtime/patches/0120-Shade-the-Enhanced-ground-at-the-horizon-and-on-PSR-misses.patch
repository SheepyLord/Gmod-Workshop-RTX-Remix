+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include "rtx/pass/numos/numos_ground.slangh"
+
+// Shade the last reflected or transmitted segment while its actual ray is still
+// available. Both split paths then carry this radiance through their ordinary
+// PSR attenuation. The composite handles the shared camera-to-surface leg.
+float3 numosPsrSky(Ray ray) {
+  NumosGroundHit hit = {};
+  const float3 view = enhanced_worldToAtmosphereYUp(ray.direction, skyArgs.isZUp != 0u, skyArgs.flipUpAxis != 0u);
+  const float3 offset = ray.origin - skyArgs.cameraPosition;
+  const float3 originKm = numosWorldToKmYUp(offset, skyArgs);
+  if ((numosNight.flags & kNumosFiniteGround) != 0u)
+    hit = numosSkyGround(originKm, view, skyArgs);
+
+  float3 sky = 0.xxx;
+  if (hit.coverage < 1.f) {
+    const float3 skyDir = hit.coverage > 0.f ? normalize(numosKmYUpToWorld(hit.skyDir, skyArgs)) : ray.direction;
+    sky = cb.skyRadianceUnscale * numosVisibleSky(skyDir, skyArgs, cb.isZUp, true, numosNight);
+    sky *= calcVolumetricAttenuation(cb.volumeArgs, none, true, 0.f, ray.origin, skyDir);
+  }
+  if (hit.coverage == 0.f) return sky;
+
+  const float distance = numosKmToWorld(hit.km, skyArgs);
+  enhanced_AtmosphereArgs air = skyArgs;
+  // The atmospheric LUT is baked about the eye. The analytic height fog can
+  // start at the mirror's own altitude, in the independently scaled air frame.
+  air.apCameraAltitudeKm += numosWorldToAirKmYUp(offset, skyArgs).y;
+  float3 airT;
+  const float3 scatter = numosAerialPerspectiveAlongRay(air, ray.direction, distance, NumosFarScatter,
+    NumosFarTransmittance, enhanced_AtmosphereSkyViewSampler, airT);
+  float3 ground = scatter + airT * numosBareGround(originKm, hit, skyArgs);
+  if (skyArgs.cloudSecondaryLutEnable != 0u) {
+    const float4 cloud = enhanced_sampleCloudDomeLutSmooth(enhanced_AtmosphereCloudSecondaryLut,
+      enhanced_AtmosphereSkyViewSampler, enhanced_cloudDomeDirToUv(view), 0.f);
+    ground = cloud.rgb + cloud.a * ground;
+  }
+  ground *= cb.skyRadianceUnscale;
+  ground *= calcVolumetricAttenuation(cb.volumeArgs, none, false, distance, ray.origin, ray.direction);
+  return lerp(sky, ground, hit.coverage);
+}
