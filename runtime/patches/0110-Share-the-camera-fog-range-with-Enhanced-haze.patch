new file mode 100644
index 000000000..277a3cc2a
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_numos_volume.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include "rtx_sky_mode.h"
+
+namespace dxvk {
+  struct NumosVolumePolicy {
+    int selection = -1;  // -1 is the stock frame path
+    bool playerEnabled = false;
+
+    constexpr bool paused() const { return selection == 0 || (selection == 1 && !playerEnabled); }
+    constexpr bool exclusiveRemix() const { return selection == 2 && playerEnabled; }
+    constexpr bool split() const { return selection == 1 && playerEnabled; }
+    constexpr bool resets(const NumosVolumePolicy& old) const {
+      return selection != old.selection || (selection >= 0 && playerEnabled != old.playerEnabled);
+    }
+  };
+
+  constexpr NumosVolumePolicy numosVolumePolicy(SkyMode effective, int selection, bool playerEnabled) {
+    return {effective == SkyMode::Enhanced ? selection : -1, playerEnabled};
+  }
+}
