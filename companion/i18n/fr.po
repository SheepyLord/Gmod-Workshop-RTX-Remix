msgstr "RTX Remix prépare la scène"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:26
msgid "Running add-on scripts"
msgstr "Exécution des scripts des addons"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:27
msgid "Building the spawn menu"
msgstr "Construction du menu de création"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:28
