--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_dlfg_hudless.h
@@ -0,0 +1,99 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+#pragma once
+
+// NV-DXVK: the HUD-less input of DLSS Frame Generation (ADR 0223 of the GMod native loader project). Self-contained
+// (the standard library only), so the project's gate compiles and runs tests/rtx/unit/test_dlfg_hudless.cpp against
+// it; rtx_context.cpp, rtx_dlfg.cpp, rtx_ngx_wrapper.cpp and d3d9_swapchain.cpp are the runtime's side.
+//
+// The game draws its UI over the path traced image after RTX injection, and frame generation got only the finished
+// back buffer: it moved every pixel with the scene's motion vectors, the UI's too, so a crosshair over a turning view
+// smeared or doubled in the generated frames. Given the frame as it was before the UI (NGX's HUD-less colour), DLSS
+// Frame Generation finds the UI where the two differ and keeps it in place.
+//
+// The swapchain owns a copy of its back buffer. Injection blits the path traced image into it as it blits it into
+// the back buffer, and the swapchain blits the copy, as it presents, into a HUD-less image beside each frame
+// generation back buffer, with the same blit as the back buffer's. The render thread marks the frame it filled the
+// copy for; the presenter thread interpolates that frame later and passes its HUD-less image only if it was marked.
+// A new copy (another back buffer size or format) forgets every mark: a frame filled into the old copy is
+// interpolated without one.
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+namespace dxvk {
+
+  template<typename Image>
+  class DlfgHudlessHandoff {
+  public:
+    static constexpr uint32_t kCapacity = 16;
+    static constexpr uint32_t kNoFrame = UINT32_MAX;
+
+    DlfgHudlessHandoff() {
+      forget();
+    }
+
+    // Application thread: the swapchain's copy of its back buffer. A different copy forgets every frame filled
+    // into the one before.
+    void setSource(const Image& image) {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      if (image == m_source) {
+        return;
+      }
+      m_source = image;
+      ++m_generation;
+      forget();
+    }
+
+    // Application thread: the swapchain gives up its copy; another swapchain's copy stays.
+    void dropSource(const Image& image) {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      if (image == nullptr || !(image == m_source)) {
+        return;
+      }
+      m_source = nullptr;
+      ++m_generation;
+      forget();
+    }
+
+    // Render thread: the copy to fill, and its generation for mark().
+    Image source(uint64_t& generation) const {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      generation = m_generation;
+      return m_source;
+    }
+
+    // Render thread: frame `frameId` filled the copy of `generation`. False when the copy was replaced since, as
+    // the image went with it.
+    bool mark(uint32_t frameId, uint64_t generation) {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      if (frameId == kNoFrame || generation != m_generation || m_source == nullptr) {
+        return false;
+      }
+      m_frames[frameId % kCapacity].store(frameId, std::memory_order_release);
+      return true;
+    }
+
+    // Presenter thread: whether frame `frameId` left a HUD-less image. The frame kCapacity later takes its slot;
+    // the presenter is never that far behind the render thread.
+    bool has(uint32_t frameId) const {
+      return frameId != kNoFrame && m_frames[frameId % kCapacity].load(std::memory_order_acquire) == frameId;
+    }
+
+  private:
+    void forget() {
+      for (auto& frame : m_frames) {
+        frame.store(kNoFrame, std::memory_order_relaxed);
+      }
+    }
+
+    mutable std::mutex m_mutex;
+    Image m_source = nullptr;
+    uint64_t m_generation = 0;
+    std::array<std::atomic<uint32_t>, kCapacity> m_frames;
+  };
+
+}
