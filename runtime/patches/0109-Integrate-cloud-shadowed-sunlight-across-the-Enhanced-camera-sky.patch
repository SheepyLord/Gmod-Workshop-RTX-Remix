diff --git a/src/dxvk/rtx_render/rtx_fork_numos_rays.cpp b/src/dxvk/rtx_render/rtx_fork_numos_rays.cpp
new file mode 100644
index 000000000..b11fcc8a0
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_numos_rays.cpp
@@ -0,0 +1,97 @@
+#include "numos/renderer.h"
+#include "rtx_fork_numos_rays.h"
+#include "rtx_numos_gpu.h"
+#include "rtx_context.h"
+#include "rtx_shader_manager.h"
+#include "dxvk_device.h"
+#include "dxvk_scoped_annotation.h"
+#include "rtx/pass/composite/composite_binding_indices.h"
+#include <rtx_shaders/numos_sun_rays.h>
+
+namespace dxvk {
+  namespace {
+    class NumosSunRayShader : public ManagedShader {
+      SHADER_SOURCE(NumosSunRayShader, VK_SHADER_STAGE_COMPUTE_BIT, numos_sun_rays)
+      BEGIN_PARAMETER()
+        CONSTANT_BUFFER(NUMOS_RAYS_FRAME)
+        CONSTANT_BUFFER(NUMOS_RAYS_SKY)
+        CONSTANT_BUFFER(NUMOS_RAYS_CONTROLS)
+        TEXTURE2D(NUMOS_RAYS_DEPTH)
+        TEXTURE2D(NUMOS_RAYS_SUN_LUT)
+        TEXTURE3D(NUMOS_RAYS_SHADOW)
+        SAMPLER(NUMOS_RAYS_SAMPLER)
+        TEXTURE2D(NUMOS_RAYS_PREVIOUS)
+        RW_TEXTURE2D(NUMOS_RAYS_OUTPUT)
+      END_PARAMETER()
+    };
+  }
+
+  void NumosSkyRays::dispatch(RtxContext& ctx, const Resources::RaytracingOutput& scene, const numos::FrameOutputs& out,
+                              const NumosGpu& gpu, const Rc<DxvkBuffer>& skyBuffer, int skyQuality,
+                              bool eligible, bool haze, bool reset) {
+    const auto& a = out.args;
+    const auto detail = numosRayQuality(quality(), skyQuality);
+    const auto extent = scene.m_primaryLinearViewZ.view->imageInfo().extent;
+    NumosRayArgs p {};
+    p.divisor = detail.divisor;
+    p.steps = steps() > 0 ? steps() : detail.steps;
+    p.frame = ctx.getDevice()->getCurrentFrameId();
+    p.debugView = debugView();
+    p.rangeKm = rangeKm();
+    p.historyWeight = historyWeight();
+    p.strength = strength();
+    p.nearHaze = haze && a.apFroxelSizeX;
+    p.width = (extent.width + p.divisor - 1) / p.divisor;
+    p.height = (extent.height + p.divisor - 1) / p.divisor;
+    // These are the two casters exported in the pinned library's host shadow map.
+    const bool lowDeck = a.cloudShadowLive && a.cloudEnabled > 0.5f && a.cloudDensity > 0.f && a.cloudCoverageMean >= 0.01f;
+    const bool cirrus = a.cloudCirrusShadowLive && a.cloudCirrusCoverageMean > 0.f && a.cloudCirrusOpticalDepth > 0.f;
+    const bool canShade = a.cloudVoxelShadowsEnable && a.cloudShadowStrength > 0.f && !a.cloudKeyLight && (lowDeck || cirrus);
+    p.active = runNumosRays(eligible, enable(), p.strength, canShade, a.sunDirection.y) &&
+      gpu.getView(out.cloudShadowMap) != nullptr && gpu.getView(out.transmittanceLut) != nullptr;
+    const Vector3 sun(a.sunDirection.x, a.sunDirection.y, a.sunDirection.z);
+    p.historyValid = p.active && m_last.active && !reset && m_last.frame + 1u == p.frame &&
+      m_last.width == p.width && m_last.height == p.height && m_last.divisor == p.divisor &&
+      m_last.steps == p.steps && m_last.nearHaze == p.nearHaze && m_last.rangeKm == p.rangeKm &&
+      m_last.debugView == p.debugView && dot(m_sun, sun) > 0.999f;
+
+    if (m_controls == nullptr) {
+      DxvkBufferCreateInfo info {};
+      info.size = 256;
+      info.usage = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+      info.stages = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+      info.access = VK_ACCESS_UNIFORM_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+      m_controls = ctx.getDevice()->createBuffer(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, DxvkMemoryStats::Category::RTXBuffer, "Enhanced ray controls");
+    }
+    ctx.writeToBuffer(m_controls, 0, sizeof(p), &p);
+    m_last = p;
+    m_sun = sun;
+    if (!p.active) { return; }
+
+    ScopedGpuProfileZone(&ctx, "Enhanced sky sun rays");
+    const VkExtent3D size {p.width, p.height, 1};
+    if (!m_history[0].isValid() || m_history[0].image->info().extent != size) {
+      Rc<DxvkContext> context = &ctx;
+      for (auto& image : m_history) {
+        image = Resources::createImageResource(context, "Enhanced sky ray history", size, VK_FORMAT_R16G16B16A16_SFLOAT);
+      }
+    }
+    ctx.bindResourceBuffer(NUMOS_RAYS_FRAME, DxvkBufferSlice(ctx.getResourceManager().getConstantsBuffer()));
+    ctx.bindResourceBuffer(NUMOS_RAYS_SKY, DxvkBufferSlice(skyBuffer, 0, sizeof(numos::AtmosphereArgs)));
+    ctx.bindResourceBuffer(NUMOS_RAYS_CONTROLS, DxvkBufferSlice(m_controls, 0, sizeof(p)));
+    ctx.bindResourceView(NUMOS_RAYS_DEPTH, scene.m_primaryLinearViewZ.view, nullptr);
+    ctx.bindResourceView(NUMOS_RAYS_SUN_LUT, gpu.getView(out.transmittanceLut), nullptr);
+    ctx.bindResourceView(NUMOS_RAYS_SHADOW, gpu.getView(out.cloudShadowMap), nullptr);
+    ctx.bindResourceSampler(NUMOS_RAYS_SAMPLER, gpu.getSampler(out.linearClampSampler));
+    ctx.bindResourceView(NUMOS_RAYS_PREVIOUS, m_history[m_index].view, nullptr);
+    m_index ^= 1u;
+    ctx.bindResourceView(NUMOS_RAYS_OUTPUT, m_history[m_index].view, nullptr);
+    ctx.bindShader(VK_SHADER_STAGE_COMPUTE_BIT, NumosSunRayShader::getShader());
+    ctx.dispatch((p.width + 7) / 8, (p.height + 7) / 8, 1);
+  }
+
+  void NumosSkyRays::bindComposite(RtxContext& ctx) const {
+    ctx.bindResourceBuffer(COMPOSITE_SKY_RAY_CONTROLS, DxvkBufferSlice(m_controls, 0, sizeof(NumosRayArgs)));
+    ctx.bindResourceView(COMPOSITE_SKY_RAY_HISTORY, m_last.active ? m_history[m_index].view : nullptr, nullptr);
+  }
+}
diff --git a/src/dxvk/rtx_render/rtx_fork_numos_rays.h b/src/dxvk/rtx_render/rtx_fork_numos_rays.h
new file mode 100644
index 000000000..75c90038c
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_fork_numos_rays.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include "rtx_option.h"
+#include "rtx_resources.h"
+#include "rtx/pass/numos/numos_ray_args.h"
+
+namespace numos { struct FrameOutputs; }
+
+namespace dxvk {
+  class NumosGpu;
+  class RtxContext;
+
+  struct NumosRayQuality { uint32_t divisor, steps; };
+
+  constexpr NumosRayQuality numosRayQuality(int requested, int skyQuality) {
+    const int level = requested < 0 ? skyQuality : requested;
+    return level <= 0 ? NumosRayQuality{6, 16} : level == 1 ? NumosRayQuality{8, 10} : NumosRayQuality{12, 6};
+  }
+
+  constexpr bool runNumosRays(bool enhanced, bool enabled, float strength, bool canShade, float sunY) {
+    return enhanced && enabled && strength > 0.f && canShade && sunY > -0.14f;
+  }
+
+  class NumosSkyRays {
+  public:
+    RTX_OPTION("rtx.atmosphere.numos.rays", bool, enable, true, "Draw sunlight scattered through cloud gaps on camera sky rays.");
+    RTX_OPTION_ARGS("rtx.atmosphere.numos.rays", float, strength, 1.f, "Scale the direct sunlight removed by cloud shadow in the distant air. Zero disables the pass.",
+      args.minValue = 0.f, args.maxValue = 4.f);
+    RTX_OPTION_ARGS("rtx.atmosphere.numos.rays", int32_t, quality, -1, "Ray detail. -1 follows Enhanced quality, 0 High, 1 Medium, 2 Low.",
+      args.minValue = -1, args.maxValue = 2);
+    RTX_OPTION_ARGS("rtx.atmosphere.numos.rays", int32_t, debugView, 0, "Sky ray diagnostic. 0 scene, 1 removed light, 2 unshadowed light, 3 shadowed fraction, 4 march limits.",
+      args.minValue = 0, args.maxValue = 4);
+    RTX_OPTION_ARGS("rtx.atmosphere.numos.rays", float, rangeKm, 120.f, "Farthest sky ray sample in haze kilometres.",
+      args.minValue = 1.f, args.maxValue = 400.f);
+    RTX_OPTION_ARGS("rtx.atmosphere.numos.rays", int32_t, steps, 0, "Stratified ray samples. Zero uses the selected quality.",
+      args.minValue = 0, args.maxValue = 64);
+    RTX_OPTION_ARGS("rtx.atmosphere.numos.rays", float, historyWeight, 0.8f, "Maximum share of reprojected ray history.",
+      args.minValue = 0.f, args.maxValue = 0.95f);
+
+    void dispatch(RtxContext& ctx, const Resources::RaytracingOutput& scene, const numos::FrameOutputs& sky,
+                  const NumosGpu& gpu, const Rc<DxvkBuffer>& skyBuffer, int skyQuality, bool eligible, bool haze, bool reset);
+    void bindComposite(RtxContext& ctx) const;
+
+  private:
+    Rc<DxvkBuffer> m_controls;
+    Resources::Resource m_history[2];
+    NumosRayArgs m_last {};
+    Vector3 m_sun {};
+    uint32_t m_index = 0;
+  };
+}
