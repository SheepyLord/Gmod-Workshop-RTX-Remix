+    // Endfield maps: Endfield also ships NPC, weapon and item families (T_npc_major_<x>, T_wpn_misc_<n>,
+    // T_item_widget_<x>) with the same _N/_HN, _P and _E maps as its t_actor_ ones. Outside t_actor_ the
+    // game is known the way Silver hair is, by a packed map under the same "t_<word>_" prefix: here a _P,
+    // the family's own or a sibling's (faces and bodies have only _N). Silver's _MRA evidence comes first.
+    bool EndfieldPrefix(const std::string& stem) const {
+        const auto split=stem.find('_',2);
+        if(stem.compare(0,2,"t_")!=0 || split==std::string::npos)return false;
+        const auto prefix=stem.substr(0,split+1);
+        for(const auto& p:files_)
+            if(p.first.size()>prefix.size()+2 && p.first.compare(0,prefix.size(),prefix)==0 && p.first.compare(p.first.size()-2,2,"_p")==0)return true;
+        return false;
+    }
     fs::path Find(const std::string& stem,const fs::path& beside) const {
         auto p=files_.find(stem);if(p==files_.end())return {};
         std::vector<fs::path> candidates;
@@ -136,8 +148,9 @@ public:
             const auto prefix=split==std::string::npos?std::string{}:stem.substr(0,split+1);
             if(stem.find("t_")==0 && !prefix.empty())for(const auto& p:files_)
                 if(p.first.compare(0,prefix.size(),prefix)==0 && p.first.size()>4 && p.first.substr(p.first.size()-4)=="_mra")silver=true;
-            if(!silver)return {};
-            m.layout=Maps::Silver;
+            if(silver)m.layout=Maps::Silver;
+            else if(EndfieldPrefix(stem)){m.layout=Maps::Endfield;m.packed=Find(stem+"_p",beside);if(m.normal.empty())m.normal=Find(stem+"_hn",beside);}
+            else return {};
         }
         m.recognized=!m.normal.empty() || !m.packed.empty();return m;
     }
@@ -156,6 +169,9 @@ public:
                 // exact name or by hand, never by UV evidence alone: that is outside R12's calibration,
                 // and a belly decal matched Chisa's Alpha atlas at 0.386.
                 if(m.layout==Maps::Wuwa && Find(stem.first+"_id",root_).empty() && Find(stem.first+"_hm",root_).empty())continue;
+                // Endfield maps: so does an Endfield family outside t_actor_ (NPCs, weapons, items): R12
+                // calibrated UV matching on t_actor_ families, and a _P under a t_ prefix is weaker evidence.
+                if(m.layout==Maps::Endfield && stem.first.compare(0,8,"t_actor_")!=0)continue;
                 Family family{stem.first,m,{}};
                 for(const auto& path:{m.normal,m.packed})if(!path.empty())family.features.push_back({path,Feature(path)});
                 families_.push_back(std::move(family));
