+#: src/dxvk/rtx_render/rtx_atmosphere.h:311
 msgid "Density of air molecules multiplier (1.0 = clear sky)."
 msgstr "공기 분자 밀도 배수입니다(1.0 = 맑은 하늘)."
 
 #. option rtx.atmosphere.aerosolDensity
-#: src/dxvk/rtx_render/rtx_atmosphere.h:311
+#: src/dxvk/rtx_render/rtx_atmosphere.h:312
 msgid "Density of aerosols/dust multiplier (1.0 = typical)."
 msgstr "에어로졸/먼지 밀도 배수입니다(1.0 = 일반)."
 
 #. option rtx.atmosphere.aerosolAbsorption
-#: src/dxvk/rtx_render/rtx_atmosphere.h:312
+#: src/dxvk/rtx_render/rtx_atmosphere.h:313
 msgid "Scale on mieAbsorption [0..4], with aerosolDensity: how much of the light the aerosol meets it absorbs rather than scatters. 1 = as mieAbsorption sets it; low values make a bright, milky haze (water and sulfate haze scatter nine tenths of it), high ones a dark, smoky one. The weathers set it."
 msgstr "mieAbsorption에 적용하는 배율 [0..4]로, aerosolDensity와 함께 에어로졸이 접한 빛 중 산란하지 않고 흡수하는 양을 결정합니다. 1 = mieAbsorption 설정값 그대로입니다. 낮은 값은 밝고 우윳빛인 연무를 만듭니다(물과 황산염 연무는 빛의 10분의 9를 산란시킵니다). 높은 값은 어둡고 연기 같은 연무를 만듭니다. 날씨별로 설정됩니다."
 
 #. option rtx.atmosphere.ozoneDensity
-#: src/dxvk/rtx_render/rtx_atmosphere.h:316
+#: src/dxvk/rtx_render/rtx_atmosphere.h:317
 msgid "Density of ozone layer multiplier (1.0 = typical)."
 msgstr "오존층 밀도 배수입니다(1.0 = 일반)."
 
 #. option rtx.atmosphere.planetRadius
-#: src/dxvk/rtx_render/rtx_atmosphere.h:317
+#: src/dxvk/rtx_render/rtx_atmosphere.h:318
 msgid "Planet radius in kilometers."
 msgstr "행성 반경(킬로미터)입니다."
 
 #. option rtx.atmosphere.atmosphereThickness
-#: src/dxvk/rtx_render/rtx_atmosphere.h:318
+#: src/dxvk/rtx_render/rtx_atmosphere.h:319
 msgid "Atmosphere thickness in kilometers."
 msgstr "대기 두께(킬로미터)입니다."
 
 #. option rtx.atmosphere.mieAnisotropy
