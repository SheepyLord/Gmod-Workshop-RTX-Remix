+// The lower bake stores the lower half of the library LUT at its original
+// texel centres. Wrap azimuth explicitly, including at the seam of the night sky.
+float3 numosHorizonSkyAir(float3 view, enhanced_AtmosphereArgs args) {
+  const float elevation = asin(clamp(view.y, -1.f, 1.f));
+  const float azimuth = frac(atan2(view.z, view.x) / (2.f * enhanced_kPi));
+  if (view.y >= 0.f) {
+    // Exclude the first ground texel from the upper horizon's bilinear footprint.
+    const float v = max(.5f + .5f * sqrt(elevation / (.5f * enhanced_kPi)), .5f + .5f / args.skyViewLutHeight);
+    return enhanced_sampleAzimuthWrappedLut(enhanced_AtmosphereSkyViewLut, enhanced_AtmosphereSkyViewSampler, float2(azimuth, v), 0.f).rgb;
+  }
+  const float2 uv = float2(azimuth, 1.f - sqrt(-elevation / (.5f * enhanced_kPi)));
+  return enhanced_sampleAzimuthWrappedLut(NumosLowerAir, enhanced_AtmosphereSkyViewSampler, uv, 0.f).rgb;
+}
+
+float numosHorizonCloudWeight(float y, float pixelAngle) {
+  // Each cloud march ends at its own planet limb. Taper only the last half
+  // degree into the horizon air, where unrelated distant clouds meet.
+  return smoothstep(0.f, max(.00873f, 2.f * pixelAngle), abs(y));
+}
