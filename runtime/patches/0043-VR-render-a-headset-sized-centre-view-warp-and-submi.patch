+#include "../dxvk_gpu_query.h"
+
+namespace vr { class IVRCompositor; class IVROverlay; struct VRVulkanTextureData_t; }
+namespace dxvk {
+  class RtxContext;
+  class DxvkContext;
+  class RtxOptionLayer;
+  class RtCamera;
+  class RtxVr : public CommonDeviceObject {
+  public:
+    explicit RtxVr(DxvkDevice* device) : CommonDeviceObject(device) { m_status.structSize=sizeof(m_status); }
+    ~RtxVr();
+    bool hasWork() const { return m_work.load(std::memory_order_acquire); }
+    bool active() const { return m_active.load(std::memory_order_acquire); }
+    int start(const rtxvr_StartInfo* info);
+    void stop();
+    int updateEyes(const rtxvr_Eye eyes[2]);
+    int pushPose(const rtxvr_FramePose* pose);
+    int overlaySource(uint64_t handle, uint32_t w, uint32_t h);
+    int capture(const wchar_t* folder, uint32_t what);
+    int status(rtxvr_Status* out);
+    bool projection(Matrix4& matrix, float& fov, float& aspect);
+    VkExtent3D beginFrame(RtxContext& ctx, VkExtent3D flat);
+    void timestamp(RtxContext& ctx, uint32_t stage);
+    void output(RtxContext& ctx, const Rc<DxvkImage>& colour, const Rc<DxvkImageView>& depth, const Rc<DxvkImage>& game);
+    void observeTarget(DxvkContext& ctx, const Rc<DxvkImage>& image);
+    void beforeSubmission();
+    void present(RtxContext& ctx, const Rc<DxvkImage>& game);
+  private:
+    struct Image { Rc<DxvkImage> image; Rc<DxvkImageView> view; };
+    struct Overlay { uint32_t width=0,height=0; Image texture; bool dirty=false; };
+    struct Timer { std::array<Rc<DxvkGpuQuery>,6> queries; bool pending=false; };
+    Image makeImage(DxvkContext& ctx, VkExtent3D size, VkFormat format=VK_FORMAT_R8G8B8A8_UNORM);
+    void captureImage(RtxContext& ctx, const Rc<DxvkImage>& image, const std::filesystem::path& path, bool depth=false);
+    void submit(RtxContext& ctx);
+    void clearResources();
+    bool initialise(RtxContext& ctx);
+    void fail(int error, const std::string& message);
+    vr::VRVulkanTextureData_t textureData(const Image& image) const;
+    std::mutex m_requestMutex, m_openVrMutex;
+    std::atomic<bool> m_active {false}, m_work {false};
+    uint64_t m_generation=0, m_renderGeneration=0;
+    rtxvr_StartInfo m_requested {}, m_frame {};
+    vrmath::Projection m_projection {}, m_frameProjection {};
+    vrmath::PoseRing m_poses;
+    rtxvr_FramePose m_framePose {};
+    rtxvr_Status m_status {};
+    std::map<uint64_t,Overlay> m_overlays;
+    std::map<uint64_t,std::pair<uint32_t,uint32_t>> m_overlayRequests;
+    std::filesystem::path m_captureFolder, m_frameCaptureFolder;
+    uint32_t m_captureWhat=0, m_frameCaptureWhat=0;
+    std::array<Image,2> m_eyes;
+    std::array<Timer,8> m_timers;
+    Timer* m_timer=nullptr;
+    uint32_t m_timerIndex=0;
+    uint64_t m_frames=0;
+    vr::IVRCompositor* m_compositor=nullptr;
+    vr::IVROverlay* m_overlay=nullptr;
+    const RtxOptionLayer* m_layer=nullptr;
+    bool m_ready=false;
+    std::set<uint64_t> m_submittedOverlays;
+    uint64_t m_timingFrame=~uint64_t(0);
+  };
+}
