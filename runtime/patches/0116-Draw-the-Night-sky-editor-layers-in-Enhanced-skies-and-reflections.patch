+
+#pragma once
+
+#include "rtx/pass/numos/numos_night.h"
+#include "rtx/pass/numos/numos_disc.h"
+#include "rtx/pass/atmosphere/atmosphere_common.slangh"
+
+// NightSky HD's actual mesh mappings and Standard's gamma-space layer blend.
+// q is the direction in NUMOS equatorial coordinates (RA 0h, RA 6h, north pole).
+static const float kNumosImageRings[10] = { 0.0f, 0.21128f, 0.41641f, 0.60876f, 0.7983f,
+                                         1.01726f, 1.24191f, 1.46891f, 1.70335f, 1.95472f };
+
+vec3 numosLayerColour(vec3 colour, float saturation) {
+  float grey = dot(colour, vec3(0.2126f, 0.7152f, 0.0722f));
+  return max(lerp(vec3(grey), colour, saturation), vec3(0.0f));
+}
+
+vec3 numosNightImage(vec3 q, float pixel, NumosNightArgs night) {
+  vec3 layers = vec3(0.0f);
+
+  if ((night.flags & kNumosNightStars) != 0u) {
+    const vec3 kCentre = vec3(0.0f, -0.390731f, 0.920505f);
+    const vec3 kTheta0 = vec3(1.0f, 0.0f, 0.0f);
+    const vec3 kTheta90 = vec3(0.0f, -0.920505f, -0.390731f);
+    vec3 h = (dot(q, kCentre) < 0.0f) ? -q : q;
+    float angle = acos(clamp(dot(h, kCentre), -1.0f, 1.0f));
+    float ring = clamp(angle * (18.0f / kPi), 0.0f, 8.999f);
+    uint k = uint(ring);
+    float r = lerp(kNumosImageRings[k], kNumosImageRings[k + 1u], ring - float(k));
+    float theta = atan2(dot(h, kTheta90), dot(h, kTheta0));
+    vec2 uv = vec2(1.0f + r * cos(theta), r * sin(theta));
+    // Mip from the larger of the radial (dr/dangle) and round (r/sin) stretch.
+    float radial = (kNumosImageRings[k + 1u] - kNumosImageRings[k]) * (18.0f / kPi);
+    float around = (angle > 1e-3f) ? r / sin(angle) : radial;
+    uint width, height;
+    AtmosphereStarMap.GetDimensions(width, height);
+    float lod = max(log2(max(pixel * max(radial, around) * float(width), 1e-4f)), 0.0f);
+    // The texture tiles: wrap v by hand (the sampler clamps it).
+    vec4 s = AtmosphereStarMap.SampleLevel(AtmosphereSkyViewSampler, frac(uv), lod);
+    layers += numosLayerColour(s.rgb * s.a, night.saturation.x) * night.weight.x;
+  }
+
+  if (night.deepFade > 0.f && (night.flags & kNumosNightGalaxy) != 0u) {
+    const vec3 kAxis = vec3(0.722456f, -0.042907f, 0.690085f);
+    const vec3 kAlong0 = vec3(-0.573207f, 0.520957f, 0.632486f);
+    const vec3 kAlong90 = vec3(-0.386642f, -0.852504f, 0.351773f);
+    const float kSinHalfWidth = 0.642788f;  // sin 40 degrees
+    float sinBeta = dot(q, kAxis);
+    if (abs(sinBeta) < kSinHalfWidth) {
+      float along = atan2(dot(q, kAlong90), dot(q, kAlong0));
+      vec2 uv = vec2(2.0f + along * (1.5f / kPi), 0.5f - 0.5f * sinBeta / kSinHalfWidth);
+      uint width, height;
+      AtmosphereStarMapGalaxy.GetDimensions(width, height);
+      float cosBeta = sqrt(max(1.0f - sinBeta * sinBeta, 0.0f));
+      float texelsPerRadian = max(float(width) * (1.5f / kPi), float(height) * 0.5f * cosBeta / kSinHalfWidth);
+      float lod = max(log2(max(pixel * texelsPerRadian, 1e-4f)), 0.0f);
+      vec4 g = AtmosphereStarMapGalaxy.SampleLevel(AtmosphereSkyViewSampler, uv, lod);
+      layers += numosLayerColour(g.rgb * g.a, night.saturation.z) * (night.weight.z * night.deepFade);
+    }
+  }
+
+  if ((night.flags & (kNumosNightNebula | kNumosNightConstellations)) != 0u) {
+    vec2 uv = vec2(0.5f + atan2(q.y, q.x) / (2.0f * kPi), 0.5f - asin(clamp(q.z, -1.f, 1.f)) / kPi);
+    uint width, height;
+    if (night.deepFade > 0.f && (night.flags & kNumosNightNebula) != 0u) {
+      AtmosphereStarMapNebula.GetDimensions(width, height);
+      float lod = max(log2(max(pixel * float(height) / kPi, 1e-4f)), 0.0f);
+      vec3 nebula = AtmosphereStarMapNebula.SampleLevel(AtmosphereSkyViewSampler, uv, lod).rgb;
+      layers += numosLayerColour(nebula, night.saturation.w) * (night.weight.w * night.deepFade);
+    }
+    if ((night.flags & kNumosNightConstellations) != 0u) {
+      AtmosphereStarMapConstellations.GetDimensions(width, height);
+      float lod = max(log2(max(pixel * float(height) / kPi, 1e-4f)), 0.0f);
+      vec3 constellations = AtmosphereStarMapConstellations.SampleLevel(AtmosphereSkyViewSampler, uv, lod).rgb;
+      layers += numosLayerColour(constellations, night.saturation.y) * night.weight.y;
+    }
+  }
+
+  // Held at the image's white (1), or at the brightest layer's weight above it (starMapCeiling).
+  return pow(min(layers, vec3(night.ceiling)), vec3(2.2f)) * night.brightness;
+}
+
+vec3 numosShootingStar(vec3 viewDir, float timeSeconds, NumosNightArgs night) {
+  if (night.shootingChance > 0.0f && night.shootingBrightness > 0.0f)
+  {
+    float slotTime = floor(timeSeconds / 4.0f);
+    float slotFrac = fract(timeSeconds / 4.0f);
+
+    float slotHash = hash31(vec3(slotTime, 0.0f, 42.0f));
+    if (slotHash > 1.0f - night.shootingChance) {
+      float startTheta = hash31(vec3(slotTime, 1.0f, 42.0f)) * kPi * 0.5f + 0.3f;
+      float startPhi = hash31(vec3(slotTime, 2.0f, 42.0f)) * 2.0f * kPi;
+
+      vec3 streakStart = vec3(
+        sin(startTheta) * cos(startPhi),
+        cos(startTheta),
+        sin(startTheta) * sin(startPhi)
+      );
+
+      float streakAng = hash31(vec3(slotTime, 3.0f, 42.0f)) * kPi;
+      vec3 streakMoveDir = normalize(vec3(cos(streakAng) * 0.3f, -0.4f, sin(streakAng) * 0.3f));
+
+      float streakLen = 0.05f;  // Longer tail
+      vec3 headPos = normalize(streakStart + streakMoveDir * slotFrac * 0.4f);  // Faster travel
+      vec3 tailPos = normalize(streakStart + streakMoveDir * (slotFrac * 0.4f - streakLen));
+
+      vec3 v = viewDir;
+      vec3 segVec = headPos - tailPos;
+      float segLen = length(segVec);
+      if (segLen > 0.001f) {
+        vec3 segNorm = segVec / segLen;
+        float t = dot(v - tailPos, segNorm);
+        t = clamp(t, 0.0f, segLen);
+        vec3 closest = tailPos + segNorm * t;
+        float dist = length(v - closest);
+
+        // Thinner streak — tighter Gaussian falloff
+        float streakBright = exp(-dist * dist * 18000000.0f);
+
+        // Tail gradient: bright head fading to dim tail
+        float tailFade = t / max(segLen, 0.001f);
+        tailFade = pow(tailFade, 1.5f);
+
+        float timeFade = sin(slotFrac * kPi);
+
+        return vec3(1.0f, 0.95f, 0.85f) * streakBright * tailFade * timeFade * (2.0f * night.shootingBrightness);
+      }
+    }
+  }
+
+  return 0.xxx;
+}
+
+// The emitter's own pre-exposed, phase-dependent illuminance sets the halo level.
+// Its two-and-a-half-radius Gaussian is Standard's. The disc masks it at composition.
+vec3 numosMoonGlow(vec3 view, enhanced_AtmosphereArgs sky, NumosNightArgs night) {
+  vec3 glow = 0.xxx;
+  if (night.moonGlow <= 0.f || night.moonFade <= 0.f) return glow;
+  [unroll] for (uint i = 0; i < enhanced_MAX_MOONS; ++i) {
+    const enhanced_MoonParams m = sky.moons[i];
+    if (m.enabled < .5f || m.angularRadius <= 0.f) continue;
+    const vec3 dir = normalize(m.direction);
+    float radius = 2.5f * m.angularRadius;
+    if (dot(view - dir, view - dir) >= radius * radius) continue;
+    float f = atan2(length(cross(view, dir)), dot(view, dir)) / radius;
+    if (f < 1.f)
+      glow += m.illuminance * (exp(-6.f * f * f) / max(numosDiscSolidAngle(m.angularRadius), 1.f / kNumosDiscPeak));
+  }
+  return glow * (night.moonGlow * night.moonFade);
+}
+
+// Only the outer layers of Standard's solar eclipse. Task S already draws the disc
+// at NUMOS's actual radius. Coverage is the measured geometric overlap this frame.
+vec3 numosSolarCorona(vec3 view, enhanced_AtmosphereArgs sky, NumosNightArgs night) {
+  if (night.eclipseCoverage <= 0.f || night.coronaBrightness <= 0.f) return 0.xxx;
+  const float radius = max(sky.sunAngularRadius, 1e-4f);
+  const vec3 sun = normalize(sky.sunDirection);
+  const float angle = atan2(length(cross(view, sun)), dot(view, sun));
+  const float rho = angle / radius;
+  if (rho >= 8.f) return 0.xxx;
+  const float width = numosDiscRimWidth(sky.skyPixelAngle, sin(radius));
+  const float coverage = numosDiscCoverage(radius - angle, width);
+  if (coverage >= 1.f) return 0.xxx;
+  vec3 north = sky.celestialToLocalZ - sun * dot(sky.celestialToLocalZ, sun);
+  north = dot(north, north) > 1e-6f ? normalize(north)
+    : normalize(cross(sun, abs(sun.y) < .9f ? vec3(0,1,0) : vec3(1,0,0)));
+  vec2 around = vec2(dot(view, north), dot(view, cross(north, sun)));
+  around *= rsqrt(max(dot(around, around), 1e-12f));
+
+  const float r = max(rho, 1.f);
+  float profile = .75f * pow(r, -5.f) + .25f * pow(r, -2.2f);
+  float streamers = saturate(.6f + 1.2f * fbmNoise3D(vec3(around * 3.f, .15f * r), 3, 517.f));
+  float comb = lerp(1.f, 1.6f * streamers * (.55f + .45f * around.y * around.y), saturate((r - 1.f) * .9f));
+  vec3 emission = vec3(1.f, .97f, .92f) * (profile * comb * (1.f - smoothstep(4.8f, 8.f, r)));
+  float rim = exp(-((rho - 1.f) * (rho - 1.f)) / (.012f * .012f));
+  float flares = smoothstep(.1f, .35f, fbmNoise3D(vec3(around * 14.f, 0.f), 2, 731.f));
+  float arcs = flares * exp(-max(rho - 1.f, 0.f) / .035f) * step(1.f, rho);
+  emission += vec3(1.f, .28f, .38f) * (40.f * (rim + 1.5f * arcs));
+  emission *= night.coronaBrightness * night.eclipseCoverage * (1.f - coverage) / (.8f * numosDiscSolidAngle(radius));
+  // Keep the solar disc and its new limb together inside the 0115 display ceiling.
+  float mu = saturate(rho);
+  float disc = numosSunDiscCentre(radius) * (.4f + .6f * sqrt(max(1.f - mu * mu, 0.f))) * coverage;
+  float peak = max(emission.r, max(emission.g, emission.b));
+  return sky.sunIlluminance * emission * min(1.f, max(0.f, kNumosDiscPeak - disc) / max(peak, 1e-12f));
+}
+
+vec3 numosHostNight(vec3 view, enhanced_AtmosphereArgs sky, NumosNightArgs night) {
+  vec3 light = numosMoonGlow(view, sky, night) + numosSolarCorona(view, sky, night);
+  if (night.starFade > 0.f) {
+    vec3 stars = numosShootingStar(view, sky.timeSeconds, night);
+    if ((night.flags & kNumosNightImage) != 0u && night.brightness > 0.f && (night.flags & 15u) != 0u) {
+      const vec3 equatorial = enhanced_nightSkyLocalToEquatorial(view, sky);
+      stars += numosNightImage(equatorial, max(sky.skyPixelAngle, 1e-6f), night);
+    }
+    // nightSkyIlluminance already carries R. nightSkyGain already combines night and star gains.
+    light += stars * sky.nightSkyIlluminance * (kNumosNightImageScale * night.starFade * sky.nightSkyGain);
+  }
+  return light;
+}
