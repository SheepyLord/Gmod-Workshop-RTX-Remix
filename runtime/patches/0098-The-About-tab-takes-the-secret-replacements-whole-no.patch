diff --git a/src/dxvk/rtx_render/rtx_secret_handoff.h b/src/dxvk/rtx_render/rtx_secret_handoff.h
new file mode 100644
index 000000000..ac2c28206
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_secret_handoff.h
@@ -0,0 +1,51 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+#pragma once
+
+// NV-DXVK: the asset replacer's secret replacements, handed to the About tab (runtime patch 0098 of the GMod native
+// loader project). Self-contained (the standard library only), so the project's gate compiles and runs
+// tests/rtx/unit/test_secret_handoff.cpp against it; rtx_asset_replacer.h and .cpp are the runtime's side.
+//
+// AssetReplacer::updateSecretReplacements runs on DXVK's command thread when mods finish loading, change or reload;
+// ImGuiAbout::Secrets::update runs on the game's present thread every frame. They shared one map and a plain bool,
+// so the present thread could walk the map while the command thread cleared and refilled it: GMod died with a null
+// read in Secrets::update a few seconds after Remix loaded its mods (the field, 2026-11-15). The command thread now
+// builds the map on its own and publishes it whole under a lock; the About tab takes a copy under the same lock.
+
+#include <atomic>
+#include <mutex>
+#include <utility>
+
+namespace dxvk {
+
+  template<typename Map>
+  class SecretHandoff {
+  public:
+    // Command thread: the new map, and whether the About tab should take it. As before, a load that found no secret
+    // replacement leaves the tab's copy as it was.
+    void publish(Map&& map, bool updated) {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      m_map = std::move(map);
+      m_updated.store(updated, std::memory_order_release);
+    }
+
+    // Any thread: a published map waits for the About tab.
+    bool pending() const {
+      return m_updated.load(std::memory_order_acquire);
+    }
+
+    // The About tab: a copy of the published map. pending() stays false until the next publish.
+    Map take() {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      m_updated.store(false, std::memory_order_relaxed);
+      return m_map;
+    }
+
+  private:
+    std::mutex m_mutex;
+    Map m_map {};
+    std::atomic<bool> m_updated { false };
+  };
+
+}
