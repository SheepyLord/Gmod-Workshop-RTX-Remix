+  void RtxVr::applyOverlayRequests(DxvkContext& ctx) {
+    if(!m_ready||!active()) { return; }
+    std::map<uint64_t,OverlayRequest> requests;
+    { std::lock_guard lock(m_requestMutex);requests.swap(m_overlayRequests); }
+    for(const auto& item:requests) {
+      const auto& r=item.second;
+      const auto found=m_overlays.find(item.first);
+      if(!r.width&&!r.windowFlags) { retireOverlay(ctx,item.first); }
+      else if(found==m_overlays.end()||found->second.width!=r.width||found->second.height!=r.height||found->second.windowFlags!=r.windowFlags) {
+        retireOverlay(ctx,item.first);
+        m_overlays[item.first]={r.width,r.height,{},false,r.windowFlags};
+      }
+    }
+  }
+
+  void RtxVr::clearWindow(DxvkContext& ctx,const Rc<DxvkImage>& game) {
+    if(game==nullptr) { return; }
+    const VkClearColorValue black {{0.f,0.f,0.f,1.f}};
+    const VkImageSubresourceRange range {VK_IMAGE_ASPECT_COLOR_BIT,0,1,0,1};
+    ctx.clearColorImage(game,black,range);
+  }
