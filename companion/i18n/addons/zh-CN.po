msgid "Disable Client Frustum Culling"
msgstr "禁用客户端视锥剔除"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:254
msgid "Force NoVis (Disable Engine PVS)"
msgstr "强制 NoVis（禁用引擎 PVS）"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:275
msgid "You have enabled r_3dsky which may cause rendering issues with RTX Remix due how the engine culls the skybox. It's recommended to keep r_3dsky disabled for best results."
msgstr "您已启用 r_3dsky。由于引擎剔除天空盒的方式，这可能导致 RTX Remix 出现渲染问题。建议保持 r_3dsky 关闭，以获得较好的效果。"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:280
msgid "Don't show this warning again"
msgstr "不再显示此警告"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:357
msgid "ToPBR"
msgstr "ToPBR"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:360
msgid "Enable ToPBR"
msgstr "启用 ToPBR"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:361
msgid "Converts source material maps (normal, bump, ssbump, etc) to a pseudo-pbr format for RTX Remix."
msgstr "将 Source 材质的法线、凹凸、ssbump 等贴图转换为供 RTX Remix 使用的近似 PBR 格式。"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:362
msgid "Conversion is experimental and cannot reproduce every material exactly."
msgstr "此功能仍在开发中，转换结果无法完全准确。"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:363
msgid "This will use a significant amount of VRAM, disk space, and may cause stability issues."
msgstr "会占用大量显存和磁盘空间，也可能导致稳定性问题。"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:365
