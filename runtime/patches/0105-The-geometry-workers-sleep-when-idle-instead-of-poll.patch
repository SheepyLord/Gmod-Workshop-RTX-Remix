new file mode 100644
index 000000000..c4b12f28f
--- /dev/null
+++ b/tests/rtx/unit/test_worker_idle.cpp
@@ -0,0 +1,293 @@
+/*
+* Copyright (c) 2026, the GMod native loader project. MIT licence, as the runtime this file belongs to.
+*/
+// How an idle worker of a low-latency WorkerThreadPool waits (runtime patch 0105 of the GMod native loader project):
+// it polls for kWorkerSpinWindow after its last task, then sleeps until a task is counted or the pool stops.
+// Standalone: cl /EHsc /std:c++17 /W4 /WX test_worker_idle.cpp
+
+#include "../../../src/util/util_worker_idle.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <random>
+#include <thread>
+#include <vector>
+
+using namespace dxvk;
+
+namespace {
+  int g_checks = 0;
+  int g_failures = 0;
+
+  void check(bool condition, const char* what, int line) {
+    ++g_checks;
+    if (!condition) {
+      ++g_failures;
+      std::printf("FAIL line %d: %s\n", line, what);
+    }
+  }
+#define CHECK(condition) check((condition), #condition, __LINE__)
+
+  using Clock = WorkerSpin::Clock;
+  using Sleep = WorkerSleep<std::mutex, std::condition_variable>;
+  using std::chrono::microseconds;
+  using std::chrono::milliseconds;
+
+  // Waits up to `limit` for `done()`; true if it came.
+  template<typename Done>
+  bool waitFor(Done done, milliseconds limit) {
+    const Clock::time_point end = Clock::now() + limit;
+    while (!done()) {
+      if (Clock::now() > end) {
+        return false;
+      }
+      std::this_thread::sleep_for(microseconds(200));
+    }
+    return true;
+  }
+
+  // A pool shaped like WorkerThreadPool's low-latency mode (util_threadpool.h): a queue per worker, the task count
+  // incremented after the push and before the wake, stealing (or not), and the idle step of patch 0105.
+  class MiniPool {
+  public:
+    explicit MiniPool(uint32_t workers, bool stealing = true)
+    : m_stealing(stealing) {
+      for (uint32_t i = 0; i < workers; ++i) {
+        m_queues.push_back(std::make_unique<Queue>());
+      }
+      for (uint32_t i = 0; i < workers; ++i) {
+        m_threads.emplace_back([this, i] { run(i); });
+      }
+    }
+
+    ~MiniPool() {
+      m_stop = true;
+      m_sleep.stop();
+      for (std::thread& thread : m_threads) {
+        thread.join();
+      }
+    }
+
+    void schedule(std::function<void()> task) {
+      Queue& queue = *m_queues[m_next++ % m_queues.size()];
+      {
+        std::lock_guard<std::mutex> lock(queue.mutex);
+        queue.tasks.push_back(std::move(task));
+      }
+      ++m_count;
+      m_sleep.wake(!m_stealing);
+    }
+
+    uint32_t sleepers() const {
+      return m_sleep.sleepers();
+    }
+
+    // Rounds that found no task and yielded: what an idle worker spends its core on.
+    uint64_t polls() const {
+      return m_polls.load();
+    }
+
+  private:
+    struct Queue {
+      std::mutex mutex;
+      std::deque<std::function<void()>> tasks;
+    };
+
+    bool runOne(uint32_t index) {
+      std::function<void()> task;
+      {
+        Queue& queue = *m_queues[index];
+        std::lock_guard<std::mutex> lock(queue.mutex);
+        if (queue.tasks.empty()) {
+          return false;
+        }
+        task = std::move(queue.tasks.front());
+        queue.tasks.pop_front();
+        --m_count;
+      }
+      task();
+      return true;
+    }
+
+    void run(uint32_t id) {
+      WorkerSpin spin;
+      while (true) {
+        if (m_stop) {
+          return;
+        }
+        if (runOne(id)) {
+          spin.worked();
+          continue;
+        }
+        bool stolen = false;
+        if (m_stealing) {
+          for (uint32_t i = 1; i < m_queues.size() && !stolen; ++i) {
+            stolen = runOne((id + i) % static_cast<uint32_t>(m_queues.size()));
+          }
+        }
+        if (stolen) {
+          spin.worked();
+        } else if (spin.keepPolling()) {
+          ++m_polls;
+          std::this_thread::yield();
+        } else {
+          m_sleep.sleep([this] { return m_count > 0 || m_stop.load(); });
+        }
+      }
+    }
+
+    const bool m_stealing;
+    std::vector<std::unique_ptr<Queue>> m_queues;
+    std::vector<std::thread> m_threads;
+    std::atomic<uint32_t> m_count { 0 };
+    std::atomic<bool> m_stop { false };
+    uint32_t m_next = 0;
+    std::atomic<uint64_t> m_polls { 0 };
+    Sleep m_sleep;
+  };
+
+  void testTheWindow() {
+    const Clock::time_point t0 = Clock::now();
+    WorkerSpin spin;
+    // The first round without a task starts the window; the worker polls until it is over.
+    CHECK(spin.keepPolling(t0));
+    CHECK(spin.keepPolling(t0 + kWorkerSpinWindow / 2));
+    CHECK(spin.keepPolling(t0 + kWorkerSpinWindow - microseconds(1)));
+    CHECK(!spin.keepPolling(t0 + kWorkerSpinWindow));
+    // A worker woken without a task keeps its old window: it sleeps again at once.
+    CHECK(!spin.keepPolling(t0 + kWorkerSpinWindow * 5));
+    // A task starts a new window at the next empty round.
+    spin.worked();
+    CHECK(spin.keepPolling(t0 + kWorkerSpinWindow * 5));
+    CHECK(spin.keepPolling(t0 + kWorkerSpinWindow * 6 - microseconds(1)));
+    CHECK(!spin.keepPolling(t0 + kWorkerSpinWindow * 6));
+    // Long against a thread's wake-up, short against a frame.
+    CHECK(kWorkerSpinWindow >= microseconds(500));
+    CHECK(kWorkerSpinWindow <= milliseconds(2));
+  }
+
+  void testASleeperWakesForATaskAndAtStop() {
+    Sleep sleep;
+    std::atomic<uint32_t> count { 0 };
+    std::atomic<bool> stop { false };
+    std::atomic<int> woken { 0 };
+    std::thread sleeper([&] {
+      sleep.sleep([&] { return count > 0 || stop.load(); });
+      ++woken;
+      --count;
+      sleep.sleep([&] { return count > 0 || stop.load(); });
+      ++woken;
+    });
+    CHECK(waitFor([&] { return sleep.sleepers() == 1; }, milliseconds(2000)));
+    // No task: it stays asleep.
+    std::this_thread::sleep_for(milliseconds(20));
+    CHECK(woken == 0);
+    // A task counted, then the wake: it wakes.
+    ++count;
+    sleep.wake(false);
+    CHECK(waitFor([&] { return woken == 1; }, milliseconds(2000)));
+    CHECK(waitFor([&] { return sleep.sleepers() == 1; }, milliseconds(2000)));
+    // The stop flag, then stop(): it wakes again and ends.
+    stop = true;
+    sleep.stop();
+    CHECK(waitFor([&] { return woken == 2; }, milliseconds(2000)));
+    sleeper.join();
+    CHECK(sleep.sleepers() == 0);
+    // A wake without sleepers does nothing.
+    sleep.wake(false);
+    sleep.wake(true);
+    CHECK(sleep.sleepers() == 0);
+  }
+
+  void testIdleWorkersSleepAndWakeForEachTask() {
+    MiniPool pool(2);
+    std::atomic<uint32_t> ran { 0 };
+    for (int i = 0; i < 5000; ++i) {
+      pool.schedule([&ran] { ++ran; });
+    }
+    CHECK(waitFor([&] { return ran == 5000; }, milliseconds(5000)));
+    // Past their window both workers sleep, and an idle worker no longer polls.
+    CHECK(waitFor([&] { return pool.sleepers() == 2; }, milliseconds(2000)));
+    const uint64_t polls = pool.polls();
+    std::this_thread::sleep_for(milliseconds(50));
+    CHECK(pool.polls() == polls);
+    // A task scheduled while both sleep runs, each time.
+    for (int i = 0; i < 50; ++i) {
+      CHECK(waitFor([&] { return pool.sleepers() == 2; }, milliseconds(2000)));
+      const uint32_t before = ran;
+      pool.schedule([&ran] { ++ran; });
+      CHECK(waitFor([&] { return ran == before + 1; }, milliseconds(2000)));
+    }
+  }
+
+  void testNoTaskIsLeftAtTheWindowsEdge() {
+    // Tasks after pauses on both sides of the window, so the scheduler often counts a task just as a worker goes to
+    // sleep. Every task runs.
+    MiniPool pool(2);
+    std::atomic<uint32_t> ran { 0 };
+    std::mt19937 random(105);
+    std::uniform_int_distribution<int> pause(0, 2 * static_cast<int>(kWorkerSpinWindow.count()));
+    const int tasks = 600;
+    for (int i = 0; i < tasks; ++i) {
+      const Clock::time_point until = Clock::now() + microseconds(pause(random));
+      while (Clock::now() < until) {
+      }
+      pool.schedule([&ran] { ++ran; });
+    }
+    CHECK(waitFor([&] { return ran == static_cast<uint32_t>(tasks); }, milliseconds(5000)));
+  }
+
+  void testWorkersThatCannotStealAllWake() {
+    // Without stealing a task waits for its own worker, so wake() wakes every sleeper.
+    MiniPool pool(3, false);
+    std::atomic<uint32_t> ran { 0 };
+    CHECK(waitFor([&] { return pool.sleepers() == 3; }, milliseconds(2000)));
+    for (int i = 0; i < 30; ++i) {
+      pool.schedule([&ran] { ++ran; });
+      CHECK(waitFor([&] { return ran == static_cast<uint32_t>(i + 1); }, milliseconds(2000)));
+    }
+  }
+
+  void testAPoolStopsWithSleepingOrPollingWorkers() {
+    {
+      auto pool = std::make_unique<MiniPool>(4);
+      CHECK(waitFor([&] { return pool->sleepers() == 4; }, milliseconds(2000)));
+      const Clock::time_point start = Clock::now();
+      pool.reset();
+      CHECK(Clock::now() - start < milliseconds(1000));
+    }
+    {
+      // Right after a task, inside the window.
+      auto pool = std::make_unique<MiniPool>(2);
+      std::atomic<uint32_t> ran { 0 };
+      pool->schedule([&ran] { ++ran; });
+      CHECK(waitFor([&] { return ran == 1; }, milliseconds(2000)));
+      const Clock::time_point start = Clock::now();
+      pool.reset();
+      CHECK(Clock::now() - start < milliseconds(1000));
+    }
+  }
+}
+
+int main() {
+  testTheWindow();
+  testASleeperWakesForATaskAndAtStop();
+  testIdleWorkersSleepAndWakeForEachTask();
+  testNoTaskIsLeftAtTheWindowsEdge();
+  testWorkersThatCannotStealAllWake();
+  testAPoolStopsWithSleepingOrPollingWorkers();
+
+  if (g_failures != 0) {
+    std::printf("FAIL worker idle: %d of %d checks\n", g_failures, g_checks);
+    return 1;
+  }
+  std::printf("PASS worker idle: %d checks\n", g_checks);
+  return 0;
+}
