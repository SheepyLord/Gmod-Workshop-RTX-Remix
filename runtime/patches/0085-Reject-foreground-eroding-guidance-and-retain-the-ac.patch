     timestamp(ctx,vrtiming::Stage::WarpBegin);
     const auto depthSize=depth->imageInfo().extent;
     if(!vrpolicy::resources([&] {
@@ -671,7 +664,6 @@ namespace dxvk {
       ctx.changeImageLayout(m_depthTileMinimum.image,VK_IMAGE_LAYOUT_GENERAL);
       ctx.bindResourceView(0,depth,nullptr);ctx.bindResourceView(1,m_depthCoverage.view,nullptr);
       ctx.bindResourceView(2,m_depthTileMinimum.view,nullptr);
-      ctx.bindResourceView(3,view,nullptr);
       ctx.bindShader(VK_SHADER_STAGE_COMPUTE_BIT,VrDepthCoverageShader::getShader());
       ctx.dispatch((depthSize.width+7)/8,(depthSize.height+7)/8,1);
       ctx.changeImageLayout(m_depthFrameMinimum.image,VK_IMAGE_LAYOUT_GENERAL);
@@ -701,6 +693,12 @@ namespace dxvk {
     }
