       }
-      old.pending=false; m_timer=&old;
+      collectRecordings();
+      auto& old=m_timers[m_timerIndex]; m_timer=nullptr;
+      if (!resolveTimer(old)) { return; }
+      old.frame=m_device->getCurrentFrameId(); old.pose=m_framePose.sequence;
+      old.untrackedBegin=m_untrackedSubmissions.load();
+      old.cpuScopeBegin=cpuWallMs();
+      old.cpuWallBegin=m_lastCpuWall ? m_lastCpuWall : old.cpuScopeBegin;
+      old.cpuRunBegin=m_lastCpuRun ? m_lastCpuRun : threadRunMs();
+      old.captureFolder=m_frameCaptureWhat ? m_frameCaptureFolder : std::filesystem::path();
+      m_timer=&old;
     }
-    if (m_timer && stage<7 && (stage!=6 || m_timer->pending)) { ctx.writeTimestamp(m_timer->queries[stage]); }
-    if (stage==6) {
+    if (m_timer && (stage!=vrtiming::Stage::FrameEnd || m_timer->pending)) { ctx.writeTimestamp(m_timer->queries[index]); }
+    if (stage==vrtiming::Stage::FrameEnd) {
+      m_lastCpuWall=cpuWallMs(); m_lastCpuRun=threadRunMs();
+      if (m_timer) {
+        m_timer->cpuWallEnd=m_lastCpuWall; m_timer->cpuRunEnd=m_lastCpuRun;
+        m_timer->untrackedEnd=m_untrackedSubmissions.load();
+        std::lock_guard lock(m_requestMutex); m_timer->cpuSubmit=m_status.cpuMsSubmit;
+      }
       m_timer=nullptr; m_timerIndex=(m_timerIndex+1)%m_timers.size();
+      collectRecordings();
     }
   }
 
