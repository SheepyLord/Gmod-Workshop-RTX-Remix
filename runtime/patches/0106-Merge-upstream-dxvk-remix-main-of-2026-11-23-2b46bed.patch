+    bool isMirrorTransform(const Matrix4& matrix) {
+      const Vector3 x(matrix[0].data);
+      const Vector3 y(matrix[1].data);
+      const Vector3 z(matrix[2].data);
+      return dot(cross(x, y), z) < 0;
+    }
