diff --git a/src/dxvk/shaders/rtx/pass/numos/numos_disc.h b/src/dxvk/shaders/rtx/pass/numos/numos_disc.h
new file mode 100644
index 000000000..ab5763753
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/numos/numos_disc.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include "rtx/utility/shader_types.h"
+
+// R17's Standard disc stays white on screen at 48 times the brightest daylight channel.
+// Keep the unit-area limb law for large discs. 4*pi*sin^2(r/2) also works for subpixel moons.
+static const float kNumosDiscPeak = 48.f;
+inline float numosDiscSolidAngle(float radius) {
+  const float s = sin(.5f * radius);
+  return 12.566370614359172f * s * s;
+}
+
+inline float numosDiscRimWidth(float pixelAngle, float sinRadius) {
+  const float twoPixels = 2.f * pixelAngle;
+  return twoPixels > .02f * sinRadius ? twoPixels : .02f * sinRadius;
+}
+
+inline float numosDiscCoverage(float distanceInsideRim, float width) {
+  const float coverage = .5f + distanceInsideRim / width;
+  return coverage < 0.f ? 0.f : (coverage > 1.f ? 1.f : coverage);
+}
+
+// Centroid of the covered interval, in projected angular coordinates.
+inline float numosMoonSampleOffset(float offset, float sinRadius, float width, float coverage) {
+  if (coverage >= 1.f) return offset;
+  const float sample = sinRadius - .5f * coverage * width;
+  return sample > 0.f ? sample : 0.f;
+}
+
+inline float numosSunDiscCentre(float radius) {
+  const float area = .8f * numosDiscSolidAngle(radius); // mean of the u=0.6 limb law
+  return 1.f / (area > 1.f / kNumosDiscPeak ? area : 1.f / kNumosDiscPeak);
+}
+
+// A full moon of mean albedo uses at most 48 times its own illuminance before surface shading.
+// Keep dim markings linear and roll bright relief, crescents and authored gains toward the limit.
+// Multiplying RGB by one factor preserves their colour and the slope is continuous at the knee.
+inline float numosMoonDiscGain(float peak, float illuminance) {
+  const float knee = .5f * kNumosDiscPeak * illuminance;
+  if (peak <= knee || peak <= 0.f) return 1.f;
+  const float ratio = knee / peak;
+  return ratio * (2.f - ratio);
+}
diff --git a/src/dxvk/shaders/rtx/pass/numos/numos_visible_discs.slangh b/src/dxvk/shaders/rtx/pass/numos/numos_visible_discs.slangh
new file mode 100644
index 000000000..67e4c3b5c
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/numos/numos_visible_discs.slangh
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include "numos/host/numos_host.slangh"
+#include "rtx/pass/numos/numos_disc.h"
+
+// Keep NUMOS's lunar material, phase, earthshine, texture footprint and disc gain.
+// Coverage belongs to the real silhouette; surface shading belongs to its covered part.
+float3 numosVisibleMoon(float3 view, uint index, enhanced_AtmosphereArgs args, float3 sunDir, out float coverage) {
+  coverage = 0.f;
+  const enhanced_MoonParams moon = args.moons[index];
+  if (moon.enabled < .5f) return 0.xxx;
+
+  const float3 dir = normalize(moon.direction);
+  const float radius = moon.angularRadius;
+  const float sinRadius = sin(radius);
+  const float width = numosDiscRimWidth(args.skyPixelAngle, sinRadius);
+  const float3 chord = view - dir;
+  if (dot(chord, chord) > (radius + width) * (radius + width) || sinRadius <= 0.f) return 0.xxx;
+
+  const float3 tangent = cross(cross(dir, view), dir);
+  const float offset = length(tangent);
+  coverage = numosDiscCoverage(sinRadius - offset, width);
+  if (coverage <= 0.f) return 0.xxx;
+
+  // In a partial pixel, sample halfway across the covered interval. The exact sphere
+  // tangent has no projected area and can have zero sunlight even at full Moon.
+  // Below .001 rad the library's 1-cos(radius) loses precision. Its material depends
+  // only on unit-disc coordinates, so use a larger reference disc with the same footprint.
+  const float evalRadius = radius < .001f ? .01f : radius;
+  if (coverage < 1.f || evalRadius != radius) {
+    const float sampleOffset = numosMoonSampleOffset(offset, sinRadius, width, coverage);
+    const float ratio = sin(evalRadius) / sinRadius;
+    const float3 t = tangent * (ratio * sampleOffset / max(offset, 1e-12f));
+    view = normalize(t + dir * sqrt(max(0.f, 1.f - dot(t, t))));
+    args.moons[index].angularRadius = evalRadius;
+    args.skyPixelAngle *= ratio;
+  }
+  const float libraryArea = 2.f * enhanced_kPi * (1.f - cos(evalRadius));
+  const float displayArea = max(numosDiscSolidAngle(radius), 1.f / kNumosDiscPeak);
+  args.moons[index].illuminance *= libraryArea / displayArea;
+  float unusedCoverage;
+  const float3 surface = enhanced_evalMoonDisk(view, index, args, sunDir, unusedCoverage);
+  const float peak = max(surface.r, max(surface.g, surface.b));
+  const float illuminance = max(moon.illuminance.r, max(moon.illuminance.g, moon.illuminance.b));
+  return surface * numosMoonDiscGain(peak, illuminance);
+}
+
+float numosVisibleSun(float3 view, float3 sunDir, enhanced_AtmosphereArgs args) {
+  const float radius = max(args.sunAngularRadius, 1e-4f);
+  const float width = numosDiscRimWidth(args.skyPixelAngle, sin(radius));
+  const float3 chord = view - sunDir;
+  const float outer = radius + .5f * width;
+  if (dot(chord, chord) > outer * outer) return 0.f;
+  // As in Standard, atan2 retains the angle at zoom levels where acos(dot) loses the rim.
+  const float angle = atan2(length(cross(view, sunDir)), dot(view, sunDir));
+  const float coverage = numosDiscCoverage(radius - angle, width);
+  const float r = saturate(angle / radius);
+  const float limb = .4f + .6f * sqrt(max(0.f, 1.f - r * r));
+  return numosSunDiscCentre(radius) * limb * coverage;
+}
+
+float3 numosVisibleDiscs(float3 view, enhanced_AtmosphereArgs args, float3 airT, out float throughMoons) {
+  const float3 sunDir = normalize(args.sunDirection);
+  throughMoons = 1.f;
+  float3 light = 0.xxx;
+  [unroll] for (uint i = 0; i < enhanced_MAX_MOONS; ++i) {
+    float coverage;
+    const float3 moon = numosVisibleMoon(view, i, args, sunDir, coverage);
+    light += moon * coverage;
+    throughMoons *= 1.f - coverage;
+  }
+  light += args.sunIlluminance * (numosVisibleSun(view, sunDir, args) * throughMoons);
+  light *= airT;
+  const float peak = max(light.r, max(light.g, light.b));
+  if (peak > 6e4f) light *= 6e4f / peak; // respect NUMOS's FP16 ceiling in the same hue
+  return light;
+}
+
+// Same layers as NUMOS evalSkyRadiance, with one visible-disc evaluation for both
+// camera and PSR. The real atmosphere and stellar footprint also apply inside a disc.
+float3 numosVisibleSky(float3 directionWorld, enhanced_AtmosphereArgs args, bool isZUp, bool reflected) {
+  const bool flat = (args.debugSkyBisectFlags & 2u) != 0u;
+  if (flat && reflected) return .5f.xxx;
+  const float3 view = normalize(enhanced_worldToAtmosphereYUp(directionWorld, isZUp, args.flipUpAxis != 0));
+  float3 sky = flat ? .5f.xxx : enhanced_sampleSkyViewLutForRay(view, enhanced_AtmosphereSkyViewLut,
+                                enhanced_AtmosphereSkyViewSampler) + enhanced_evalSkyGroundRadiance(view, args);
+  float3 airT;
+  if (enhanced_skyAboveHorizon(view, args, airT)) {
+    float throughMoons;
+    const float3 discs = numosVisibleDiscs(view, args, airT, throughMoons);
+#ifdef enhanced_NIGHT_SKY_AVAILABLE
+    if (!flat && (args.nightSkyFlags & 11u) == 11u)
+      sky += airT * enhanced_evalNightSkyBeyondAir(view, args, enhanced_AtmosphereSkyViewSampler) * throughMoons;
+#endif
+    sky = (reflected ? sky : max(sky, 0.xxx)) + discs;
+  }
+  // The composite covers the camera sky with its screen clouds. A PSR miss sees
+  // the cloud dome's premultiplied light and transmittance, sampled once.
+  if (reflected && args.cloudSecondaryLutEnable != 0u) {
+    const float2 uv = enhanced_cloudDomeDirToUv(view);
+    const float4 cloud = enhanced_sampleCloudDomeLutSmooth(enhanced_AtmosphereCloudSecondaryLut,
+                                                            enhanced_AtmosphereSkyViewSampler, uv, 0.f);
+    sky = sky * cloud.a + cloud.rgb;
+  }
+  return max(sky, 0.xxx);
+}
