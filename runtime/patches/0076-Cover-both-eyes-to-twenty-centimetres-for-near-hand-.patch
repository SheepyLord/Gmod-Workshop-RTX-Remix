+        !std::isfinite(nearestDepth)||nearestDepth<=0) { return false; }
     double densityX = 0, densityY = 0;
     for (int i = 0; i < 2; ++i) {
       const auto& e = eyes[i];
@@ -56,10 +58,10 @@ namespace dxvk::vrmath {
           out.tanX = std::max(out.tanX, std::abs(ray.x/ray.z));
           out.tanY = std::max(out.tanY, std::abs(ray.y/ray.z));
           // Include translated eye rays down to the phase-1 nearest axial depth.
-          const double t=(kNearestEyeDepthMetres+e.eyeToHead.m[2][3])/(-ray.z);
+          const double t=(nearestDepth+e.eyeToHead.m[2][3])/(-ray.z);
           if (t<=0) { return false; }
