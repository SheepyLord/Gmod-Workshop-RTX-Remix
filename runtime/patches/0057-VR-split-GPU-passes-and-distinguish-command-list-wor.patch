-  void RtxVr::timestamp(RtxContext& ctx,uint32_t stage) {
+  double RtxVr::cpuWallMs() {
+    return std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+
+  double RtxVr::threadRunMs() {
+    FILETIME creation {},exit {},kernel {},user {};
+    if (!GetThreadTimes(GetCurrentThread(),&creation,&exit,&kernel,&user)) { return 0; }
+    const uint64_t ticks=(uint64_t(kernel.dwHighDateTime)<<32)+kernel.dwLowDateTime+
+      (uint64_t(user.dwHighDateTime)<<32)+user.dwLowDateTime;
+    return ticks*0.0001;
+  }
+
+  void RtxVr::recordingBegin(DxvkContext& ctx) {
+    if (!m_recordingThread.load(std::memory_order_acquire) || !active()) { return; }
+    std::lock_guard lock(m_recordingMutex);
+    if (!m_recordingThread.load() || !active()) { return; }
+    Recording recording;
+    if (!m_freeRecordings.empty()) {
+      recording=std::move(m_freeRecordings.back()); m_freeRecordings.pop_back();
+    } else {
+      recording.begin=m_device->createGpuQuery(VK_QUERY_TYPE_TIMESTAMP,0,0);
+      recording.end=m_device->createGpuQuery(VK_QUERY_TYPE_TIMESTAMP,0,0);
+    }
+    ctx.writeTimestamp(recording.begin);
+    m_recordings[&ctx]=std::move(recording);
+  }
+
+  void RtxVr::recordingEnd(DxvkContext& ctx) {
+    if (!m_recordingThread.load(std::memory_order_acquire) || !active()) { return; }
+    std::lock_guard lock(m_recordingMutex);
+    if (!m_recordingThread.load() || !active()) { return; }
+    const auto found=m_recordings.find(&ctx);
+    if (found==m_recordings.end()) { return; }
+    ctx.writeTimestamp(found->second.end);
+    m_markedSubmissions.insert(ctx.getCommandList().ptr());
+    m_closedRecordings.push_back(std::move(found->second)); m_recordings.erase(found);
+  }
+
+  void RtxVr::noteSubmission(const DxvkCommandList* list) {
+    if (!m_recordingThread.load() || !active()) { return; }
+    std::lock_guard lock(m_recordingMutex);
+    if (!m_markedSubmissions.erase(list)) { ++m_untrackedSubmissions; }
+  }
+
+  void RtxVr::collectRecordings() {
+    std::lock_guard lock(m_recordingMutex);
+    for (auto at=m_closedRecordings.begin(); at!=m_closedRecordings.end();) {
+      DxvkQueryData first {},last {};
+      if (at->begin->getData(first)!=DxvkGpuQueryStatus::Available ||
+          at->end->getData(last)!=DxvkGpuQueryStatus::Available) { ++at; continue; }
+      const vrtiming::Interval interval {first.timestamp.time,last.timestamp.time};
+      if (interval.end>=interval.begin) {
+        const auto position=std::lower_bound(m_gpuIntervals.begin(),m_gpuIntervals.end(),interval.begin,
+          [](const auto& value,uint64_t begin) { return value.begin<begin; });
+        m_gpuIntervals.insert(position,interval);
+      }
+      m_freeRecordings.push_back(std::move(*at)); at=m_closedRecordings.erase(at);
+    }
+    if (m_gpuIntervals.size()>4096) { m_gpuIntervals.erase(m_gpuIntervals.begin(),m_gpuIntervals.end()-4096); }
+    if (m_closedRecordings.size()>1024) { ++m_untrackedSubmissions; m_closedRecordings.pop_front(); }
+  }
+
+  std::string RtxVr::profileJson(const Timer& timer,const std::array<DxvkQueryData,vrtiming::kStages>& data) {
+    const double factor=m_device->properties().core.properties.limits.timestampPeriod/1e6;
+    const bool coverage=timer.untrackedBegin==timer.untrackedEnd && !m_gpuIntervals.empty() &&
+      m_gpuIntervals.front().begin<=data.front().timestamp.time && m_gpuIntervals.back().end>=data.back().timestamp.time;
+    std::array<double,vrtiming::kPasses> elapsed {},work {};
+    double gaps=0;
+    for (size_t i=0; i<vrtiming::kPasses; ++i) {
+      const uint64_t begin=data[i].timestamp.time,end=data[i+1].timestamp.time;
+      elapsed[i]=(end-begin)*factor;
+      const double covered=vrtiming::covered(begin,end,m_gpuIntervals)*factor;
+      work[i]=vrtiming::external(i) ? elapsed[i] : std::min(elapsed[i],covered);
+      gaps+=elapsed[i]-work[i];
+    }
+    const float path=float(work[1]+work[2]+work[3]+work[4]);
+    const float upscale=float(work[5]),warp=float(work[7]);
+    const double rawTotal=(data.back().timestamp.time-data.front().timestamp.time)*factor;
+    const float other=float(std::max(0.0,rawTotal-path-upscale-warp));
+    const float total=path+upscale+warp+other;
+    {
+      std::lock_guard lock(m_requestMutex);
+      m_status.gpuMsPathTrace=path; m_status.gpuMsUpscale=upscale; m_status.gpuMsWarp=warp;
+      m_status.gpuMsOther=other; m_status.gpuMsTotal=total;
+    }
+    std::ostringstream json; json.imbue(std::locale::classic()); json<<std::fixed<<std::setprecision(6);
+    json<<"{\"frame\":"<<timer.frame<<",\"pose\":"<<timer.pose
+      <<",\"coverage_known\":"<<(coverage ? "true" : "false")
+      <<",\"untracked_submissions\":"<<(timer.untrackedEnd-timer.untrackedBegin)
+      <<",\"gpu_total_ms\":"<<rawTotal<<",\"gpu_queue_wait_cpu_ms\":"<<(coverage ? gaps : 0)
+      <<",\"unattributed_queue_ms\":"<<(coverage ? 0 : gaps)
+      <<",\"render_thread_cpu_ms\":"<<std::max(0.0,timer.cpuRunEnd-timer.cpuRunBegin)
+      <<",\"render_thread_cycle_ms\":"<<std::max(0.0,timer.cpuWallEnd-timer.cpuWallBegin)
+      <<",\"render_injection_wall_ms\":"<<std::max(0.0,timer.cpuWallEnd-timer.cpuScopeBegin)
+      <<",\"cpu_submit_ms\":"<<timer.cpuSubmit<<",\"denoising_fused_in_upscaler\":true,\"passes\":{";
+    for (size_t i=0; i<vrtiming::kPasses; ++i) {
+      if (i) { json<<','; }
+      json<<'\"'<<vrtiming::kNames[i]<<"\":{\"gpu_ms\":"<<work[i]<<",\"span_ms\":"<<elapsed[i]<<'}';
+    }
+    json<<"},\"status_sums\":{\"path\":"<<path<<",\"upscale\":"<<upscale<<",\"warp\":"<<warp
+      <<",\"other\":"<<other<<",\"total\":"<<total<<"}}";
+    return json.str();
+  }
+
+  bool RtxVr::resolveTimer(Timer& timer) {
+    if (!timer.pending) { return true; }
+    std::array<DxvkQueryData,vrtiming::kStages> data {};
+    for (size_t i=0; i<data.size(); ++i) {
+      if (timer.queries[i]->getData(data[i])!=DxvkGpuQueryStatus::Available) { return false; }
+    }
+    m_lastProfile=profileJson(timer,data);
+    if ((timer.frame%60)==0 || !timer.captureFolder.empty()) { Logger::info(str::format("RTX VR profile ",m_lastProfile)); }
+    if (!timer.captureFolder.empty()) {
+      std::error_code error; std::filesystem::create_directories(timer.captureFolder,error);
+      std::ofstream file(timer.captureFolder/L"timings.json",std::ios::binary);
+      file<<m_lastProfile<<'\n';
+    }
+    timer.pending=false; return true;
+  }
+
