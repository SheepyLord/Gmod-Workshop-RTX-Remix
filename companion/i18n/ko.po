msgstr "맵을 불러왔습니다. 게임을 시작하는 중입니다"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:25
msgid "RTX Remix is preparing the scene"
msgstr "RTX Remix가 장면을 준비하는 중입니다"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:26
msgid "Running add-on scripts"
msgstr "애드온 스크립트를 실행하는 중"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:27
msgid "Building the spawn menu"
msgstr "생성 메뉴를 구성하는 중"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:28
msgid "Loading game files"
msgstr "게임 파일을 불러오는 중"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:29
msgid "Workshop: updating add-ons"
msgstr "Workshop: 애드온 업데이트 중"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:30
#, c-format
msgid "Workshop: fetching subscriptions (%s of %s)"
msgstr "Workshop: 구독 목록을 가져오는 중 (%s/%s)"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:31
#, c-format
msgid "Workshop: downloading add-ons (%s of %s)"
msgstr "Workshop: 애드온 다운로드 중 (%s/%s)"

#: nativeloader/lua/nativeloader/menu/loading_status.lua:32
#, c-format
