diff --git a/src/dxvk/shaders/rtx/pass/numos/numos_rainbow.h b/src/dxvk/shaders/rtx/pass/numos/numos_rainbow.h
new file mode 100644
index 000000000..f88dc37cc
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/numos/numos_rainbow.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "rtx/pass/numos/numos_ray_args.h"
+#ifdef __cplusplus
+#include <cmath>
+#endif
+
+struct NumosRainbowArgs {
+  float strength;
+  float distanceMeters;
+  float depthMeters;
+  float padding;
+};
+
+struct NumosSkyEffectsArgs {
+  NumosRayArgs rays;
+  NumosRainbowArgs rainbow;
+};
+
+// Stationary deviation in a spherical water drop, with a visible-light Cauchy approximation for water.
+#ifdef __cplusplus
+inline
+#endif
+float numosBowRadiusDegrees(float wavelengthMicrons, int order) {
+  const float pi = 3.141592653589793f;
+  const float n = 1.3242f + .00324f / (wavelengthMicrons * wavelengthMicrons);
+  const float m = float(order + 1);
+  const float incidence = acos(sqrt((n*n - 1.f) / (m*m - 1.f)));
+  const float refraction = asin(sin(incidence) / n);
+  const float deviation = float(order) * pi + 2.f * (incidence - m * refraction);
+  return (order == 1 ? pi - deviation : deviation - pi) * (180.f / pi);
+}
diff --git a/src/dxvk/shaders/rtx/pass/numos/numos_rainbow.slangh b/src/dxvk/shaders/rtx/pass/numos/numos_rainbow.slangh
new file mode 100644
index 000000000..71bd7dba9
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/numos/numos_rainbow.slangh
@@ -0,0 +1,78 @@
+#pragma once
+
+float3 bowSpectrum(float angle, float primary, float secondary) {
+  float3 energy = 0.xxx, normalization = 0.xxx;
+  [unroll] for (int i = 0; i < 9; ++i) {
+    const float wavelength = .410f + .0325f * i;
+    float3 x = (wavelength - float3(.612f, .545f, .458f)) / float3(.041f, .037f, .030f);
+    float3 response = exp(-.5f*x*x);
+    float violet = (wavelength - .420f) / .024f;
+    response.r += .12f * exp(-.5f * violet * violet);
+    float p = (angle - numosBowRadiusDegrees(wavelength, 1)) / .37f;
+    float s = (angle - numosBowRadiusDegrees(wavelength, 2)) / .54f;
+    energy += response * (primary * exp(-.5f*p*p) + .22f * secondary * exp(-.5f*s*s));
+    normalization += response;
+  }
+  return energy / normalization;
+}
+
+float3 numosRainBow(uint2 pixel, CameraDirections ray, bool miss, float hitDistance,
+                    float alphaDistance, float alphaTransmission, float3 radiance) {
+  const NumosRainbowArgs bow = skyEffects.rainbow;
+  if (!(bow.strength > 0.f)) return radiance;
+  const bool zUp = skyArgs.isZUp != 0u, flip = skyArgs.flipUpAxis != 0u;
+  const float3 sun = normalize(skyArgs.sunDirection);
+  const float3 dir = normalize(enhanced_worldToAtmosphereYUp(ray.worldDirection, zUp, flip));
+  const float angle = acos(clamp(dot(dir, -sun), -1.f, 1.f)) * (180.f / enhanced_kPi);
+  if (angle > 56.f) return radiance;
+  const float elevation = asin(clamp(sun.y, -1.f, 1.f)) * (180.f / enhanced_kPi);
+  const float primary = 1.f - smoothstep(41.5f, 42.f, elevation);
+  const float secondary = 1.f - smoothstep(50.5f, 51.f, elevation);
+  const float start = numosAirKmToWorld(.001f * bow.distanceMeters, skyArgs);
+  const float thickness = numosAirKmToWorld(.001f * bow.depthMeters, skyArgs);
+  const SkyForeground front = skyForegroundUnpack(SkyForegroundInput.Load(int3(pixel,0)));
+  float end = start + thickness;
+  if (!miss) end = min(end, hitDistance);
+  if (front.hasPsrSurface()) end = min(end, numosKmToWorld(-front.depthKm, skyArgs));
+  if (end <= start) return radiance;
+
+  const float3 ground = float3(0.f, -skyArgs.cameraAltitudeKm, 0.f);
+  const float3 groundSun = skyArgs.sunIlluminance * enhanced_evalSunShadowingClampedToSurface(
+    ground, sun, enhanced_AtmosphereTransmittanceLut, enhanced_AtmosphereSkyViewSampler, skyArgs) / cb.skyRadianceScale;
+  if (!any(groundSun > 0.xxx)) return radiance;
+
+  const float2 uv = cameraPixelCoordinateToScreenUV(cb.camera, int2(pixel));
+  const float2 cloudDepth = cb.skyCloudsValid ? SkyCloudDepth.Load(int3(pixel,0)).xy : float2(-1.f,-1.f);
+  const float cloudAlpha = cb.skyCloudsValid ? 1.f - SkyCloudRender.Load(int3(pixel,0)).a : 0.f;
+  const float forwardCos = max(abs(ray.viewDirection.z), 1e-5f);
+  float3 light = 0.xxx;
+  [unroll] for (uint i = 0u; i < 4u; ++i) {
+    float distance = lerp(start, end, (float(i) + .5f) / 4.f);
+    float3 world = skyArgs.cameraPosition + distance * ray.worldDirection;
+    float visible = 1.f;
+    if (skyArgs.cloudVoxelShadowsEnable && skyArgs.cloudKeyLight == 0u) {
+      visible = enhanced_sampleCloudGroundShadowFromMap(world, sun, skyArgs, zUp,
+        enhanced_AtmosphereCloudShadowMap, enhanced_AtmosphereCloudNoise3DSampler);
+    }
+    float forward = distance * forwardCos;
+    if (cb.skyHazeActive && skyArgs.apSceneShadow && forward < skyArgs.apFroxelRange && skyArgs.apDebugView == 0u) {
+      float slice = enhanced_apFroxelSliceCoordBefore(forward, miss ? 1e30f : hitDistance * forwardCos, skyArgs);
+      visible *= SkyHazeFroxelAux.SampleLevel(SkyHazeSampler, float3(uv,slice), 0.f).a;
+    }
+    const float distanceKm = numosWorldToKm(distance, skyArgs);
+    if (front.hasSeparateLayers() && distanceKm > front.depthKm) visible *= front.attenuation;
+    if (alphaDistance > 0.f && distance > alphaDistance) visible *= alphaTransmission;
+    visible *= 1.f - cloudAlpha * numosCloudDepthVisibility(cloudDepth.x, cloudDepth.y, distanceKm, cloudAlpha);
+    float3 viewT = cb.skyHazeActive ? enhanced_apNearTransmittance(dir, distance, skyArgs) : 1.xxx;
+    if (cb.volumeArgs.enable) {
+      viewT *= calcVolumetricAttenuation(cb.volumeArgs, none, false, distance, skyArgs.cameraPosition, ray.worldDirection);
+    }
+    light += visible * viewT;
+  }
+  light *= groundSun * (.25f * bow.strength * (end - start) / thickness);
+  const float inside = primary * (1.f - smoothstep(39.f,41.f,angle));
+  const float band = secondary * smoothstep(42.2f,43.8f,angle) * (1.f - smoothstep(49.f,51.f,angle));
+  const float3 spectrum = angle > 37.f ? bowSpectrum(angle, primary, secondary) : 0.xxx;
+  const float3 darkening = min(max(radiance, 0.xxx) * .12f, light * .004f) * band;
+  return radiance - darkening + light * (.020f * spectrum + .0017f * inside);
+}
