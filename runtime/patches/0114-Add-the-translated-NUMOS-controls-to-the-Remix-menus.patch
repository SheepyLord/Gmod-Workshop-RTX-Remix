+  void showNumosDeveloperPages(DxvkContext* ctx) {
+    RtxOptionLayerTarget target(RtxOptionEditTarget::RuntimeApi);
+    Pages page(ctx);
+    companionNote();
+    page.weatherNote();
+    if (page.status.shaderFailure)
+      ImGui::TextWrapped(
+          "NUMOS shaders could not be loaded. Check the Remix log and the numos folder beside d3d9.dll.");
+    if (!ImGui::BeginTabBar("NumosPages", ImGuiTabBarFlags_FittingPolicyScroll))
+      return;
+    if (ImGui::BeginTabItem("Sky")) {
+      page.showSkyTab();
+      page.showRayControls();
+      ImGui::EndTabItem();
+    }
+    if (ImGui::BeginTabItem("Clouds")) {
+      page.showCloudsTab();
+      ImGui::EndTabItem();
+    }
+    if (ImGui::BeginTabItem("Haze")) {
+      page.showHazeTab();
+      ImGui::EndTabItem();
+    }
+    if (ImGui::BeginTabItem("Night")) {
+      page.showNightTab();
+      ImGui::EndTabItem();
+    }
+    if (ImGui::BeginTabItem("Weather")) {
+      if (page.status.ready)
+        ImGui::Text("Current weather: %s", fork_hooks::translateUiText(presetLabel(page.status.preset)));
+      if (ImGui::Button("Weather presets"))
+        presetWindowOpen = true;
+      page.showLightning();
+      page.showRainbow();
+      ImGui::EndTabItem();
+    }
+    if (ImGui::BeginTabItem("Setup")) {
+      page.showSetupTab();
+      ImGui::EndTabItem();
+    }
+    ImGui::EndTabBar();
+  }
+
+  void showNumosGraphicsSettings(DxvkContext* ctx) {
+    RtxOptionLayerTarget target(RtxOptionEditTarget::RuntimeApi);
+    Pages page(ctx);
+    companionNote();
+    page.weatherNote();
+    ImGui::TextSeparator("Night Settings", 10.f);
+    page.showUserNight();
+    ImGui::TextSeparator("Haze Settings", 10.f);
+    page.showUserHaze();
+    ImGui::TextSeparator("Cloud Settings", 10.f);
+    page.showUserClouds();
+  }
+
+  void showNumosPresetWindow(DxvkContext* ctx, bool developerMenu) {
+    if (!presetWindowOpen)
+      return;
+    if (!developerMenu || ctx->getCommonObjects()->skyMode() != SkyMode::Enhanced) {
+      presetWindowOpen = false;
+      return;
+    }
+    RtxOptionLayerTarget target(RtxOptionEditTarget::RuntimeApi);
+    ImGui::SetNextWindowSize(ImVec2(34.f * ImGui::GetFontSize(), 0.f), ImGuiCond_FirstUseEver);
+    if (ImGui::Begin("Weather presets###NumosBuiltinWeather", &presetWindowOpen, ImGuiWindowFlags_NoSavedSettings)) {
+      companionNote();
+      auto& option = NumosWeather::presetObject();
+      const auto current = enhancedSky::findPreset(option.getCopy());
+      {
+        const char* presetTooltip =
+            "Choose Custom settings to use the current sky controls without a built-in weather preset.";
+        RemixGui::RtxOptionUxWrapper wrapper(&option, presetTooltip);
+        if (ImGui::BeginCombo("Built-in weather", presetLabel(current))) {
+          using P = numos::WeatherPreset;
+          for (int i = -1; i < int(P::Count); ++i) {
+            const auto which = i < 0 ? P::Count : P(i);
+            if (ImGui::Selectable(presetLabel(which), current == which)) {
+              RemixGui::CheckRtxOptionPopups(&option);
+              option.setDeferred(which == P::Count ? "" : numos::weatherPresetName(which));
+            }
+            if (current == which)
+              ImGui::SetItemDefaultFocus();
+          }
+          ImGui::EndCombo();
+        }
+      }
+      RemixGui::Checkbox("Follow game weather", &NumosWeather::followGameObject());
+      RemixGui::DragFloat("Weather transition", &NumosWeather::transitionSecondsObject(), .1f, 0.f, 600.f, "%.1f s",
+                          kClamp);
+      const auto incoming = NumosWeather::gameWeather.getCopy();
+      if (!incoming.empty())
+        ImGui::Text("Game weather: %s", gameWeatherLabel(incoming));
+      const auto outgoing = NumosWeather::gameWeatherOutgoing.getCopy();
+      const float blend = NumosWeather::gameWeatherBlend();
+      if (NumosWeather::followGame() && !incoming.empty() && !outgoing.empty() && blend >= 0.f) {
+        ImGui::Text("Transition from %s: %.0f%%", gameWeatherLabel(outgoing), std::clamp(blend, 0.f, 1.f) * 100.f);
+      }
+    }
+    ImGui::End();
+  }
