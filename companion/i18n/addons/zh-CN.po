msgstr "性能模式"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:114
msgid "Enables custom renderers to replace engine rendered world geometry and static props. Also controls engine culling patches. This will break mesh replacements in Remix when enabled."
msgstr "使用自定义渲染器代替引擎来绘制世界几何体和静态物体，并控制引擎的剔除补丁。启用后会使 Remix 的网格替换失效。"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:118
msgid "Culling"
msgstr "不可见物体剔除"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:130
#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/customrender/cl_build_progress.lua:71
msgid "Static Props"
msgstr "静态道具"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:137
msgid "Enables PVS culling for static props. May cause some props to cull incorrectly."
msgstr "对静态物体启用潜在可见集 (PVS) 剔除。部分物体可能被错误地剔除。"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:144
msgid "PVS Safety Distance"
msgstr "PVS 安全距离"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:153
msgid "Props within this distance always render, bypassing PVS. (0 = disabled)"
msgstr "此距离内的物体始终渲染，不受 PVS 限制。（0 = 禁用）"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:160
msgid "Distance Culling"
msgstr "距离剔除"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:169
msgid "Sphere-based culling for static props. With PVS on: applied after PVS as an extra filter. With PVS off: sole culling method. (0 = disabled)"
msgstr "按球形范围剔除静态物体。启用 PVS 时，在 PVS 之后再进行此项筛选；禁用 PVS 时，仅使用此剔除方式。（0 = 禁用）"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:193
msgid "3D Sky"
msgstr "3D 天空盒"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:205
msgid "Enable 3D Sky"
msgstr "启用 3D 天空盒"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:212
msgid "Renders 3D skybox map faces, displacements, and static props projected into world space. This does not include anything dynamic like particles, entities, etc. This is still WIP so there might be rendering issues on some maps."
msgstr "将 3D 天空盒中的地图表面、置换地形和静态物体投影到世界空间进行渲染。不包括粒子、实体等动态内容。此功能仍在开发中，部分地图可能出现渲染问题。"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:228
msgid "Advanced: Engine Patches"
msgstr "高级：引擎补丁"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:248
msgid "Disable Engine Frustum Culling"
msgstr "禁用引擎视锥剔除"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:249
msgid "Force Brush Entity Backfaces"
msgstr "强制绘制笔刷实体背面"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:250
msgid "Force World Backfaces #1"
msgstr "强制绘制世界背面 #1"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:251
msgid "Force World Backfaces #2"
msgstr "强制绘制世界背面 #2"

#: packages/fixes/garrysmod/garrysmod/addons/remixbinary/lua/remixlua/cl/cl_rtx_settings.lua:252
msgid "Disable BSP Culling"
msgstr "禁用 BSP 剔除"

