+msgid "Anchor Cut Threshold"
+msgstr "锚点跳变阈值"
+
+#: src/dxvk/rtx_render/rtx_numos_ui.cpp:847 src/dxvk/rtx_render/rtx_numos_ui_fields.inl:192
