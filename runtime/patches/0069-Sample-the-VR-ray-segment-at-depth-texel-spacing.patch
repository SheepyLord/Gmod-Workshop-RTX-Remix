     std::ostringstream json; json.imbue(std::locale::classic()); json<<std::fixed<<std::setprecision(6);
     json<<"{\"frame\":"<<timer.frame<<",\"pose\":"<<timer.pose
       <<",\"stale_camera_frames\":"<<m_staleCameras
+      <<",\"warp_search_override\":"<<m_warpSearchTaps<<",\"warp_maximum_steps\":"<<m_maxWarpSteps
       <<",\"coverage_known\":"<<(coverage ? "true" : "false")
       <<",\"untracked_submissions\":"<<(timer.untrackedEnd-timer.untrackedBegin)
       <<",\"gpu_total_ms\":"<<rawTotal<<",\"gpu_queue_wait_cpu_ms\":"<<(coverage ? gaps : 0)
@@ -557,6 +560,19 @@ namespace dxvk {
     if (!m_frameEligible) { mirror(ctx,game); return; }
     ScopedCpuProfileZone();
     timestamp(ctx,vrtiming::Stage::WarpBegin);
+    uint32_t maxSteps=0;
+    for(const auto& eye:m_frame.eyes) for(double u:{0.,1.}) for(double v:{0.,1.}) {
+      const auto start=vrmath::warpAtDepth(m_frameProjection,eye,u,v,
+        vrmath::kNearestEyeDepthMetres*m_frame.worldUnitsPerMetre,m_frame.worldUnitsPerMetre);
+      const auto infinity=vrmath::project(m_frameProjection,vrmath::eyeRay(eye,u,v));
+      maxSteps=std::max(maxSteps,vrmath::searchSteps(start,infinity,depth->imageInfo().extent.width,
+        depth->imageInfo().extent.height,m_warpSearchTaps));
+    }
+    if(maxSteps!=m_maxWarpSteps) {
+      m_maxWarpSteps=maxSteps;
+      Logger::info(str::format("RTX VR warp search: ",maxSteps," intervals, ",maxSteps+1,
+        " positions, depth ",depth->imageInfo().extent.width,"x",depth->imageInfo().extent.height));
+    }
     {
     ScopedGpuProfileZone(&ctx, "VR eye warp");
     DxvkImageViewCreateInfo desc {};
